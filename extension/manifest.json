{
  "manifest_version": 3,
  "name": "IDM-like Capture (POC)",
  "version": "0.1.0",
  "description": "Captures download URLs in the page and forwards them to the idm-host native messaging host.",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "IDM — stáhnout",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "102",
  "key": ""
}
