<!DOCTYPE html>
<html>

<head>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />

    <style type='text/css'>

        @font-face {
            font-family: 'Basier Circle';
            src: url('https://assets.revolut.com/media/fonts/BasierCircle-Regular.woff2') format('woff2');
        }

        body {
            margin: 0;
            letter-spacing: 1px;
            font-weight: 300;
            font-family: "Basier Circle";
            -webkit-font-smoothing: antialiased;
            color: #191C1F;
            font-size: 12px;
        }

        .sheet {
            margin: 0;
            overflow: hidden;
            position: relative;
            box-sizing: border-box;
            page-break-after: always;
        }

        .footer {
            position: absolute;
            bottom: -40px;
            display: block;
            width: 100%;
        }

        .footer p {
            color: #bfbfbf;
            width: 100%;
            font-size: 9px;
            text-align: center;
            position: relative;
            left: 0;
            bottom: 20px;
        }

        .col-1,
        .col-2,
        .col-3,
        .col-4,
        .col-5,
        .col-6,
        .col-7,
        .col-8,
        .col-9,
        .col-10,
        .col-11,
        .col-12 {
            float: left;
            position: relative;
            min-height: 1px;
        }

        .col-12 {
            width: 100%;
        }

        .col-11 {
            width: 91.66666667%;
        }

        .col-10 {
            width: 83.33333333%;
        }

        .col-9 {
            width: 75%;
        }

        .col-8 {
            width: 66.66666667%;
        }

        .col-7 {
            width: 58.33333333%;
        }

        .col-6 {
            width: 50%;
        }

        .col-5 {
            width: 41.66666667%;
        }

        .col-4 {
            width: 33.33333333%;
        }

        .col-3 {
            width: 25%;
        }

        .col-2 {
            width: 16.66666667%;
        }

        .col-1 {
            width: 8.33333333%;
        }

        .clearfix:before,
        .clearfix:after,
        .container:before,
        .container:after,
        .container-fluid:before,
        .container-fluid:after,
        .row:before,
        .row:after {
            content: ' ';
            display: table;
        }

        .clearfix:after,
        .container:after,
        .container-fluid:after,
        .row:after {
            clear: both;
        }

        .row {
            margin: 0 0 15px;
        }

        p {
            text-align: justify;
        }

        h1 {
            margin-bottom: 7.5px;
        }

        h4 {
            margin-top: 0;
            font-weight: 500;
        }

        h3 {
            font-size: 18px;
            margin-bottom: 17.5px;
        }

        .align-left {
            text-align: left;
        }

        .align-right {
            text-align: right;
        }

        .logo {
            position: relative;
            top: 18px;
        }

        ul {
            list-style: none;
            padding: 0;
        }

        ul li {
            margin: 4px 0;
        }

        .box {
            background: #f7f7f7;
            padding: 17.5px 15px;
            margin-bottom: 15px;
        }

        .box.summary {
            padding: 15px 17.5px;
            margin-bottom: 45px;
        }

        .box.summary h4 {
            margin: 17.5px 0 10px;
        }

        .box.box.summary p {
            margin-top: 0;
        }

        .get-in-touch {
            margin-top: 20px;
            padding: 15px 17.5px;
            display: inline-block;
        }

        .get-in-touch img {
            margin-right: 2px;
        }

        .get-in-touch ul li {
            padding-left: 18px;
        }

        .get-in-touch ul li:first-child {
            padding-left: 0;
        }

        .box ul {
            margin: 0;
        }

        .box ul li {
            margin: 0 0 12.5px 0;
        }

        .box ul li:last-child {
            margin: 0;
        }

        .box ul li span:first-child {
            float: left;
        }

        .box ul li.highlight {
            font-weight: 500;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        table thead th {
            text-align: right;
            padding: 7.5px;
            font-weight: 300;
            border-bottom: 2px solid;
            width: 10%;
        }

        table thead th:first-child {
            text-align: left;
        }

        table thead th:nth-child(2) {
            text-align: left;
            width: 18%;
        }

        table tbody td {
            padding: 14px 7.5px;
            text-align: right;
            -webkit-column-break-inside: avoid;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        table tbody tr {
            -webkit-column-break-inside: avoid;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        table tbody tr:first-child td {
            padding: 17.5px 7.5px 14px;
        }

        table tbody td:first-child,
        table tbody td:nth-child(2) {
            text-align: left;
        }

        table tbody tr:nth-child(even) td {
            background: #f7f7f7;
            border-top: 1px solid #efefef;
            border-bottom: 1px solid #efefef;
        }

        table.overdue tbody tr td {
            color: #EB008D;
        }

        table.overdue tbody tr:last-child td {
            color: #191C1F;
        }

        .break {
            display: block;
            page-break-after: always;
        }

        .table-explanation {
            display: block;
            -webkit-column-break-inside: avoid;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .table-explanation h3 {
            margin-bottom: 22.5px;
        }

        .separator {
            margin: 17.5px 0;
            height: 2px;
            width: 100%;
            background: #efefef;
        }

        @page {
            margin: 1cm 5mm;
            size: A4;
        }

        @supports (-webkit-overflow-scrolling: touch) {
            @media print {
                body {
                    padding: 1rem 1rem 2rem;
                }

                .footer {
                    position: absolute;
                    bottom: -2.5rem;
                }
            }
        }

        @media screen {
            body {
                padding: 3rem 4rem;
            }

            .footer {
                position: absolute;
                bottom: -1.5rem;
            }

            .footer::after {
                display: none;
            }
        }
    </style>
</head>

<body>
<div class="container sheet">
    <div class="row" style="margin-bottom: 45px;">
        <div class="col-6 align-left">
            <svg class="logo" width="100" height="22" viewBox="0 0 138 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M98.992 0H93.6205V29.748H98.992V0Z" fill="#191C1F"/>
