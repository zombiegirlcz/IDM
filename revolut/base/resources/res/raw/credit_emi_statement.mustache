            </svg>
        </div>
        <div class="col-6 align-right">
            <div>
                <h1>{{header}}</h1>
                <span>{{statementPeriodDate}}</span>
            </div>
        </div>
    </div>

    <div class="footer">
        <p>{{footer}}</p>
    </div>
    <div class="row">
        <div class="col-6 align-left">
            <h4>{{fullName}}</h4>
            <ul>
                <li>{{streetLine1}} {{streetLine2}}</li>
                <li>{{city}}</li>
                <li>{{postCode}}</li>
                <li>{{country}}</li>
            </ul>
        </div>
        <div class="col-6 align-right">
            <div class="box">
                <ul>
                    <li>
                        <span>{{summaryEntity}}</span>
                        <span>Revolut Payments UAB</span>
                    </li>
                    <li>
                        <span>{{summaryCurrency}}</span>
                        <span>{{currency}} · {{currencySymbol}}</span>
                    </li>
                </ul>
            </div>
            <div class="box">
                <ul>
                    <li class="highlight">
                        <span>{{summaryAccountOverview}}</span>
                        <span style="visibility:hidden;">-</span>
                    </li>
                    <li>
                        <span>{{summaryTotalBalance}}</span>
                        <span>{{totalBalance}}</span>
                    </li>
                    <li>
                        <span>{{summaryTotalOutgoings}}</span>
                        <span>{{totalOutgoings}}</span>
                    </li>
                    <li>
                        <span>{{summaryTotalDeposits}}</span>
                        <span>{{totalDeposits}}</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <h3>{{transactionsTitle}}</h3>
            <table>
                <thead>
                <th>{{transactionsDate}}</th>
                <th>{{transactionsDescription}}</th>
                <th>{{transactionsAmount}}</th>
                <th>{{transactionsBalance}}</th>
                </thead>
                <tbody>
                {{#otherTransactions}}
                    <tr>
                        <td>{{date}}</td>
                        <td style="text-transform: capitalize;">
                            {{description}}
                        </td>
                        <td style="text-align: right;">{{amount}}</td>
                        <td style="text-align: right;">{{balance}}</td>
                    </tr>
                {{/otherTransactions}}
                </tbody>
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="get-in-touch" style="padding-left: 0;">
                <h3>{{contactUsTitle}}</h3>
                <ul>
                    <li>
                        <img width="12px"
                             src="data:image/png;base64," />
                        <strong>{{contactUsChat}}</strong>
                    </li>
                    <li>{{contactUsWorkingHours}}</li>
                    <li>{{contactUsPremium}}</li>
                </ul>
                <ul>
                    <li>
                        <img style="position: relative; bottom: -2px;" width="12px"
                             src="data:image/png;base64," />
                        <strong>revolut.com</strong>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
</body>

</html>