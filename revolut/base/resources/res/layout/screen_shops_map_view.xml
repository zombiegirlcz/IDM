<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shopsMapViewScreen_rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/shopsMapViewScreen_navbar"
        android:background="@color/colorTransparent"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:outlineProvider="none"
        app:layout_anchorGravity="top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:layout_gravity="center_horizontal"
        android:id="@+id/shopsMapViewScreen_searchButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationZ="50dp"
        android:outlineProvider="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shopsMapViewScreen_navbar"
        app:uikit_SmallActionButtonStyle="AccentButton"/>
    <com.revolut.core.ui_kit.views.MapView
        android:id="@+id/shopsMapViewScreen_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/shopsMapViewScreen_backgroundView"
        android:background="?attr/uikit_windowBackground"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="-36dp"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/shopsMapViewScreen_coordinatorLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:orientation="vertical"
        android:id="@+id/shopsMapViewScreen_coordinatorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shopsMapViewScreen_navbar">
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:layout_gravity="bottom"
            android:id="@+id/shopsMapViewScreen_horizontalRecyclerView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="52dp"/>
        <com.revolut.core.ui_kit.internal.dialogs.BottomExpandableDialogView
            android:id="@+id/shopsMapViewScreen_expandableDialogContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_anchorGravity="bottom"/>
        <com.revolut.core.ui_kit.views.buttons.FormsActionButton
            android:layout_gravity="end|top"
            android:id="@+id/shopsMapViewScreen_locationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:translationY="-16dp"
            android:layout_marginEnd="@dimen/dp_16"
            app:backgroundTint="?attr/uikit_colorBackground"
            app:layout_anchor="@+id/shopsMapViewScreen_expandableDialogContainer"
            app:layout_anchorGravity="end|top"
            app:uikit_FormsActionButton="AccentButton"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
