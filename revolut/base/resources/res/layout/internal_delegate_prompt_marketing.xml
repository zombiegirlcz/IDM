<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.OnMeasureCallbackConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:layout_gravity="center"
        android:id="@+id/marketingPrompt_fullscreenBackgroundMediaView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.InnerScrollView
        android:id="@+id/marketingPrompt_scrollView"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout
            android:id="@+id/marketingPrompt_scrollContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/marketingPrompt_topGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="0dp"/>
            <com.revolut.core.ui_kit.internal.views.UiKitMediaView
                android:layout_gravity="center"
                android:id="@+id/marketingPrompt_mediaView"
                android:layout_width="250dp"
                android:layout_height="250dp"
                app:layout_constraintBottom_toTopOf="@+id/marketingPrompt_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPrompt_topGuideline"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.revolut.core.ui_kit.views.AvatarView
                android:id="@+id/marketingPrompt_avatar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/marketingPrompt_avatarHeading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPrompt_topGuideline"
                app:layout_constraintVertical_bias="0.5"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorForeground"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/marketingPrompt_avatarHeading"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp24"
                android:maxLines="2"
                android:layout_marginStart="?attr/uikit_dp24"
                android:layout_marginEnd="?attr/uikit_dp24"
                app:layout_constraintBottom_toTopOf="@+id/marketingPrompt_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPrompt_avatar"
                style="?attr/internal_textAppearanceHeading2"/>
            <com.revolut.core.ui_kit.internal.views.CircleProgressBarWithText
                android:id="@+id/marketingPrompt_progressBar"
                android:layout_width="0dp"
                android:layout_height="250dp"
                app:layout_constraintBottom_toTopOf="@+id/marketingPrompt_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPrompt_topGuideline"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
                android:textColor="?attr/uikit_colorForeground"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/marketingPrompt_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxLines="3"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="@dimen/internal_MarketingDisplay2_min_text_size"
                android:autoSizeMaxTextSize="@dimen/internal_MarketingDisplay2_text_size"
                app:layout_constraintBottom_toTopOf="@+id/marketingPrompt_description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPrompt_mediaView"/>
            <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:ellipsize="end"
                android:gravity="top|center_horizontal"
                android:id="@+id/marketingPrompt_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxLines="5"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="@dimen/internal_primary_text_size"
                app:layout_constraintBottom_toTopOf="@+id/marketingPrompt_link"
                app:layout_constraintEnd_toEndOf="@+id/marketingPrompt_title"
                app:layout_constraintStart_toStartOf="@+id/marketingPrompt_title"
                app:layout_constraintTop_toBottomOf="@+id/marketingPrompt_title"
                app:layout_goneMarginBottom="16dp"
                style="?attr/internal_textAppearanceBody1"/>
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorBlue"
                android:gravity="center_horizontal"
                android:id="@+id/marketingPrompt_link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:textAlignment="center"
                app:layout_constraintBottom_toTopOf="@+id/marketingPrompt_bottomGuideline"
                app:layout_constraintEnd_toEndOf="@+id/marketingPrompt_title"
                app:layout_constraintStart_toStartOf="@+id/marketingPrompt_title"
                app:layout_constraintTop_toBottomOf="@+id/marketingPrompt_description"
                style="?attr/internal_textAppearanceEmphasis2"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/marketingPrompt_bottomGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="0dp"/>
        </com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
    </com.revolut.core.ui_kit.views.InnerScrollView>
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/marketingPrompt_navBar"
        android:fitsSystemWindows="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.FcaDisclaimerView
        android:id="@+id/marketingPrompt_disclaimer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/marketingPrompt_navBar"/>
    <com.revolut.core.ui_kit.views.buttons.ActionFooterView
        android:orientation="vertical"
        android:id="@+id/marketingPrompt_actionFooter"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.revolut.core.ui_kit.internal.views.OnMeasureCallbackConstraintLayout>
