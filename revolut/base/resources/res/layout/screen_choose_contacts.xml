<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.NestedScrollCoordinatorView
        android:id="@+id/contactsChooser_coordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/contactsChooser_navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/contactsChooser_recyclerView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:layout_constraintTop_toBottomOf="@+id/contactsChooser_navBar"/>
    </com.revolut.core.ui_kit.views.NestedScrollCoordinatorView>
    <com.revolut.core.ui_kit.views.buttons.TwinVerticalButton
        android:id="@+id/contactsChooser_continueTwinButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintRight_toLeftOf="parent"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/contactsChooser_continueButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/uikit_dp16"
        android:layout_marginRight="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintRight_toLeftOf="parent"/>
    <com.revolut.core.ui_kit.views.LabeledVerticalScrollView
        android:layout_gravity="end|bottom"
        android:id="@+id/contactsChooser_labeledRecyclerViewScroller"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
