<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/prompt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/prompt_backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.InnerScrollView
        android:id="@+id/prompt_scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.revolut.core.ui_kit.internal.views.UiKitMediaView
                android:layout_gravity="center"
                android:id="@+id/prompt_playerView"
                android:layout_width="@dimen/internal_prompt_image_size"
                android:layout_height="@dimen/internal_prompt_image_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/prompt_link"
                app:layout_constraintVertical_bias="0.5"/>
            <com.revolut.core.ui_kit.internal.views.CircleProgressBarWithText
                android:layout_gravity="center_horizontal"
                android:id="@+id/prompt_progressBar"
                android:layout_width="@dimen/internal_prompt_image_size"
                android:layout_height="@dimen/internal_prompt_image_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/prompt_link"
                app:layout_constraintVertical_bias="0.5"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/prompt_gradientOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/prompt_link"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/internal_content_overlay_gradient"/>
            <TextView
                android:textColor="?attr/uikit_colorForeground"
                android:id="@+id/prompt_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                android:layout_marginStart="?attr/uikit_dp24"
                app:layout_constraintEnd_toStartOf="@+id/prompt_avatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="@dimen/internal_dp24"
                style="?attr/internal_textAppearanceHeading1"/>
            <TextView
                android:textColor="?attr/uikit_colorForeground"
                android:id="@+id/prompt_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp24"
                app:layout_constraintEnd_toEndOf="@+id/prompt_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/prompt_title"
                app:layout_goneMarginEnd="@dimen/internal_dp24"
                style="?attr/internal_textAppearanceEmphasis1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/prompt_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/internal_dp24"
                app:layout_constraintBottom_toBottomOf="@+id/prompt_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/prompt_title"
                app:layout_constraintTop_toTopOf="@+id/prompt_title"/>
            <TextView
                android:textColor="?attr/uikit_colorForeground"
                android:id="@+id/prompt_link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp24"
                android:layout_marginEnd="?attr/uikit_dp24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/prompt_description"
                style="?attr/internal_textAppearanceEmphasis1"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/prompt_RecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/prompt_link"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.revolut.core.ui_kit.views.InnerScrollView>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/prompt_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="?attr/uikit_dp8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="?attr/uikit_dp8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_24_cross"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/prompt_menuIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="?attr/uikit_dp8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/prompt_BottomContainer"
        android:paddingBottom="?attr/uikit_dp24"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="center_horizontal"
            android:id="@+id/prompt_footerDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp24"
            android:layout_marginEnd="?attr/uikit_dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceBody3"/>
        <com.revolut.core.ui_kit.views.buttons.GooglePayButton
            android:id="@+id/prompt_googlePayButton"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/prompt_footerDescription"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/prompt_primaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/prompt_googlePayButton"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/prompt_secondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/prompt_primaryButton"
            app:uikit_LargeActionButtonStyle="SemiAccentButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
