<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.revolut.core.ui_kit.internal.views.linearlayout.UIKitLinearLayout
        android:orientation="vertical"
        android:id="@+id/modalContainer_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.internal.views.modal.ModalTopSpacerView
            android:id="@+id/modalContainer_topPaddingSpace"
            android:background="?attr/uikit_colorTransparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.core.ui_kit.internal.views.framelayout.UIKitFrameLayout
            android:id="@+id/modalContainer_contentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/modalContainer_knobContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/modalContainer_knob"
                    android:background="@drawable/internal_modal_knob"
                    android:layout_width="48dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"/>
            </FrameLayout>
        </com.revolut.core.ui_kit.internal.views.framelayout.UIKitFrameLayout>
    </com.revolut.core.ui_kit.internal.views.linearlayout.UIKitLinearLayout>
    <com.revolut.core.ui_kit.base.UIKitView
        android:id="@+id/modalContainer_foreground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</merge>
