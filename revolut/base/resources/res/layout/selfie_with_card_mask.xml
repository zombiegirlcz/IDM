<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selfieWithCardGroup"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/overlayTop"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/overlayLeft"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardFaceSeparator"
        app:layout_constraintEnd_toStartOf="@+id/faceMaskImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overlayTop"/>
    <View
        android:id="@+id/overlayLeft1"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardMaskView"
        app:layout_constraintEnd_toStartOf="@+id/cardMaskView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overlayLeft"/>
    <ImageView
        android:id="@+id/faceMaskImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/cardFaceSeparator"
        app:layout_constraintDimensionRatio="1:1.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overlayTop"
        app:srcCompat="@drawable/selfie_mask"/>
    <View
        android:id="@+id/cardFaceSeparator"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintEnd_toEndOf="@+id/faceMaskImageView"
        app:layout_constraintStart_toStartOf="@+id/faceMaskImageView"
        app:layout_constraintTop_toBottomOf="@+id/faceMaskImageView"/>
    <ImageView
        android:id="@+id/cardMaskView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/overlayBottom"
        app:layout_constraintDimensionRatio="85.6:54"
        app:layout_constraintEnd_toEndOf="@+id/faceMaskImageView"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/faceMaskImageView"
        app:layout_constraintTop_toBottomOf="@+id/cardFaceSeparator"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/cnp_selfie_bank_card_mask"/>
    <View
        android:id="@+id/overlayRight"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardFaceSeparator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/faceMaskImageView"
        app:layout_constraintTop_toBottomOf="@+id/overlayTop"/>
    <View
        android:id="@+id/overlayRight1"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/cardMaskView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardMaskView"
        app:layout_constraintTop_toBottomOf="@+id/overlayRight"/>
    <View
        android:id="@+id/overlayBottom"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="188dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Space
        android:id="@+id/leftTopNumberCover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cardMaskView"
        app:layout_constraintEnd_toEndOf="@+id/cardMaskView"
        app:layout_constraintHorizontal_bias="0.29"
        app:layout_constraintStart_toEndOf="@+id/overlayLeft1"
        app:layout_constraintTop_toBottomOf="@+id/cardFaceSeparator"
        app:layout_constraintVertical_bias="0.52"/>
    <Space
        android:id="@+id/rightBottomNumberCover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cardMaskView"
        app:layout_constraintEnd_toEndOf="@+id/cardMaskView"
        app:layout_constraintHorizontal_bias="0.92"
        app:layout_constraintStart_toEndOf="@+id/overlayLeft1"
        app:layout_constraintTop_toBottomOf="@+id/cardFaceSeparator"
        app:layout_constraintVertical_bias="0.72"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/overlayGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="overlayTop, overlayLeft, overlayLeft1, overlayRight, overlayRight1, overlayBottom, cardFaceSeparator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
