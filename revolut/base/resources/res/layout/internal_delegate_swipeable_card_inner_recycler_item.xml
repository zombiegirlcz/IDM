<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.swipeablecards.container.SwipeableCardContainerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@drawable/internal_background_swipeable_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/swipeableCardInnerRecyclerItemDelegate_recyclerView"
            android:padding="@dimen/internal_dp24"
            android:focusableInTouchMode="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:layout_gravity="bottom"
            android:id="@+id/swipeableCardInnerRecyclerItemDelegate_largeButton"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/uikit_dp24"
            android:layout_marginRight="?attr/uikit_dp24"
            android:layout_marginBottom="?attr/uikit_dp24"
            app:uikit_LargeActionButtonStyle="ForegroundButton"/>
        <View
            android:layout_gravity="top"
            android:id="@+id/swipeableCardInnerRecyclerItemDelegate_headerGradient"
            android:background="@drawable/internal_background_gradient_swipeable_card_header"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/internal_quiz_card_gradient_height"
            android:elevation="1dp"
            android:outlineProvider="none"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/swipeableCardInnerRecyclerItemDelegate_footerGradient"
            android:background="@drawable/internal_background_gradient_swipeable_card_footer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/internal_quiz_card_gradient_height"
            android:elevation="1dp"
            android:outlineProvider="none"/>
    </FrameLayout>
</com.revolut.core.ui_kit.internal.views.swipeablecards.container.SwipeableCardContainerView>
