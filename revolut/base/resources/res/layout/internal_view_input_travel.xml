<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inputTravel_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/inputTravel_primaryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:lines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/inputTravel_progress"
            app:layout_constraintEnd_toStartOf="@+id/inputTravel_secondaryText"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"
            app:layout_goneMarginBottom="?attr/uikit_dp16"
            style="?attr/internal_textAppearanceBody1"/>
        <ViewStub
            android:id="@+id/inputTravel_hintSwitcherStub"
            android:layout="@layout/internal_view_input_travel_hint_switcher"
            android:inflatedId="@+id/inputTravel_hintSwitcher"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp8"
            app:layout_constraintBottom_toTopOf="@+id/inputTravel_progress"
            app:layout_constraintEnd_toStartOf="@+id/inputTravel_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/inputTravel_secondaryText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/uikit_dp8"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/inputTravel_progress"
            app:layout_constraintEnd_toStartOf="@+id/inputTravel_icon"
            app:layout_constraintStart_toEndOf="@+id/inputTravel_primaryText"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginBottom="?attr/uikit_dp16"
            style="?attr/internal_textAppearanceBody1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/inputTravel_icon"
            android:layout_width="?attr/uikit_dp24"
            android:layout_height="?attr/uikit_dp24"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/inputTravel_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginBottom="?attr/uikit_dp16"/>
        <FrameLayout
            android:id="@+id/inputTravel_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="?attr/uikit_dp16"
                android:indeterminate="true"
                android:indeterminateBehavior="repeat"
                android:minHeight="?attr/uikit_dp4"
                android:indeterminateTint="?attr/uikit_colorAccent"
                android:indeterminateTintMode="src_in"
                android:screenReaderFocusable="true"
                style="?android:attr/progressBarStyleHorizontal"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/inputTravel_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="?attr/uikit_dp16"
        app:shimmer_auto_start="false">
        <View
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/internal_input_text_rectangle_grey"
            android:layout_width="160dp"
            android:layout_height="?attr/uikit_dp16"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</merge>
