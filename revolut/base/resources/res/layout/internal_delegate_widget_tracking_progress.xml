<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/internal_dp12"
        android:paddingBottom="@dimen/internal_dp12"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/internal_dp16">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="start"
            android:id="@+id/trackingProgressWidget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/trackingProgressWidget_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trackingProgressWidget_title"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/trackingProgressWidget_mainValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:layout_marginHorizontal="@dimen/internal_dp8"
            android:autoSizeMaxTextSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/trackingProgressWidget_badgeStatus"
            app:layout_constraintStart_toEndOf="@+id/trackingProgressWidget_image"
            app:layout_constraintTop_toBottomOf="@+id/trackingProgressWidget_title"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/trackingProgressWidget_secondaryValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginHorizontal="@dimen/internal_dp8"
            app:layout_constraintEnd_toStartOf="@+id/trackingProgressWidget_badgeStatus"
            app:layout_constraintStart_toEndOf="@+id/trackingProgressWidget_image"
            app:layout_constraintTop_toBottomOf="@+id/trackingProgressWidget_mainValue"
            style="?attr/internal_textAppearanceBody2"/>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/trackingProgressWidget_badgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trackingProgressWidget_title"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/trackingProgressWidget_bottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="true"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="trackingProgressWidget_image, trackingProgressWidget_secondaryValue, trackingProgressWidget_badgeStatus"/>
        <com.revolut.core.ui_kit.internal.views.LinearTrackingProgressBar
            android:id="@+id/trackingProgressWidget_trackingProgressView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/trackingProgressWidget_footerTitle"
            app:layout_constraintTop_toBottomOf="@+id/trackingProgressWidget_bottomBarrier"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="start"
            android:id="@+id/trackingProgressWidget_footerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/trackingProgressWidget_footerValue"
            app:layout_constraintStart_toStartOf="parent"
            style="?attr/internal_textAppearanceBody3"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="end"
            android:id="@+id/trackingProgressWidget_footerValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewEnd"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/trackingProgressWidget_footerTitle"
            style="?attr/internal_textAppearanceBody3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
