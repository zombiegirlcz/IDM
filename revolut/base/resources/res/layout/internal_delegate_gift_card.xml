<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.TiltGlowCardContainerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_tiltGlowContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_8">
    <com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout
        android:id="@+id/card_constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/card_imageView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/card_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginHorizontal="?attr/uikit_dp16"
            app:layout_constraintBottom_toBottomOf="@+id/card_imageView"
            app:layout_constraintStart_toStartOf="@+id/card_imageView"
            app:layout_constraintTop_toTopOf="@+id/card_imageView"
            app:layout_constraintVertical_bias="0"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/internal_colorForegroundTintOnLightBackground"
            android:id="@+id/card_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            android:maxLines="1"
            android:layout_marginHorizontal="?attr/uikit_dp16"
            app:layout_constraintEnd_toEndOf="@+id/card_imageView"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="@+id/card_imageView"
            app:layout_constraintTop_toTopOf="@+id/card_imageView"
            style="?attr/internal_textAppearanceHeading2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/internal_colorForegroundTintOnLightBackground"
            android:id="@+id/card_amountSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:alpha="0.8"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toBottomOf="@+id/card_imageView"
            app:layout_constraintEnd_toEndOf="@+id/card_imageView"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="@+id/card_imageView"
            app:layout_constraintTop_toBottomOf="@+id/card_amount"
            app:layout_constraintVertical_bias="0"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
</com.revolut.core.ui_kit.views.TiltGlowCardContainerView>
