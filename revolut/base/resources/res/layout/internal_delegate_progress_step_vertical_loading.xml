<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/progressStepVerticalLoading_root"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/progressStepVerticalLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/internal_dp16">
            <View
                android:id="@+id/progressStepVerticalLoading_stepProgress"
                android:background="@drawable/internal_background_rounded_gray"
                android:layout_width="@dimen/internal_dp4"
                android:layout_height="0dp"
                android:backgroundTint="@color/internal_greyTone20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/progressStepVerticalLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginBottom="?attr/uikit_dp8"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/progressStepVerticalLoading_stepProgress"/>
            <View
                android:id="@+id/progressStepVerticalLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="@dimen/internal_card_8dp_padding_size"
                app:layout_constraintStart_toStartOf="@+id/progressStepVerticalLoading_title"
                app:layout_constraintTop_toBottomOf="@+id/progressStepVerticalLoading_title"
                app:layout_constraintWidth_percent="0.22"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
