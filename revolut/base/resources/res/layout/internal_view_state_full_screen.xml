<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:paddingBottom="96dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="312dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/stateImage"
            android:visibility="visible"
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:layout_constraintBottom_toTopOf="@+id/stateTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="center_horizontal"
            android:id="@+id/stateTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp16"
            app:layout_constraintBottom_toTopOf="@+id/stateSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stateImage"
            app:layout_goneMarginTop="24dp"
            style="?attr/internal_textAppearanceHeading3"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="center_horizontal"
            android:id="@+id/stateSubtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp16"
            app:layout_constraintBottom_toTopOf="@+id/bottomButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stateTitle"
            style="?attr/internal_textAppearanceBody2"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/bottomButton"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:uikit_LargeActionButtonStyle="FlatButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
