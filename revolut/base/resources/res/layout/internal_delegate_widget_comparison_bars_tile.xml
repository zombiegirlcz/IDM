<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.internal.views.ResizableTileHeaderView
            android:id="@+id/comparisonBarsTile_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp12"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorPerformancePositive"
            android:ellipsize="end"
            android:id="@+id/comparisonBarsTile_positiveValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/internal_dp4"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp4"
            app:layout_constraintBottom_toTopOf="@+id/comparisonBarsTile_negativeValue"
            app:layout_constraintEnd_toStartOf="@+id/comparisonBarsTile_chart"
            app:layout_constraintStart_toStartOf="parent"
            style="?attr/internal_textAppearanceBody3"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorPerformanceNegative"
            android:ellipsize="end"
            android:id="@+id/comparisonBarsTile_negativeValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/internal_dp12"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/comparisonBarsTile_chart"
            app:layout_constraintStart_toStartOf="parent"
            style="?attr/internal_textAppearanceBody3"/>
        <com.revolut.core.ui_kit.internal.views.chart.HistogramView
            android:id="@+id/comparisonBarsTile_chart"
            android:layout_width="28dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/internal_dp12"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
