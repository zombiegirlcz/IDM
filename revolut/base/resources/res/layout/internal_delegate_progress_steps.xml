<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_colorBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/progressSteps_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/progressSteps_counter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/progressSteps_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/progressSteps_caption"
        app:layout_constraintEnd_toEndOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/progressSteps_step1"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/progressSteps_step2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_caption"
        app:srcCompat="@drawable/internal_progress_accent_step"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/progressSteps_step2"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintEnd_toStartOf="@+id/progressSteps_step3"
        app:layout_constraintStart_toEndOf="@+id/progressSteps_step1"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_caption"
        app:srcCompat="@drawable/internal_progress_accent_step"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/progressSteps_step3"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/progressSteps_step2"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_caption"
        app:srcCompat="@drawable/internal_progress_accent_step"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/progressSteps_step1Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="@+id/progressSteps_step1"
        app:layout_constraintStart_toStartOf="@+id/progressSteps_step1"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_step1"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGrey50"
        android:gravity="center"
        android:id="@+id/progressSteps_step1Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/progressSteps_step1"
        app:layout_constraintStart_toStartOf="@+id/progressSteps_step1"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_step1Title"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/progressSteps_step2Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="@+id/progressSteps_step2"
        app:layout_constraintStart_toStartOf="@+id/progressSteps_step2"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_step2"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGrey50"
        android:gravity="center"
        android:id="@+id/progressSteps_step2Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/progressSteps_step2"
        app:layout_constraintStart_toStartOf="@+id/progressSteps_step2"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_step2Title"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/progressSteps_step3Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="@+id/progressSteps_step3"
        app:layout_constraintStart_toStartOf="@+id/progressSteps_step3"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_step3"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGrey50"
        android:gravity="center"
        android:id="@+id/progressSteps_step3Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/progressSteps_step3"
        app:layout_constraintStart_toStartOf="@+id/progressSteps_step3"
        app:layout_constraintTop_toBottomOf="@+id/progressSteps_step3Title"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
