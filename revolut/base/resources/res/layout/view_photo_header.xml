<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/photoHeader_root"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="56dp"
    app:layout_scrollFlags="exitUntilCollapsed|scroll">
    <FrameLayout
        android:id="@+id/photoHeader_wallpaperContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.navbar.WallpaperAssetSwitcher
            android:id="@+id/photoHeader_wallpaperView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/photoHeader_topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="56dp"/>
    <com.revolut.core.ui_kit.views.AvatarView
        android:id="@+id/photoHeader_avatarView"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/photoHeader_statusView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/photoHeader_topGuideline"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/photoHeader_statusView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/photoHeader_titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photoHeader_avatarView"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginTop="8dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:gravity="center"
        android:id="@+id/photoHeader_titleView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/photoHeader_descriptionView"
        app:layout_constraintEnd_toStartOf="@+id/photoHeader_userStatusBadge"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photoHeader_statusView"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginEnd="16dp"
        app:layout_goneMarginTop="8dp"/>
    <com.revolut.core.ui_kit.internal.views.badge.UserStatusBadgeView
        android:id="@+id/photoHeader_userStatusBadge"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/photoHeader_titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/photoHeader_titleView"
        app:layout_constraintTop_toTopOf="@+id/photoHeader_titleView"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/photoHeader_descriptionView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/photoHeader_actionsView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photoHeader_titleView"
        app:layout_goneMarginTop="8dp"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.ActionsView
        android:id="@+id/photoHeader_actionsView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:internal_brightDark="true"
        app:internal_paddingEnd="16dp"
        app:internal_paddingStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/photoHeader_bottomGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photoHeader_descriptionView"
        app:layout_goneMarginTop="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/photoHeader_bottomGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="24dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/photoHeader_toolbarLayout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
            android:layout_gravity="center_vertical"
            android:id="@+id/photoHeader_navigationButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/uikit.navigate_up.description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/photoHeader_toolbarTitleView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/photoHeader_toolbarSubtitleView"
            app:layout_constraintEnd_toStartOf="@+id/photoHeader_menuRecyclerView"
            app:layout_constraintStart_toEndOf="@+id/photoHeader_navigationButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="16dp"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/photoHeader_toolbarSubtitleView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/photoHeader_menuRecyclerView"
            app:layout_constraintStart_toEndOf="@+id/photoHeader_navigationButton"
            app:layout_constraintTop_toBottomOf="@+id/photoHeader_toolbarTitleView"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="16dp"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/photoHeader_menuRecyclerView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout>
