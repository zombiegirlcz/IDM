<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/heroBannerLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="110dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroBannerLoading_constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="?attr/uikit_dp16"
            android:paddingVertical="?attr/uikit_dp16">
            <TextView
                android:id="@+id/heroBannerLoading_badge"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="?attr/uikit_dp24"
                app:layout_constraintEnd_toEndOf="@+id/heroBannerLoading_contentArea"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.24"/>
            <TextView
                android:id="@+id/heroBannerLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/heroBannerLoading_description1"
                app:layout_constraintEnd_toEndOf="@+id/heroBannerLoading_contentArea"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_percent="0.24"
                style="?attr/internal_textAppearanceEmphasis1"/>
            <TextView
                android:id="@+id/heroBannerLoading_description1"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                app:layout_constraintBottom_toTopOf="@+id/heroBannerLoading_description2"
                app:layout_constraintEnd_toEndOf="@+id/heroBannerLoading_contentArea"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/heroBannerLoading_title"
                app:layout_constraintVertical_bias="1"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_percent="0.64"
                style="?attr/internal_textAppearanceBody2"/>
            <TextView
                android:id="@+id/heroBannerLoading_description2"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/heroBannerLoading_contentArea"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/heroBannerLoading_description1"
                app:layout_constraintWidth_percent="0.49"
                style="?attr/internal_textAppearanceBody2"/>
            <View
                android:id="@+id/heroBannerLoading_contentArea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.7"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
