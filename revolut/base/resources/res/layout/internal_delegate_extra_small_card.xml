<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/extraSmallCard_ConstraintLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/extraSmallCard_BackgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/extraSmallCard_BackgroundImageGradientOverlay"
        android:background="@drawable/internal_gradient_bottom_to_top_dark"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="@+id/extraSmallCard_BackgroundImage"
        app:layout_constraintEnd_toEndOf="@+id/extraSmallCard_BackgroundImage"
        app:layout_constraintStart_toStartOf="@+id/extraSmallCard_BackgroundImage"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/extraSmallCard_topRightIcon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/uikit_colorBackground"
        android:gravity="center"
        android:id="@+id/extraSmallCard_topRightBadgeText"
        android:background="@drawable/internal_extra_small_card_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="?attr/uikit_dp8"
        android:minWidth="18dp"
        android:lines="1"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/extraSmallCard_topLeftIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/extraSmallCard_iconsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="extraSmallCard_topLeftIcon,extraSmallCard_topRightBadgeText,extraSmallCard_topRightIcon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/extraSmallCard_textTopLine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/extraSmallCard_textBottomLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraSmallCard_iconsBarrier"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="?attr/uikit_dp8"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/extraSmallCard_textBottomLine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp8"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <View
        android:id="@+id/extraSmallCard_ForegroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/extraSmallCard_BackgroundImage"
        app:layout_constraintEnd_toEndOf="@+id/extraSmallCard_BackgroundImage"
        app:layout_constraintStart_toStartOf="@+id/extraSmallCard_BackgroundImage"
        app:layout_constraintTop_toTopOf="@+id/extraSmallCard_BackgroundImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
