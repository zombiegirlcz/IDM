<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.OnMeasureCallbackConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroBanner_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/heroBanner_media"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_min="110dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/heroBanner_foregroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/heroBanner_closeButton"
        android:paddingTop="?attr/uikit_dp12"
        android:paddingBottom="?attr/uikit_dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="?attr/uikit_dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.BadgeStatusView
        android:id="@+id/heroBanner_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/heroBanner_title"
        app:layout_constraintEnd_toStartOf="@+id/promotionalMediumTile_closeIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/heroBanner_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:ellipsize="end"
        android:id="@+id/heroBanner_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/heroBanner_description"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/heroBanner_badge"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.7"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:ellipsize="end"
        android:id="@+id/heroBanner_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp8"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/heroBanner_progress"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/heroBanner_title"
        app:layout_constraintWidth_percent="0.7"
        app:layout_goneMarginBottom="?attr/uikit_dp12"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.HorizontalStepsProgressView
        android:id="@+id/heroBanner_progress"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="?attr/uikit_dp4"
        android:layout_marginBottom="?attr/uikit_dp12"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/heroBanner_title"
        app:layout_constraintStart_toStartOf="@+id/heroBanner_title"/>
</com.revolut.core.ui_kit.internal.views.OnMeasureCallbackConstraintLayout>
