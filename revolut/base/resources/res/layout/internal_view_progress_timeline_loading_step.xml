<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foregroundGravity="center_horizontal">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/viewProgressTimelineLoadingStep_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="98dp"
        android:minWidth="54dp">
        <View
            android:id="@+id/viewProgressTimelineLoadingStep_icon"
            android:background="?attr/uikit_shimmerBackgroundCircle"
            android:layout_width="@dimen/internal_dp24"
            android:layout_height="@dimen/internal_dp24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/viewProgressTimelineLoadingStep_title"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="@dimen/internal_dp16"
            android:layout_marginTop="@dimen/internal_dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewProgressTimelineLoadingStep_icon"/>
        <View
            android:id="@+id/viewProgressTimelineLoadingStep_subtitle"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="@dimen/internal_dp16"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="@+id/viewProgressTimelineLoadingStep_title"
            app:layout_constraintStart_toStartOf="@+id/viewProgressTimelineLoadingStep_title"
            app:layout_constraintTop_toBottomOf="@+id/viewProgressTimelineLoadingStep_title"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_percent="0.65"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
