<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ReactionsKeyboardView_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:layout_gravity="top"
            android:id="@+id/ReactionsKeyboardView_navBar"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="56dp"/>
        <com.revolut.core.ui_kit.views.FixedTabs
            android:id="@+id/ReactionsKeyboardView_typesTabs"
            android:background="?attr/uikit_colorGroupedBackground"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/uikit_dp16"
            android:paddingEnd="?attr/uikit_dp16"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/ReactionsKeyboardView_contentContainer"
        android:background="?attr/uikit_colorGroupedBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/ReactionsKeyboardView_tabsAndListContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.revolut.core.ui_kit.internal.views.reactionskeyboard.NoSwipeableViewPager
                android:layout_gravity="bottom"
                android:id="@+id/ReactionsKeyboardView_viewPager"
                android:background="?attr/uikit_colorGroupedBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
            <com.revolut.core.ui_kit.internal.views.reactionskeyboard.ReactionsKeyboardTabs
                android:id="@+id/ReactionsKeyboardView_categoriesTabs"
                android:background="?attr/uikit_colorGroupedBackground"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <com.revolut.core.ui_kit.internal.views.reactionskeyboard.ReactionsKeyboardSearchView
            android:id="@+id/ReactionsKeyboardView_searchView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.internal.views.reactionskeyboard.ReactionsKeyboardBottomBarView
        android:layout_gravity="bottom"
        android:id="@+id/ReactionsKeyboardView_bottomBar"
        android:background="?attr/uikit_colorGroupedBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
