<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/quickActionWidget_container"
        android:paddingBottom="@dimen/dp_16"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/quickActionWidget_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/quickActionWidget_badgeTop"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toStartOf="@+id/quickActionWidget_image"
            app:layout_constraintTop_toTopOf="@+id/quickActionWidget_image"
            app:srcCompat="@drawable/uikit_icn_24_copy"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/quickActionWidget_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/quickActionWidget_image"
            app:layout_constraintStart_toStartOf="@+id/quickActionWidget_image"/>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/quickActionWidget_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/quickActionWidget_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/quickActionWidget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="132dp"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/quickActionWidget_image"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/quickActionWidget_mainAction"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/quickActionWidget_rightAction"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/quickActionWidget_leftAction"
            app:layout_constraintTop_toBottomOf="@+id/quickActionWidget_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/quickActionWidget_leftAction"
            android:padding="4dp"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/quickActionWidget_mainAction"
            app:layout_constraintEnd_toStartOf="@+id/quickActionWidget_mainAction"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/quickActionWidget_mainAction"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/quickActionWidget_rightAction"
            android:padding="4dp"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/quickActionWidget_mainAction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/quickActionWidget_mainAction"
            app:layout_constraintTop_toTopOf="@+id/quickActionWidget_mainAction"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
