<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/progressStepHorizontalLoading_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/progressStepHorizontalLoading_guideline1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.33"/>
        <View
            android:id="@+id/progressStepHorizontalLoading_dot1"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toStartOf="@+id/progressStepHorizontalLoading_guideline1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/progressStepHorizontalLoading_line1"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/progressStepHorizontalLoading_dot1"
            app:layout_constraintEnd_toStartOf="@+id/progressStepHorizontalLoading_dot2"
            app:layout_constraintStart_toEndOf="@+id/progressStepHorizontalLoading_dot1"
            app:layout_constraintTop_toTopOf="@+id/progressStepHorizontalLoading_dot1"/>
        <TextView
            android:id="@+id/progressStepHorizontalLoading_title"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toStartOf="@+id/progressStepHorizontalLoading_guideline1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressStepHorizontalLoading_dot1"
            app:layout_constraintWidth_percent="0.18"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <TextView
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/progressStepHorizontalLoading_title"
            app:layout_constraintStart_toStartOf="@+id/progressStepHorizontalLoading_title"
            app:layout_constraintTop_toBottomOf="@+id/progressStepHorizontalLoading_title"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/progressStepHorizontalLoading_guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.66"/>
        <View
            android:id="@+id/progressStepHorizontalLoading_dot2"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toStartOf="@+id/progressStepHorizontalLoading_guideline2"
            app:layout_constraintStart_toStartOf="@+id/progressStepHorizontalLoading_guideline1"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/progressStepHorizontalLoading_line2"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/progressStepHorizontalLoading_dot2"
            app:layout_constraintEnd_toStartOf="@+id/progressStepHorizontalLoading_dot3"
            app:layout_constraintStart_toEndOf="@+id/progressStepHorizontalLoading_dot2"
            app:layout_constraintTop_toTopOf="@+id/progressStepHorizontalLoading_dot2"/>
        <TextView
            android:id="@+id/progressStepHorizontalLoading_title2"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toStartOf="@+id/progressStepHorizontalLoading_guideline2"
            app:layout_constraintStart_toStartOf="@+id/progressStepHorizontalLoading_guideline1"
            app:layout_constraintTop_toBottomOf="@+id/progressStepHorizontalLoading_dot2"
            app:layout_constraintWidth_percent="0.18"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <TextView
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="@+id/progressStepHorizontalLoading_title2"
            app:layout_constraintStart_toStartOf="@+id/progressStepHorizontalLoading_title2"
            app:layout_constraintTop_toBottomOf="@+id/progressStepHorizontalLoading_title2"
            style="?attr/internal_textAppearanceBody2"/>
        <View
            android:id="@+id/progressStepHorizontalLoading_dot3"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/progressStepHorizontalLoading_guideline2"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/progressStepHorizontalLoading_title3"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/progressStepHorizontalLoading_guideline2"
            app:layout_constraintTop_toBottomOf="@+id/progressStepHorizontalLoading_dot3"
            app:layout_constraintWidth_percent="0.18"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <TextView
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="@+id/progressStepHorizontalLoading_title3"
            app:layout_constraintStart_toStartOf="@+id/progressStepHorizontalLoading_title3"
            app:layout_constraintTop_toBottomOf="@+id/progressStepHorizontalLoading_title3"
            style="?attr/internal_textAppearanceBody2"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
