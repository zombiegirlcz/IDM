<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_optimizationLevel="barrier">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/backgroundImageGradientOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundImage"
        app:layout_constraintEnd_toEndOf="@+id/backgroundImage"
        app:layout_constraintStart_toStartOf="@+id/backgroundImage"
        app:layout_constraintTop_toTopOf="@+id/backgroundImage"/>
    <com.revolut.core.ui_kit.views.BadgeStatusView
        android:id="@+id/smallCard_topLeftBadge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/smallCard_topLeftTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/smallCard_topRightIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/topRightText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/internal_card_16dp_padding_size"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceHeading1"/>
    <com.revolut.core.ui_kit.internal.views.CircleProgressBar
        android:id="@+id/imageProgress"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/image"
        app:layout_constraintStart_toStartOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/internal_card_16dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_card_16dp_padding_size"
        android:layout_marginBottom="4dp"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toTopOf="@+id/barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="descriptionIcon, action, smallCard_descriptionContainer"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/descriptionIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/smallCard_descriptionContainer"
        app:layout_constraintEnd_toStartOf="@+id/smallCard_descriptionContainer"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/smallCard_descriptionContainer"/>
    <FrameLayout
        android:id="@+id/smallCard_descriptionContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_8dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toTopOf="@+id/horizontalProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/descriptionIcon"
        app:layout_goneMarginBottom="@dimen/internal_card_16dp_padding_size">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:ellipsize="end"
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <com.revolut.core.ui_kit.internal.views.timer.CountDownTextView
            android:id="@+id/smallCard_countDown"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.internal.views.stories.StoriesHorizontalStepsProgressView
        android:id="@+id/horizontalProgress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginBottom="@dimen/internal_card_16dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/action"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="@dimen/internal_card_16dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/foregroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundImage"
        app:layout_constraintEnd_toEndOf="@+id/backgroundImage"
        app:layout_constraintStart_toStartOf="@+id/backgroundImage"
        app:layout_constraintTop_toTopOf="@+id/backgroundImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
