<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/listingCardSmallLoading_shimmerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmallLoading_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/listingCardSmallLoading_bottomText"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="90dp"
                android:layout_height="16dp"
                android:layout_marginBottom="?attr/uikit_dp24"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/listingCardSmallLoading_ratingTag"
                android:background="@drawable/internal_rectangle_foreground_tag"
                android:layout_width="64dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp24"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/listingCardSmallLoading_bottomText"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/listingCardSmallLoading_cashbackTag"
                android:background="@drawable/internal_rectangle_foreground_tag"
                android:layout_width="64dp"
                android:layout_height="?attr/uikit_dp24"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp8"
                app:layout_constraintBottom_toBottomOf="@+id/listingCardSmallLoading_ratingTag"
                app:layout_constraintStart_toEndOf="@+id/listingCardSmallLoading_ratingTag"
                app:layout_constraintTop_toTopOf="@+id/listingCardSmallLoading_ratingTag"/>
            <View
                android:id="@+id/listingCardSmallLoading_title"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="172dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginTop="?attr/uikit_dp24"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardSmallLoading_image"
        android:layout_width="96dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,96:164"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
