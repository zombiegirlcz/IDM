<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.kompot.view.ControllerContainerFrameLayout
        android:id="@+id/alipayPlusQrScanner_cameraContainer"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="false"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/alipayPlusQrScanner_frameTopGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.27"/>
    <com.revolut.core.ui_kit.views.ScanView
        android:id="@+id/alipayPlusQrScanner_scanView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/alipayPlusQrScanner_frameTopGuideline"/>
    <com.revolut.core.ui_kit.views.TextSwitcherView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/alipayPlusQrScanner_prompt"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="2"
        android:minLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alipayPlusQrScanner_scanView"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/alipayPlusQrScanner_avatars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alipayPlusQrScanner_prompt"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
