<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/cellDetailsText_rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.LabelView
        android:textAppearance="?attr/internal_textAppearanceEmphasis2"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="start|center_vertical"
        android:id="@+id/cellDetailsText_titleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsText_warningBadge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.badge.WarningBadgeView
        android:layout_gravity="center_vertical"
        android:id="@+id/cellDetailsText_warningBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/cellDetailsText_titleLabel"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsText_contentDivider"
        app:layout_constraintStart_toEndOf="@+id/cellDetailsText_titleLabel"
        app:layout_constraintTop_toTopOf="@+id/cellDetailsText_titleLabel"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/cellDetailsText_contentDivider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.revolut.core.ui_kit.internal.views.LabelView
        android:textAppearance="?attr/internal_textAppearanceBody2"
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="end|center_vertical"
        android:id="@+id/cellDetailsText_endLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="viewEnd"
        android:paddingStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/cellDetailsText_endSecondaryLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/cellDetailsText_contentDivider"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/cellDetailsText_endSecondaryLabel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/cellDetailsText_contentDivider"
        app:layout_constraintTop_toBottomOf="@+id/cellDetailsText_endLabel"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
