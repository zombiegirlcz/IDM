<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.uicomponent.toolbar.app_bar.RevolutAppBarLayout
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        android:background="?attr/uikit_colorTransparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.uicomponent.toolbar.app_bar.CustomViewRevolutToolbar
            android:layout_gravity="top"
            android:id="@+id/toolbar_progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            app:navigationIcon="@drawable/uikit_icn_24_back_button_arrow"
            app:rtb_adjust_custom_view_margins="true"
            app:rtb_custom_view_layout="@layout/toolbar_progress_view_wrapper"
            app:rtb_menu_layout="@menu/create_plan_menu"/>
    </com.revolut.uicomponent.toolbar.app_bar.RevolutAppBarLayout>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:background="?attr/uikit_colorBackground"
        android:paddingBottom="100dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/loadingProgress"
        android:background="?attr/uikit_colorTransparent"
        android:visibility="invisible"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/uikit_colorAccent"
        android:indeterminateTintMode="src_in"
        app:layout_anchorGravity="center"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:background="@drawable/background_action_button_white_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/next_button_above_note_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            style="@style/BottomNoteText"/>
        <com.revolut.core_ui_custom_font.TypefaceButton
            android:id="@+id/next_button"
            android:visibility="visible"
            style="@style/Style.Button.Default"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:gravity="center"
            android:id="@+id/bottom_note_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="-10dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            style="@style/BottomNoteText"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
