<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikit_colorBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="?attr/uikit_colorGreyTone20"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.48"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:textColor="?attr/uikit_colorPink"
        android:gravity="center"
        android:id="@+id/item_text"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:ttv_typeface="regular"/>
</LinearLayout>
