<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navBarWithContainerHeader_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="false">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/navBarWithContainerHeader_bottomGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/internal_nav_bar_with_container_toolbar_height"/>
        <com.revolut.core.ui_kit.views.AvatarView
            android:id="@+id/navBarWithContainerHeader_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/navBarWithContainerHeader_bottomGuideline"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navBarWithContainerHeader_avatarBadgeDot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/navBarWithContainerHeader_avatar"
            app:layout_constraintEnd_toEndOf="@+id/navBarWithContainerHeader_avatar"
            app:layout_constraintStart_toEndOf="@+id/navBarWithContainerHeader_avatar"
            app:layout_constraintTop_toTopOf="@+id/navBarWithContainerHeader_avatar"
            app:srcCompat="@drawable/internal_icn_16_new_item"/>
        <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
            android:id="@+id/navBarWithContainerHeader_navigationButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/navBarWithContainerHeader_bottomGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.views.buttons.SearchButton
            android:id="@+id/navBarWithContainerHeader_searchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/navBarWithContainerHeader_bottomGuideline"
            app:layout_constraintEnd_toStartOf="@+id/navBarWithContainerHeader_menuRecycler"
            app:layout_constraintStart_toEndOf="@+id/navBarWithContainerHeader_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="16dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/navBarWithContainerHeader_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/navBarWithContainerHeader_bottomGuideline"
            app:layout_constraintEnd_toStartOf="@+id/navBarWithContainerHeader_menuRecycler"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/navBarWithContainerHeader_navigationButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="?attr/uikit_dp16"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/navBarWithContainerHeader_titleChained"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/navBarWithContainerHeader_subtitleChained"
            app:layout_constraintEnd_toStartOf="@+id/navBarWithContainerHeader_menuRecycler"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/navBarWithContainerHeader_navigationButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="?attr/internal_textAppearanceBody1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/navBarWithContainerHeader_subtitleChained"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/navBarWithContainerHeader_bottomGuideline"
            app:layout_constraintEnd_toStartOf="@+id/navBarWithContainerHeader_menuRecycler"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/navBarWithContainerHeader_navigationButton"
            app:layout_constraintTop_toBottomOf="@+id/navBarWithContainerHeader_titleChained"
            app:layout_constraintVertical_chainStyle="packed"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/navBarWithContainerHeader_menuRecycler"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/navBarWithContainerHeader_bottomGuideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.framelayout.UIKitFrameLayout
            android:id="@+id/navBarWithContainerHeader_headerDisclaimerWrapper"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarWithContainerHeader_bottomGuideline">
            <com.revolut.core.ui_kit.internal.views.navbar.HeaderDisclaimerTextView
                android:theme="@style/UiKitThemeOverlay.FcaDisclaimer"
                android:id="@+id/navBarWithContainerHeader_headerDisclaimer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="4dp"/>
        </com.revolut.core.ui_kit.internal.views.framelayout.UIKitFrameLayout>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/navBarWithContainerHeader_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/navBarWithContainerHeader_bottomGuideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
