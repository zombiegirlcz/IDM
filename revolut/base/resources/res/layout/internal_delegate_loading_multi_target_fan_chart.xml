<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loadingMultiTargetFanChart_shimmeringView"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="120dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"/>
            <View
                android:layout_gravity="end"
                android:background="@drawable/internal_circle_gradient_grey"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="140dp">
            <View
                android:background="@drawable/internal_circle_gradient_grey"
                android:layout_width="27dp"
                android:layout_height="27dp"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/internal_dashed_line_grey"
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="67dp"/>
        </FrameLayout>
        <View
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="60dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"/>
        <View
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"/>
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="200dp"
            android:layout_height="16dp"
            android:layout_marginTop="32dp"/>
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="80dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
