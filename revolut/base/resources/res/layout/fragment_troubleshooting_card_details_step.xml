<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:fitNavigationBar="true">
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/recyclerView"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <com.revolut.core_ui_custom_font.TypefaceButton
        android:layout_gravity="bottom"
        android:id="@+id/actionButton"
        android:text="@string/common.alert.got_it"
        style="@style/Style.Button.Blue.NoBorders"/>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout>
