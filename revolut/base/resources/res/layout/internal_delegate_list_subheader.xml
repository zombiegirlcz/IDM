<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.ListSubheaderContainerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listSubheader_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerLinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/listSubheader_startContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/endLabel"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/listSubheader_mainImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:layout_gravity="center_vertical"
            android:id="@+id/listSubheader_startLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/listSubheader_startImage"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:tint="?attr/uikit_colorGreyTone50"
            android:layout_marginStart="8dp"
            android:tintMode="src_in"/>
    </com.facebook.shimmer.ShimmerLinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorAccent"
        android:gravity="end"
        android:id="@+id/endLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="250dp"
        style="?attr/internal_textAppearanceEmphasis2"/>
</com.revolut.core.ui_kit.internal.views.ListSubheaderContainerView>
