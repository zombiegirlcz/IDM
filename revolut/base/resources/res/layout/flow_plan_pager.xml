<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/planPagerFlow_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.background.AnimatedBackgroundView
        android:id="@+id/planPagerFlow_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/planPagerFlow_navBarWithToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.Tabs
            android:id="@+id/planPagerFlow_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp8"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/planPagerFlow_pager"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/planPagerFlow_footerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fitNavigationBar="true">
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/planPagerFlow_topButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/planPagerFlow_bottomButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="?attr/uikit_dp16"
            app:uikit_LargeActionButtonStyle="SemiAccentButton"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/planPagerFlow_bottomButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/planPagerFlow_footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="?attr/uikit_dp16"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
        <View
            android:id="@+id/planPagerFlow_footerBackground"
            android:background="@drawable/uikit_bottom_container_gradient"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/planPagerFlow_footer"/>
        <com.revolut.core.ui_kit.views.FooterTextView
            android:id="@+id/planPagerFlow_footer"
            android:padding="?attr/uikit_dp16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
