<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/logo_block"
        android:layout_width="43dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="13dp"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/logo_icon"
            android:layout_width="@dimen/list_regular_icon_size"
            android:layout_height="@dimen/list_regular_icon_size"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/icon_organization"/>
        <ImageView
            android:id="@+id/logo_icon_small"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitXY"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_text_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_toEndOf="@+id/logo_block">
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ListItemTitle_Light"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/item_subtitle1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"
            style="@style/ListItemSubtitle_Light"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:gravity="start|center_vertical"
            android:id="@+id/item_subtitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ListItemSubtitle_Light"/>
    </LinearLayout>
</merge>
