<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardLoading_backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:layout_constraintDimensionRatio="H,343:202"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/listingCardLoading_imageShimmeringView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/listingCardLoading_backgroundImage"
        app:layout_constraintEnd_toEndOf="@+id/listingCardLoading_backgroundImage"
        app:layout_constraintStart_toStartOf="@+id/listingCardLoading_backgroundImage"
        app:layout_constraintTop_toTopOf="@+id/listingCardLoading_backgroundImage">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/listingCardLoading_tag1"
                android:background="@drawable/internal_rectangle_tag"
                android:layout_width="64dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/listingCardLoading_tag2"
                android:background="@drawable/internal_rectangle_tag"
                android:layout_width="64dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/listingCardLoading_tag1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/listingCardLoading_bottomShimmeringView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardLoading_imageShimmeringView">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/listingCardLoading_title"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="228dp"
                android:layout_height="24dp"
                android:layout_marginTop="?attr/uikit_dp24"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/listingCardLoading_subtitle"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="132dp"
                android:layout_height="16dp"
                android:layout_marginTop="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/listingCardLoading_title"/>
            <View
                android:id="@+id/listingCardLoading_price"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="56dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="60dp"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/listingCardLoading_subtitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
