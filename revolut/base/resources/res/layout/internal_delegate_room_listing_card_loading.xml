<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/travelRoomListingCardLoading_headerImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:layout_constraintDimensionRatio="H,285:100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/travelRoomListingCardLoading_shimmeringView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelRoomListingCardLoading_headerImage">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/travelRoomListingCardLoading_title"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="228dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginTop="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_price"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp48"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/travelRoomListingCardLoading_title"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_priceDetails"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/travelRoomListingCardLoading_price"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_cashback"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp32"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/travelRoomListingCardLoading_price"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_cashbackDetails"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/travelRoomListingCardLoading_cashback"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_detailsInfo"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="132dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/travelRoomListingCardLoading_cashback"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_details"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="60dp"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/travelRoomListingCardLoading_detailsInfo"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_detailsAction"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/travelRoomListingCardLoading_details"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_detailsSubtitle"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="132dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/travelRoomListingCardLoading_details"/>
            <View
                android:id="@+id/travelRoomListingCardLoading_button"
                android:background="@drawable/internal_rectangle_gradient_light_accent"
                android:layout_width="100dp"
                android:layout_height="?attr/uikit_dp32"
                android:layout_marginTop="?attr/uikit_dp48"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/travelRoomListingCardLoading_detailsSubtitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
