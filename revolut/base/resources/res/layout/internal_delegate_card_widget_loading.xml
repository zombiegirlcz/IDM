<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/cardWidgetLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/cardWidgetLoading_cardImage"
                android:layout_width="111dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/cardWidgetLoading_title"
                app:layout_constraintDimensionRatio="1.538:1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:srcCompat="@drawable/internal_card_gradient_grey"/>
            <View
                android:id="@+id/cardWidgetLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="80dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardWidgetLoading_cardImage"/>
            <View
                android:id="@+id/cardWidgetLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="56dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardWidgetLoading_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
