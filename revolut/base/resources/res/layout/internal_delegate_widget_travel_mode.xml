<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.internal.views.UiKitMediaView
            android:id="@+id/travelModeWidget_backgroundMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground"/>
        <View
            android:id="@+id/travelModeWidget_topOverlay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/travelModeWidget_productsContainer"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/travelModeWidget_bottomOverlay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="@color/internal_white_70"
            android:ellipsize="end"
            android:id="@+id/travelModeWidget_topLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/travelModeWidget_disable"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceHeading2"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorWhite"
            android:ellipsize="end"
            android:id="@+id/travelModeWidget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Japan"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="24dp"
            app:layout_constraintEnd_toEndOf="@+id/travelModeWidget_topLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/travelModeWidget_topLabel"
            style="?attr/internal_textAppearanceHeading2"/>
        <com.revolut.core.ui_kit.internal.views.SuggestionView
            android:id="@+id/travelModeWidget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/travelModeWidget_topLabel"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/travelModeWidget_title"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/travelModeWidget_disable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:backgroundTint="?attr/uikit_colorTransparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/uikit_icn_16_cross"
            app:tint="@color/internal_white_70"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/travelModeWidget_productsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
