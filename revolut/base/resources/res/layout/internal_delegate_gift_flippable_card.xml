<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/giftFlippableCard_backCoverView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.box.ShadowLayout
            android:id="@+id/giftFlippableCard_backCoverViewShadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/internal_gift_flippable_card_vertical_margin"
            android:layout_marginBottom="@dimen/internal_gift_flippable_card_vertical_margin"
            android:layout_marginStart="@dimen/internal_gift_flippable_card_min_horizontal_margin"
            android:layout_marginEnd="@dimen/internal_gift_flippable_card_min_horizontal_margin">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/giftFlippableCard_backCoverImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/giftFlippableCard_backCoverBackgroundView"
                    android:padding="?attr/uikit_dp24"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/giftFlippableCard_senderAvatar"
                        android:layout_width="?attr/uikit_dp24"
                        android:layout_height="?attr/uikit_dp24"
                        android:contentDescription="@null"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="?attr/uikit_colorBackground"
                        android:ellipsize="end"
                        android:id="@+id/giftFlippableCard_senderNameText"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:maxLines="1"
                        android:layout_marginStart="?attr/uikit_dp8"
                        app:layout_constraintBottom_toBottomOf="@+id/giftFlippableCard_senderAvatar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/giftFlippableCard_senderAvatar"
                        app:layout_constraintTop_toTopOf="@+id/giftFlippableCard_senderAvatar"
                        style="?attr/internal_textAppearanceEmphasis1"/>
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/giftFlippableCard_senderBarrier"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="giftFlippableCard_senderAvatar,giftFlippableCard_senderNameText"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="?attr/uikit_colorBackground"
                        android:ellipsize="end"
                        android:id="@+id/giftFlippableCard_senderMessageText"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="?attr/uikit_dp24"
                        app:autoSizeMaxTextSize="@dimen/internal_H1_text_size"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintBottom_toTopOf="@+id/giftFlippableCard_brandIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/giftFlippableCard_senderBarrier"
                        style="?attr/internal_textAppearanceHeading1"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/giftFlippableCard_brandIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="?attr/uikit_dp32"
                        app:layout_constraintBottom_toTopOf="@+id/giftFlippableCard_giftTitleText"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/giftFlippableCard_senderMessageText"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="?attr/uikit_colorBackground_50"
                        android:gravity="start"
                        android:id="@+id/giftFlippableCard_giftTitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/uikit_dp8"
                        android:layout_marginEnd="?attr/uikit_dp8"
                        app:layout_constraintBottom_toTopOf="@+id/giftFlippableCard_moneyText"
                        app:layout_constraintEnd_toStartOf="@+id/giftFlippableCard_backCoverButton"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/giftFlippableCard_brandIcon"
                        app:layout_goneMarginTop="?attr/uikit_dp32"
                        style="?attr/internal_textAppearanceEmphasis1"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="?attr/uikit_colorBackground"
                        android:id="@+id/giftFlippableCard_moneyText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/uikit_dp4"
                        android:maxLines="1"
                        android:layout_marginEnd="?attr/uikit_dp8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/giftFlippableCard_backCoverButton"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/giftFlippableCard_giftTitleText"
                        style="?attr/internal_textAppearanceHeading1"/>
                    <com.revolut.core.ui_kit.internal.views.SmallActionButton
                        android:id="@+id/giftFlippableCard_backCoverButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </com.revolut.core.ui_kit.internal.views.box.ShadowLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/giftFlippableCard_frontCoverView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.box.ShadowLayout
            android:id="@+id/giftFlippableCard_frontCoverViewShadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/internal_gift_flippable_card_vertical_margin"
            android:layout_marginBottom="@dimen/internal_gift_flippable_card_vertical_margin"
            android:layout_marginStart="@dimen/internal_gift_flippable_card_min_horizontal_margin"
            android:layout_marginEnd="@dimen/internal_gift_flippable_card_min_horizontal_margin">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.revolut.core.ui_kit.internal.views.videoplayer.UiKitPlayerView
                    android:id="@+id/giftFlippableCard_playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.revolut.core.ui_kit.internal.views.SmallActionButton
                    android:layout_gravity="end|bottom"
                    android:id="@+id/giftFlippableCard_frontCoverButton"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginBottom="?attr/uikit_dp24"
                    android:layout_marginEnd="?attr/uikit_dp24"/>
            </FrameLayout>
        </com.revolut.core.ui_kit.internal.views.box.ShadowLayout>
    </FrameLayout>
</FrameLayout>
