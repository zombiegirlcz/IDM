<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="?attr/uikit_dp4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/tooltip_min_width">
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tooltipRow_name"
        android:layout_width="?attr/uikit_dp0"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        style="?attr/internal_textAppearanceBody3"/>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="end|center_vertical"
        android:id="@+id/tooltipRow_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/uikit_dp4"
        style="?attr/internal_textAppearanceBody3"/>
</LinearLayout>
