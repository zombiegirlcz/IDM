<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_colorWidgetBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/featuredCard_avatarGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/featuredCard_topLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/featuredCard_avatarGroup"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/featuredCard_topTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/featuredCard_topLabel"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/featuredCard_bottomLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/featuredCard_topTitle"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/featuredCard_bottomTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/featuredCard_bottomLabel"
        style="?attr/internal_textAppearanceHeading1"/>
    <com.revolut.core.ui_kit.internal.views.trend.TrendPreviewView
        android:id="@+id/featuredCard_chart"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/featuredCard_bottomTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
