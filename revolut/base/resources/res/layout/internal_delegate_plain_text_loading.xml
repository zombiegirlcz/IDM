<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/plainTextLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/internal_dp16"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/plainTextLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="160dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="48dp"/>
            <View
                android:id="@+id/plainTextLoading_description"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="90dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/internal_dp16"/>
            <View
                android:id="@+id/plainTextLoading_image"
                android:background="@drawable/internal_purple_grey_gradient_background_rounded"
                android:layout_width="match_parent"
                android:layout_height="233dp"
                android:layout_marginTop="@dimen/internal_dp16"/>
            <View
                android:id="@+id/plainTextLoading_action"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="90dp"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/internal_dp16"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
