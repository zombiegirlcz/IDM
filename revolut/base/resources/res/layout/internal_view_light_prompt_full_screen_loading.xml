<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/lightPromptLoading_shimmerBackground"
        android:background="?attr/uikit_colorShimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_base_alpha="0"/>
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/lightPromptLoading_headerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        app:layout_constraintDimensionRatio="375:392"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/lightPromptLoading_description1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/lightPromptLoading_description2"
            app:layout_constraintWidth_percent="0.597"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/lightPromptLoading_description2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.277"
            style="?attr/internal_textAppearanceEmphasis1"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/lightPromptLoading_navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/lightPromptLoading_closeButton"
        android:background="@drawable/internal_oval_ripple"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/uikit.navigate_up.description"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_24_cross"/>
    <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
        android:id="@+id/lightPromptLoading_rowsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lightPromptLoading_headerContainer"/>
</merge>
