<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.RadialGaugeView
        android:id="@+id/radialGaugeChart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/radialGaugeChart_label"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radialGaugeChart_topLabel"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/radialGaugeChart_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/radialGaugeChart_description"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radialGaugeChart"
        style="?attr/internal_textAppearanceHeading3"/>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/radialGaugeChart_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radialGaugeChart_label"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/radialGaugeChart_symmetryAxis"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/radialGaugeChart_leftLabel"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="76dp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/radialGaugeChart"
        app:layout_constraintRight_toLeftOf="@+id/radialGaugeChart_symmetryAxis"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="right"
        android:id="@+id/radialGaugeChart_leftTopLabel"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="56dp"
        android:maxLines="1"
        app:layout_constraintRight_toLeftOf="@+id/radialGaugeChart_symmetryAxis"
        app:layout_constraintTop_toTopOf="@+id/radialGaugeChart"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/radialGaugeChart_topLabel"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/radialGaugeChart_rightTopLabel"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="56dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/radialGaugeChart_symmetryAxis"
        app:layout_constraintTop_toTopOf="@+id/radialGaugeChart"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/radialGaugeChart_rightLabel"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="76dp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/radialGaugeChart"
        app:layout_constraintLeft_toRightOf="@+id/radialGaugeChart_symmetryAxis"
        style="?attr/internal_textAppearanceEmphasis3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
