<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.OnMeasureCallbackConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/marketingPromptLoading_closeImageView"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_24_cross"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/marketingPromptLoading_topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/marketingPromptLoading_shimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/marketingPromptLoading_topGuideline">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/marketingPromptLoading_circleAsset"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_marginTop="84dp"
                app:layout_constraintBottom_toTopOf="@+id/marketingPromptLoading_circleAssetTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"
                app:srcCompat="?attr/uikit_shimmerBackgroundCircle"/>
            <View
                android:id="@+id/marketingPromptLoading_circleAssetTitle"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="240dp"
                android:layout_height="30dp"
                android:layout_marginTop="32dp"
                app:layout_constraintBottom_toTopOf="@+id/marketingPromptLoading_circleAssetSubtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPromptLoading_circleAsset"/>
            <View
                android:id="@+id/marketingPromptLoading_circleAssetSubtitle"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="120dp"
                android:layout_height="30dp"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPromptLoading_circleAssetTitle"/>
            <View
                android:id="@+id/marketingPromptLoading_backgroundAssetTitle1"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="240dp"
                android:layout_height="30dp"
                android:layout_marginBottom="246dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/marketingPromptLoading_backgroundAssetTitle2"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="120dp"
                android:layout_height="30dp"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toTopOf="@+id/marketingPromptLoading_backgroundAssetSubtitle1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPromptLoading_backgroundAssetTitle1"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/marketingPromptLoading_backgroundAssetSubtitle1"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="316dp"
                android:layout_height="16dp"
                android:layout_marginTop="40dp"
                app:layout_constraintBottom_toTopOf="@+id/marketingPromptLoading_backgroundAssetSubtitle2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPromptLoading_backgroundAssetTitle2"
                app:layout_constraintVertical_bias="0"/>
            <View
                android:id="@+id/marketingPromptLoading_backgroundAssetSubtitle2"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="252dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/marketingPromptLoading_backgroundAssetSubtitle1"
                app:layout_constraintVertical_bias="0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.revolut.core.ui_kit.internal.views.OnMeasureCallbackConstraintLayout>
