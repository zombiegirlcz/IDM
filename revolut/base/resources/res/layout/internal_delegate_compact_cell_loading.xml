<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/internalDelegateCompactCellLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/internalDelegateCompactCellLoading_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/uikit_shimmerBackgroundCircle"/>
            <View
                android:id="@+id/internalDelegateCompactCellLoading_title"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginBottom="3dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toTopOf="@+id/internalDelegateCompactCellLoading_description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/internalDelegateCompactCellLoading_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:orientation="vertical"
                android:id="@+id/internalDelegateCompactCellLoading_titleCenterGuideline"
                android:visibility="invisible"
                android:layout_width="1dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/internalDelegateCompactCellLoading_title"/>
            <View
                android:id="@+id/internalDelegateCompactCellLoading_description"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/internalDelegateCompactCellLoading_titleCenterGuideline"
                app:layout_constraintStart_toStartOf="@+id/internalDelegateCompactCellLoading_title"
                app:layout_constraintTop_toBottomOf="@+id/internalDelegateCompactCellLoading_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
