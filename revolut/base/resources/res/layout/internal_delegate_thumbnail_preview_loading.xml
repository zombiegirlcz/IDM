<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/thumbnailPreviewLoading_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/thumbnailPreviewLoading_wallpaperContainer"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="112dp"
        android:layout_height="242dp"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toTopOf="@+id/thumbnailPreviewLoading_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/thumbnailPreviewLoading_label"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="60dp"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thumbnailPreviewLoading_wallpaperContainer"/>
</com.facebook.shimmer.ShimmerConstraintLayout>
