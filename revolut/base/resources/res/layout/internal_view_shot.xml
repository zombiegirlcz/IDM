<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shot_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <Space
        android:id="@+id/shot_spaceStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/shot_image"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/shot_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/shot_spaceEnd"
        app:layout_constraintStart_toEndOf="@+id/shot_spaceStart"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/shot_image"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:tint="?attr/uikit_colorForeground"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/shot_background"
        app:layout_constraintEnd_toStartOf="@+id/shot_message"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/shot_spaceStart"
        app:layout_constraintTop_toTopOf="@+id/shot_background"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/shot_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="@+id/shot_background"
        app:layout_constraintEnd_toStartOf="@+id/shot_delimiter"
        app:layout_constraintStart_toEndOf="@+id/shot_image"
        app:layout_constraintTop_toTopOf="@+id/shot_background"
        app:layout_constraintWidth_default="wrap"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/shot_animated_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/shot_image"
        app:layout_constraintEnd_toEndOf="@+id/shot_image"
        app:layout_constraintStart_toStartOf="@+id/shot_image"
        app:layout_constraintTop_toTopOf="@+id/shot_image"/>
    <View
        android:id="@+id/shot_delimiter"
        android:background="?attr/uikit_colorGreyTone20_50"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/shot_background"
        app:layout_constraintEnd_toStartOf="@+id/shot_action"
        app:layout_constraintStart_toEndOf="@+id/shot_message"
        app:layout_constraintTop_toTopOf="@+id/shot_background"/>
    <TextView
        android:textColor="?attr/uikit_colorAccent"
        android:ellipsize="end"
        android:id="@+id/shot_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="@+id/shot_background"
        app:layout_constraintEnd_toStartOf="@+id/shot_spaceEnd"
        app:layout_constraintStart_toEndOf="@+id/shot_delimiter"
        app:layout_constraintTop_toTopOf="@+id/shot_background"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_max="200dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <Space
        android:id="@+id/shot_spaceEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/shot_action"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
