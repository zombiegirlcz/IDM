<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.NestedScrollCoordinatorView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/driverDetails_navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/driverDetails_recyclerView"
            android:paddingBottom="@dimen/dp_160"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    </com.revolut.core.ui_kit.views.NestedScrollCoordinatorView>
    <com.revolut.core.ui_kit.views.buttons.TwinVerticalButton
        android:id="@+id/driverDetails_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
