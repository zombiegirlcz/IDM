<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/centeredFixedTabs_leftPadding"
        android:layout_width="10dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/centeredFixedTabs_tabText"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="none"
        android:id="@+id/centeredFixedTabs_tabText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/centeredFixedTabs_leftPadding"
        app:layout_constraintRight_toLeftOf="@+id/centeredFixedTabs_rightPadding"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <View
        android:id="@+id/centeredFixedTabs_rightPadding"
        android:layout_width="10dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toRightOf="@+id/centeredFixedTabs_tabText"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
