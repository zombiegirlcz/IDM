<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/challengeMediumImageCardLoading_boxBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/challengeMediumImageCardLoading_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="204dp">
        <com.revolut.core.ui_kit.internal.views.ShimmeringRectView
            android:id="@+id/challengeMediumImageCardLoading_title"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/challengeMediumImageCardLoading_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringRectView
            android:id="@+id/challengeMediumImageCardLoading_progress"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
