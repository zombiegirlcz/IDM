<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:orientation="vertical"
        android:id="@+id/comparisonLineChartLoadingWidget_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/comparisonLineChartLoadingWidget_topLabel"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="96dp"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/comparisonLineChartLoadingWidget_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="56dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/comparisonLineChartLoadingWidget_topLabel"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/internal_lottie_chart_loading"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
