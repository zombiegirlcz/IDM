<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.CutoutImageView
        android:id="@+id/actionWidget_imageStart"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/actionWidget_buttonsBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.revolut.core.ui_kit.internal.views.SimpleLimitProgressBarWithText
        android:id="@+id/actionWidget_simpleLimitWithText"
        android:visibility="visible"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/actionWidget_buttonsBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/actionWidget_mainItemBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="end"
        app:constraint_referenced_ids="actionWidget_imageStart, actionWidget_simpleLimitWithText"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/actionWidget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/actionWidget_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/actionWidget_valueBarrier"
        app:layout_constraintStart_toEndOf="@+id/actionWidget_mainItemBarrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/actionWidget_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/actionWidget_buttonsBarrier"
        app:layout_constraintEnd_toEndOf="@+id/actionWidget_title"
        app:layout_constraintStart_toStartOf="@+id/actionWidget_title"
        app:layout_constraintTop_toBottomOf="@+id/actionWidget_title"
        app:layout_goneMarginBottom="16dp"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="end"
        android:id="@+id/actionWidget_valuePrimary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="130dp"
        android:textAlignment="viewEnd"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/actionWidget_valueSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceBody1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="end"
        android:id="@+id/actionWidget_valueSecondary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:maxWidth="130dp"
        android:textAlignment="viewEnd"
        app:layout_constraintBottom_toTopOf="@+id/actionWidget_buttonsBarrier"
        app:layout_constraintEnd_toEndOf="@+id/actionWidget_valuePrimary"
        app:layout_constraintTop_toBottomOf="@+id/actionWidget_valuePrimary"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/actionWidget_valueBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="actionWidget_valuePrimary,actionWidget_valueSecondary"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/actionWidget_imageDismiss"
        android:paddingTop="?attr/uikit_dp12"
        android:paddingBottom="?attr/uikit_dp16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="?attr/uikit_dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_16_cross_small"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/actionWidget_buttonsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="actionWidget_buttonStart,actionWidget_buttonEnd"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/actionWidget_buttonStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/actionWidget_buttonEnd"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginEnd="16dp"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/actionWidget_buttonEnd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/actionWidget_buttonStart"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginStart="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
