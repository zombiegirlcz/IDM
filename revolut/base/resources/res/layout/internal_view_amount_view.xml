<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/posNumpadView_amount"
        android:layout_width="wrap_content"
        android:layout_height="?attr/uikit_dp64"
        android:layout_marginTop="?attr/uikit_dp8"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/posNumpadView_hintText"
        app:layout_constraintEnd_toStartOf="@+id/posNumpadView_chevron"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceDisplay2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorBlack"
        android:gravity="center"
        android:id="@+id/posNumpadView_amountInvisible"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="?attr/uikit_dp64"
        android:maxLines="1"
        android:layout_marginEnd="?attr/uikit_dp32"
        android:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@+id/posNumpadView_hintText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceDisplay2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/posNumpadView_chevron"
        android:layout_width="?attr/uikit_dp24"
        android:layout_height="?attr/uikit_dp24"
        android:layout_marginStart="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="@+id/posNumpadView_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/posNumpadView_amount"
        app:layout_constraintTop_toTopOf="@+id/posNumpadView_amount"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/posNumpadView_bottomContainer"
        android:paddingBottom="?attr/uikit_dp8"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/posNumpadView_amount">
        <TextView
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/posNumpadView_hintText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp8"
            style="?attr/internal_textAppearanceBody2"/>
        <TextView
            android:id="@+id/posNumpadView_secondaryHintText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp8"
            style="?attr/internal_textAppearanceBody2"/>
        <com.revolut.core.ui_kit.views.ActionsView
            android:id="@+id/posNumpadView_actions"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            android:layout_marginBottom="?attr/uikit_dp8"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</merge>
