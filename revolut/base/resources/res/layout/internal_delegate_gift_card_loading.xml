<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.framelayout.UIKitFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/giftCardLoading_frameLayout"
    android:background="@drawable/internal_big_tile_loading_delegate_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/internal_gift_flippable_card_vertical_margin"
    android:layout_marginBottom="@dimen/internal_gift_flippable_card_vertical_margin"
    android:layout_marginStart="@dimen/internal_gift_flippable_card_min_horizontal_margin"
    android:layout_marginEnd="@dimen/internal_gift_flippable_card_min_horizontal_margin">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/giftCardLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/giftCardLoading_title"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="56dp"
                android:layout_height="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/giftCardLoading_subtitle_1"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="219dp"
                android:layout_height="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/giftCardLoading_title"/>
            <View
                android:id="@+id/giftCardLoading_subtitle_2"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="142dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/giftCardLoading_subtitle_1"/>
            <View
                android:id="@+id/giftCardLoading_footer_1"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="142dp"
                android:layout_height="24dp"
                android:layout_marginTop="235dp"
                android:layout_marginStart="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/giftCardLoading_subtitle_2"/>
            <View
                android:id="@+id/giftCardLoading_footer_2"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="56dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/giftCardLoading_footer_1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.revolut.core.ui_kit.internal.views.framelayout.UIKitFrameLayout>
