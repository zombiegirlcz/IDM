<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithContainer
        android:id="@+id/revPointsDashboardScreen_navBarWithContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.navbar.AccountSelectionNavBarContentView
            android:id="@+id/revPointsDashboardScreen_accountSelectionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.core.ui_kit.views.FixedTabs
            android:id="@+id/revPointsDashboardScreen_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/uikit_dp16"
            android:paddingEnd="?attr/uikit_dp16"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithContainer>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/revPointsDashboardScreen_recyclerView"
        android:paddingBottom="@dimen/dp_80"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarOverlappingScrollingViewBehavior"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
