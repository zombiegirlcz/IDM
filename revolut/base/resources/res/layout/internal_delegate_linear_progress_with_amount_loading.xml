<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/linearProgressWithAmountLoading_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/internal_box_background_ripple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/linearProgressWithAmountLoading_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/internal_textAppearanceHeading1"/>
            <View
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="96dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/linearProgressWithAmountLoading_title"
                app:layout_constraintStart_toStartOf="@+id/linearProgressWithAmountLoading_title"
                app:layout_constraintTop_toTopOf="@+id/linearProgressWithAmountLoading_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/linearProgressWithAmountLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/internal_dp4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearProgressWithAmountLoading_title"
                style="?attr/internal_textAppearanceBody2"/>
            <View
                android:id="@+id/linearProgressWithAmountLoading_progressBar"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toTopOf="@+id/startBottomText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearProgressWithAmountLoading_subtitle"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/linearProgressWithAmountLoading_bottomText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lines="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearProgressWithAmountLoading_progressBar"
                style="?attr/internal_textAppearanceBody2"/>
            <View
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="160dp"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/linearProgressWithAmountLoading_bottomText"
                app:layout_constraintStart_toStartOf="@+id/linearProgressWithAmountLoading_bottomText"
                app:layout_constraintTop_toTopOf="@+id/linearProgressWithAmountLoading_bottomText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
