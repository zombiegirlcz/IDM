<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/smallStockCard_decorative_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceLargeDecorativeText"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/internal_card_16dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/smallStockCard_images"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_card_16dp_padding_size"
        android:layout_marginBottom="@dimen/internal_card_16dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/smallStockCard_topLeftBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="image, smallStockCard_images"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_card_16dp_padding_size"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/smallStockCard_titleBarrier"
        app:layout_constraintEnd_toStartOf="@+id/smallStockCard_titleInfoIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/smallStockCard_topLeftBarrier"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="@dimen/internal_card_16dp_padding_size"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/smallStockCard_titleInfoIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="@dimen/internal_dp16"
        android:layout_height="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp4"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toTopOf="@+id/valuePrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_goneMarginBottom="@dimen/internal_dp4"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/smallStockCard_titleBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="top"
        app:constraint_referenced_ids="subtitle, smallStockCard_description, smallStockCard_action, valuePrimary"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/smallStockCard_descriptionIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/smallStockCard_description"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/smallStockCard_description"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/smallStockCard_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/smallStockCard_descriptionIcon"
        app:layout_goneMarginStart="0dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/valuePrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toTopOf="@+id/valueSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="@dimen/internal_card_16dp_padding_size"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/valueSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_16dp_padding_size"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/smallStockCard_action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="@dimen/internal_card_8dp_padding_size"
        android:layout_marginBottom="@dimen/internal_card_16dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
</com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout>
