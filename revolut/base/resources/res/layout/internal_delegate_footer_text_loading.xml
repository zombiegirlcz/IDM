<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/footerTextLoading_content"
    android:padding="@dimen/internal_dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/footerTextLoading_image"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="@dimen/internal_dp72"
        android:layout_height="@dimen/internal_dp24"
        android:layout_marginBottom="@dimen/internal_dp8"/>
    <View
        android:id="@+id/footerTextLoading_description"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="200dp"
        android:layout_height="@dimen/internal_dp16"
        android:layout_marginBottom="@dimen/internal_dp8"/>
    <View
        android:id="@+id/footerTextLoading_description_short"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="80dp"
        android:layout_height="@dimen/internal_dp16"/>
</com.facebook.shimmer.ShimmerLinearLayout>
