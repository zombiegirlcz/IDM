<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/dialog_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MainText.Primary"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_s"
        android:ellipsize="end"
        android:id="@+id/dialog_item_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MainText.Clickable"/>
</androidx.constraintlayout.widget.ConstraintLayout>
