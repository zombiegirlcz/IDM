<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/headerWithBigTileLoading_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <View
            android:id="@+id/headerWithBigTileLoading_icon"
            android:background="?attr/uikit_shimmerBackgroundCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toTopOf="@+id/headerWithBigTileLoading_titleWithIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/headerWithBigTileLoading_titleWithIcon"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:layout_marginTop="40dp"
            app:layout_constraintBottom_toTopOf="@+id/headerWithBigTileLoading_descriptionWithIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerWithBigTileLoading_icon"/>
        <View
            android:id="@+id/headerWithBigTileLoading_descriptionWithIcon"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="96dp"
            android:layout_height="16dp"
            android:layout_marginTop="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerWithBigTileLoading_titleWithIcon"/>
        <View
            android:id="@+id/headerWithBigTileLoading_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="160dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toTopOf="@+id/headerWithBigTileLoading_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/headerWithBigTileLoading_description"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="120dp"
            android:layout_height="24dp"
            android:layout_marginTop="?attr/uikit_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerWithBigTileLoading_title"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/headerWithBigTileLoading_centeredGroup"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="headerWithBigTileLoading_title, headerWithBigTileLoading_description"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/headerWithBigTileLoading_centeredWithIconGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="headerWithBigTileLoading_icon, headerWithBigTileLoading_titleWithIcon, headerWithBigTileLoading_descriptionWithIcon"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</merge>
