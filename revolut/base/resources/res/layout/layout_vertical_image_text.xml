<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/delegate_new_badge"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="delegate_new_badge_top_space,delegate_new_badge_text"/>
    <Space
        android:id="@+id/delegate_new_badge_top_space"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_4"
        app:layout_constraintBottom_toTopOf="@+id/delegate_title"
        app:layout_constraintEnd_toEndOf="@+id/delegate_title"
        app:layout_constraintStart_toStartOf="@+id/delegate_title"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_xxs"
        android:textColor="?attr/uikit_colorPink"
        android:id="@+id/delegate_new_badge_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/badge.new.sign.title"
        android:layout_marginStart="@dimen/margin_xs"
        app:layout_constraintStart_toEndOf="@+id/delegate_title"
        app:layout_constraintTop_toTopOf="@+id/delegate_new_badge_top_space"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/delegate_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toTopOf="@+id/delegate_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="18dp"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:gravity="center"
        android:id="@+id/delegate_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/delegate_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delegate_icon"
        app:layout_constraintWidth_default="wrap"
        app:ttv_typeface="medium"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_s"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center"
        android:id="@+id/delegate_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delegate_title"/>
</merge>
