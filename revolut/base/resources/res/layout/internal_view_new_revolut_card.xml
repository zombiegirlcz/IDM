<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/internalNewRevolutCardView_frontView"
        android:layout_width="@dimen/internal_revolut_card_image_width"
        android:layout_height="@dimen/internal_revolut_card_image_height"
        android:layoutDirection="ltr">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/internalNewRevolutCardView_cardDetailsView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/internalNewRevolutCardView_cardFrontImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/internalNewRevolutCardView_cardCustomisationImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:id="@+id/internalNewRevolutCardView_cardLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/internalNewRevolutCardView_frontTagView"
                app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_cardFrontImage"
                app:layout_constraintTop_toTopOf="@+id/internalNewRevolutCardView_cardFrontImage"
                style="?attr/internal_textAppearanceEmphasis1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/internalNewRevolutCardView_cardTypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_cardFrontImage"
                app:layout_constraintTop_toBottomOf="@+id/internalNewRevolutCardView_cardLabel"
                style="?attr/internal_textAppearanceBody3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/internalNewRevolutCardView_lastFour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/internalNewRevolutCardView_cardFrontImage"
                app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_cardFrontImage"
                style="?attr/internal_textAppearanceEmphasis1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/internalNewRevolutCardView_cardHolderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/internalNewRevolutCardView_lastFour"
                app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_lastFour"
                style="?attr/internal_textAppearanceBody3"/>
            <com.revolut.core.ui_kit.internal.views.tag.TagView
                android:id="@+id/internalNewRevolutCardView_frontTagView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/internalNewRevolutCardView_frontSecondaryTagView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="16dp"/>
            <com.revolut.core.ui_kit.internal.views.tag.TagView
                android:id="@+id/internalNewRevolutCardView_frontSecondaryTagView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/internalNewRevolutCardView_cardOverlayContainer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/internalNewRevolutCardView_cardFreezeView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/internalNewRevolutCardView_cardOverlayIcon"
                android:clickable="false"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="center"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/internalNewRevolutCardView_backView"
        android:visibility="gone"
        android:layout_width="@dimen/internal_revolut_card_image_width"
        android:layout_height="@dimen/internal_revolut_card_image_height"
        android:layoutDirection="ltr">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/internalNewRevolutCardView_cardBackImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/internalNewRevolutCardView_expiryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/internalNewRevolutCardView_cardBackImage"
            app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_cardBackImage"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/internalNewRevolutCardView_expiryDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expiry date"
            app:layout_constraintBottom_toTopOf="@+id/internalNewRevolutCardView_expiryDate"
            app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_expiryDate"
            style="?attr/internal_textAppearanceBody3"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/internalNewRevolutCardView_cvvLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CVV"
            android:layout_marginStart="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/internalNewRevolutCardView_expiryDateLabel"
            app:layout_constraintStart_toEndOf="@+id/internalNewRevolutCardView_expiryDateLabel"
            style="?attr/internal_textAppearanceBody3"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/internalNewRevolutCardView_cvv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_cvvLabel"
            app:layout_constraintTop_toBottomOf="@+id/internalNewRevolutCardView_cvvLabel"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/internalNewRevolutCardView_copyCvvIcon"
            android:padding="@dimen/internal_dp8"
            android:layout_width="@dimen/internal_dp32"
            android:layout_height="@dimen/internal_dp32"
            android:layout_marginStart="22dp"
            app:layout_constraintBottom_toBottomOf="@+id/internalNewRevolutCardView_cvv"
            app:layout_constraintStart_toEndOf="@+id/internalNewRevolutCardView_cvv"
            app:layout_constraintTop_toTopOf="@+id/internalNewRevolutCardView_cvv"
            app:srcCompat="@drawable/uikit_icn_24_copy"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/internalNewRevolutCardView_cardNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/internalNewRevolutCardView_expiryDateLabel"
            app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_expiryDateLabel"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/internalNewRevolutCardView_cardNumberLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Card number"
            app:layout_constraintBottom_toTopOf="@+id/internalNewRevolutCardView_cardNumber"
            app:layout_constraintStart_toStartOf="@+id/internalNewRevolutCardView_cardNumber"
            style="?attr/internal_textAppearanceBody3"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/internalNewRevolutCardView_copyCardNumberIcon"
            android:padding="@dimen/internal_dp8"
            android:layout_width="@dimen/internal_dp32"
            android:layout_height="@dimen/internal_dp32"
            android:layout_marginStart="22dp"
            app:layout_constraintBottom_toBottomOf="@+id/internalNewRevolutCardView_cardNumber"
            app:layout_constraintStart_toEndOf="@+id/internalNewRevolutCardView_cardNumber"
            app:layout_constraintTop_toTopOf="@+id/internalNewRevolutCardView_cardNumber"
            app:srcCompat="@drawable/uikit_icn_24_copy"/>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/internalNewRevolutCardView_backTagView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/internalNewRevolutCardView_backSecondaryTagView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="16dp"/>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/internalNewRevolutCardView_backSecondaryTagView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_gravity="center"
        android:id="@+id/internalNewRevolutCardView_shimmerLayout"
        android:visibility="gone"
        android:layout_width="@dimen/internal_revolut_card_image_width"
        android:layout_height="@dimen/internal_revolut_card_image_height">
        <View
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</merge>
