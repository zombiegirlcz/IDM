<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.CutoutImageView
        android:id="@+id/icon_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
        android:id="@+id/icon_badgeTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon_image"
        app:layout_constraintStart_toStartOf="@+id/icon_image"
        app:uikit_circle_badge_size="medium"/>
    <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
        android:id="@+id/icon_badgeBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:layout_marginStart="44dp"
        app:layout_constraintStart_toStartOf="@+id/icon_image"
        app:layout_constraintTop_toTopOf="@+id/icon_image"
        app:uikit_circle_badge_size="small"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/icon_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_image"
        style="?attr/internal_textAppearanceEmphasis3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
