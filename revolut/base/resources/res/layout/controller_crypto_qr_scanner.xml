<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <io.fotoapparat.view.CameraView
        android:id="@+id/cryptoQrScanner_cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.ScanView
        android:id="@+id/cryptoQrScanner_scanView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="156dp"
        android:layout_marginStart="58dp"
        android:layout_marginEnd="58dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/cryptoQrScanner_messageLabelContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:animateLayoutChanges="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cryptoQrScanner_scanView">
        <TextView
            android:textColor="?attr/uikit_colorBackground"
            android:layout_gravity="center"
            android:id="@+id/cryptoQrScanner_messageLabel"
            android:background="@drawable/message_background"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/uikit_dp24"
            android:paddingEnd="?attr/uikit_dp24"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:layout_gravity="top"
        android:id="@+id/cryptoQrScanner_navBarWithToolbar"
        android:background="@color/colorTransparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:expanded="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
