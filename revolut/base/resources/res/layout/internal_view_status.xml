<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/status_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ProgressBar
        android:id="@+id/status_progressView"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:max="100"
        android:progressDrawable="@drawable/internal_status_progress_background"
        android:screenReaderFocusable="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/status_imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:id="@+id/status_indefiniteProgress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateDrawable="@null"/>
    <FrameLayout
        android:id="@+id/status_finiteProgressContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.CircleProgressBar
            android:layout_gravity="center"
            android:id="@+id/status_progressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:internal_backgroundColor="?attr/uikit_colorGreyTone10"
            app:internal_endColor="?attr/uikit_colorAccent"
            app:internal_startColor="?attr/uikit_colorAccent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorAccent"
            android:layout_gravity="center"
            android:id="@+id/status_percentage"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceHeading3"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/status_titleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/status_titleImageView"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="8dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/status_titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="4"
            style="?attr/internal_textAppearanceHeading3"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorAccent"
        android:gravity="center_horizontal"
        android:id="@+id/status_finiteProgress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/internal_textAppearanceHeading3"/>
    <ProgressBar
        android:id="@+id/status_descriptionProgressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/internal_vaults_progress"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:screenReaderFocusable="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/status_descriptionTextView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/status_primaryActionButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/status_secondaryActionButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:uikit_LargeActionButtonStyle="SemiAccentButton"/>
</LinearLayout>
