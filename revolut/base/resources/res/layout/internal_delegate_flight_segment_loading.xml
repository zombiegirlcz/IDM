<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flightDetailsLoading_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/flightDetailsLoading_title"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginEnd="54dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/flightDetailsLoading_dotsView"
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_8"
                android:paddingVertical="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/flightDetailsLoading_placeArrival"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/flightDetailsLoading_timeDeparture"/>
            <View
                android:id="@+id/flightDetailsLoading_timeDeparture"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="54dp"
                android:layout_height="22dp"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toEndOf="@+id/flightDetailsLoading_dotsView"
                app:layout_constraintTop_toBottomOf="@+id/flightDetailsLoading_title"/>
            <View
                android:id="@+id/flightDetailsLoading_placeDeparture"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="162dp"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="@dimen/internal_dp4"
                app:layout_constraintStart_toStartOf="@+id/flightDetailsLoading_timeDeparture"
                app:layout_constraintTop_toBottomOf="@+id/flightDetailsLoading_timeDeparture"/>
            <View
                android:id="@+id/flightDetailsLoading_duration"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="39dp"
                android:layout_height="@dimen/internal_dp18"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="@+id/flightDetailsLoading_timeDeparture"
                app:layout_constraintTop_toBottomOf="@+id/flightDetailsLoading_placeDeparture"
                style="?attr/internal_textAppearanceEmphasis2"/>
            <View
                android:id="@+id/flightDetailsLoading_timeArrival"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="54dp"
                android:layout_height="22dp"
                android:layout_marginTop="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="@+id/flightDetailsLoading_timeDeparture"
                app:layout_constraintTop_toBottomOf="@+id/flightDetailsLoading_duration"/>
            <View
                android:id="@+id/flightDetailsLoading_placeArrival"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="162dp"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="@dimen/internal_dp4"
                app:layout_constraintStart_toStartOf="@+id/flightDetailsLoading_timeDeparture"
                app:layout_constraintTop_toBottomOf="@+id/flightDetailsLoading_timeArrival"/>
            <View
                android:id="@+id/flightDetailsLoading_footer"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="154dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginEnd="54dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/flightDetailsLoading_placeArrival"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
