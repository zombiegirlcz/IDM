<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.LazyInflatableCachedView
        android:id="@+id/vaultsProgress_endTopValueContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/leftTopText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/leftTopText"
        app:layout_goneMarginTop="@dimen/internal_dp16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/leftTopText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/vaultsProgress_leftTopDescription"
        app:layout_constraintEnd_toStartOf="@+id/vaultsProgressLeftTopText_endTextImage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vaultsProgressLeftTopText_endTextImage"
        android:padding="@dimen/internal_dp4"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintBottom_toBottomOf="@+id/leftTopText"
        app:layout_constraintEnd_toStartOf="@+id/vaultsProgress_endTopValueContainer"
        app:layout_constraintStart_toEndOf="@+id/leftTopText"
        app:layout_constraintTop_toTopOf="@+id/leftTopText"
        app:layout_goneMarginEnd="@dimen/internal_dp4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/vaultsProgress_leftTopDescription"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:text="Description"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintBottom_toTopOf="@+id/progressBar"
        app:layout_constraintEnd_toEndOf="@+id/vaultsProgress_endTopValueContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/leftTopText"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.StatusProgressBarView
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/internal_vaults_progress"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        android:screenReaderFocusable="true"
        app:layout_constraintBottom_toTopOf="@+id/internalDelegateVaultsProgress_bottomTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vaultsProgress_leftTopDescription"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/internalDelegateVaultsProgress_bottomTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:maxLines="1"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/startBottomText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/startBottomText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintBottom_toTopOf="@+id/bottomActionStatus"
        app:layout_constraintEnd_toStartOf="@+id/endBottomText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalDelegateVaultsProgress_bottomTitle"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.ActionStatusView
        android:id="@+id/bottomActionStatus"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/vaultsProgress_actionButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/startBottomText"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/vaultsProgress_actionButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/endBottomText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/startBottomText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/startBottomText"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
