<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/document_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_file_xl"
            app:tint="?attr/uikit_colorGreyTone50"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorBlack"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/document_extension"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            style="?attr/internal_textAppearanceEmphasis1"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/document_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="32dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:layout_gravity="center_horizontal"
        android:id="@+id/document_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="32dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
</LinearLayout>
