<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp">
    <Space
        android:id="@+id/left_space"
        android:layout_width="16dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatRadioButton
        android:id="@+id/radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="32dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/editor_wrapper"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/editor_wrapper"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/left_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="right"
        app:constraint_referenced_ids="radio,left_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.uicomponent.widgets.support_edit_text.RevolutTextInputLayout
        android:id="@+id/editor_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:errorEnabled="false"
        app:hintAnimationEnabled="true"
        app:hintEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/left_barrier"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <com.revolut.uicomponent.text.masked.MaskedEditText
            android:ellipsize="end"
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            app:met_floatingLabel="highlight"
            app:met_floatingLabelTextColor="?attr/uikit_colorGreyTone50"
            app:met_textColor="?attr/uikit_colorForeground"
            app:met_underlineColor="?attr/uikit_colorGreyTone20"
            style="@style/RMaterialEditText"/>
    </com.revolut.uicomponent.widgets.support_edit_text.RevolutTextInputLayout>
    <ImageView
        android:id="@+id/icon"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/editor_wrapper"
        app:layout_constraintRight_toRightOf="@+id/editor_wrapper"
        app:layout_constraintTop_toTopOf="@+id/editor_wrapper"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_ss"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/underline_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/left_barrier"
        app:layout_constraintTop_toBottomOf="@+id/editor_wrapper"
        app:ttv_typeface="regular"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_ss"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/text_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editor_wrapper"
        app:ttv_typeface="regular"/>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="?attr/uikit_colorAccent"
        app:layout_constraintBottom_toBottomOf="@+id/editor_wrapper"
        app:layout_constraintRight_toRightOf="@+id/editor_wrapper"
        app:layout_constraintTop_toTopOf="@+id/editor_wrapper"/>
</androidx.constraintlayout.widget.ConstraintLayout>
