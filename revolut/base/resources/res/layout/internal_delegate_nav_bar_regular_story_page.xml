<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.internal.views.navbar.WallpaperView
        android:id="@+id/navBarRegularStoryPage_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/navBarRegularStoryPage_titleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="4"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/navBarRegularStoryPage_subtitleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceDisplay2"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/navBarRegularStoryPage_subtitleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/navBarRegularStoryPage_subtitleChevron"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginEnd="16dp"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <ImageView
        android:id="@+id/navBarRegularStoryPage_subtitleChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/navBarRegularStoryPage_subtitleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/navBarRegularStoryPage_subtitleView"
        app:layout_constraintTop_toTopOf="@+id/navBarRegularStoryPage_subtitleView"
        app:srcCompat="@drawable/uikit_icn_24_chevron_right"/>
    <View
        android:id="@+id/navBarRegularStoryPage_subtitleClickableArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/navBarRegularStoryPage_subtitleView"
        app:layout_constraintEnd_toEndOf="@+id/navBarRegularStoryPage_subtitleChevron"
        app:layout_constraintStart_toStartOf="@+id/navBarRegularStoryPage_subtitleView"
        app:layout_constraintTop_toTopOf="@+id/navBarRegularStoryPage_subtitleView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
