<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/image_text_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/imageTextMainContainer"
        android:background="?attr/selectableItemBackground_res_0x7f04060d"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/layout_icon_with_badges"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_m"
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toTopOf="@+id/subtitle"
            app:layout_constraintLeft_toRightOf="@+id/icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:ttv_typeface="medium"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_s"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/message"
            app:layout_constraintLeft_toLeftOf="@+id/title"
            app:layout_constraintRight_toRightOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:ttv_typeface="regular"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_s"
            android:textColor="?attr/uikit_colorPink"
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/title"
            app:layout_constraintRight_toRightOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            app:ttv_typeface="regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
