<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/badgeStatus_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/badgeStatus_label"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/badgeStatus_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="?attr/uikit_dp24"
        android:maxLines="1"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/badgeStatus_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/badgeStatus_icon"
        app:layout_constraintTop_toTopOf="@+id/badgeStatus_icon"
        app:layout_goneMarginStart="?attr/uikit_dp8"
        style="?attr/internal_textAppearanceEmphasis4"/>
</merge>
