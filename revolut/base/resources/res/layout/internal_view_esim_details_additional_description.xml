<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/esimDetailsAdditionalDescription_startImage"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="?attr/uikit_dp4"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:layout_marginEnd="10dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/esimDetailsAdditionalDescription_label"
        android:paddingTop="?attr/uikit_dp4"
        android:paddingBottom="?attr/uikit_dp4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="?attr/uikit_dp8"
        style="?attr/internal_textAppearanceBody2"/>
</merge>
