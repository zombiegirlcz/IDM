<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/profileCard_shimmer"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.background.AnimatedBackgroundView
            android:id="@+id/profileCard_animatedBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:foreground="?attr/uikit_colorWidgetBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/profileCard_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_begin="24dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/profileCard_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_begin="24dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/profileCard_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_end="40dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/profileCard_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_end="24dp"/>
        <ImageView
            android:id="@+id/profileCard_logoImage"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:adjustViewBounds="true"
            android:maxHeight="40dp"
            app:layout_constraintBottom_toTopOf="@+id/profileCard_top"
            app:layout_constraintEnd_toStartOf="@+id/profileCard_end"
            app:layout_constraintStart_toEndOf="@+id/profileCard_start"/>
        <FrameLayout
            android:id="@+id/profileCard_imageContainer"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/profileCard_bottom"
            app:layout_constraintEnd_toStartOf="@+id/profileCard_end"
            app:layout_constraintStart_toEndOf="@+id/profileCard_start"
            app:layout_constraintTop_toBottomOf="@+id/profileCard_top"
            app:layout_constraintVertical_bias="0.4"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorAccentNeutral"
            android:id="@+id/profileCard_imageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="56dp"
            app:layout_constraintBottom_toTopOf="@+id/profileCard_imageSubtitle"
            app:layout_constraintEnd_toEndOf="@+id/profileCard_imageContainer"
            app:layout_constraintStart_toStartOf="@+id/profileCard_imageContainer"
            app:layout_constraintTop_toTopOf="@+id/profileCard_imageContainer"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/InternalTextAppearance.Heading2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/profileCard_imageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="56dp"
            app:layout_constraintBottom_toBottomOf="@+id/profileCard_imageContainer"
            app:layout_constraintEnd_toEndOf="@+id/profileCard_imageContainer"
            app:layout_constraintStart_toStartOf="@+id/profileCard_imageContainer"
            app:layout_constraintTop_toBottomOf="@+id/profileCard_imageTitle"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringRectView
            android:id="@+id/profileCard_imageContainerLoading"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/profileCard_end"
            app:layout_constraintStart_toEndOf="@+id/profileCard_start"
            app:layout_constraintTop_toBottomOf="@+id/profileCard_top"
            app:layout_constraintWidth_percent="0.65"/>
        <ImageView
            android:id="@+id/profileCard_imageBadge"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="-20dp"
            app:layout_constraintBottom_toBottomOf="@+id/profileCard_imageContainer"
            app:layout_constraintEnd_toEndOf="@+id/profileCard_imageContainer"
            app:layout_constraintStart_toStartOf="@+id/profileCard_imageContainer"/>
        <com.revolut.core.ui_kit.views.ActionsView
            android:id="@+id/profileCard_actionsView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/profileCard_bottom"
            app:layout_constraintEnd_toStartOf="@+id/profileCard_end"
            app:layout_constraintStart_toEndOf="@+id/profileCard_start"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:id="@+id/profileCard_actionButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/profileCard_bottom"
            app:layout_constraintEnd_toStartOf="@+id/profileCard_end"
            app:layout_constraintStart_toEndOf="@+id/profileCard_start"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringPillShapeView
            android:id="@+id/profileCard_actionButtonLoading"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="?attr/uikit_small_action_height"
            app:layout_constraintBottom_toTopOf="@+id/profileCard_bottom"
            app:layout_constraintDimensionRatio="76:40"
            app:layout_constraintEnd_toStartOf="@+id/profileCard_end"
            app:layout_constraintStart_toEndOf="@+id/profileCard_start"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</merge>
