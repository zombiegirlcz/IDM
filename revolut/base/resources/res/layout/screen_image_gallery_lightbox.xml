<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imageGalleryLightboxScreen_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.LightboxGalleryView
        android:id="@+id/imageGalleryLightboxScreen_lightboxGallery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.ExpandableTextView
        android:layout_gravity="bottom"
        android:id="@+id/imageGalleryLightboxScreen_caption"
        android:padding="16dp"
        android:visibility="gone"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.ChatInputLayoutView
        android:layout_gravity="bottom"
        android:id="@+id/imageGalleryLightboxScreen_inputLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
