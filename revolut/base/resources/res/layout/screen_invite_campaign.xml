<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewSwitcher
        android:id="@+id/viewSwitcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.kompot.view.ControllerContainerCoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.revolut.core.ui_kit.views.navbar.NavBarWithContainer
                android:id="@+id/navbarWithContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.revolut.core.ui_kit.views.navbar.StoryNavBarContentView
                    android:id="@+id/storyContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.revolut.core.ui_kit.views.navbar.NavBarWithContainer>
            <com.revolut.recyclerkit.ScreenContentRecyclerView
                android:id="@+id/recyclerViewCashback"
                android:paddingBottom="@dimen/dp_96"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarOverlappingScrollingViewBehavior"/>
        </com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
        <com.revolut.kompot.view.ControllerContainerCoordinatorLayout
            android:id="@+id/homeLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.revolut.recyclerkit.ScreenContentRecyclerView
                android:id="@+id/recyclerView"
                android:paddingBottom="@dimen/dp_96"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
        </com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
    </ViewSwitcher>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:layout_gravity="bottom"
        android:id="@+id/goToButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/uikit_dp16"
        android:layout_marginRight="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp24"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
