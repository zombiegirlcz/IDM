<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/dialog_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="24dp"
        android:layout_alignParentStart="true"
        app:srcCompat="@drawable/ic_outline_info_m"/>
    <View
        android:id="@+id/dialog_item_icon_border"
        android:background="@drawable/circle_stroke_grey"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:ellipsize="end"
        android:id="@+id/dialog_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/dialog_item_checked_tick"
        android:layout_toEndOf="@+id/dialog_item_icon"
        style="@style/MainText.Primary"/>
    <ImageView
        android:id="@+id/dialog_item_checked_tick"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/ic_checkmark_m"/>
</merge>
