<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/showCardPinScreen_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.kompot.view.ControllerContainerCoordinatorLayout
        android:id="@+id/showCardPinScreen_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/showCardPinScreen_footerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/showCardPinScreen_navBarWithToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/showCardPinScreen_recyclerView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    </com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
    <com.revolut.core.ui_kit.views.FooterTextView
        android:id="@+id/showCardPinScreen_footerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/uikit_dp16"
        android:layout_marginRight="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="parent"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
