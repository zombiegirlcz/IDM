<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.CutoutImageView
        android:id="@+id/row_mainImage"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/row_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/row_valueBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/row_mainImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth="wrap_content_constrained"
        app:layout_goneMarginStart="0dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/row_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/row_valueBarrier"
        app:layout_constraintStart_toEndOf="@+id/row_mainImage"
        app:layout_constraintTop_toBottomOf="@+id/row_title"
        app:layout_goneMarginStart="0dp"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/row_valuePrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxWidth="130dp"
        android:maxLines="2"
        android:textAlignment="viewEnd"
        app:layout_constraintBottom_toTopOf="@+id/row_valueSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/row_title"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceBody1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/row_valueSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxWidth="130dp"
        android:maxLines="2"
        android:textAlignment="viewEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/row_valuePrimary"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.LazyInflatableCachedView
        android:id="@+id/row_lazyInflatableValue"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout>
