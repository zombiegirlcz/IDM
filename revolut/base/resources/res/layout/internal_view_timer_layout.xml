<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorBackground"
        android:gravity="center"
        android:id="@+id/viewTimer_days"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toStartOf="@+id/viewTimer_dividerDaysHours"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/viewTimer_dividerDaysHours"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewTimer_days"
        app:layout_constraintEnd_toStartOf="@+id/viewTimer_hours"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/viewTimer_days"
        app:layout_constraintTop_toTopOf="@+id/viewTimer_days"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorBackground"
        android:gravity="center"
        android:id="@+id/viewTimer_hours"
        android:layout_width="32dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toStartOf="@+id/viewTimer_dividerHoursMinutes"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/viewTimer_dividerDaysHours"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/viewTimer_dividerHoursMinutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewTimer_hours"
        app:layout_constraintEnd_toStartOf="@+id/viewTimer_minutes"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/viewTimer_hours"
        app:layout_constraintTop_toTopOf="@+id/viewTimer_hours"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorBackground"
        android:gravity="center"
        android:id="@+id/viewTimer_minutes"
        android:layout_width="32dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toStartOf="@+id/viewTimer_dividerMinutesSecs"
        app:layout_constraintStart_toEndOf="@+id/viewTimer_dividerHoursMinutes"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/viewTimer_dividerMinutesSecs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewTimer_hours"
        app:layout_constraintEnd_toStartOf="@+id/viewTimer_seconds"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/viewTimer_minutes"
        app:layout_constraintTop_toTopOf="@+id/viewTimer_hours"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorBackground"
        android:gravity="center"
        android:id="@+id/viewTimer_seconds"
        android:layout_width="32dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/viewTimer_dividerMinutesSecs"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/viewTimer_labelDays"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/viewTimer_days"
        app:layout_constraintStart_toStartOf="@+id/viewTimer_days"
        app:layout_constraintTop_toBottomOf="@+id/viewTimer_days"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/viewTimer_labelHours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/viewTimer_hours"
        app:layout_constraintStart_toStartOf="@+id/viewTimer_hours"
        app:layout_constraintTop_toBottomOf="@+id/viewTimer_hours"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/viewTimer_labelMinutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/viewTimer_minutes"
        app:layout_constraintStart_toStartOf="@+id/viewTimer_minutes"
        app:layout_constraintTop_toBottomOf="@+id/viewTimer_minutes"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/viewTimer_labelSeconds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/viewTimer_seconds"
        app:layout_constraintStart_toStartOf="@+id/viewTimer_seconds"
        app:layout_constraintTop_toBottomOf="@+id/viewTimer_seconds"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <View
        android:id="@+id/viewTimer_daysBar"
        android:background="?attr/uikit_colorForeground"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewTimer_days"
        app:layout_constraintEnd_toEndOf="@+id/viewTimer_days"
        app:layout_constraintStart_toStartOf="@+id/viewTimer_days"
        app:layout_constraintTop_toTopOf="@+id/viewTimer_days"/>
    <View
        android:id="@+id/viewTimer_hoursBar"
        android:background="?attr/uikit_colorForeground"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewTimer_hours"
        app:layout_constraintEnd_toEndOf="@+id/viewTimer_hours"
        app:layout_constraintStart_toStartOf="@+id/viewTimer_hours"
        app:layout_constraintTop_toTopOf="@+id/viewTimer_hours"/>
    <View
        android:id="@+id/viewTimer_minutesBar"
        android:background="?attr/uikit_colorForeground"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewTimer_minutes"
        app:layout_constraintEnd_toEndOf="@+id/viewTimer_minutes"
        app:layout_constraintStart_toStartOf="@+id/viewTimer_minutes"
        app:layout_constraintTop_toTopOf="@+id/viewTimer_minutes"/>
    <View
        android:id="@+id/viewTimer_secondsBar"
        android:background="?attr/uikit_colorForeground"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewTimer_seconds"
        app:layout_constraintEnd_toEndOf="@+id/viewTimer_seconds"
        app:layout_constraintStart_toStartOf="@+id/viewTimer_seconds"
        app:layout_constraintTop_toTopOf="@+id/viewTimer_seconds"/>
</merge>
