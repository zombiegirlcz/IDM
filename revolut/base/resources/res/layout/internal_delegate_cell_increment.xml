<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cellIncrement_image"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/cellIncrement_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/cellIncrement_description"
        app:layout_constraintEnd_toStartOf="@+id/cellIncrement_decrement_button"
        app:layout_constraintStart_toEndOf="@+id/cellIncrement_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        app:layout_goneMarginStart="?attr/uikit_dp0"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/cellIncrement_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/cellIncrement_title"
        app:layout_constraintStart_toStartOf="@+id/cellIncrement_title"
        app:layout_constraintTop_toBottomOf="@+id/cellIncrement_title"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/cellIncrement_decrement_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:contentDescription="@string/common.action.minus"
        android:layout_marginEnd="?attr/uikit_dp48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cellIncrement_increment_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.TwoTextSwitcherView
        android:textColor="?attr/uikit_colorAccent"
        android:id="@+id/cellIncrement_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLength="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cellIncrement_increment_button"
        app:layout_constraintStart_toEndOf="@+id/cellIncrement_decrement_button"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/cellIncrement_increment_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:contentDescription="@string/common.action.plus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
