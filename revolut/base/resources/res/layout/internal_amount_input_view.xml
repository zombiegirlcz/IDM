<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"> tools:theme=&quot;@style/UiKitTheme&quot;&gt; 
    <FrameLayout
        android:id="@+id/amountInput_startView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/amountInput_amountInputPrefix"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/amountInput_amountInputPrefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/amountInput_startView"
        app:layout_constraintRight_toLeftOf="@+id/amountInput_amountInputText"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceDisplay2"/>
    <com.revolut.core.ui_kit.views.input.MaskedTextInputEditText
        android:textColor="?attr/uikit_colorForeground"
        android:textColorHint="?attr/uikit_colorGreyTone50"
        android:gravity="end|center_vertical"
        android:id="@+id/amountInput_amountInputText"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="0"
        android:singleLine="true"
        android:digits="0123456789.,"
        android:inputType="numberDecimal"
        app:errorEnabled="false"
        app:hintEnabled="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/amountInput_amountInputPrefix"
        app:layout_constraintRight_toLeftOf="@+id/amountInput_amountInputFractionDigitsHint"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceDisplay2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center"
        android:id="@+id/amountInput_amountInputFractionDigitsHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/amountInput_amountInputText"
        app:layout_constraintRight_toLeftOf="@+id/amountInput_amountInputResult"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceDisplay2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center"
        android:id="@+id/amountInput_amountInputResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/amountInput_amountInputFractionDigitsHint"
        app:layout_constraintRight_toLeftOf="@+id/amountInput_amountInputSuffix"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceDisplay2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center"
        android:id="@+id/amountInput_amountInputSuffix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/amountInput_amountInputResult"
        app:layout_constraintRight_toLeftOf="@+id/amountInput_endView"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceDisplay2"/>
    <FrameLayout
        android:id="@+id/amountInput_endView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/amountInput_amountInputSuffix"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
        android:gravity="center"
        android:id="@+id/amountInput_invisibleAutoSizeView"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceDisplay2"/>
</merge>
