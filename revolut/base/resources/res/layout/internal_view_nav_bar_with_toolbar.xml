<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    app:layout_scrollFlags="exitUntilCollapsed|scroll">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/navBarWithToolbar_guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout
        android:id="@+id/navBarWithToolbar_headerContainerLayout"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/menuLayout">
        <com.revolut.core.ui_kit.internal.views.navbar.ConstraintHeaderLayout
            android:id="@+id/headerLayout"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/headerExtraContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/headerLayout"/>
        </com.revolut.core.ui_kit.internal.views.navbar.ConstraintHeaderLayout>
        <ViewStub
            android:id="@+id/navBarWithToolbar_switcherButton_stub"
            android:layout="@layout/internal_view_nav_bar_with_toolbar_switch_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/internal_dp16"
            app:layout_constraintStart_toStartOf="@+id/headerLayout"
            app:layout_constraintTop_toBottomOf="@+id/headerLayout"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/headerBarrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="navBarWithToolbar_switcherButton_stub,navBarWithToolbar_switcherButton"/>
        <com.revolut.core.ui_kit.views.ExpandableTextView
            android:id="@+id/navBarWithToolbar_expandableTextView"
            android:paddingBottom="@dimen/internal_dp16"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/headerBarrier"/>
        <com.revolut.core.ui_kit.views.ActionsView
            android:id="@+id/navBarWithToolbar_topActionsView"
            android:paddingBottom="@dimen/internal_dp16"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_expandableTextView"
            app:layout_goneMarginTop="0dp"/>
        <com.revolut.core.ui_kit.views.buttons.SearchButton
            android:id="@+id/navBarWithToolbar_searchButton"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/navBarWithToolbar_actionsView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_topActionsView"/>
        <com.revolut.core.ui_kit.views.ActionsView
            android:id="@+id/navBarWithToolbar_actionsView"
            android:paddingBottom="@dimen/internal_dp16"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_searchButton"
            app:layout_goneMarginTop="0dp"/>
    </com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
    <ViewStub
        android:id="@+id/navBarWithToolbar_headerLoadingStub"
        android:layout="@layout/internal_view_header_loading_layout"
        android:inflatedId="@+id/navBarWithToolbar_headerLoading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_headerContainerLayout"/>
    <com.revolut.core.ui_kit.base.UIKitView
        android:id="@+id/navBarWithToolbar_toolbarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/menuLayout"
        app:layout_constraintEnd_toEndOf="@+id/menuLayout"
        app:layout_constraintStart_toStartOf="@+id/menuLayout"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/menuLayout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHeight_min="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_guidelineTop">
        <com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout
            android:id="@+id/navBarWithToolbar_innerMenuLayout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintHeight_min="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
                android:layout_gravity="center_vertical"
                android:id="@+id/navigationButton"
                android:background="@drawable/internal_oval_ripple"
                android:padding="@dimen/dp_8"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/uikit.navigate_up.description"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ProgressBar
                android:id="@+id/navBarWithToolbar_toolbarProgress"
                android:visibility="gone"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:progressDrawable="@drawable/internal_toolbar_progress_bar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?android:attr/progressBarStyleHorizontal"/>
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorForeground"
                android:ellipsize="end"
                android:id="@+id/navBarWithToolbar_toolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/navBarWithToolbar_menuIndefiniteLoading"
                app:layout_constraintStart_toEndOf="@+id/navigationButton"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/internal_textAppearanceHeading3"/>
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorForeground"
                android:ellipsize="end"
                android:id="@+id/navBarWithToolbar_toolbarTitleChained"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/navBarWithToolbar_toolbarSubtitleChained"
                app:layout_constraintEnd_toStartOf="@+id/navBarWithToolbar_menuIndefiniteLoading"
                app:layout_constraintStart_toEndOf="@+id/navigationButton"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="?attr/internal_textAppearanceEmphasis1"/>
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:ellipsize="end"
                android:id="@+id/navBarWithToolbar_toolbarSubtitleChained"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/navBarWithToolbar_toolbarDescriptionChained"
                app:layout_constraintEnd_toStartOf="@+id/navBarWithToolbar_menuIndefiniteLoading"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/navigationButton"
                app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_toolbarTitleChained"
                app:layout_constraintVertical_chainStyle="packed"
                style="?attr/internal_textAppearanceBody2"/>
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorForeground"
                android:ellipsize="end"
                android:id="@+id/navBarWithToolbar_toolbarDescriptionChained"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/navBarWithToolbar_menuIndefiniteLoading"
                app:layout_constraintStart_toEndOf="@+id/navigationButton"
                app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_toolbarSubtitleChained"
                app:layout_constraintVertical_chainStyle="packed"
                style="?attr/internal_textAppearanceBody2"/>
            <ProgressBar
                android:id="@+id/navBarWithToolbar_menuIndefiniteLoading"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/menuRecyclerView"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/uikit_progressBarPrimary"/>
            <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
                android:orientation="horizontal"
                android:id="@+id/menuRecyclerView"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/navBarWithToolbar_menuShimmeringView"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintHeight_max="56dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/navBarWithToolbar_menuShimmeringView"
                android:background="@drawable/internal_nav_bar_menu_loading_background"
                android:visibility="gone"
                android:layout_width="70dp"
                android:layout_height="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.revolut.core.ui_kit.internal.views.tag.TagView
                android:id="@+id/navBarWithToolbar_menuTagView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:theme="@style/UiKitThemeOverlay.FcaDisclaimer"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/navBarWithToolbar_headerDisclaimerSticky"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_innerMenuLayout"
            style="?attr/internal_textAppearanceFcaDisclaimerEmphasised"/>
    </com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
    <com.revolut.core.ui_kit.internal.views.navbar.SearchView
        android:id="@+id/navBarWithToolbar_searchView"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/menuLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar_guidelineTop"
        app:layout_constraintVertical_bias="0"/>
</com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
