<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_colorBackground"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/delegate_title_value_row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="230dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/delegate_title_value_row_value"
        app:layout_constraintTop_toTopOf="parent"
        app:ttv_typeface="regular"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="right"
        android:id="@+id/delegate_title_value_row_value"
        android:paddingTop="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="5sp"
        app:layout_constraintLeft_toRightOf="@+id/delegate_title_value_row_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttv_typeface="regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
