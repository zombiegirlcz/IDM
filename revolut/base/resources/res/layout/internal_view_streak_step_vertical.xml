<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp">
    <ImageView
        android:id="@+id/streakStepVerticalView_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/streakStepVerticalView_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="8"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/streakStepVerticalView_icon"
        app:layout_constraintTop_toTopOf="@+id/streakStepVerticalView_icon"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/streakStepVerticalView_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="@+id/streakStepVerticalView_title"
        app:layout_constraintStart_toStartOf="@+id/streakStepVerticalView_title"
        app:layout_constraintTop_toBottomOf="@+id/streakStepVerticalView_title"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/streakStepVerticalView_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp8"
        app:layout_constraintStart_toStartOf="@+id/streakStepVerticalView_title"
        app:layout_constraintTop_toBottomOf="@+id/streakStepVerticalView_subtitle"
        app:layout_goneMarginTop="@dimen/internal_dp8"/>
</merge>
