<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/giftShareOutput_backgroundView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,530:310"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/giftShareOutput_coverImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/uikit_dp8"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/icon"
        app:layout_constraintEnd_toEndOf="@+id/giftShareOutput_backgroundView"
        app:layout_constraintStart_toStartOf="@+id/giftShareOutput_backgroundView"
        app:layout_constraintTop_toBottomOf="@+id/giftShareOutput_messageText"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/giftShareOutput_senderAvatar"
        android:layout_width="?attr/uikit_dp24"
        android:layout_height="?attr/uikit_dp24"
        android:layout_marginTop="?attr/uikit_dp24"
        android:contentDescription="@null"
        android:layout_marginStart="?attr/uikit_dp24"
        app:layout_constraintStart_toStartOf="@+id/giftShareOutput_backgroundView"
        app:layout_constraintTop_toTopOf="@+id/giftShareOutput_backgroundView"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/giftShareOutput_senderNameText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="@+id/giftShareOutput_senderAvatar"
        app:layout_constraintEnd_toEndOf="@+id/giftShareOutput_backgroundView"
        app:layout_constraintStart_toEndOf="@+id/giftShareOutput_senderAvatar"
        app:layout_constraintTop_toTopOf="@+id/giftShareOutput_senderAvatar"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/giftShareOutput_senderBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="giftShareOutput_senderAvatar,giftShareOutput_senderNameText"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/giftShareOutput_messageText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp24"
        android:maxHeight="116dp"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:autoSizeMaxTextSize="@dimen/internal_H1_text_size"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="@+id/giftShareOutput_backgroundView"
        app:layout_constraintStart_toStartOf="@+id/giftShareOutput_backgroundView"
        app:layout_constraintTop_toBottomOf="@+id/giftShareOutput_senderBarrier"
        style="?attr/internal_textAppearanceHeading1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/giftShareOutput_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp24"
        android:layout_marginStart="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="@+id/giftShareOutput_backgroundView"
        app:layout_constraintStart_toStartOf="@+id/giftShareOutput_backgroundView"
        app:srcCompat="@drawable/uikit_icn_24_heart"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/giftShareOutput_logo"
        android:padding="@dimen/internal_dp4"
        android:layout_width="106dp"
        android:layout_height="0dp"
        android:scaleType="fitStart"
        android:layout_marginStart="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="@+id/giftShareOutput_icon"
        app:layout_constraintStart_toEndOf="@+id/giftShareOutput_icon"
        app:layout_constraintTop_toTopOf="@+id/giftShareOutput_icon"
        app:srcCompat="@drawable/uikit_icn_revolut_logo"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/giftShareOutput_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="@+id/giftShareOutput_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/giftShareOutput_icon"
        app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
</merge>
