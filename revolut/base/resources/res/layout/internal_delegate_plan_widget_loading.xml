<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widgetLoading_shimmeringView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/widgetLoading_title"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="200dp"
        android:layout_height="20dp"/>
    <View
        android:id="@+id/widgetLoading_subtitle"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="96dp"
        android:layout_height="12dp"
        android:layout_marginTop="11dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widgetLoading_action"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp">
        <View
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_marginEnd="9dp"/>
        <View
            android:background="?attr/uikit_shimmerBackgroundCircle"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </LinearLayout>
</com.facebook.shimmer.ShimmerLinearLayout>
