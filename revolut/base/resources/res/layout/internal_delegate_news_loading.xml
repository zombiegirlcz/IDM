<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/newsLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/newsLoading_highlightedImage"
                android:background="@drawable/internal_big_tile_loading_delegate_background"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/newsLoading_contentContainer"
                app:layout_constraintDimensionRatio="168:118"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/newsLoading_contentContainer"
                android:padding="?attr/uikit_dp16"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toStartOf="@+id/newsLoading_defaultImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/newsLoading_highlightedImage">
                <View
                    android:id="@+id/newsLoading_straps"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    app:layout_constraintEnd_toStartOf="@+id/newsLoading_defaultImage"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.4"/>
                <View
                    android:id="@+id/newsLoading_title"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="?attr/uikit_dp8"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/newsLoading_defaultImage"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/newsLoading_straps"
                    app:layout_constraintWidth_percent="0.8"/>
                <View
                    android:id="@+id/newsLoading_footer"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/newsLoading_defaultImage"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.4"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/newsLoading_defaultImage"
                android:background="@drawable/internal_big_tile_loading_delegate_background"
                android:visibility="gone"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="@+id/newsLoading_contentContainer"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/newsLoading_contentContainer"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
