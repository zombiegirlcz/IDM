<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp">
        <com.revolut.core.ui_kit.internal.views.CutoutShapeableImageView
            android:layout_gravity="center"
            android:id="@+id/selectableIconDelegate_imageView"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <com.revolut.core.ui_kit.internal.views.CutoutImageView
            android:layout_gravity="center"
            android:id="@+id/selectableIconDelegate_progressBar"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/selectableIconDelegate_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="20dp"
            app:srcCompat="@drawable/internal_icn_16_new_item"/>
        <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
            android:layout_gravity="end|bottom"
            android:id="@+id/selectableIconDelegate_badgeImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/selectableIconDelegate_labelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="128dp"
        android:minWidth="64dp"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        style="@style/InternalTextAppearance.Emphasis4"/>
</LinearLayout>
