<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/backgroundSelectionItem_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/backgroundSelectionItem_subtitle"
        app:layout_constraintDimensionRatio="H,2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="6dp"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/backgroundSelectionItem_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundSelectionItem_background"
        app:layout_constraintEnd_toEndOf="@+id/backgroundSelectionItem_background"
        app:layout_constraintStart_toStartOf="@+id/backgroundSelectionItem_background"
        app:layout_constraintTop_toTopOf="@+id/backgroundSelectionItem_background"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backgroundSelectionItem_overlayIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toTopOf="@+id/backgroundSelectionItem_overlayText"
        app:layout_constraintEnd_toEndOf="@+id/backgroundSelectionItem_overlay"
        app:layout_constraintStart_toStartOf="@+id/backgroundSelectionItem_overlay"
        app:layout_constraintTop_toTopOf="@+id/backgroundSelectionItem_overlay"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/backgroundSelectionItem_overlayText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundSelectionItem_overlay"
        app:layout_constraintEnd_toEndOf="@+id/backgroundSelectionItem_overlay"
        app:layout_constraintStart_toStartOf="@+id/backgroundSelectionItem_overlay"
        app:layout_constraintTop_toBottomOf="@+id/backgroundSelectionItem_overlayIcon"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <View
        android:id="@+id/backgroundSelectionItem_selectionView"
        android:background="@drawable/internal_background_selection_item_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/backgroundSelectionItem_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="0dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backgroundSelectionItem_themedIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundSelectionItem_background"
        app:layout_constraintEnd_toStartOf="@+id/backgroundSelectionItem_videoIcon"
        app:layout_goneMarginEnd="8dp"
        app:srcCompat="@drawable/uikit_icn_24_contrast"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backgroundSelectionItem_videoIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundSelectionItem_background"
        app:layout_constraintEnd_toEndOf="@+id/backgroundSelectionItem_background"
        app:srcCompat="@drawable/uikit_icn_24_play"/>
    <com.revolut.core.ui_kit.internal.views.NewBadgeView
        android:id="@+id/backgroundSelectionItem_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="58dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/backgroundSelectionItem_background"
        app:layout_constraintTop_toTopOf="@+id/backgroundSelectionItem_background"/>
    <com.revolut.core.ui_kit.internal.views.DeleteButtonSmall
        android:id="@+id/backgroundSelectionItem_deleteIcon"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/backgroundSelectionItem_background"
        app:layout_constraintTop_toTopOf="@+id/backgroundSelectionItem_background"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/internal_textAppearanceEmphasis2"
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/backgroundSelectionItem_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
