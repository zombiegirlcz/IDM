<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stickerView_topImage"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/stickerView_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stickerView_badge"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/stickerView_topImage"
        app:layout_constraintEnd_toEndOf="@+id/stickerView_topImage"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stickerView_topLeftImage"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="@dimen/internal_dp24"
        android:layout_marginTop="@dimen/internal_dp24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/stickerView_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_sticker_title_margin_top"
        android:maxLines="3"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stickerView_topImage"
        app:layout_goneMarginTop="@dimen/internal_sticker_title_gone_margin_top"
        style="?attr/internal_textAppearanceHeading3"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/stickerView_value"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:maxLines="1"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/stickerView_bottomText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/stickerView_startImage"
        app:layout_constraintTop_toBottomOf="@+id/stickerView_title"
        app:layout_goneMarginBottom="@dimen/internal_sticker_value_gone_margin_bottom"
        app:layout_goneMarginStart="@dimen/internal_dp24"
        app:layout_goneMarginTop="12dp"
        style="?attr/internal_textAppearanceDisplay1"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/stickerView_bottomText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_sticker_bottom_text_margin_bottom"
        android:maxLines="3"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stickerView_value"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stickerView_startImage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="@dimen/internal_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stickerView_value"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stickerView_backgroundImage"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/stickerView_imageGradient"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/stickerView_backgroundImage"
        app:layout_constraintEnd_toEndOf="@+id/stickerView_backgroundImage"
        app:layout_constraintStart_toStartOf="@+id/stickerView_backgroundImage"
        app:layout_constraintTop_toTopOf="@+id/stickerView_backgroundImage"/>
    <TextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/stickerView_bottomTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp8"
        android:maxLines="3"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constraintBottom_toTopOf="@+id/stickerView_bottomSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="@dimen/internal_dp24"
        style="?attr/internal_textAppearanceHeading3"/>
    <TextView
        android:textColor="?attr/uikit_colorWhite_80"
        android:ellipsize="end"
        android:id="@+id/stickerView_bottomSubtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp24"
        android:maxLines="4"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
</merge>
