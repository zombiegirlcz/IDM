<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/revPointsTrophyRoomHighlightsSharingScreen_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/revPointsTrophyRoomHighlightsSharingScreen_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
        android:layout_gravity="center_vertical"
        android:id="@+id/revPointsTrophyRoomHighlightsSharingScreen_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.ActionsView
        android:layout_gravity="bottom"
        android:id="@+id/revPointsTrophyRoomHighlightsSharingScreen_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
