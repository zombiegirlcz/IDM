<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_input_travel_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/cellDetailsTextProgress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/cellDetailsTextProgress_progress"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsTextProgress_titleEndImage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="16dp"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cellDetailsTextProgress_titleEndImage"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/cellDetailsTextProgress_title"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsTextProgress_endText"
        app:layout_constraintStart_toEndOf="@+id/cellDetailsTextProgress_title"
        app:layout_constraintTop_toTopOf="@+id/cellDetailsTextProgress_title"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/cellDetailsTextProgress_endText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/cellDetailsTextProgress_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <ProgressBar
        android:layout_gravity="center_vertical"
        android:id="@+id/cellDetailsTextProgress_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:indeterminateTint="?attr/uikit_colorAccent"
        android:indeterminateTintMode="src_in"
        android:screenReaderFocusable="true"
        app:layout_constraintBottom_toTopOf="@+id/cellDetailsTextProgress_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellDetailsTextProgress_title"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/cellDetailsTextProgress_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginTop="16dp"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
