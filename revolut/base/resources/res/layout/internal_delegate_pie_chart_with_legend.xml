<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.chart.PieChartView
        android:id="@+id/pieChartLegend_pieChartView"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="12dp"/>
    <com.revolut.core.ui_kit.internal.views.chart.VerticalChartLegendView
        android:id="@+id/pieChartLegend_legendView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
