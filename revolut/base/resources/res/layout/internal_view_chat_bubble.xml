<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/chatBubble_imageLoadingBackground"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/chatBubble_image"
        app:layout_constraintEnd_toEndOf="@+id/chatBubble_image"
        app:layout_constraintStart_toStartOf="@+id/chatBubble_image"
        app:layout_constraintTop_toTopOf="@+id/chatBubble_image"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/chatBubble_image"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:maxHeight="278dp"
        android:minHeight="151dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="289dp"
        app:layout_constraintWidth_min="230dp"/>
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/chatBubble_giftPlayer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="385dp"
        app:layout_constraintHeight_min="307dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="289dp"
        app:layout_constraintWidth_min="230dp"/>
    <View
        android:id="@+id/chatBubble_messageArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatBubble_contentBottomBarrier"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/chatBubble_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/chatBubble_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatBubble_contentBottomBarrier"
        app:layout_goneMarginTop="12dp"/>
    <com.revolut.core.ui_kit.views.SingleLineAutoSizeTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center_vertical"
        android:id="@+id/chatBubble_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="0dp"
        android:maxWidth="252dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/chatBubble_titleSmall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatBubble_tag"
        app:layout_constraintWidth_min="80dp"
        app:layout_goneMarginTop="16dp"
        app:uikit_autoSizeMaxTextSize="35sp"
        app:uikit_autoSizeMinTextSize="5sp"
        style="?attr/internal_textAppearanceHeading1"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center_vertical"
        android:id="@+id/chatBubble_titleSmall"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="252dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/chatBubble_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatBubble_title"
        app:layout_goneMarginTop="8dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:textColor="?attr/uikit_colorWhite"
        android:id="@+id/chatBubble_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="252dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/chatBubble_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatBubble_titleSmall"
        app:layout_goneMarginTop="8dp"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <TextView
        android:textColor="?attr/uikit_colorWhite"
        android:id="@+id/chatBubble_description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/chatBubble_descriptionAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatBubble_subtitle"
        app:layout_goneMarginBottom="8dp"
        app:layout_goneMarginTop="8dp"
        style="?attr/internal_textAppearanceBody1Spaced"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorAccent"
        android:id="@+id/chatBubble_descriptionAction"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/chatBubble_overlappedIcons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatBubble_description"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/chatBubble_overlappedIcons"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatBubble_descriptionAction"/>
    <com.revolut.core.ui_kit.internal.views.chat.ChatBubbleMetaView
        android:id="@+id/chatBubble_bottomViewsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/chatBubble_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"/>
</merge>
