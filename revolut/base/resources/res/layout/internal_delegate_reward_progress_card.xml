<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/rewardProgressCard_media"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="343:180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.BadgeStatusView
        android:id="@+id/rewardProgressCard_topLeftStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/rewardProgressCard_topRightIconBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/rewardProgressCard_topRightIconBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="rewardProgressCard_topRightInfoIcon,rewardProgressCard_topRightDismissIcon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rewardProgressCard_topRightInfoIcon"
        android:paddingTop="?attr/uikit_dp16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:paddingEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_24_info_outline"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rewardProgressCard_topRightDismissIcon"
        android:paddingTop="?attr/uikit_dp16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:paddingEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_24_cross_small"/>
    <TextView
        android:textColor="?attr/uikit_colorBlack"
        android:ellipsize="end"
        android:id="@+id/rewardProgressCard_title"
        android:paddingBottom="?attr/uikit_dp12"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/rewardProgressCard_titleBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/rewardProgressCard_titleBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="rewardProgressCard_button,rewardProgressCard_circleSteps,rewardProgressCard_progressWithTextOnSides,rewardProgressCard_amountText"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/rewardProgressCard_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.views.CircleStepsView
        android:id="@+id/rewardProgressCard_circleSteps"
        android:background="@drawable/internal_reward_progress_card_progress_background"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="?attr/uikit_colorBlack"
        android:ellipsize="end"
        android:id="@+id/rewardProgressCard_amountText"
        android:background="@drawable/internal_reward_progress_card_progress_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:lines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        android:paddingHorizontal="?attr/uikit_dp16"
        android:paddingVertical="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceHeading3"/>
    <com.revolut.core.ui_kit.views.ProgressWithTextOnSidesView
        android:id="@+id/rewardProgressCard_progressWithTextOnSides"
        android:background="@drawable/internal_reward_progress_card_progress_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginHorizontal="?attr/uikit_dp16"
        android:paddingHorizontal="?attr/uikit_dp16"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
