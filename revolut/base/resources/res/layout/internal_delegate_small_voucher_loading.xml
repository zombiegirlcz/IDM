<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smallVoucherLoading_root"
    android:background="?attr/uikit_colorShimmer_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/smallVoucherLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/internal_dp12"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/smallVoucherLoading_cardBackground"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/smallVoucherLoading_title"
                app:layout_constraintDimensionRatio="H,167:114"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/smallVoucherLoading_title"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="?attr/uikit_dp12"
                android:layout_marginHorizontal="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/smallVoucherLoading_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/smallVoucherLoading_cardBackground"
                app:layout_constraintWidth_max="135dp"/>
            <View
                android:id="@+id/smallVoucherLoading_subtitle"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/smallVoucherLoading_title"
                app:layout_constraintWidth_max="75dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
