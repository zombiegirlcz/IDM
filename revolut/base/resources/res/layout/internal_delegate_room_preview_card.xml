<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/roomPreviewCard_previewImage"
        android:layout_width="?attr/uikit_dp72"
        android:layout_height="?attr/uikit_dp72"
        android:layout_marginTop="?attr/uikit_dp16"
        android:foreground="@drawable/internal_box_foreground_ripple"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/roomPreviewCard_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/roomPreviewCard_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/roomPreviewCard_previewImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/roomPreviewCard_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/roomPreviewCard_label"
        app:layout_constraintEnd_toStartOf="@+id/roomPreviewCard_previewImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roomPreviewCard_title"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceBody2"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/roomPreviewCard_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/roomPreviewCard_barrier"
        app:layout_constraintEnd_toStartOf="@+id/roomPreviewCard_previewImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roomPreviewCard_subtitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/roomPreviewCard_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="roomPreviewCard_previewImage, roomPreviewCard_label"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/roomPreviewCard_detailsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp24"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/roomPreviewCard_detailsSubtitle"
        app:layout_constraintEnd_toStartOf="@+id/roomPreviewCard_detailsAction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roomPreviewCard_barrier"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/roomPreviewCard_detailsAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp24"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roomPreviewCard_barrier"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <TextView
        android:id="@+id/roomPreviewCard_detailsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp24"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/roomPreviewCard_price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roomPreviewCard_detailsTitle"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceBody2"/>
    <include
        android:id="@+id/roomPreviewCard_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roomPreviewCard_detailsSubtitle"
        layout="@layout/internal_delegate_cell_details_price"/>
    <TextView
        android:id="@+id/roomPreviewCard_cashbackTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/roomPreviewCard_cashbackBadge"
        app:layout_constraintEnd_toStartOf="@+id/roomPreviewCard_cashbackBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/roomPreviewCard_cashbackBadge"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/roomPreviewCard_cashbackBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp24"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roomPreviewCard_price"/>
</androidx.constraintlayout.widget.ConstraintLayout>
