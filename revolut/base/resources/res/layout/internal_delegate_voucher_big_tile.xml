<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/voucherBigTile_cardBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,16:10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/voucherBigTile_cardBackgroundImage"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/voucherBigTile_cardBackgroundLottieImage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <com.revolut.core.ui_kit.internal.views.videoplayer.UiKitPlayerView
            android:id="@+id/voucherBigTile_cardBackgroundVideo"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/voucherBigTile_cardBackgroundAvatarStub"
            android:layout="@layout/internal_view_avatar_stub"
            android:inflatedId="@+id/voucherBigTile_cardBackgroundAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <View
        android:id="@+id/voucherBigTile_grayMask"
        android:background="@color/internal_grey50_10"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.7"
        app:layout_constraintBottom_toBottomOf="@+id/voucherBigTile_cardBackground"
        app:layout_constraintEnd_toEndOf="@+id/voucherBigTile_cardBackground"
        app:layout_constraintStart_toStartOf="@+id/voucherBigTile_cardBackground"
        app:layout_constraintTop_toTopOf="@+id/voucherBigTile_cardBackground"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voucherBigTile_iconLocked"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/voucherBigTile_cardBackground"
        app:layout_constraintTop_toTopOf="@+id/voucherBigTile_cardBackground"/>
    <com.revolut.flexbox.FlexboxLayout
        android:orientation="horizontal"
        android:id="@+id/voucherBigTile_tagsContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:dividerDrawable="@drawable/internal_divider_tags"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintBottom_toTopOf="@+id/voucherBigTile_footerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voucherBigTile_cardBackground"
        app:showDivider="middle"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/voucherBigTile_footerText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voucherBigTile_tagsContainer"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceHeading3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
