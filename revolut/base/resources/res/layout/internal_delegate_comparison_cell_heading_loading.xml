<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:backgroundTint="?attr/uikit_colorGreyTone5">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/comparisonCellHeadingLoadingDelegate_singleText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/uikit_dp24"
            android:layout_marginEnd="?attr/uikit_dp24"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/comparisonCellHeadingLoadingDelegate_firstText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/comparisonCellHeadingLoadingDelegate_verticalDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/uikit_dp24"
            android:layout_marginEnd="?attr/uikit_dp24"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <View
        android:id="@+id/comparisonCellHeadingLoadingDelegate_verticalDivider"
        android:background="?attr/uikit_colorGreyTone10"
        android:layout_width="1px"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/comparisonCellHeadingLoadingDelegate_secondText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/comparisonCellHeadingLoadingDelegate_verticalDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comparisonCellHeadingLoadingDelegate_verticalDivider"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/uikit_dp24"
            android:layout_marginEnd="?attr/uikit_dp24"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/comparisonCellHeadingLoadingDelegate_multiGroup"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="comparisonCellHeadingLoadingDelegate_firstText,comparisonCellHeadingLoadingDelegate_verticalDivider,comparisonCellHeadingLoadingDelegate_secondText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
