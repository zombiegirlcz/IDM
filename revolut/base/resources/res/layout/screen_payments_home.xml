<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBar
        android:id="@+id/mainNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.DraggableTabsView
            android:id="@+id/tabs"
            android:paddingLeft="?attr/uikit_dp16"
            android:paddingRight="?attr/uikit_dp16"
            android:paddingBottom="?attr/uikit_dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.revolut.core.ui_kit.views.navbar.NavBar>
    <com.revolut.core.ui_kit.views.pager.RevolutViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
