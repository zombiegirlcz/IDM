<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/productSelectionLoading_shimmeringImages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/productSelectionLoading_icon"
            android:background="@drawable/internal_circle_gradient_grey"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/productSelectionLoading_picture"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:shapeAppearanceOverlay="@style/InternalShapeAppearanceOverlayRoundedCorners12dp"
            app:srcCompat="@drawable/internal_rectangle_gradient_grey"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/productSelectionLoading_shimmeringTexts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/productSelectionLoading_shimmeringImages"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/newProductLoading_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="160dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp16"/>
        <View
            android:id="@+id/newProductLoading_subtitle"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="80dp"
            android:layout_height="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp16"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
