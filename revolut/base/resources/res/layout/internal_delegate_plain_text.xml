<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/plainTextDelegate_topImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="343:200"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/plainTextDelegate_topContentSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/plainTextDelegate_topImage"/>
    <Space
        android:id="@+id/plainTextDelegate_startContentSpace"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/plainTextDelegate_endContentSpace"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/plainTextDelegate_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/plainTextDelegate_endContentSpace"
        app:layout_constraintStart_toEndOf="@+id/plainTextDelegate_startContentSpace"
        app:layout_constraintTop_toBottomOf="@+id/plainTextDelegate_topContentSpace"
        style="?attr/internal_textAppearanceHeading3"/>
    <com.revolut.core.ui_kit.views.ExpandableTextView
        android:id="@+id/plainTextDelegate_expandableText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintBottom_toTopOf="@+id/plainTextDelegate_bottomContentSpace"
        app:layout_constraintEnd_toStartOf="@+id/plainTextDelegate_endContentSpace"
        app:layout_constraintStart_toEndOf="@+id/plainTextDelegate_startContentSpace"
        app:layout_constraintTop_toBottomOf="@+id/plainTextDelegate_title"
        app:layout_goneMarginTop="0dp"
        style="?attr/internal_textAppearanceBody2"/>
    <Space
        android:id="@+id/plainTextDelegate_bottomContentSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
