<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.chat.ChatSwipeToReplyLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatPaymentBubbleDelegate_swipeToReplyLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.chat.ChatParentLayout
        android:id="@+id/chatPaymentBubbleDelegate_chatParentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/chatPaymentBubbleDelegate_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.revolut.core.ui_kit.internal.views.chat.ChatPaymentView
                android:id="@+id/chatPaymentBubbleDelegate_bubbleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.revolut.core.ui_kit.internal.views.chat.ChatBubbleReactionView
                android:id="@+id/chatPaymentBubbleDelegate_reactionsView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"/>
        </LinearLayout>
    </com.revolut.core.ui_kit.internal.views.chat.ChatParentLayout>
</com.revolut.core.ui_kit.internal.views.chat.ChatSwipeToReplyLayout>
