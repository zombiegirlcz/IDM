<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/esimDetails_tagView"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:layout_marginStart="?attr/uikit_dp12"
        android:layout_marginEnd="?attr/uikit_dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.AvatarView
        android:id="@+id/esimDetails_avatar"
        android:background="?attr/uikit_colorTransparent"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="?attr/uikit_dp16"
        android:scaleType="fitCenter"
        android:layout_marginStart="?attr/uikit_dp12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/esimDetails_tagView"
        app:layout_goneMarginTop="?attr/uikit_dp16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/esimDetails_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp12"
        app:layout_constraintBottom_toBottomOf="@+id/esimDetails_avatar"
        app:layout_constraintStart_toEndOf="@+id/esimDetails_avatar"
        app:layout_constraintTop_toTopOf="@+id/esimDetails_avatar"
        style="?attr/internal_textAppearanceHeading3"/>
    <com.revolut.core.ui_kit.internal.views.CutoutImageView
        android:id="@+id/esimDetails_titleImage"
        android:padding="?attr/uikit_dp4"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="@+id/esimDetails_title"
        app:layout_constraintStart_toEndOf="@+id/esimDetails_title"
        app:layout_constraintTop_toTopOf="@+id/esimDetails_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/esimDetails_additionalDescriptionsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:layout_marginBottom="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp12"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/esimDetails_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
