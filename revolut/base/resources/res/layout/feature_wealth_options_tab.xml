<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.Tabs
        android:id="@+id/expirationDatesTabs"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/uikit_dp16"/>
    <com.revolut.core.ui_kit.views.FixedTabs
        android:id="@+id/contractTypeTabs"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:paddingHorizontal="?attr/uikit_dp16"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.revolut.kompot.view.ControllerContainerLinearLayout>
