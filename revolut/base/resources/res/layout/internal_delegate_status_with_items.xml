<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_colorBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/statusWithItems_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/statusWithItems_subtitleImage"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/statusWithItems_subtitle"
        app:layout_constraintTop_toBottomOf="@+id/statusWithItems_title"
        app:layout_constraintTop_toTopOf="@+id/statusWithItems_subtitle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreen"
        android:id="@+id/statusWithItems_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:maxLines="1"
        android:layout_marginStart="@dimen/internal_dp8"
        app:layout_constraintStart_toEndOf="@+id/statusWithItems_subtitleImage"
        app:layout_constraintTop_toBottomOf="@+id/statusWithItems_title"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/internal_greyTone50"
        android:id="@+id/statusWithItems_firstStartLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp32"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@+id/statusWithItems_subtitle"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/statusWithItems_firstEndLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBaseline_toBaselineOf="@+id/statusWithItems_firstStartLabel"
        app:layout_constraintEnd_toEndOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/internal_greyTone50"
        android:id="@+id/statusWithItems_secondStartLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp24"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@+id/statusWithItems_firstStartLabel"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/statusWithItems_secondEndLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBaseline_toBaselineOf="@+id/statusWithItems_secondStartLabel"
        app:layout_constraintEnd_toEndOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
