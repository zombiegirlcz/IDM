<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/draggableActionWidgetLoading_shimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/draggableActionWidgetLoading_image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintBottom_toTopOf="@+id/draggableActionWidgetLoading_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:srcCompat="@drawable/internal_circle_gradient_grey"/>
            <View
                android:id="@+id/draggableActionWidgetLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="96dp"
                android:layout_height="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/draggableActionWidgetLoading_image"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
