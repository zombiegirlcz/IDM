<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/supportTileWidgetLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/supportTileWidgetLoading_image"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                app:srcCompat="@drawable/internal_circle_gradient_grey"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:id="@+id/supportTileWidgetLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="96dp"
                android:layout_height="16dp"/>
            <View
                android:id="@+id/supportTileWidgetLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="56dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
