<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <com.revolut.core.ui_kit.views.input.MaskedTextInputEditText
            android:textColor="@color/internal_color_input_text"
            android:textColorHint="?attr/uikit_colorGreyTone50"
            android:gravity="end"
            android:id="@+id/row_valueEditableNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="130dp"
            android:minWidth="30dp"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:backgroundTint="?attr/uikit_colorGreyTone10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceBody1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/internal_color_input_text"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="end"
            android:id="@+id/row_valueEditableNumberSuffix"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@+id/row_valueEditableNumber"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceBody1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/internal_greyTone50"
        android:layout_gravity="end"
        android:id="@+id/row_subtitleEditableNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/internal_textAppearanceBody2"/>
</LinearLayout>
