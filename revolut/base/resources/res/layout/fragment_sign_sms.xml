<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikit_windowBackground"
    android:paddingBottom="24dp"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:shadow="white_no_shadow"/>
    <RelativeLayout
        android:id="@+id/deeplink_wrapper"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/toolbar_height">
        <LinearLayout
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="?attr/uikit_dp16"
            android:layout_marginTop="@dimen/toolbar_height"
            android:layout_marginRight="?attr/uikit_dp16">
            <ImageView
                android:id="@+id/deeplink_animation_view"
                android:layout_width="192dp"
                android:layout_height="192dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"/>
            <com.revolut.core_ui_custom_font.TypefaceTextView
                android:gravity="center_horizontal"
                android:id="@+id/deeplink_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_goneMarginTop="24dp"
                style="@style/TutorialTitleText"/>
            <com.revolut.core_ui_custom_font.TypefaceTextView
                android:gravity="center_horizontal"
                android:id="@+id/deeplink_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/SubtitleText"/>
            <com.revolut.core_ui_custom_font.TypefaceTextView
                android:gravity="center_horizontal"
                android:id="@+id/deeplink_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                style="@style/SubtitleText"/>
        </LinearLayout>
        <com.revolut.core_ui_custom_font.TypefaceButton
            android:id="@+id/deeplink_button"
            android:layout_alignParentBottom="true"
            style="@style/Style.Button.Default"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/digits_wrapper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/debug_sms_code"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            android:maxLines="1"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <com.revolut.core.ui_kit.views.code.CodeEditor
            android:id="@+id/codeInput"
            android:longClickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_s"
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="start"
            android:id="@+id/main_hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/uikit_dp16"
            android:layout_marginRight="?attr/uikit_dp16"
            app:ttv_typeface="regular"/>
        <com.revolut.core.ui_kit.views.LabelButtonView
            android:id="@+id/resend_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/uikit_dp16"
            android:layout_marginRight="?attr/uikit_dp16"/>
    </LinearLayout>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerLinearLayout>
