<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/largeVoucherLoading_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/largeVoucherLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/largeVoucherLoading_cardBackground"
                android:background="@drawable/internal_big_tile_loading_delegate_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="H,343:148"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/largeVoucherLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="match_parent"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginBottom="?attr/uikit_dp8"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/largeVoucherLoading_subtitle"
                app:layout_constraintTop_toBottomOf="@+id/largeVoucherLoading_cardBackground"/>
            <View
                android:id="@+id/largeVoucherLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginBottom="?attr/uikit_dp12"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.22"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
