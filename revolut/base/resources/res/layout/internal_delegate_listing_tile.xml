<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/listingTile_minHeight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,343:164"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/listingTile_backgroundMedia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/listingTile_foregroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/listingTile_backgroundMedia"
        app:layout_constraintEnd_toEndOf="@+id/listingTile_backgroundMedia"
        app:layout_constraintStart_toStartOf="@+id/listingTile_backgroundMedia"
        app:layout_constraintTop_toTopOf="@+id/listingTile_backgroundMedia"/>
    <View
        android:id="@+id/listingTile_backgroundImageOverlay"
        android:background="@drawable/internal_listing_gradient_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/listingTile_backgroundMedia"
        app:layout_constraintEnd_toEndOf="@+id/listingTile_backgroundMedia"
        app:layout_constraintStart_toStartOf="@+id/listingTile_backgroundMedia"
        app:layout_constraintTop_toTopOf="@+id/listingTile_backgroundMedia"/>
    <FrameLayout
        android:id="@+id/listingTile_topLeftItemContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/listingTile_topRightBadgeContainer"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.TagsView
            android:id="@+id/listingTile_topLeftTagsView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.revolut.core.ui_kit.views.OverlappedIconsView
            android:id="@+id/listingTile_topLeftImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            android:layout_marginEnd="?attr/uikit_dp8"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/listingTile_topRightBadgeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/listingTile_topRightBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/listingTile_topRightIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/listingTile_topItemsBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="listingTile_topLeftItemContainer,listingTile_topRightBadgeContainer"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/listingTile_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:maxLines="3"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/listingTile_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/listingTile_bottomRightImagesBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingTile_topItemsBarrier"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceHeading3"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/listingTile_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp0"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/listingTile_secondDescription"
        app:layout_constraintEnd_toEndOf="@+id/listingTile_bottomRightImagesBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/listingTile_secondDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/listingTile_progressBar"
        app:layout_constraintEnd_toEndOf="@+id/listingTile_bottomRightImagesBarrier"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceBody3"/>
    <ProgressBar
        android:id="@+id/listingTile_progressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:progressDrawable="@drawable/internal_progress_accent"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        android:screenReaderFocusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/listingTile_bottomRightImagesBarrier"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/listingTile_endOfText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/listingTile_bottomRightImagesBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="listingTile_endOfText,listingTile_bottomRightImages"/>
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/listingTile_bottomRightImages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_16dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_default="wrap"/>
</androidx.constraintlayout.widget.ConstraintLayout>
