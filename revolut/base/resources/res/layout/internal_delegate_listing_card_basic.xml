<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="96dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardBasic_image"
        android:layout_width="106dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/listingCardBasic_addNewIconStub"
        android:layout="@layout/internal_delegate_listing_card_basic_add_new_icon"
        android:inflatedId="@+id/listingCardBasic_addNewIcon"
        android:layout_width="?attr/uikit_dp24"
        android:layout_height="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="@+id/listingCardBasic_image"
        app:layout_constraintEnd_toEndOf="@+id/listingCardBasic_image"
        app:layout_constraintStart_toStartOf="@+id/listingCardBasic_image"
        app:layout_constraintTop_toTopOf="@+id/listingCardBasic_image"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardBasic_topRightIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardBasic_topInfoIcon"
        android:visibility="gone"
        android:layout_width="?attr/uikit_dp16"
        android:layout_height="?attr/uikit_dp16"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/listingCardBasic_topBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/uikit_colorGrey50"
        android:ellipsize="end"
        android:id="@+id/listingCardBasic_topInfoText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp4"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBaseline_toBaselineOf="@+id/listingCardBasic_topInfoIcon"
        app:layout_constraintEnd_toStartOf="@+id/listingCardBasic_image"
        app:layout_constraintStart_toEndOf="@+id/listingCardBasic_topInfoIcon"
        app:layout_goneMarginStart="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/listingCardBasic_topBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="listingCardBasic_topInfoIcon, listingCardBasic_topInfoText"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/listingCardBasic_titleText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/listingCardBasic_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardBasic_topBarrier"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:textColor="?attr/uikit_colorGrey50"
        android:ellipsize="end"
        android:id="@+id/listingCardBasic_descriptionText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="3"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/listingCardBasic_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardBasic_titleText"
        app:layout_constraintVertical_bias="0"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/listingCardBasic_priceContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/listingCardBasic_tagsContainer"
        app:layout_constraintEnd_toStartOf="@+id/listingCardBasic_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardBasic_descriptionText"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="?attr/uikit_dp16">
        <TextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/listingCardBasic_priceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <TextView
            android:textColor="?attr/uikit_colorGrey50"
            android:ellipsize="end"
            android:id="@+id/listingCardBasic_priceDescriptionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/uikit_dp4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/listingCardBasic_priceText"
            app:layout_goneMarginStart="?attr/uikit_dp0"
            style="?attr/internal_textAppearanceBody3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.revolut.flexbox.FlexboxLayout
        android:orientation="horizontal"
        android:id="@+id/listingCardBasic_tagsContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:dividerDrawable="@drawable/internal_divider_price_tags"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintBottom_toTopOf="@+id/listingCardBasic_actionsView"
        app:layout_constraintEnd_toStartOf="@+id/listingCardBasic_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardBasic_priceContainer"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        app:showDivider="middle"/>
    <com.revolut.core.ui_kit.views.ActionsView
        android:id="@+id/listingCardBasic_actionsView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/listingCardBasic_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardBasic_tagsContainer"/>
    <ViewStub
        android:id="@+id/listingCardBasic_addNewOutlineStub"
        android:layout="@layout/internal_delegate_listing_card_basic_add_new_outline"
        android:inflatedId="@+id/listingCardBasic_addNewOutline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
