<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lightPrompt_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/lightPrompt_fullSizeMediaWrapper"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="343:480"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.internal.views.UiKitMediaView
            android:id="@+id/lightPrompt_fullSizeMedia"
            android:background="?attr/uikit_colorBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.internal.views.DynamicHeightAutosizeTextView
        android:ellipsize="end"
        android:id="@+id/lightPrompt_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp24"
        android:maxLines="3"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="normal"
        android:layout_marginHorizontal="?attr/uikit_dp16"
        app:autoSizeMaxTextSize="@dimen/internal_MarketingDisplay2_text_size"
        app:autoSizeMinTextSize="@dimen/internal_MarketingDisplay2_min_text_size"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/lightPrompt_description"
        android:paddingBottom="?attr/uikit_dp16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:maxLines="3"
        android:layout_marginHorizontal="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lightPrompt_title"
        app:layout_goneMarginTop="?attr/uikit_dp24"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/lightPrompt_compactMedia"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="343:248"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lightPrompt_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
