<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.ImageWithAnimatedBackgroundView
        android:id="@+id/headerLayout_titleIcon"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="?attr/uikit_dp32"
        android:layout_height="?attr/uikit_dp32"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/headerLayout_animatedViewContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerLayout_titleTopNote"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/headerLayout_titleIconBadgeDot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/headerLayout_titleIcon"
        app:layout_constraintEnd_toEndOf="@+id/headerLayout_titleIcon"
        app:layout_constraintStart_toEndOf="@+id/headerLayout_titleIcon"
        app:layout_constraintTop_toTopOf="@+id/headerLayout_titleIcon"
        app:srcCompat="@drawable/internal_icn_16_new_item"/>
    <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
        android:id="@+id/headerLayout_statusBadgeIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="6dp"
        android:translationY="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/headerLayout_titleIcon"
        app:layout_constraintEnd_toEndOf="@+id/headerLayout_titleIcon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/headerLayout_titleTopDescriptionImage"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/headerLayout_titleTopDescription"
        app:layout_constraintEnd_toStartOf="@+id/headerLayout_titleTopDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerLayout_titleTopDescription"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/headerLayout_titleTopDescription"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/headerLayout_titleTopDescriptionImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/dp_16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.navbar.ImageAutoSizeTextView
        android:id="@+id/headerLayout_chevronTextView"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="41sp"
        android:paddingStart="?attr/uikit_dp8"
        android:paddingEnd="?attr/uikit_dp16"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/descriptionContainer"
        app:layout_constraintEnd_toStartOf="@+id/headerExtraContainer"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/headerLayout_titleIcon"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout_titleTopDescription"
        app:layout_goneMarginStart="?attr/uikit_dp8"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/headerLayout_titleTopNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/headerLayout_animatedViewContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/headerLayout_animatedViewContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/headerExtraContainer"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout_titleTopNote">
        <com.revolut.core.ui_kit.internal.views.animated_numbers.AnimatedNumbersView
            android:id="@+id/headerLayout_animatedTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/headerLayout_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/headerLayout_titleDescription"
        android:paddingBottom="?attr/uikit_dp4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/headerLayout_chevronTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/headerLayout_chevronTextView"
        style="?attr/internal_textAppearanceBody2"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/headerLayout_description"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="24dp"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="@dimen/dp_16"
        app:layout_constraintEnd_toStartOf="@+id/headerExtraContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout_chevronTextView">
        <FrameLayout
            android:id="@+id/descriptionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/headerLayout_descriptionIcon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <com.revolut.core.ui_kit.internal.views.CircleProgressBar
                android:id="@+id/headerLayout_descriptionProgress"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end"
                android:id="@+id/headerLayout_badgeDot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                app:srcCompat="@drawable/internal_icn_16_new_dot"/>
        </FrameLayout>
        <com.revolut.core.ui_kit.internal.views.timer.CountDownTextView
            android:id="@+id/headerLayout_countDown"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/headerLayout_descriptionText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            style="?attr/internal_textAppearanceEmphasis1"/>
    </LinearLayout>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/headerLayout_secondDescriptionText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/headerExtraContainer"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout_description"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/headerLayout_thirdDescriptionText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintEnd_toStartOf="@+id/headerExtraContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout_secondDescriptionText"
        style="?attr/internal_textAppearanceBody2"/>
</merge>
