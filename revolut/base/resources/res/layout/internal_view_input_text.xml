<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.input.InputTextFieldContainer
        android:id="@+id/inputText_fieldContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/inputText_startPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="0dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/inputText_endPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="0dp"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/inputText_labelBarrier"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:barrierDirection="start"
            app:constraint_referenced_ids="inputText_EditText,inputText_prefixText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:gravity="top|left"
            android:id="@+id/inputText_shimmer"
            android:paddingTop="20dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/inputText_iconsContainer"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/inputText_prefixText">
            <View
                android:background="@drawable/internal_input_text_rectangle_grey"
                android:layout_width="160dp"
                android:layout_height="16dp"
                style="?attr/internal_textAppearanceHeading3"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <com.revolut.core.ui_kit.views.input.MaskedTextInputEditText
            android:textColor="@color/internal_color_input_text"
            android:textColorHint="?attr/uikit_colorGreyTone50"
            android:gravity="start|top"
            android:id="@+id/inputText_EditText"
            android:background="@null"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:textSelectHandleLeft="@drawable/internal_input_text_select_handle_left"
            android:textSelectHandleRight="@drawable/internal_input_text_select_handle_right"
            android:textSelectHandle="@drawable/internal_input_text_select_handle_middle"
            android:textCursorDrawable="@drawable/internal_input_text_cursor"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/inputText_iconsContainer"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/inputText_prefixText"
            app:textInputLayoutFocusedRectEnabled="false"
            style="?attr/internal_textAppearanceBody1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="top|left"
            android:id="@+id/inputText_prefixText"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:includeFontPadding="true"
            app:layout_constraintEnd_toStartOf="@+id/inputText_EditText"
            app:layout_constraintStart_toEndOf="@+id/inputText_prefixIcon"
            app:textInputLayoutFocusedRectEnabled="false"
            style="?attr/internal_textAppearanceBody1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="top|left"
            android:id="@+id/inputText_suffixText"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:maxLines="1"
            android:includeFontPadding="true"
            app:layout_constraintStart_toStartOf="@+id/inputText_EditText"
            app:textInputLayoutFocusedRectEnabled="false"
            style="?attr/internal_textAppearanceBody1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/inputText_prefixIcon"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/inputText_EditText"
            app:layout_constraintEnd_toStartOf="@+id/inputText_prefixText"
            app:layout_constraintStart_toEndOf="@+id/inputText_startPadding"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/inputText_iconsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/inputText_EditText"
            app:layout_constraintEnd_toEndOf="@+id/inputText_endPadding"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/inputText_quickClearIconView"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/uikit_icn_24_cross_circled"
                app:tint="?attr/uikit_colorForeground_30"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/inputText_secondaryIconView"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/inputText_mainIconView"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <com.revolut.core.ui_kit.internal.views.tag.TagView
                android:id="@+id/inputText_tagFirst"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"/>
            <com.revolut.core.ui_kit.internal.views.tag.TagView
                android:id="@+id/inputText_tagSecond"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"/>
            <ProgressBar
                android:id="@+id/inputText_progressBar"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="?attr/uikit_dp32"
                android:layout_height="?attr/uikit_dp32"
                style="?attr/uikit_progressBarPrimary"/>
        </LinearLayout>
    </com.revolut.core.ui_kit.internal.views.input.InputTextFieldContainer>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:id="@+id/inputText_helperStart"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/inputText_helperEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inputText_fieldContainer"
        app:textInputLayoutFocusedRectEnabled="false"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:id="@+id/inputText_helperEnd"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inputText_fieldContainer"
        app:textInputLayoutFocusedRectEnabled="false"
        style="?attr/internal_textAppearanceBody3"/>
</merge>
