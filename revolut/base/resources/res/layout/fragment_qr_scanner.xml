<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <io.fotoapparat.view.CameraView
        android:id="@+id/cameraView"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.ScanView
        android:id="@+id/scanView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="157dp"
        android:layout_marginStart="58dp"
        android:layout_marginEnd="58dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/messageLabelContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:animateLayoutChanges="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scanView">
        <TextView
            android:textColor="?attr/uikit_colorBackground"
            android:layout_gravity="center"
            android:id="@+id/messageLabel"
            android:background="@drawable/message_background"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </FrameLayout>
    <ProgressBar
        android:id="@+id/scannerProgress"
        android:background="?attr/uikit_colorTransparent"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/uikit_colorAccent"
        android:indeterminateTintMode="src_in"
        app:layout_constraintBottom_toTopOf="@+id/scanView"
        app:layout_constraintEnd_toStartOf="@+id/scanView"
        app:layout_constraintStart_toEndOf="@+id/scanView"
        app:layout_constraintTop_toBottomOf="@+id/scanView"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:layout_gravity="top"
        android:id="@+id/navBarWithToolbar"
        android:background="@color/colorTransparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
