<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/screenRecyclerNavbarFooterTwoButtons_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/screenRecyclerNavbarFooterTwoButtons_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/screenRecyclerNavbarFooterTwoButtons_footerContainer"
        android:paddingTop="?attr/uikit_dp16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fitNavigationBar="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp24"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16">
            <com.revolut.core.ui_kit.views.FooterTextView
                android:id="@+id/screenRecyclerNavbarFooterTwoButtons_footerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.revolut.core.ui_kit.views.LargeActionButton
                android:id="@+id/screenRecyclerNavbarFooterTwoButtons_firstButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp16"
                app:uikit_LargeActionButtonStyle="AccentButton"/>
            <com.revolut.core.ui_kit.views.LargeActionButton
                android:id="@+id/screenRecyclerNavbarFooterTwoButtons_secondButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp16"
                app:uikit_LargeActionButtonStyle="AccentButton"/>
        </LinearLayout>
    </com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
