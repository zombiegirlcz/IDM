<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="32dp"
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/ccy"
        android:background="@drawable/deprecated_background_selectable_transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:drawablePadding="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.uicomponent.widgets.material_edit_text.TypefaceMaterialEditText
        android:textSize="32dp"
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="right"
        android:id="@+id/amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="0"
        android:includeFontPadding="false"
        android:digits="0123456789.,"
        android:inputType="numberDecimal"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:met_bottomSpacing="0dp"
        app:met_floatingLabelPadding="0dp"
        app:met_hideUnderline="true"
        app:met_textColor="?attr/uikit_colorForeground"
        app:met_textColorHint="?attr/uikit_colorGreyTone20"/>
    <ImageView
        android:id="@+id/left_hint_info_icon"
        android:background="@drawable/deprecated_background_selectable_transparent"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/left_hint"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/left_hint"
        app:layout_constraintTop_toTopOf="@+id/left_hint"
        app:srcCompat="@drawable/icon_16_outline_info"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="marquee"
        android:id="@+id/left_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:maxWidth="200dp"
        android:singleLine="true"
        app:layout_constraintLeft_toRightOf="@+id/left_hint_info_icon"
        app:layout_constraintTop_toBottomOf="@+id/amount"
        app:layout_goneMarginLeft="2dp"
        style="@style/SubtitleText"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="right"
        android:id="@+id/top_right_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        app:layout_constraintLeft_toRightOf="@+id/left_hint"
        app:layout_constraintRight_toLeftOf="@+id/top_right_hint_info_icon"
        app:layout_constraintTop_toBottomOf="@+id/amount"
        app:layout_goneMarginRight="0dp"
        style="@style/SubtitleText"/>
    <ImageView
        android:id="@+id/top_right_hint_info_icon"
        android:background="@drawable/deprecated_background_selectable_transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/uikit_colorGreyTone50"
        app:layout_constraintBottom_toBottomOf="@+id/top_right_hint"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amount"
        app:layout_constraintTop_toTopOf="@+id/top_right_hint"
        app:srcCompat="@drawable/icon_16_outline_info"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="right"
        android:id="@+id/bottom_right_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/left_hint"
        app:layout_constraintRight_toLeftOf="@+id/bottom_right_hint_info_icon"
        app:layout_constraintTop_toBottomOf="@+id/top_right_hint"
        app:layout_goneMarginRight="0dp"
        app:layout_goneMarginTop="4dp"
        style="@style/SubtitleText"/>
    <ImageView
        android:id="@+id/bottom_right_hint_info_icon"
        android:background="@drawable/deprecated_background_selectable_transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:tint="?attr/uikit_colorGreyTone50"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_right_hint"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_right_hint"
        app:srcCompat="@drawable/icon_16_outline_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
