<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/internal_delegate_cell_details_title"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/cellDetailsTwinButtons_startButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp12"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsTwinButtons_endButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellDetailsTitle_label"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/cellDetailsTwinButtons_endButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cellDetailsTwinButtons_startButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cellDetailsTwinButtons_startButton"
        app:layout_constraintTop_toTopOf="@+id/cellDetailsTwinButtons_startButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
