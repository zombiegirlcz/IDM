<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/internalIdDocumentView_backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/internalIdDocumentView_documentCountryIcon"
        android:padding="@dimen/internal_dp2"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/internal_dp12"
        app:layout_constraintBottom_toBottomOf="@+id/internalIdDocumentView_documentType"
        app:layout_constraintEnd_toStartOf="@+id/internalIdDocumentView_documentType"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalIdDocumentView_documentType"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_documentType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp8"
        android:maxLines="1"
        android:layout_marginStart="@dimen/internal_dp4"
        android:layout_marginEnd="@dimen/internal_dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/internalIdDocumentView_topEndIconBarrier"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_documentCountryIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/internalIdDocumentView_topEndIconBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:barrierMargin="6dp"
        app:constraint_referenced_ids="internalIdDocumentView_logo,internalIdDocumentView_tag"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/internalIdDocumentView_logo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/internal_dp12"
        app:layout_constraintBottom_toBottomOf="@+id/internalIdDocumentView_documentType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalIdDocumentView_documentType"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/internalIdDocumentView_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/internal_dp12"
        app:layout_constraintBottom_toBottomOf="@+id/internalIdDocumentView_documentType"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalIdDocumentView_documentType"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/internalIdDocumentView_headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:barrierMargin="6dp"
        app:constraint_referenced_ids="internalIdDocumentView_documentCountryIcon,internalIdDocumentView_documentType,internalIdDocumentView_tag,internalIdDocumentView_logo"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/internalIdDocumentView_photo"
        android:background="@drawable/internal_background_grey_borders"
        android:layout_width="65dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/internal_dp16"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/internal_dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_headerBarrier"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite_70"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_legalNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:maxLines="1"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_photo"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_headerBarrier"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_legalNameValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/internalIdDocumentView_copyLegalNameIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/internalIdDocumentView_legalNameLabel"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_legalNameLabel"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/internalIdDocumentView_copyLegalNameIcon"
        android:layout_width="@dimen/internal_dp16"
        android:layout_height="@dimen/internal_dp16"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/internalIdDocumentView_legalNameValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_legalNameValue"
        app:layout_constraintTop_toTopOf="@+id/internalIdDocumentView_legalNameValue"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite_70"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_documentNumberLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp12"
        android:maxLines="1"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_photo"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_legalNameValue"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_documentNumberValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/internalIdDocumentView_copyDocumentNumberIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/internalIdDocumentView_documentNumberLabel"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_documentNumberLabel"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/internalIdDocumentView_copyDocumentNumberIcon"
        android:layout_width="@dimen/internal_dp16"
        android:layout_height="@dimen/internal_dp16"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/internalIdDocumentView_documentNumberValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_documentNumberValue"
        app:layout_constraintTop_toTopOf="@+id/internalIdDocumentView_documentNumberValue"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite_70"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_dateOfBirthLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp12"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/internalIdDocumentView_expiresOnLabel"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_photo"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_documentNumberValue"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_dateOfBirthValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:layout_marginBottom="@dimen/internal_dp8"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/internalIdDocumentView_copyDateOfBirthIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/internalIdDocumentView_dateOfBirthLabel"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_dateOfBirthLabel"
        app:layout_constraintVertical_bias="0"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/internalIdDocumentView_copyDateOfBirthIcon"
        android:layout_width="@dimen/internal_dp16"
        android:layout_height="@dimen/internal_dp16"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintBottom_toBottomOf="@+id/internalIdDocumentView_dateOfBirthValue"
        app:layout_constraintEnd_toStartOf="@+id/internalIdDocumentView_expiresOnValue"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_dateOfBirthValue"
        app:layout_constraintTop_toTopOf="@+id/internalIdDocumentView_dateOfBirthValue"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite_70"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_expiresOnLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp12"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_dateOfBirthLabel"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_documentNumberValue"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/internalIdDocumentView_expiresOnValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:layout_marginBottom="@dimen/internal_dp8"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/internalIdDocumentView_copyExpiresOnIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/internalIdDocumentView_expiresOnLabel"
        app:layout_constraintTop_toBottomOf="@+id/internalIdDocumentView_expiresOnLabel"
        app:layout_constraintVertical_bias="0"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/internalIdDocumentView_copyExpiresOnIcon"
        android:layout_width="@dimen/internal_dp16"
        android:layout_height="@dimen/internal_dp16"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/internalIdDocumentView_expiresOnValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalIdDocumentView_expiresOnValue"
        app:layout_constraintTop_toTopOf="@+id/internalIdDocumentView_expiresOnValue"/>
</merge>
