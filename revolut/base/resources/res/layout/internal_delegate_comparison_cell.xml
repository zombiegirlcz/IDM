<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp">
    <View
        android:id="@+id/comparisonCellDelegate_firstHighlightContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toStartOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/comparisonCellDelegate_firstText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_firstSubText"
        app:layout_constraintEnd_toStartOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center"
        android:id="@+id/comparisonCellDelegate_firstSubText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toEndOf="@+id/comparisonCellDelegate_firstText"
        app:layout_constraintStart_toStartOf="@+id/comparisonCellDelegate_firstText"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/comparisonCellDelegate_firstIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toStartOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/comparisonCellDelegate_firstCardImage"
        android:layout_width="80dp"
        android:layout_height="49dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_firstCardText"
        app:layout_constraintEnd_toStartOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/comparisonCellDelegate_firstCardText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toStartOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comparisonCellDelegate_firstCardImage"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.BadgeStatusView
        android:id="@+id/comparisonCellDelegate_firstCardBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_firstCardImage"
        app:layout_constraintEnd_toEndOf="@+id/comparisonCellDelegate_firstCardImage"
        app:layout_constraintStart_toEndOf="@+id/comparisonCellDelegate_firstCardImage"
        app:layout_constraintTop_toTopOf="@+id/comparisonCellDelegate_firstCardImage"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/comparisonCellDelegate_firstCardGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="comparisonCellDelegate_firstCardImage,comparisonCellDelegate_firstCardText,comparisonCellDelegate_firstCardBadge"/>
    <View
        android:id="@+id/comparisonCellDelegate_horizontalDivider"
        android:background="?attr/uikit_colorBackground"
        android:layout_width="@dimen/internal_dp2"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/comparisonCellDelegate_secondHighlightContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/comparisonCellDelegate_secondText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="center"
        android:id="@+id/comparisonCellDelegate_secondIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/comparisonCellDelegate_secondCardImage"
        android:layout_width="80dp"
        android:layout_height="49dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_secondCardText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/comparisonCellDelegate_secondCardText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comparisonCellDelegate_horizontalDivider"
        app:layout_constraintTop_toBottomOf="@+id/comparisonCellDelegate_secondCardImage"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.BadgeStatusView
        android:id="@+id/comparisonCellDelegate_secondCardBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        app:layout_constraintBottom_toTopOf="@+id/comparisonCellDelegate_secondCardImage"
        app:layout_constraintEnd_toEndOf="@+id/comparisonCellDelegate_secondCardImage"
        app:layout_constraintStart_toEndOf="@+id/comparisonCellDelegate_secondCardImage"
        app:layout_constraintTop_toTopOf="@+id/comparisonCellDelegate_secondCardImage"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/comparisonCellDelegate_secondCardGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="comparisonCellDelegate_secondCardImage,comparisonCellDelegate_secondCardText,comparisonCellDelegate_secondCardBadge"/>
    <View
        android:id="@+id/comparisonCellDelegate_bottomDivider"
        android:background="?attr/uikit_colorBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/internal_dp2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
