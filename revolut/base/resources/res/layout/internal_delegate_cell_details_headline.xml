<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/cellDetailsHeadline_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:textAlignment="viewStart"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/cellDetailsHeadline_headline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellDetailsHeadline_title"
        style="?attr/internal_textAppearanceHeading3"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/cellDetailsHeadline_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="@+id/cellDetailsHeadline_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellDetailsHeadline_headline"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginTop="0dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/cellDetailsHeadline_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:lines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cellDetailsHeadline_badge"
        app:layout_constraintTop_toBottomOf="@+id/cellDetailsHeadline_headline"
        app:layout_goneMarginStart="0dp"
        app:layout_goneMarginTop="0dp"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
