<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/challengeSmallCardDelegate_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/challengeSmallCardDelegate_title"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/challengeSmallCardDelegate_tagView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/challengeSmallCardDelegate_image"
        app:layout_constraintTop_toTopOf="@+id/challengeSmallCardDelegate_image"/>
    <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
        android:id="@+id/challengeSmallCardDelegate_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/challengeSmallCardDelegate_image"
        app:layout_constraintTop_toTopOf="@+id/challengeSmallCardDelegate_image"
        app:uikit_circle_badge_size="small"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/challengeSmallCardDelegate_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="3"
        android:lines="3"
        app:layout_constraintBottom_toTopOf="@+id/challengeSmallCardDelegate_points"
        app:layout_constraintEnd_toEndOf="@+id/challengeSmallCardDelegate_image"
        app:layout_constraintStart_toStartOf="@+id/challengeSmallCardDelegate_image"
        app:layout_constraintTop_toBottomOf="@+id/challengeSmallCardDelegate_image"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/challengeSmallCardDelegate_points"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceEmphasis3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
