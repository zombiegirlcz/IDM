<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:background="?attr/uikit_colorBackground"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/chartTracker_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="£0"
        android:lines="1"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="wrap"
        style="?attr/internal_textAppearanceHeading1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/chartTracker_subtitle"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/chartTracker_title"
        app:layout_constraintTop_toBottomOf="@+id/chartTracker_title"
        app:layout_constraintWidth_min="wrap"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/chartTracker_secondSubtitleIcon"
        android:visibility="visible"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@+id/chartTracker_title"
        app:layout_constraintTop_toBottomOf="@+id/chartTracker_subtitle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/chartTracker_secondSubtitle"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lines="1"
        android:layout_marginStart="@dimen/internal_dp4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/chartTracker_secondSubtitleIcon"
        app:layout_constraintTop_toBottomOf="@+id/chartTracker_subtitle"
        app:layout_constraintWidth_min="wrap"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.chart.charttracker.chart.StepChartView
        android:id="@+id/chartTracker_chartView"
        android:background="?attr/uikit_colorBackground"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="29dp"
        app:layout_constraintTop_toBottomOf="@+id/chartTracker_secondSubtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
