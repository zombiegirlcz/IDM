<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/deprecated_background_selectable_transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_56">
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:id="@+id/short_text_view"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="64dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/long_text_view"
        app:layout_constraintTop_toTopOf="@+id/long_text_view"
        app:ttv_typeface="regular"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="16sp"
        android:id="@+id/long_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:minLines="1"
        app:layout_constraintLeft_toRightOf="@+id/short_text_view"
        app:layout_constraintRight_toLeftOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:ttv_typeface="regular"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        app:layout_constraintLeft_toRightOf="@+id/long_text_view"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
