<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/progressionCount_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toStartOf="@+id/progressionCount_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceHeading3"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/progressionCount_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toStartOf="@+id/progressionCount_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressionCount_title"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/progressionCount_titleDescriptionBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="progressionCount_title,progressionCount_description"/>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/progressionCount_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toStartOf="@+id/progressionCount_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressionCount_titleDescriptionBarrier"
        style="?attr/internal_textAppearanceBody3"/>
    <ImageView
        android:id="@+id/progressionCount_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/progressionCount_captionImageBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="progressionCount_caption,progressionCount_image"/>
    <com.revolut.core.ui_kit.views.HorizontalStepsProgressView
        android:id="@+id/progressionCount_progressSteps"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/uikit_dp4"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintTop_toBottomOf="@+id/progressionCount_captionImageBarrier"/>
    <ProgressBar
        android:id="@+id/progressionCount_progressLinear"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/uikit_dp4"
        android:layout_marginTop="?attr/uikit_dp16"
        android:screenReaderFocusable="true"
        app:layout_constraintTop_toBottomOf="@+id/progressionCount_captionImageBarrier"
        style="?android:attr/progressBarStyleHorizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
