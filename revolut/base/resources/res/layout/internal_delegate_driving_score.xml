<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/internal_dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/drivingScore_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toStartOf="@+id/drivingScore_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/drivingScore_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toStartOf="@+id/drivingScore_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drivingScore_title"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceHeading1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/drivingScore_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toStartOf="@+id/drivingScore_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drivingScore_value"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <ImageView
        android:id="@+id/drivingScore_icon"
        android:layout_width="@dimen/internal_dp24"
        android:layout_height="@dimen/internal_dp24"
        app:layout_constraintBottom_toBottomOf="@+id/drivingScore_progress"
        app:layout_constraintEnd_toEndOf="@+id/drivingScore_progress"
        app:layout_constraintStart_toStartOf="@+id/drivingScore_progress"
        app:layout_constraintTop_toTopOf="@+id/drivingScore_progress"/>
    <com.revolut.core.ui_kit.internal.views.LimitProgressBar
        android:id="@+id/drivingScore_progress"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="42dp"
        android:layout_marginBottom="42dp"
        android:layout_marginEnd="@dimen/internal_dp32"
        app:internal_limitArrowVisible="false"
        app:internal_limitProgressBarThickness="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/drivingScore_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/drivingScore_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <View
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
