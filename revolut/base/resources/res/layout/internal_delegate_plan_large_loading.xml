<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/planLargeLoading_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/planLargeLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/planLargeLoading_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="340:240"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/planLargeLoading_tag"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="90dp"
                android:layout_height="24dp"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="@+id/planLargeLoading_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/planLargeLoading_title"/>
            <View
                android:id="@+id/planLargeLoading_title"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="160dp"
                android:layout_height="24dp"
                android:layout_marginTop="?attr/uikit_dp24"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/planLargeLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="88dp"
                android:layout_height="16dp"
                android:layout_marginBottom="?attr/uikit_dp8"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/planLargeLoading_caption"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_goneMarginBottom="?attr/uikit_dp16"/>
            <View
                android:id="@+id/planLargeLoading_caption"
                android:background="@drawable/internal_rectangle_gradient_white"
                android:layout_width="136dp"
                android:layout_height="16dp"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
