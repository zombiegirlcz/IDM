<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.background.AnimatedBackgroundView
        android:id="@+id/screenPlanPricingBottomSheetBeDriven_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/screenPlanPricingBottomSheetBeDriven_contentContainer"
        app:layout_constraintEnd_toEndOf="@+id/screenPlanPricingBottomSheetBeDriven_contentContainer"
        app:layout_constraintStart_toStartOf="@+id/screenPlanPricingBottomSheetBeDriven_contentContainer"
        app:layout_constraintTop_toTopOf="@+id/screenPlanPricingBottomSheetBeDriven_contentContainer"/>
    <com.revolut.kompot.view.ControllerContainerCoordinatorLayout
        android:id="@+id/screenPlanPricingBottomSheetBeDriven_contentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarBottomSheet
            android:id="@+id/screenPlanPricingBottomSheetBeDriven_navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/screenPlanPricingBottomSheetBeDriven_recyclerView"
            android:paddingBottom="@dimen/dp_24"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    </com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
