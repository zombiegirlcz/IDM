<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/internalCardPersonalisationToolbar_recyclerView"
        android:paddingTop="?attr/uikit_dp16"
        android:paddingBottom="?attr/uikit_dp16"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/internalCardPersonalisationToolbar_leftActionBackground"
        android:background="@drawable/internal_background_card_personalisation_toolbar_left_action"
        android:layout_width="60dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/internalCardPersonalisationToolbar_leftActionImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalCardPersonalisationToolbar_leftActionImage"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/internalCardPersonalisationToolbar_leftActionImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/internalCardPersonalisationToolbar_recyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalCardPersonalisationToolbar_recyclerView"/>
    <View
        android:id="@+id/internalCardPersonalisationToolbar_rightActionBackground"
        android:background="@drawable/internal_background_card_personalisation_toolbar_left_action"
        android:layout_width="60dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/internalCardPersonalisationToolbar_rightActionImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalCardPersonalisationToolbar_rightActionImage"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/internalCardPersonalisationToolbar_rightActionImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/internalCardPersonalisationToolbar_recyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalCardPersonalisationToolbar_recyclerView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
