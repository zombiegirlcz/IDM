<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rewardsHubHomeScreen_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithContainer
        android:id="@+id/rewardsHubHomeScreen_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.navbar.MarketingPhotoHeaderContentView
            android:id="@+id/rewardsHubHomeScreen_contentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithContainer>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/rewardsHubHomeScreen_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarOverlappingScrollingViewBehavior"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
