<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.AvatarView
        android:id="@+id/assetSmartTile_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/horizontal_top_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/assetSmartTile_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/horizontal_top_barrier"
        app:layout_constraintEnd_toStartOf="@+id/assetSmartTile_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/horizontal_top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="assetSmartTile_caption,assetSmartTile_icon"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/vertical_center_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/assetSmartTile_chartLoadingView"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_center_guideline"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_top_barrier"
        app:layout_constraintVertical_bias="0.5"/>
    <com.revolut.core.ui_kit.internal.views.chart.LineChartView
        android:id="@+id/assetSmartTile_chart"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_center_guideline"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_top_barrier"
        app:layout_constraintVertical_bias="0.5"/>
    <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/assetSmartTile_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:layout_marginEnd="8dp"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeMinTextSize="@dimen/internal_heading3_text_size"
        android:autoSizeMaxTextSize="@dimen/internal_heading1_text_size"
        app:layout_constraintBottom_toTopOf="@+id/assetSmartTile_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/vertical_center_guideline"
        app:layout_constraintStart_toStartOf="@+id/assetSmartTile_caption"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_top_barrier"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceHeading1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/assetSmartTile_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:textAlignment="viewStart"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vertical_center_guideline"
        app:layout_constraintStart_toStartOf="@+id/assetSmartTile_title"
        app:layout_constraintTop_toBottomOf="@+id/assetSmartTile_title"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceEmphasis2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
