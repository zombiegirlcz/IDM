<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/productSelection_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/productSelection_imageEndBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/productSelection_media"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/productSelection_imageEndBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/productSelection_imageEndBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="end"
        app:constraint_referenced_ids="productSelection_icon, productSelection_media"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/productSelection_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintBottom_toTopOf="@+id/productSelection_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/productSelection_arrowImage"
        app:layout_constraintStart_toEndOf="@+id/productSelection_imageEndBarrier"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/productSelection_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/productSelection_tagsView"
        app:layout_constraintEnd_toEndOf="@+id/productSelection_title"
        app:layout_constraintStart_toStartOf="@+id/productSelection_title"
        app:layout_constraintTop_toBottomOf="@+id/productSelection_title"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.TagsView
        android:id="@+id/productSelection_tagsView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/productSelection_title"
        app:layout_constraintStart_toStartOf="@+id/productSelection_title"
        app:layout_constraintTop_toBottomOf="@+id/productSelection_subtitle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/productSelection_arrowImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="?attr/uikit_colorGreyTone20"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_24_chevron_right"/>
</androidx.constraintlayout.widget.ConstraintLayout>
