<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.background.AnimatedBackgroundView
        android:id="@+id/planRewardsReveal_planBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.background.VideoBackgroundView
        android:id="@+id/planRewardsReveal_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:layout_gravity="top"
        android:id="@+id/planRewardsReveal_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/planRewardsReveal_content"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <com.revolut.core.ui_kit.views.TitleView
            android:id="@+id/planRewardsReveal_titleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="?attr/uikit_dp24"/>
        <com.revolut.core.ui_kit.views.buttons.ActionFooterView
            android:layout_gravity="bottom"
            android:id="@+id/planRewardsReveal_actionFooter"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp32"/>
    </LinearLayout>
    <com.revolut.core.ui_kit.views.FullScreenStateView
        android:id="@+id/planRewardsReveal_errorState"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
