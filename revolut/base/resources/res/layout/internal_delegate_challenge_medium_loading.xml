<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/challengeMediumLoading_boxBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/challengeMediumLoading_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <View
            android:id="@+id/challengeMediumLoading_image"
            android:background="?attr/uikit_shimmerBackgroundCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/challengeMediumLoading_title"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/challengeMediumLoading_subtitle"
            app:layout_constraintTop_toBottomOf="@+id/challengeMediumLoading_image"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/challengeMediumLoading_subtitle"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toTopOf="@+id/challengeMediumLoading_points"
            app:layout_constraintTop_toBottomOf="@+id/challengeMediumLoading_title"/>
        <View
            android:id="@+id/challengeMediumLoading_points"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/challengeMediumLoading_subtitle"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
