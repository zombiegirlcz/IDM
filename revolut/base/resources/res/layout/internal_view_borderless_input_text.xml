<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.input.MaskedTextInputEditText
        android:scrollbarSize="5dp"
        android:scrollbarThumbVertical="@color/internal_color_input_text"
        android:textColor="@color/internal_color_input_text"
        android:gravity="center"
        android:id="@+id/inputText_EditText"
        android:background="@null"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="40dp"
        android:textSelectHandleLeft="@drawable/internal_input_text_select_handle_left"
        android:textSelectHandleRight="@drawable/internal_input_text_select_handle_right"
        android:textSelectHandle="@drawable/internal_input_text_select_handle_middle"
        android:textCursorDrawable="@drawable/internal_input_text_cursor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="128dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textInputLayoutFocusedRectEnabled="false"
        style="?attr/internal_textAppearanceBody1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/inputText_helperStart"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/inputText_helperEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:textInputLayoutFocusedRectEnabled="false"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/inputText_helperEnd"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:textInputLayoutFocusedRectEnabled="false"
        style="?attr/internal_textAppearanceBody3"/>
</merge>
