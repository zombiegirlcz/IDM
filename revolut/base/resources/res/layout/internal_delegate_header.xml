<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.navbar.ConstraintHeaderLayout
        android:id="@+id/headerLayout"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/header_extraClickableArea"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/headerExtraContainer"
            app:layout_constraintEnd_toStartOf="@+id/headerExtraContainer"
            app:layout_constraintStart_toEndOf="@+id/headerLayout_animatedViewContainer"
            app:layout_constraintTop_toTopOf="@+id/headerExtraContainer"/>
        <FrameLayout
            android:gravity="end"
            android:id="@+id/headerExtraContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/headerLayout_animatedViewContainer">
            <FrameLayout
                android:layout_gravity="end|center_vertical"
                android:id="@+id/imageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </com.revolut.core.ui_kit.internal.views.navbar.ConstraintHeaderLayout>
</FrameLayout>
