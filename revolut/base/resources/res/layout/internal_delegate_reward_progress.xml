<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/rewardProgress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.views.CircleStepsView
        android:id="@+id/rewardProgress_circleSteps"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp18"
        android:layout_marginBottom="?attr/uikit_dp4"
        app:layout_constraintBottom_toTopOf="@+id/rewardProgress_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rewardProgress_title"
        app:layout_goneMarginBottom="?attr/uikit_dp0"/>
    <com.revolut.core.ui_kit.views.ProgressWithTextOnSidesView
        android:id="@+id/rewardProgress_progressWithTextOnSides"
        android:paddingBottom="14dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:paddingHorizontal="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/rewardProgress_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rewardProgress_title"
        app:layout_goneMarginBottom="?attr/uikit_dp0"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/rewardProgress_amount"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp18"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/rewardProgress_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rewardProgress_title"
        app:layout_goneMarginBottom="?attr/uikit_dp0"
        style="?attr/internal_textAppearanceHeading3"/>
    <TextView
        android:textColor="?attr/uikit_colorAccent"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/rewardProgress_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceBody3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
