<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:background="@drawable/tdcoreekyc__frame_round_bottom_sheet_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/tdcoreekyc__text_20sp"
        android:textColor="@color/tdcoreekyc__grey500"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tdcoreekyc__margin_32dp"
        android:text="@string/tdcoreekyc__nfcScan_popupTitle_android"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/icon"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="@dimen/tdcoreekyc__margin_24dp"
        android:src="@drawable/tdcoreekyc__icon_nfc_scan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="@dimen/tdcoreekyc__text_13sp"
        android:textColor="@color/tdcoreekyc__grey800"
        android:id="@+id/description"
        android:layout_width="@dimen/tdcoreekyc__bottom_button_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tdcoreekyc__margin_24dp"
        android:minHeight="@dimen/tdcoreekyc__text_40sp"
        android:text="@string/tdcoreekyc__nfcMNScan_popupDescription_android"
        android:minLines="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <Button
        android:id="@+id/cancelScanningButton"
        android:layout_marginTop="@dimen/tdcoreekyc__margin_24dp"
        android:layout_marginBottom="@dimen/tdcoreekyc__margin_24dp"
        android:text="@string/tdcoreekyc__common_popupButton_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"
        style="@style/tdcoreekyc__CancelButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
