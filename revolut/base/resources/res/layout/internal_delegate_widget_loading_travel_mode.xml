<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/travelModeLoading_shimmeringView"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/travelModeLoading_shimmeringTopLabel"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="216dp"
                android:layout_height="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="160dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/travelModeLoading_shimmeringTopLabel"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">
                <View
                    android:id="@+id/travelModeLoading_first_icon"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/travelModeLoading_first_label"
                    app:layout_constraintEnd_toStartOf="@+id/travelModeLoading_second_icon"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"/>
                <View
                    android:id="@+id/travelModeLoading_first_label"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="56dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/travelModeLoading_first_icon"
                    app:layout_constraintStart_toStartOf="@+id/travelModeLoading_first_icon"/>
                <View
                    android:id="@+id/travelModeLoading_second_icon"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/travelModeLoading_second_label"
                    app:layout_constraintEnd_toStartOf="@+id/travelModeLoading_third_icon"
                    app:layout_constraintStart_toEndOf="@+id/travelModeLoading_first_icon"/>
                <View
                    android:id="@+id/travelModeLoading_second_label"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="56dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/travelModeLoading_second_icon"
                    app:layout_constraintStart_toStartOf="@+id/travelModeLoading_second_icon"/>
                <View
                    android:id="@+id/travelModeLoading_third_icon"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/travelModeLoading_third_label"
                    app:layout_constraintEnd_toStartOf="@+id/travelModeLoading_fourth_icon"
                    app:layout_constraintStart_toEndOf="@+id/travelModeLoading_second_icon"/>
                <View
                    android:id="@+id/travelModeLoading_third_label"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="56dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/travelModeLoading_third_icon"
                    app:layout_constraintStart_toStartOf="@+id/travelModeLoading_third_icon"/>
                <View
                    android:id="@+id/travelModeLoading_fourth_icon"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/travelModeLoading_fourth_label"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/travelModeLoading_third_icon"/>
                <View
                    android:id="@+id/travelModeLoading_fourth_label"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="56dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/travelModeLoading_fourth_icon"
                    app:layout_constraintStart_toStartOf="@+id/travelModeLoading_fourth_icon"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
