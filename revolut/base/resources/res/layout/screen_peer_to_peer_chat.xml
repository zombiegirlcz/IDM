<?xml version="1.0" encoding="utf-8"?>
<com.revolut.ui_kit.payments.send_message_transition.SendingMessageAnimationContainerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatScreen_rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:fitNavigationBar="false">
    <com.revolut.core.ui_kit.views.BackgroundWallpaperView
        android:id="@+id/chatScreen_wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/chatScreen_chatContentContainer"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fitNavigationBar="true">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithAvatar
            android:id="@+id/chatScreen_navBar"
            android:background="@drawable/gradient_chat_navbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/chatScreen_warning"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chatScreen_navBar"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/chatScreen_recyclerView"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:splitMotionEvents="false"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/bottomButtonsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chatScreen_topAlignedRecyclerView"
            app:layout_constraintVertical_bias="0"
            app:reverseLayout="true"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatScreen_topAlignedRecyclerView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chatScreen_warning"/>
        <View
            android:id="@+id/chatScreen_bottomBackground"
            android:background="@drawable/gradient_chat_actions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottomButtonsContainer"/>
        <FrameLayout
            android:id="@+id/bottomButtonsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/inputView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chatScreen_recyclerView">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chatScreen_actionButtonsContainer"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <com.revolut.core.ui_kit.internal.views.SmallActionButton
                    android:id="@+id/chatScreen_firstSmallButton"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/chatScreen_secondaryActionButtonSmall"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"/>
                <com.revolut.core.ui_kit.internal.views.SmallActionButton
                    android:id="@+id/chatScreen_secondaryActionButtonSmall"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/chatScreen_sendButtonSmall"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintHorizontal_weight="3"
                    app:layout_constraintStart_toEndOf="@+id/chatScreen_firstSmallButton"/>
                <com.revolut.core.ui_kit.internal.views.SmallActionButton
                    android:id="@+id/chatScreen_sendButtonSmall"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintHorizontal_weight="3"
                    app:layout_constraintStart_toEndOf="@+id/chatScreen_secondaryActionButtonSmall"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.revolut.core.ui_kit.internal.views.SmallActionButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/chatScreen_sendAmountButtonTiny"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </FrameLayout>
        <com.revolut.core.ui_kit.views.ChatInputView
            android:id="@+id/inputView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout>
</com.revolut.ui_kit.payments.send_message_transition.SendingMessageAnimationContainerLayout>
