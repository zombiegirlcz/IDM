<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:background="?attr/uikit_colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <com.revolut.core.ui_kit.views.legacy.LegacyContentContainerLinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fitNavigationBar="true">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:gravity="center"
            android:id="@+id/main_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/TitleTextBlack"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:id="@+id/main_subtitletitle"
            style="@style/SubTitleText"/>
        <com.revolut.core.ui_kit.views.input.InputText
            android:id="@+id/email_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </com.revolut.core.ui_kit.views.legacy.LegacyContentContainerLinearLayout>
</androidx.core.widget.NestedScrollView>
