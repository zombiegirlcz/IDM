<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/travelFlightsBaggageSelectionScreen_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/travelFlightsBaggageSelectionScreen_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/travelFlightsBaggageSelectionScreen_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/travelFlightsBaggageSelectionScreen_footer"
        android:background="@drawable/uikit_bottom_container_gradient"
        android:paddingTop="?attr/uikit_dp16"
        android:paddingBottom="?attr/uikit_dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="?attr/uikit_dp16"
        app:layout_behavior="com.revolut.core.ui_kit.views.scrolling.BottomOverlayPaddingBehavior">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/travelFlightsBaggageSelectionScreen_price"
            android:background="@drawable/travel_flights_baggage_selection_price_background"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="?attr/uikit_dp16">
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:ellipsize="end"
                android:id="@+id/travelFlightsBaggageSelectionScreen_priceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                style="?attr/internal_textAppearanceBody2"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.revolut.core.ui_kit.internal.views.UIKitTextView
                    android:textColor="?attr/uikit_colorForeground"
                    android:id="@+id/travelFlightsBaggageSelectionScreen_pricePoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?attr/internal_textAppearanceEmphasis1"/>
                <com.revolut.core.ui_kit.internal.views.UIKitTextView
                    android:textColor="?attr/uikit_colorForeground"
                    android:id="@+id/travelFlightsBaggageSelectionScreen_priceFiat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?attr/internal_textAppearanceHeading3"/>
                <com.revolut.core.ui_kit.views.ProgressSwitcher
                    android:id="@+id/travelFlightsBaggageSelectionScreen_priceProgress"
                    android:visibility="gone"
                    android:layout_width="?attr/uikit_dp24"
                    android:layout_height="?attr/uikit_dp24"/>
            </LinearLayout>
        </LinearLayout>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/travelFlightsBaggageSelectionScreen_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
    </LinearLayout>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
