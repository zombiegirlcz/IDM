<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/groupChatBalances_recyclerView"
        android:paddingBottom="@dimen/dp_80"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/groupChatBalances_buttonsContainer"
        android:background="?attr/uikit_colorGroupedBackground"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:id="@+id/groupChatBalances_buttonSettle"
            android:visibility="gone"
            android:fitsSystemWindows="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/groupChatBalances_buttonAdd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:id="@+id/groupChatBalances_buttonAdd"
            android:visibility="gone"
            android:fitsSystemWindows="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/groupChatBalances_buttonSettle"
            app:layout_constraintTop_toTopOf="parent"
            app:uikit_SmallActionButtonStyle="AccentButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
