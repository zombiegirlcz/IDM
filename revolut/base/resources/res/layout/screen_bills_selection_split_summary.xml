<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/splitBillSummary_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/splitBillSummary_recyclerView"
        android:paddingBottom="@dimen/dp_120"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/splitBillSummary_bottomContainer"
        android:background="@drawable/uikit_bottom_container_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        app:fitNavigationBar="true">
        <com.revolut.core.ui_kit.views.FooterTextView
            android:gravity="center"
            android:id="@+id/splitBillSummary_footerView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_16"
            app:layout_constraintBaseline_toTopOf="@+id/splitBillSummary_submitButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/splitBillSummary_selectionButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/splitBillSummary_submitButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/splitBillSummary_footerView"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/splitBillSummary_submitButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/splitBillSummary_selectionButton"
            app:layout_constraintTop_toBottomOf="@+id/splitBillSummary_footerView"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
    </com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
