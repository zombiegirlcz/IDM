<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/actionWidgetLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/actionWidgetLoading_imageStart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:srcCompat="@drawable/internal_circle_gradient_grey"/>
            <View
                android:id="@+id/actionWidgetLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="160dp"
                android:layout_height="16dp"
                android:layout_marginTop="19dp"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="55dp"
                app:layout_constraintBottom_toTopOf="@+id/actionWidgetLoading_subtitle"
                app:layout_constraintEnd_toStartOf="@+id/actionWidgetLoading_value"
                app:layout_constraintStart_toEndOf="@+id/actionWidgetLoading_imageStart"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/actionWidgetLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="80dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toTopOf="@+id/actionWidgetLoading_buttonPrimary"
                app:layout_constraintEnd_toEndOf="@+id/actionWidgetLoading_title"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/actionWidgetLoading_title"
                app:layout_constraintTop_toBottomOf="@+id/actionWidgetLoading_title"/>
            <View
                android:id="@+id/actionWidgetLoading_value"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="40dp"
                android:layout_height="16dp"
                android:layout_marginTop="19dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/actionWidgetLoading_buttonPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/actionWidgetLoading_title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"/>
            <com.revolut.core.ui_kit.internal.views.SmallActionButton
                android:id="@+id/actionWidgetLoading_buttonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/actionWidgetLoading_buttonSecondary"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/actionWidgetLoading_subtitle"/>
            <com.revolut.core.ui_kit.internal.views.SmallActionButton
                android:id="@+id/actionWidgetLoading_buttonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/actionWidgetLoading_buttonPrimary"
                app:layout_constraintTop_toBottomOf="@+id/actionWidgetLoading_subtitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout>
