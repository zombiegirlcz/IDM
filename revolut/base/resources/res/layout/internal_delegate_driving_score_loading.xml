<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drivingScoreLoading_shimmeringView"
    android:padding="@dimen/internal_dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/drivingScoreLoading_title"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="72dp"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/internal_dp16"
            android:layout_marginStart="@dimen/internal_dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.6"/>
        <View
            android:id="@+id/drivingScoreLoading_value"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="130dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/internal_dp16"
            android:layout_marginStart="@dimen/internal_dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/drivingScoreLoading_title"
            app:layout_constraintWidth_percent="0.6"/>
        <View
            android:id="@+id/drivingScoreLoading_description"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="97dp"
            android:layout_height="16dp"
            android:layout_marginBottom="@dimen/internal_dp16"
            android:layout_marginStart="@dimen/internal_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.6"/>
        <com.revolut.core.ui_kit.internal.views.LimitProgressBar
            android:id="@+id/drivingScoreLoading_progress"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="42dp"
            android:layout_marginBottom="42dp"
            android:layout_marginEnd="@dimen/internal_dp32"
            app:internal_limitArrowVisible="false"
            app:internal_limitProgressBarThickness="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
