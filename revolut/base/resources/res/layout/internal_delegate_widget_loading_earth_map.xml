<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/earthMapLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/earthMapWidget_shimmering_topLabel"
            android:layout_width="80dp"
            android:layout_height="@dimen/internal_dp24"
            android:layout_marginTop="@dimen/internal_dp16"
            android:layout_marginStart="@dimen/internal_dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringRectView
            android:id="@+id/earthMapWidget_shimmering_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toTopOf="@+id/earthMapWidget_shimmering_stats"
            app:layout_constraintDimensionRatio="311:132"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/earthMapWidget_shimmering_topLabel"
            app:layout_goneMarginBottom="26dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/earthMapWidget_shimmering_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/earthMapWidget_shimmering_image">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/earthMapWidget_shimmering_stat1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
                    android:layout_width="40dp"
                    android:layout_height="24dp"
                    style="?attr/internal_textAppearanceHeading1"/>
                <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
                    android:layout_width="24dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    style="?attr/internal_textAppearanceBody3"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/earthMapWidget_shimmering_stat2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
                    android:layout_width="40dp"
                    android:layout_height="24dp"
                    style="?attr/internal_textAppearanceHeading1"/>
                <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
                    android:layout_width="24dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    style="?attr/internal_textAppearanceBody3"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/earthMapWidget_shimmering_stat3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
                    android:layout_width="40dp"
                    android:layout_height="24dp"
                    style="?attr/internal_textAppearanceHeading1"/>
                <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
                    android:layout_width="24dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    style="?attr/internal_textAppearanceBody3"/>
            </LinearLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
