<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/UiKitThemeOverlay.DefaultWindowBackground"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.kompot.view.ControllerContainerCoordinatorLayout
        android:id="@+id/coordinatorLayout"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fitNavigationBar="false"
        app:fitStatusBar="false">
        <com.revolut.core.ui_kit.background.AnimatedBackgroundView
            android:id="@+id/background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.revolut.core.ui_kit.chat.background.AirChatBackgroundView
            android:id="@+id/airBackground"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/navBarWithToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.core.ui_kit.gesture_control.VerticalSnapLayout
            android:id="@+id/verticalSnapLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior">
            <com.revolut.recyclerkit.ScreenContentRecyclerView
                android:id="@+id/recyclerView"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/promptContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <com.revolut.core.ui_kit.chat.prompt.ChatPromptView
                    android:id="@+id/promptView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.core.widget.NestedScrollView>
        </com.revolut.core.ui_kit.gesture_control.VerticalSnapLayout>
        <com.revolut.core.ui_kit.views.ChatInputLayoutView
            android:layout_gravity="bottom"
            android:id="@+id/inputLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/bottomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Space
            android:layout_gravity="end|top"
            android:id="@+id/fabAnchor"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            app:layout_anchor="@+id/inputLayout"
            app:layout_anchorGravity="end|top"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:layout_gravity="end|top"
            android:id="@+id/fab"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="2dp"
            app:layout_anchor="@+id/fabAnchor"
            app:layout_anchorGravity="end|top"/>
    </com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
