<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbox_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/toolbox_bubble"
        android:layout_width="@dimen/internal_dp0"
        android:layout_height="56dp"
        android:layout_marginBottom="@dimen/internal_dp32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/toolbox_bubbleEnd"
        app:layout_constraintStart_toStartOf="@+id/toolbox_bubbleStart"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/toolbox_recycler"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="40dp"
        android:tint="?attr/uikit_colorBackground"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        android:clipToOutline="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/toolbox_bubbleStart"
        android:layout_width="@dimen/internal_dp0"
        android:layout_height="@dimen/internal_dp0"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintEnd_toStartOf="@+id/toolbox_recycler"/>
    <Space
        android:id="@+id/toolbox_bubbleEnd"
        android:layout_width="@dimen/internal_dp0"
        android:layout_height="@dimen/internal_dp0"
        android:layout_marginStart="@dimen/internal_dp8"
        app:layout_constraintStart_toEndOf="@+id/toolbox_recycler"/>
    <com.revolut.core.ui_kit.views.BubbleTooltipView
        android:id="@+id/toolbox_tooltip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp8"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintBottom_toTopOf="@+id/toolbox_bubble"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
