<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <io.fotoapparat.view.CameraView
        android:id="@+id/profileScanner_cameraView"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.ScanView
        android:id="@+id/profileScanner_scanView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="144dp"
        android:layout_marginStart="58dp"
        android:layout_marginEnd="58dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/profileScanner_messageLabelContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:animateLayoutChanges="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileScanner_scanView">
        <TextView
            android:textColor="?attr/uikit_colorBackground"
            android:layout_gravity="center"
            android:id="@+id/profileScanner_messageLabel"
            android:background="@drawable/message_background"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </FrameLayout>
    <ProgressBar
        android:id="@+id/profileScanner_scannerProgress"
        android:background="?attr/uikit_colorTransparent"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/uikit_colorAccent"
        android:indeterminateTintMode="src_in"
        app:layout_constraintBottom_toBottomOf="@+id/profileScanner_scanView"
        app:layout_constraintEnd_toEndOf="@+id/profileScanner_scanView"
        app:layout_constraintStart_toStartOf="@+id/profileScanner_scanView"
        app:layout_constraintTop_toTopOf="@+id/profileScanner_scanView"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
