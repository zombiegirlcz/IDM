<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/metadataStories_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/metadataStories_content"
        android:background="@drawable/internal_metadata_story_gradient_overlay_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/metadataStories_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/metadataStories_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/metadataStories_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/metadataStories_description"
            app:layout_constraintStart_toStartOf="parent"
            style="?attr/internal_textAppearanceStoriesTitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:id="@+id/metadataStories_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/metadataStories_title"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/metadataStories_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/internal_dp12"
            app:layout_constraintBottom_toTopOf="@+id/metadataStories_buttonContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/metadataStories_description"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/metadataStories_buttonContainer"
            android:paddingBottom="?attr/uikit_dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/metadataStories_recyclerView">
            <com.revolut.core.ui_kit.views.buttons.CollapsingActionButton
                android:layout_gravity="center"
                android:id="@+id/metadataStories_primaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                android:clipToOutline="false"/>
            <com.revolut.core.ui_kit.views.buttons.CollapsingActionButton
                android:layout_gravity="center"
                android:id="@+id/metadataStories_secondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                android:clipToOutline="false"/>
            <com.revolut.core.ui_kit.views.buttons.TwinHorizontalButton
                android:id="@+id/metadataStories_twinHorizontalButton"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.revolut.core.ui_kit.internal.views.BottomSwipeView
        android:id="@+id/metadataStories_bottomSwipeView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
