<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/passcodeScreen_screenContainer"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/passcodeScreen_innerContainer"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.views.navbar.BasicNavBar
            android:id="@+id/passcodeScreen_navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <com.revolut.core.ui_kit.views.pin.PinCodeView
                android:id="@+id/passcodeScreen_passcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
