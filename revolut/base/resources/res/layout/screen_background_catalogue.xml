<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/backgroundCatalogue_navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.Tabs
        android:id="@+id/backgroundCatalogue_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/backgroundCatalogue_pager"
        android:paddingTop="6dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
</com.revolut.kompot.view.ControllerContainerLinearLayout>
