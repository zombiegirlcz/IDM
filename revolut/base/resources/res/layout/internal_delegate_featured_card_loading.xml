<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/featuredCardLoading_shimmerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/uikit_colorWidgetBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/featuredCardLoading_circle"
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/uikit_shimmerBackgroundCircle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/featuredCardLoading_topLabel"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="54dp"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/featuredCardLoading_circle"
            app:srcCompat="?attr/uikit_shimmerBackgroundRect"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/featuredCardLoading_topTitle"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="80dp"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/featuredCardLoading_topLabel"
            app:srcCompat="?attr/uikit_shimmerBackgroundRect"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/featuredCardLoading_bottomLabel"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="54dp"
            android:layout_height="18dp"
            android:layout_marginTop="16dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/featuredCardLoading_topTitle"
            app:srcCompat="?attr/uikit_shimmerBackgroundRect"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/featuredCardLoading_bottomTitle"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="128dp"
            android:layout_height="36dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/featuredCardLoading_bottomLabel"
            app:srcCompat="?attr/uikit_shimmerBackgroundRect"/>
        <com.revolut.core.ui_kit.internal.views.trend.TrendPreviewView
            android:id="@+id/featuredCardLoading_chart"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/featuredCardLoading_bottomTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
