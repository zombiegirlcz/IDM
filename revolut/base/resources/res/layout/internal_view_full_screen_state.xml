<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="104dp"
        android:layout_height="104dp"
        app:layout_constraintBottom_toTopOf="@+id/fullScreenState_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <com.revolut.core.ui_kit.internal.views.box.ShadowLayout
            android:id="@+id/shadowVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.revolut.core.ui_kit.internal.views.videoplayer.UiKitPlayerView
                android:id="@+id/videoPlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.revolut.core.ui_kit.internal.views.box.ShadowLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/regularImageView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.revolut.core.ui_kit.views.OverlappedIconsView
            android:layout_gravity="center"
            android:id="@+id/fullScreenState_overlappedIconsView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/fullScreenState_avatarViewStub"
            android:layout="@layout/internal_view_avatar_stub"
            android:inflatedId="@+id/fullScreenState_avatarView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/fullScreenState_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp8"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constraintBottom_toTopOf="@+id/fullScreenState_caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageContainer"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/fullScreenState_caption"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp8"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constraintBottom_toTopOf="@+id/fullScreenState_smallActionButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullScreenState_title"
        app:layout_goneMarginTop="@dimen/dp_16"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/fullScreenState_smallActionButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/fullScreenState_horizontalButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullScreenState_caption"
        app:layout_goneMarginTop="@dimen/dp_16"
        app:uikit_SmallActionButtonStyle="AccentButton"/>
    <com.revolut.core.ui_kit.views.buttons.TwinHorizontalSmallButton
        android:id="@+id/fullScreenState_horizontalButtons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/fullScreenState_primaryLargeActionButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullScreenState_smallActionButton"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/fullScreenState_primaryLargeActionButton"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/fullScreenState_secondaryLargeActionButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullScreenState_horizontalButtons"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/fullScreenState_secondaryLargeActionButton"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullScreenState_primaryLargeActionButton"
        app:uikit_LargeActionButtonStyle="SemiAccentButton"/>
</merge>
