<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarLargeCentred
        android:id="@+id/reviewProductDetails_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/reviewProductDetails_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.buttons.CollapsingActionButton
        android:layout_gravity="bottom"
        android:id="@+id/reviewProductDetails_collapsingCta"
        android:paddingTop="@dimen/dp_16"
        android:paddingBottom="?attr/uikit_dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="?attr/uikit_dp16"
        app:layout_behavior="com.revolut.core.ui_kit.views.buttons.CollapsibleButtonBehavior"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
