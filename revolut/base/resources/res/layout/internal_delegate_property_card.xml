<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/propertyCard_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/propertyCard_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/propertyCard_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/propertyCard_subtitleImage"
        android:layout_width="wrap_content"
        android:layout_height="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/propertyCard_subtitle"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/propertyCard_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/propertyCard_rating"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/propertyCard_subtitleImage"
        app:layout_constraintTop_toBottomOf="@+id/propertyCard_title"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        app:layout_goneMarginStart="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.RatingCell
        android:id="@+id/propertyCard_rating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginBottom="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/propertyCard_badges"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/propertyCard_subtitle"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        app:layout_goneMarginTop="-8dp"/>
    <com.revolut.core.ui_kit.internal.views.BadgesPanel
        android:id="@+id/propertyCard_badges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/propertyCard_rating"
        app:layout_goneMarginBottom="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
