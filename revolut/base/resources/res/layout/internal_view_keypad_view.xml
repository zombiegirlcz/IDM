<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Button
        android:textColor="@drawable/internal_keypad_text_color"
        android:id="@+id/internalViewKeypadView_button1"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="1"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toStartOf="@+id/internalViewKeypadView_button2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/InternalKeypadNumberButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button2"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="2"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toStartOf="@+id/internalViewKeypadView_button3"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/internalViewKeypadView_button1"
        style="@style/InternalKeypadNumberButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button3"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="3"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/internalViewKeypadView_button2"
        style="@style/InternalKeypadNumberButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button4"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="4"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toStartOf="@+id/internalViewKeypadView_button5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button1"
        style="@style/InternalKeypadNumberButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button5"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="5"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toStartOf="@+id/internalViewKeypadView_button6"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/internalViewKeypadView_button4"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button2"
        style="@style/InternalKeypadNumberButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button6"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="6"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalViewKeypadView_button5"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button3"
        style="@style/InternalKeypadNumberButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button7"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="7"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toStartOf="@+id/internalViewKeypadView_button8"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button4"
        style="@style/InternalKeypadNumberButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button8"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="8"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toStartOf="@+id/internalViewKeypadView_button9"
        app:layout_constraintStart_toEndOf="@+id/internalViewKeypadView_button7"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button5"
        style="@style/InternalKeypadNumberButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button9"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="9"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalViewKeypadView_button8"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button6"
        style="@style/InternalKeypadNumberButton"/>
    <ImageButton
        android:id="@+id/internalViewKeypadView_buttonActionStart"
        android:visibility="invisible"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/internalViewKeypadView_button0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button7"
        style="@style/InternalKeypadActionButton"/>
    <Button
        android:id="@+id/internalViewKeypadView_button0"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="0"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintEnd_toStartOf="@+id/internalViewKeypadView_buttonActionEnd"
        app:layout_constraintStart_toEndOf="@+id/internalViewKeypadView_buttonActionStart"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button8"
        style="@style/InternalKeypadNumberButton"/>
    <ImageButton
        android:id="@+id/internalViewKeypadView_buttonActionEnd"
        android:visibility="invisible"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalViewKeypadView_button0"
        app:layout_constraintTop_toBottomOf="@+id/internalViewKeypadView_button9"
        style="@style/InternalKeypadActionButton"/>
</merge>
