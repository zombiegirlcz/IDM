<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.ui_kit_pdf.PdfView
        android:id="@+id/pdfView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/preview_unavailable_section"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/unavailable_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/legacy_ic_logo_other_country_grey"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_m"
            android:textColor="?attr/uikit_colorAccent"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/unavailable_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/pdf.view.title_unavailable"
            app:ttv_typeface="medium"
            style="@style/TutorialTitleText"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/open_in_browser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pdf.view.subtitle_unavailable"
            app:ttv_typeface="regular"
            style="@style/SubtitleText"/>
    </LinearLayout>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/recyclerView"
        android:background="?attr/uikit_windowBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout>
