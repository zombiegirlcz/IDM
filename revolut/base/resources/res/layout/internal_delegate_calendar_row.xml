<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/calendarRow_dateTitle"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/calendarRow_dateSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceHeading3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50_70"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/calendarRow_dateSubtitle"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calendarRow_dateTitle"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calendarRow_container"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="74dp"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/internal_dp12"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/calendarRow_dateTitle"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/calendarRow_icon"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/calendarRow_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="textStart"
            android:layout_marginStart="@dimen/internal_dp12"
            android:layout_marginEnd="@dimen/internal_dp12"
            app:layout_constraintBottom_toTopOf="@+id/calendarRow_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/calendarRow_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            app:layout_goneMarginStart="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50_70"
            android:ellipsize="end"
            android:id="@+id/calendarRow_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:layout_marginStart="@dimen/internal_dp12"
            android:layout_marginEnd="@dimen/internal_dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/calendarRow_icon"
            app:layout_constraintTop_toBottomOf="@+id/calendarRow_title"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            app:layout_goneMarginStart="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
