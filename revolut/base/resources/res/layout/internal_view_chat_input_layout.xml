<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatInputView_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:currentState="@+id/onlyTextVisible"
    app:layoutDescription="@xml/internal_view_chat_input_layout_motion_scenes">
    <ImageView
        android:id="@+id/chatInputView_startIcon"
        android:background="@drawable/internal_oval_ripple"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/chatInputView_inputContainer"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatInputView_inputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/chatInputView_startIcon"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/chatInputView_topContentWrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/bottomGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="0dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/topGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="40dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/endGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="0dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/startGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="0dp"/>
        <com.revolut.core.ui_kit.views.input.MaskedTextInputEditText
            android:textColor="?attr/uikit_colorForeground"
            android:textColorHint="?attr/uikit_colorGreyTone50"
            android:id="@+id/chatInputView_input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:minHeight="24dp"
            android:maxLines="3"
            android:inputType="textMultiLine"
            android:textCursorDrawable="@drawable/internal_search_bar_cursor"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:allowClickWhenDisabled="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chatInputView_topContentWrapper"
            style="?attr/internal_textAppearanceBody1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chatInputView_leftInnerIcon"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintStart_toStartOf="@+id/startGuideline"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:tint="?attr/uikit_colorGreyTone50"/>
        <com.revolut.core.ui_kit.internal.views.AnimatedImageSwitcher
            android:id="@+id/chatInputView_iconSwitcherPlayPause"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintStart_toEndOf="@+id/chatInputView_iconBin"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"/>
        <com.revolut.core.ui_kit.internal.views.chat.WaveformSeekBarView
            android:id="@+id/chatInputView_waveformSeekBar"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="88dp"
            android:layout_marginEnd="88dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@+id/endGuideline"
            app:layout_constraintStart_toStartOf="@+id/startGuideline"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="none"
            android:gravity="center"
            android:id="@+id/chatInputView_waveformSeekBarTimer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="32dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toStartOf="@+id/chatInputView_iconSwitcher2"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chatInputView_dot"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toStartOf="@+id/chatInputView_timer"
            app:layout_constraintStart_toStartOf="@+id/startGuideline"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chatInputView_iconBin"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toStartOf="@+id/chatInputView_iconSwitcherPlayPause"
            app:layout_constraintStart_toStartOf="@+id/startGuideline"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="none"
            android:id="@+id/chatInputView_timer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintStart_toEndOf="@+id/chatInputView_dot"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/chatInputView_cancelHint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@+id/endGuideline"
            app:layout_constraintStart_toStartOf="@+id/startGuideline"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"
            style="?attr/internal_textAppearanceBody1"/>
        <com.revolut.core.ui_kit.internal.views.chat.RealtimeWaveformView
            android:id="@+id/chatInputView_realtimeWaveform"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="75dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toStartOf="@+id/chatInputView_iconSwitcher2"
            app:layout_constraintStart_toStartOf="@+id/startGuideline"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/chatInputView_holdHint"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@+id/chatInputView_input"
            app:layout_constraintStart_toStartOf="@+id/chatInputView_input"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"
            style="?attr/internal_textAppearanceBody1"/>
        <com.revolut.core.ui_kit.internal.views.AnimatedImageSwitcher
            android:id="@+id/chatInputView_iconSwitcher1"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toStartOf="@+id/chatInputView_iconSwitcher2"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"/>
        <com.revolut.core.ui_kit.internal.views.AnimatedImageSwitcher
            android:id="@+id/chatInputView_iconSwitcher2"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="@+id/endGuideline"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/chatInputView_clear"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/bottomGuideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/topGuideline"
            app:layout_constraintVertical_bias="0.5"
            app:srcCompat="@drawable/uikit_icn_24_cross_circle"
            app:tint="?attr/uikit_colorGreyTone50"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.motion.widget.MotionLayout>
