<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/newProduct_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.CircleProgressBar
        android:id="@+id/newProduct_imageProgress"
        android:visibility="invisible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/newProduct_icon"
        app:layout_constraintEnd_toEndOf="@+id/newProduct_icon"
        app:layout_constraintStart_toStartOf="@+id/newProduct_icon"
        app:layout_constraintTop_toTopOf="@+id/newProduct_icon"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/newProduct_iconBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="newProduct_icon,newProduct_imageProgress"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/newProduct_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/newProduct_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/newProduct_productImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/newProduct_iconBarrier"
        app:layout_constraintVertical_bias="1"
        app:layout_goneMarginBottom="@dimen/internal_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/newProduct_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/newProduct_firstTag"
        app:layout_constraintEnd_toStartOf="@+id/newProduct_productImage"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/newProduct_productImage"
        android:layout_width="106dp"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/newProduct_firstTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/newProduct_secondTag"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/newProduct_secondTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/newProduct_productImage"
        app:layout_constraintStart_toEndOf="@+id/newProduct_firstTag"/>
    <View
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
