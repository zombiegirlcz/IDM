<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cellDetailsNote_topLine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsNote_endLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/cellDetailsNote_startLabel"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cellDetailsNote_startLabelEndImage"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cellDetailsNote_startLabelEndImage"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="?attr/uikit_colorGreyTone50"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cellDetailsNoteDelegate_warningBadge"
            app:layout_constraintStart_toEndOf="@+id/cellDetailsNote_startLabel"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.badge.WarningBadgeView
            android:id="@+id/cellDetailsNoteDelegate_warningBadge"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cellDetailsNote_startLabelEndImage"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.revolut.core.ui_kit.internal.views.LabelView
        android:textAppearance="?attr/internal_textAppearanceEmphasis2"
        android:gravity="end|center_vertical"
        android:id="@+id/cellDetailsNote_endLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/cellDetailsNote_topLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cellDetailsNote_topLine"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_percent="0.5"
        app:textPaddingBottom="12dp"
        app:textPaddingTop="12dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cellDetailsNote_bottomLine"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellDetailsNote_topLine">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/cellDetailsNote_image"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:layout_gravity="center_vertical"
            android:id="@+id/cellDetailsNote_text"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            style="?attr/internal_textAppearanceBody2"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
