<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <com.revolut.uicomponent.widgets.support_edit_text.NoPaddingLeftDrawableTextInputLayout
            android:id="@+id/card_number_text_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:errorEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintEnabled="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.revolut.uicomponent.widgets.support_edit_text.MultipleDrawableMaterialEditText
                android:textSize="@dimen/material_text_size_m"
                android:textColor="?attr/uikit_colorForeground"
                android:textColorHint="?attr/uikit_colorGreyTone20"
                android:id="@+id/card_number_text"
                android:paddingTop="8dp"
                android:nextFocusDown="@+id/card_expiration_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:digits="0123456789"
                android:drawablePadding="16dp"
                android:inputType="textNoSuggestions|number"
                android:imeOptions="actionDone"
                android:autofillHints="creditCardNumber"
                android:importantForAutofill="yes"/>
        </com.revolut.uicomponent.widgets.support_edit_text.NoPaddingLeftDrawableTextInputLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_number_text_wrapper"/>
        <com.revolut.uicomponent.widgets.support_edit_text.RevolutTextInputLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/card_expiration_date_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            app:errorEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintEnabled="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/guideline"
            app:layout_constraintTop_toBottomOf="@+id/card_number_text_wrapper">
            <com.revolut.uicomponent.text.masked.MaskedAppCompatEditText
                android:textSize="@dimen/material_text_size_m"
                android:textColor="?attr/uikit_colorForeground"
                android:textColorHint="?attr/uikit_colorGreyTone20"
                android:id="@+id/card_expiration_date"
                android:nextFocusRight="@+id/card_cvc"
                android:longClickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:inputType="textNoSuggestions|numberDecimal"
                android:imeOptions="actionDone"
                android:autofillHints="creditCardExpirationDate"
                android:importantForAutofill="yes"
                style="@style/RegistrationDateEditor"/>
        </com.revolut.uicomponent.widgets.support_edit_text.RevolutTextInputLayout>
        <com.revolut.uicomponent.widgets.support_edit_text.RevolutTextInputLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/card_cvc_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            app:errorEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintEnabled="true"
            app:layout_constraintLeft_toRightOf="@+id/guideline"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/card_expiration_date_wrapper">
            <com.revolut.uicomponent.widgets.support_edit_text.MultipleDrawableMaterialEditText
                android:textSize="@dimen/material_text_size_m"
                android:textColor="?attr/uikit_colorForeground"
                android:textColorHint="?attr/uikit_colorGreyTone20"
                android:id="@+id/card_cvc"
                android:longClickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:maxLength="3"
                android:digits="0123456789"
                android:drawablePadding="16dp"
                android:inputType="textNoSuggestions|number"
                android:imeOptions="actionDone"
                android:autofillHints="creditCardSecurityCode"
                android:importantForAutofill="yes"/>
        </com.revolut.uicomponent.widgets.support_edit_text.RevolutTextInputLayout>
        <com.revolut.uicomponent.widgets.support_edit_text.RevolutTextInputLayout
            android:id="@+id/card_zip_wrapper"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:errorEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintEnabled="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_expiration_date_wrapper">
            <com.revolut.uicomponent.widgets.support_edit_text.MultipleDrawableMaterialEditText
                android:textSize="@dimen/material_text_size_m"
                android:textColor="?attr/uikit_colorForeground"
                android:textColorHint="?attr/uikit_colorGreyTone20"
                android:id="@+id/card_zip"
                android:visibility="gone"
                android:nextFocusDown="@+id/card_expiration_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:drawablePadding="16dp"
                android:inputType="textNoSuggestions"
                android:privateImeOptions="nm"
                android:imeOptions="actionDone"
                android:autofillHints="postalCode"
                android:importantForAutofill="yes"/>
        </com.revolut.uicomponent.widgets.support_edit_text.RevolutTextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
