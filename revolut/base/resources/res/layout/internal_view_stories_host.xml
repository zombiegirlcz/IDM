<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.revolut.core.ui_kit.internal.views.videoplayer.UiKitPlayerView
        android:id="@+id/storiesHost_backgroundPlayerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/storiesHost_backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/storiesHost_storyContentRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <com.revolut.core.ui_kit.internal.views.stories.StoriesHorizontalStepsProgressView
        android:id="@+id/storiesHost_stepsProgressView"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/storiesHost_iconStart"
        android:padding="8dp"
        android:layout_width="@dimen/internal_dp32"
        android:layout_height="@dimen/internal_dp32"
        android:layout_marginTop="@dimen/internal_dp4"
        android:tint="?attr/uikit_colorWhite"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/storiesHost_stepsProgressView"
        app:srcCompat="@drawable/uikit_icn_16_revolut"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/storiesHost_customIconStart"
        android:padding="8dp"
        android:layout_width="@dimen/internal_dp32"
        android:layout_height="@dimen/internal_dp32"
        android:layout_marginTop="@dimen/internal_dp8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/storiesHost_stepsProgressView"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iconClose"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:layout_width="@dimen/internal_dp32"
        android:layout_height="@dimen/internal_dp32"
        android:tint="?attr/uikit_colorWhite"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/storiesHost_iconStart"
        app:srcCompat="@drawable/uikit_icn_24_cross"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorWhite"
        android:id="@+id/storiesHost_titleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/storiesHost_iconStart"
        app:layout_constraintLeft_toRightOf="@+id/storiesHost_iconStart"
        app:layout_constraintRight_toLeftOf="@+id/iconClose"
        app:layout_constraintTop_toTopOf="@+id/storiesHost_iconStart"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/storiesHost_titleShimmer"
        android:visibility="invisible"
        android:layout_width="120dp"
        android:layout_height="@dimen/internal_dp16"
        android:layout_marginLeft="@dimen/internal_dp8"
        android:layout_marginTop="@dimen/internal_dp12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/storiesHost_stepsProgressView">
        <View
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/storiesHost_titleView"/>
</merge>
