<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/triDetails_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/triDetails_startLabelImages"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_startLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startLabel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/triDetails_startLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_endLabel"
        app:layout_constraintStart_toEndOf="@+id/triDetails_startLabelImages"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/triDetails_endLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_endLabelImage"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startLabel"
        app:layout_goneMarginEnd="0dp"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/triDetails_endLabelImage"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_endLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/triDetails_endLabel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/triDetails_startHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:layout_marginEnd="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_middleLabel"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/triDetails_startLabel"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/triDetails_startHeadingImage"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_startHeading"
        app:layout_constraintStart_toEndOf="@+id/triDetails_startHeading"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startHeading"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/triDetails_startLineOfDots"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_startHeading"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_middleLabel"
        app:layout_constraintStart_toEndOf="@+id/triDetails_startHeadingImage"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startHeading"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/triDetails_middleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_endHeading"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_endHeading"
        app:layout_constraintStart_toEndOf="@+id/triDetails_startHeading"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startHeading"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/triDetails_endLineOfDots"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_endHeading"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_endHeadingImage"
        app:layout_constraintStart_toEndOf="@+id/triDetails_middleLabel"
        app:layout_constraintTop_toTopOf="@+id/triDetails_endHeading"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/triDetails_endHeadingImage"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_endHeading"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_endHeading"
        app:layout_constraintTop_toTopOf="@+id/triDetails_endHeading"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/triDetails_endHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_endSuperscriptHeading"
        app:layout_constraintStart_toEndOf="@+id/triDetails_middleLabel"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startHeading"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/triDetails_endSuperscriptHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tripDetails_endHeading"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startHeading"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/triDetails_startSubHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_middleBottomLabel"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/triDetails_startHeading"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/triDetails_middleBottomLabel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_middleLabel"
        app:layout_constraintStart_toEndOf="@+id/triDetails_middleLabel"
        app:layout_constraintTop_toBottomOf="@+id/triDetails_startHeading"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/triDetails_endSubHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/triDetails_middleBottomLabel"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startSubHeading"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/triDetails_startFooterFirstSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_endFooterFirstSubtitle"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/triDetails_startSubHeading"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/triDetails_endFooterFirstSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/triDetails_startFooterFirstSubtitle"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startFooterFirstSubtitle"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/triDetails_startFooterSecondSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_endFooterSecondSubtitle"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/triDetails_startFooterFirstSubtitle"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/triDetails_endFooterSecondSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/triDetails_startFooterSecondSubtitle"
        app:layout_constraintTop_toTopOf="@+id/triDetails_startFooterSecondSubtitle"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/triDetails_priceFooterStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_priceFooterPointsAmount"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_priceFooterPointsAmount"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/triDetails_priceFooterPointsAmount"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/triDetails_priceFooterPointsAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/triDetails_priceFooterFiat"
        app:layout_constraintEnd_toStartOf="@+id/triDetails_priceFooterFiat"
        app:layout_constraintStart_toEndOf="@+id/triDetails_priceFooterStart"
        app:layout_constraintTop_toTopOf="@+id/triDetails_priceFooterFiat"
        app:layout_goneMarginTop="6dp"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/triDetails_priceFooterFiat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp2"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/triDetails_priceFooterPointsAmount"
        app:layout_constraintTop_toBottomOf="@+id/triDetails_startFooterSecondSubtitle"
        style="?attr/internal_textAppearanceHeading3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
