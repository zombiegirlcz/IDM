<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="136dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/learnCard_guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/internal_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/learnCard_guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/internal_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/learnCard_guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/internal_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/learnCard_guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/internal_dp16"/>
    <com.revolut.core.ui_kit.internal.views.RatingBar
        android:id="@+id/learnCard_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:internal_fsrb_background_color="?attr/uikit_colorAccent"
        app:internal_fsrb_background_star_filled="false"
        app:internal_fsrb_gap="12dp"
        app:internal_fsrb_half_star_step="false"
        app:internal_fsrb_rating_color="?attr/uikit_colorAccent"
        app:internal_fsrb_star_size="24dp"
        app:layout_constraintStart_toEndOf="@+id/learnCard_guidelineStart"
        app:layout_constraintTop_toTopOf="@+id/learnCard_guidelineTop"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/learnCard_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/internal_dp8"
        android:layout_marginBottom="@dimen/internal_dp4"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/learnCard_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/learnCard_Image"
        app:layout_constraintStart_toStartOf="@+id/learnCard_guidelineStart"
        app:layout_constraintTop_toBottomOf="@+id/learnCard_progress"
        app:layout_goneMarginBottom="0dp"
        app:layout_goneMarginTop="0dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/learnCard_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp8"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/learnCard_guidelineBottom"
        app:layout_constraintEnd_toStartOf="@+id/learnCard_Image"
        app:layout_constraintStart_toStartOf="@+id/learnCard_guidelineStart"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/learnCard_Image"
        android:layout_width="106dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/learnCard_ImageOverlay"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/learnCard_Image"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/internal_view_locked_overlay"/>
    <View
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
