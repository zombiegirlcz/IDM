<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="148dp">
    <com.revolut.core.ui_kit.internal.views.chart.ChartHeaderView
        android:id="@+id/complexEmptyChartDelegate_headerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/chart_switcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/complexEmptyChartDelegate_headerView">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/complexEmptyChartDelegate_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="?attr/uikit_colorGreyTone20"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/internal_greyTone20"
            android:gravity="center"
            android:id="@+id/complexEmptyChartDelegate_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
