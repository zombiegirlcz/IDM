<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/promotionalMediumTileLoading_shimmeringView"
    android:layout_width="match_parent"
    android:layout_height="164dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/promotionalMediumTileLoading_contentLayout"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/promotionalMediumTileLoading_title"
            android:background="@drawable/internal_rectangle_gradient_white"
            android:layout_width="142dp"
            android:layout_height="24dp"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/promotionalMediumTileLoading_contentArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.7"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
