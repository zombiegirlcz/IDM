<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarRoot"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_scrollFlags="exitUntilCollapsed|scroll">
    <com.revolut.core.ui_kit.internal.views.navbar.ConstraintHeaderLayout
        android:id="@+id/headerLayout"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
            android:orientation="horizontal"
            android:id="@+id/headerExtraContainer"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/headerLayout_chevronTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/headerLayout_chevronTextView"/>
        <com.revolut.core.ui_kit.internal.views.navbar.SearchView
            android:id="@+id/searchView"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/headerLayout_chevronTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/headerLayout_chevronTextView"/>
        <com.revolut.core.ui_kit.views.buttons.SearchButton
            android:id="@+id/navBar_searchButton"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerLayout_secondDescriptionText"/>
        <com.revolut.core.ui_kit.views.ActionsView
            android:id="@+id/navBar_actionsView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBar_searchButton"/>
    </com.revolut.core.ui_kit.internal.views.navbar.ConstraintHeaderLayout>
</com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout>
