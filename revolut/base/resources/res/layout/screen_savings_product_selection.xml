<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/selectFlexibleAccount_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.DraggableTabsView
            android:id="@+id/selectFlexibleAccount_tabsView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/uikit_dp16"
            android:layout_marginTop="?attr/uikit_dp8"
            android:layout_marginRight="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp8"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/selectFlexibleAccount_viewPager"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.buttons.ActionFooterView
        android:layout_gravity="bottom"
        android:id="@+id/selectFlexibleAccount_actionFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.revolut.core.ui_kit.views.buttons.CollapsibleButtonBehavior"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
