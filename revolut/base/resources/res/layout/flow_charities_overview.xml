<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/charitiesOverviewFlow_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/charitiesOverviewFlow_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/charitiesOverviewFlow_pager"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.FloatingBottomBarView
        android:layout_gravity="bottom"
        android:id="@+id/charitiesOverviewFlow_floatingBottomBarView"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
