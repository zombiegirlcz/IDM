<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/projectionChartLoading_Shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/projectionChartLoading_description"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.48"/>
            <View
                android:id="@+id/projectionChartLoading_leftLegend1"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/projectionChartLoading_description"
                app:layout_constraintWidth_percent="0.23"/>
            <View
                android:id="@+id/projectionChartLoading_leftLegend2"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@+id/projectionChartLoading_leftLegend1"
                app:layout_constraintTop_toBottomOf="@+id/projectionChartLoading_leftLegend1"
                app:layout_constraintWidth_percent="0.11"/>
            <View
                android:id="@+id/projectionChartLoading_rightLegend1"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginStart="32dp"
                app:layout_constraintStart_toEndOf="@+id/projectionChartLoading_leftLegend1"
                app:layout_constraintTop_toTopOf="@+id/projectionChartLoading_leftLegend1"
                app:layout_constraintWidth_percent="0.23"/>
            <View
                android:id="@+id/projectionChartLoading_rightLegend2"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@+id/projectionChartLoading_rightLegend1"
                app:layout_constraintTop_toBottomOf="@+id/projectionChartLoading_rightLegend1"
                app:layout_constraintWidth_percent="0.11"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.revolut.core.ui_kit.internal.views.fanchart.CurvedFanChartView
        android:id="@+id/projectionChartLoading_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="182dp"/>
</LinearLayout>
