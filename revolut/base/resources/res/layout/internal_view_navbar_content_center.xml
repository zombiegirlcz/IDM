<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/navbarContentCenter_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/internal_textAppearanceBody2"
                android:id="@+id/navbarContentCenter_shimmerTitle"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/navbarContentCenter_shimmerMainText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.revolut.core.ui_kit.internal.views.animated_numbers.AnimatedNumbersView
                android:id="@+id/navbarContentCenter_shimmerMainText"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/navbarContentCenter_shimmerSubtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/navbarContentCenter_shimmerTitle"/>
            <TextView
                android:textAppearance="?attr/internal_textAppearanceBody2"
                android:id="@+id/navbarContentCenter_shimmerSubtitle"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/navbarContentCenter_shimmerSmallActionButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/navbarContentCenter_shimmerMainText"/>
            <View
                android:id="@+id/navbarContentCenter_shimmerSmallActionButton"
                android:layout_width="95dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/navbarContentCenter_shimmerSubtitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navbarContentCenter_contentLayout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <com.revolut.core.ui_kit.internal.views.LabelView
            android:textAppearance="?attr/internal_textAppearanceBody2"
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center"
            android:id="@+id/navbarContentCenter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconPadding="8dp"
            app:layout_constraintBottom_toTopOf="@+id/navbarContentCenter_mainText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.revolut.core.ui_kit.internal.views.animated_numbers.AnimatedNumbersView
            android:id="@+id/navbarContentCenter_mainText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/navbarContentCenter_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/navbarContentCenter_mainTextIcon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navbarContentCenter_title"/>
        <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
            android:ellipsize="end"
            android:gravity="top|center_horizontal"
            android:id="@+id/navbarContentCenter_mainText_static"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="@dimen/internal_H0_Rev10_text_size"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/navbarContentCenter_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/navbarContentCenter_mainTextIcon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navbarContentCenter_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navbarContentCenter_mainTextIcon"
            android:visibility="gone"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:baselineAlignBottom="true"
            android:layout_marginStart="@dimen/internal_dp4"
            app:layout_constraintBaseline_toBaselineOf="@+id/navbarContentCenter_mainText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/navbarContentCenter_mainText"/>
        <TextView
            android:gravity="center_horizontal"
            android:id="@+id/navbarContentCenter_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/navbarContentCenter_smallActionButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navbarContentCenter_mainText"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:layout_gravity="center"
            android:id="@+id/navbarContentCenter_smallActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toTopOf="@+id/navbarContentCenter_countDownTimerStub"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navbarContentCenter_subtitle"
            app:layout_constraintWidth_max="240dp"/>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/navbarContentCenter_smallActionButtonTag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            app:layout_constraintEnd_toEndOf="@+id/navbarContentCenter_smallActionButton"
            app:layout_constraintTop_toTopOf="@+id/navbarContentCenter_smallActionButton"/>
        <ViewStub
            android:id="@+id/navbarContentCenter_countDownTimerStub"
            android:layout="@layout/internal_view_count_down_timer_view"
            android:inflatedId="@+id/navbarContentCenter_countDownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navbarContentCenter_smallActionButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
