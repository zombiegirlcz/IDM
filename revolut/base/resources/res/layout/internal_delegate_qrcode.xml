<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qrCode_boxContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/qrCode_container"
        android:paddingTop="@dimen/internal_dp16"
        android:paddingBottom="@dimen/internal_dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/qrCode_logo"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter"
            android:forceDarkAllowed="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/qrCode_image"
            android:visibility="gone"
            android:layout_width="228dp"
            android:layout_height="228dp"
            android:layout_marginTop="@dimen/internal_dp12"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/internal_dp32"
            android:layout_marginEnd="@dimen/internal_dp32"
            app:layout_constraintBottom_toTopOf="@+id/qrCode_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qrCode_logo"
            app:layout_goneMarginBottom="@dimen/internal_dp16"
            app:layout_goneMarginTop="@dimen/internal_dp16"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center"
            android:id="@+id/qrCode_emptyStateTitle"
            android:visibility="gone"
            android:layout_width="228dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/internal_dp64"
            android:layout_marginBottom="@dimen/internal_dp8"
            app:layout_constraintBottom_toTopOf="@+id/qrCode_emptyStateSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qrCode_logo"
            app:layout_goneMarginBottom="@dimen/internal_dp64"
            app:layout_goneMarginTop="@dimen/internal_dp16"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="center"
            android:id="@+id/qrCode_emptyStateSubtitle"
            android:visibility="gone"
            android:layout_width="228dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/internal_dp64"
            app:layout_constraintBottom_toTopOf="@+id/qrCode_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qrCode_emptyStateTitle"
            app:layout_goneMarginBottom="@dimen/internal_dp16"
            style="?attr/internal_textAppearanceBody1"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/qrCode_stateBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="qrCode_image, qrCode_emptyStateSubtitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center"
            android:id="@+id/qrCode_text"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/internal_dp8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qrCode_stateBottomBarrier"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="center"
            android:id="@+id/qrCode_caption"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/internal_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qrCode_text"
            style="?attr/internal_textAppearanceBody2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/qrCode_overlayContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/qrCode_overlayImage"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center"
            android:id="@+id/qrCode_overlayText"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/internal_dp16"
            android:layout_marginStart="@dimen/internal_dp24"
            android:layout_marginEnd="@dimen/internal_dp24"
            app:layout_constraintBottom_toTopOf="@+id/qrCode_overlayCaption"
            app:layout_constraintEnd_toEndOf="@+id/qrCode_overlayImage"
            app:layout_constraintHeight="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/qrCode_overlayImage"
            app:layout_constraintTop_toTopOf="@+id/qrCode_overlayImage"
            app:layout_constraintVertical_chainStyle="packed"
            style="?attr/internal_textAppearanceHeading2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="center"
            android:id="@+id/qrCode_overlayCaption"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/internal_dp24"
            android:layout_marginEnd="@dimen/internal_dp24"
            app:layout_constraintBottom_toBottomOf="@+id/qrCode_overlayImage"
            app:layout_constraintEnd_toEndOf="@+id/qrCode_overlayImage"
            app:layout_constraintHeight="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/qrCode_overlayImage"
            app:layout_constraintTop_toBottomOf="@+id/qrCode_overlayText"
            style="?attr/internal_textAppearanceBody2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
