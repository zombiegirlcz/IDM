<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/dateOfBirthScreen_navBarWithToolbarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dateOfBirthScreen_scrollView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.revolut.core.ui_kit.views.input.InputText
                android:id="@+id/dateOfBirthScreen_dateOfBirthView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"/>
            <com.revolut.core.ui_kit.views.DateInputView
                android:id="@+id/dateOfBirthScreen_dateInput"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.revolut.core.ui_kit.views.buttons.ActionFooterView
        android:layout_gravity="bottom"
        android:id="@+id/dateOfBirthScreen_actionButtonView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.revolut.core.ui_kit.views.buttons.CollapsibleButtonBehavior"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
