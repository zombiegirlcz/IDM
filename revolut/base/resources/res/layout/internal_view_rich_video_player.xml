<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.revolut.core.ui_kit.internal.views.videoplayer.UiKitPlayerView
        android:id="@+id/richVideoPlayer_backgroundPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/richVideoPlayer_headerGradient"
        android:background="@drawable/internal_background_gradient_fullscreen_player_header"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/richVideoPlayer_controlsGradient"
        android:background="@drawable/internal_background_gradient_fullscreen_player_controls"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/richVideoPlayer_progressImage"
        android:visibility="gone"
        android:layout_width="@dimen/internal_dp24"
        android:layout_height="@dimen/internal_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.fullscreenheader.InternalFullscreenHeaderView
        android:id="@+id/richVideoPlayer_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/internal_dp32"
        android:layout_marginTop="@dimen/internal_dp8"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.CaptionsView
        android:id="@+id/richVideoPlayer_captionsView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp72"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_percent="@dimen/internal_fullscreen_video_player_captions_width_percentage"/>
    <com.revolut.core.ui_kit.views.CaptionsView
        android:id="@+id/richVideoPlayer_captionsErrorView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp72"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.richvideoplayer.RichVideoPlayerControlsView
        android:id="@+id/richVideoPlayer_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
