<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/qrCodeLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center"
                android:id="@+id/qrCodeLoading_qrCodeView"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="228dp"
                android:layout_height="228dp"
                android:layout_marginTop="@dimen/internal_dp32"
                android:layout_marginBottom="@dimen/internal_dp16"
                android:layout_marginStart="@dimen/internal_dp32"
                android:layout_marginEnd="@dimen/internal_dp32"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_gravity="center"
                android:id="@+id/qrCodeLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="176dp"
                android:layout_height="14dp"
                android:layout_marginBottom="@dimen/internal_dp16"
                style="?attr/internal_textAppearanceEmphasis2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_gravity="center"
                android:id="@+id/qrCodeLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="80dp"
                android:layout_height="14dp"
                android:layout_marginBottom="@dimen/internal_dp16"
                style="?attr/internal_textAppearanceBody2"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
