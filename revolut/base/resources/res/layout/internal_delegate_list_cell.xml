<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/internalDelegateListCell_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/internalDelegateListCell_bulletNumber"
        android:background="@drawable/internal_circle_2dp_foreground"
        android:paddingBottom="2sp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/internalDelegateListCell_iconBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="internalDelegateListCell_icon, internalDelegateListCell_bulletNumber"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/internalDelegateListCell_titleSmall"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/internalDelegateListCell_valueStartBarrier"
        app:layout_constraintStart_toEndOf="@+id/internalDelegateListCell_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/internalDelegateListCell_titleNormal"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/internalDelegateListCell_valueStartBarrier"
        app:layout_constraintStart_toEndOf="@+id/internalDelegateListCell_iconBarrier"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/internalDelegateListCell_titleTopBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="internalDelegateListCell_titleNormal, internalDelegateListCell_titleSmall"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/internalDelegateListCell_titleBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="internalDelegateListCell_titleNormal, internalDelegateListCell_titleSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorBackground"
        android:id="@+id/internalDelegateListCell_badge"
        android:background="@drawable/internal_list_cell_badge_background"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/internalDelegateListCell_titleBottomBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalDelegateListCell_titleTopBarrier"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorActionPhotoHeaderText"
        android:id="@+id/internalDelegateListCell_action"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/internalDelegateListCell_titleBottomBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/internalDelegateListCell_titleTopBarrier"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/internalDelegateListCell_valueStartBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="internalDelegateListCell_badge, internalDelegateListCell_action"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/internalDelegateListCell_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalDelegateListCell_iconBarrier"
        app:layout_constraintTop_toBottomOf="@+id/internalDelegateListCell_titleBottomBarrier"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
