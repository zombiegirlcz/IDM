<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/doubleTagView_primaryTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/doubleTagView_tagSign"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="?attr/uikit_dp0"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/doubleTagView_tagSign"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="@+id/doubleTagView_primaryTag"
        app:layout_constraintEnd_toStartOf="@+id/doubleTagView_secondaryTag"
        app:layout_constraintStart_toEndOf="@+id/doubleTagView_primaryTag"
        app:layout_constraintTop_toTopOf="@+id/doubleTagView_primaryTag"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/doubleTagView_secondaryTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/doubleTagView_tagSign"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
