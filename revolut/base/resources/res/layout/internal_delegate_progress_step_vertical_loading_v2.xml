<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/progressStepVerticalLoadingV2_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/progressStepVerticalLoadingV2_dot"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/progressStepVerticalLoadingV2_line"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="@dimen/internal_dp4"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/progressStepVerticalLoadingV2_dot"
            app:layout_constraintStart_toStartOf="@+id/progressStepVerticalLoadingV2_dot"
            app:layout_constraintTop_toBottomOf="@+id/progressStepVerticalLoadingV2_dot"/>
        <TextView
            android:id="@+id/progressStepVerticalLoadingV2_title"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="18dp"
            app:layout_constraintStart_toEndOf="@+id/progressStepVerticalLoadingV2_dot"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.55"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <TextView
            android:id="@+id/progressStepVerticalLoadingV2_subtitle"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/progressStepVerticalLoadingV2_title"
            app:layout_constraintTop_toBottomOf="@+id/progressStepVerticalLoadingV2_title"
            app:layout_constraintWidth_percent="0.27"
            style="?attr/internal_textAppearanceBody2"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
