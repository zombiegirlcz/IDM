<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/summaryLoading_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/uikit_dp8"
    android:layout_marginBottom="?attr/uikit_dp8"
    android:layout_marginStart="?attr/uikit_dp16"
    android:layout_marginEnd="?attr/uikit_dp16">
    <View
        android:id="@+id/summaryLoading_imageShimmer"
        android:background="?attr/uikit_shimmerBackgroundCircle"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/internal_summary_card_vertical_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/summaryLoading_titleShimmer"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="190dp"
        android:layout_height="24dp"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryLoading_imageShimmer"/>
    <View
        android:id="@+id/summaryLoading_descriptionShimmerLine1"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="244dp"
        android:layout_height="16dp"
        android:layout_marginTop="?attr/uikit_dp12"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryLoading_titleShimmer"/>
    <View
        android:id="@+id/summaryLoading_descriptionShimmerLine2"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="96dp"
        android:layout_height="16dp"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryLoading_descriptionShimmerLine1"/>
    <View
        android:id="@+id/summaryLoading_primaryValueShimmer"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="40dp"
        android:layout_height="16dp"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/summaryLoading_primaryLabelShimmer"
        app:layout_constraintEnd_toStartOf="@+id/summaryLoading_infosShimmerDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/summaryLoading_infosShimmerDivider"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/summaryLoading_primaryLabelShimmer"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="52dp"
        android:layout_height="16dp"
        android:layout_marginTop="?attr/uikit_dp4"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="@+id/summaryLoading_infosShimmerDivider"
        app:layout_constraintEnd_toStartOf="@+id/summaryLoading_infosShimmerDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryLoading_primaryValueShimmer"/>
    <View
        android:id="@+id/summaryLoading_infosShimmerDivider"
        android:background="?attr/uikit_shimmerBackgroundRectSquared"
        android:layout_width="1dp"
        android:layout_height="58dp"
        android:layout_marginTop="?attr/uikit_dp32"
        android:layout_marginBottom="@dimen/internal_summary_card_vertical_padding"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryLoading_descriptionShimmerLine2"/>
    <View
        android:id="@+id/summaryLoading_secondaryValueShimmer"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="52dp"
        android:layout_height="16dp"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintBottom_toTopOf="@+id/summaryLoading_secondaryLabelShimmer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/summaryLoading_infosShimmerDivider"
        app:layout_constraintTop_toTopOf="@+id/summaryLoading_infosShimmerDivider"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/summaryLoading_secondaryLabelShimmer"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="52dp"
        android:layout_height="16dp"
        android:layout_marginTop="?attr/uikit_dp4"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="@+id/summaryLoading_infosShimmerDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/summaryLoading_infosShimmerDivider"
        app:layout_constraintTop_toBottomOf="@+id/summaryLoading_secondaryValueShimmer"/>
</com.facebook.shimmer.ShimmerConstraintLayout>
