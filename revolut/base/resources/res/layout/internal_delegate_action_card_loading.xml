<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/actionCardLoading_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/actionCardLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/actionCardLoading_constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/actionCardLoading_cardBackground"
                android:background="@drawable/uikit_shape_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="?attr/uikit_colorShimmer"
                app:layout_constraintBottom_toTopOf="@+id/actionCardLoading_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/actionCardLoading_title"
                android:background="@drawable/internal_background_rounded_gray"
                android:layout_width="62dp"
                android:layout_height="@dimen/internal_dp16"
                android:layout_marginTop="@dimen/internal_dp12"
                android:layout_marginBottom="@dimen/internal_dp8"
                android:backgroundTint="?attr/uikit_colorShimmer"
                app:layout_constraintBottom_toTopOf="@+id/actionCardLoading_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/actionCardLoading_cardBackground"/>
            <View
                android:id="@+id/actionCardLoading_subtitle"
                android:background="@drawable/internal_background_rounded_gray"
                android:layout_width="32dp"
                android:layout_height="@dimen/internal_dp16"
                android:backgroundTint="?attr/uikit_colorShimmer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/actionCardLoading_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
