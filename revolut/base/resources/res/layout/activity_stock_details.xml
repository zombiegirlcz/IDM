<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stockDetails_root"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.pager.RevolutViewPager
        android:id="@+id/stockDetails_viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/stockDetails_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.Tabs
            android:id="@+id/stockDetails_tabs"
            android:paddingTop="?attr/uikit_dp8"
            android:paddingBottom="?attr/uikit_dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="?attr/uikit_dp16"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar>
    <com.revolut.core.ui_kit.views.buttons.TwinHorizontalButton
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:id="@+id/stockDetails_buySellPanel"
        android:background="@drawable/uikit_bottom_container_gradient"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerCoordinatorLayout>
