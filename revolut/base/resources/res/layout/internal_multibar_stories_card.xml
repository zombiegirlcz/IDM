<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/multibarStories_topSpacing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.DynamicHeightAutosizeTextView
        android:textColor="?attr/uikit_colorWhite"
        android:id="@+id/multibarStories_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multibarStories_topSpacing"
        style="?attr/internal_textAppearanceStoriesTitle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorWhite"
        android:id="@+id/multibarStories_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multibarStories_title"
        style="?attr/internal_textAppearanceStoriesSubtitle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorWhite"
        android:id="@+id/multibarStories_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multibarStories_subtitle"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <View
        android:id="@+id/multibarStories_titleOverlayBottom"
        android:layout_width="0dp"
        android:layout_height="200dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multibarStories_multiBarView"/>
    <com.revolut.core.ui_kit.internal.views.multibar.MultiBarView
        android:id="@+id/multibarStories_multiBarView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/internal_story_multibar_height"
        android:layout_margin="24dp"
        app:internal_barGap="24dp"
        app:internal_barWidth="34dp"
        app:internal_hideTooltipOnOverlap="false"
        app:internal_marksSubtitleSize="12sp"
        app:internal_marksTextColor="?attr/uikit_colorWhite_80"
        app:internal_marksTextSize="12dp"
        app:internal_marksVerticalPadding="4dp"
        app:internal_tooltipBoxCornerRadius="4dp"
        app:internal_tooltipHorizontalPadding="8dp"
        app:internal_tooltipLineDashGap="4dp"
        app:internal_tooltipLineDashSolid="1dp"
        app:internal_tooltipLineWidth="1dp"
        app:internal_tooltipTextSize="12sp"
        app:internal_tooltipVerticalPadding="4dp"
        app:layout_constraintBottom_toTopOf="@+id/multibarStories_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/multibarStories_link"/>
    <com.revolut.core.ui_kit.views.buttons.CollapsingActionButton
        android:layout_gravity="center"
        android:id="@+id/multibarStories_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/multibarStories_secondaryButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="?attr/uikit_dp24"/>
    <com.revolut.core.ui_kit.views.buttons.CollapsingActionButton
        android:layout_gravity="center"
        android:id="@+id/multibarStories_secondaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp24"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/multibarStories_twinHorizontalButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.views.buttons.TwinHorizontalButton
        android:id="@+id/multibarStories_twinHorizontalButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
