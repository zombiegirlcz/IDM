<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/litePosScreen_navBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.FixedTabs
        android:id="@+id/litePosScreen_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:minWidth="250dp"
        android:paddingStart="?attr/uikit_dp32"
        android:paddingEnd="?attr/uikit_dp32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/litePosScreen_navBar"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/litePosScreen_viewPager"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/litePosScreen_primaryActionButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/litePosScreen_tabs"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/litePosScreen_primaryActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/litePosScreen_secondaryActionButton"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/litePosScreen_secondaryActionButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp4"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/litePosScreen_primaryActionButton"
        app:layout_goneMarginEnd="@dimen/dp_16"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
