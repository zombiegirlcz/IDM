<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/placeholderRow_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/placeholderRow_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/placeholderRow_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/placeholderRow_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/placeholderRow_subtitleIcon"
        android:layout_width="?attr/uikit_dp16"
        android:layout_height="?attr/uikit_dp16"
        android:scaleType="centerCrop"
        android:tint="?attr/uikit_colorAccent"
        app:layout_constraintBottom_toBottomOf="@+id/placeholderRow_subtitle"
        app:layout_constraintStart_toStartOf="@+id/placeholderRow_title"
        app:layout_constraintTop_toTopOf="@+id/placeholderRow_subtitle"
        app:srcCompat="@drawable/uikit_icn_24_retry"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorAccent"
        android:ellipsize="end"
        android:id="@+id/placeholderRow_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/placeholderRow_subtitleIcon"
        app:layout_constraintTop_toBottomOf="@+id/placeholderRow_title"
        app:layout_goneMarginStart="?attr/uikit_dp0"
        style="?attr/internal_textAppearanceEmphasis2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
