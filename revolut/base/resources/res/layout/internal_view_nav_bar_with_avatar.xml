<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarWithAvatar_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/internal_nav_bar_height">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/navBarWithAvatar_bottomGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/internal_nav_bar_height"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
        android:id="@+id/navBarWithAvatar_navigationButton"
        android:background="@drawable/internal_oval_ripple"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintBottom_toTopOf="@+id/navBarWithAvatar_bottomGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/navBarWithAvatar_toolbarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/navBarWithAvatar_toolbarDescription"
        app:layout_constraintEnd_toStartOf="@+id/navBarWithAvatar_toolbarTitleBadge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/navBarWithAvatar_navigationButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="@dimen/dp_8"
        app:layout_goneMarginStart="@dimen/dp_16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <ImageView
        android:id="@+id/navBarWithAvatar_toolbarTitleBadge"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/navBarWithAvatar_toolbarTitle"
        app:layout_constraintEnd_toStartOf="@+id/navBarWithAvatar_avatarImage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/navBarWithAvatar_toolbarTitle"
        app:layout_constraintTop_toTopOf="@+id/navBarWithAvatar_toolbarTitle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/navBarWithAvatar_toolbarDescription"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/navBarWithAvatar_bottomGuideline"
        app:layout_constraintEnd_toStartOf="@+id/navBarWithAvatar_avatarImage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/navBarWithAvatar_navigationButton"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithAvatar_toolbarTitle"
        app:layout_goneMarginEnd="@dimen/dp_16"
        app:layout_goneMarginStart="@dimen/dp_16"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.AvatarView
        android:id="@+id/navBarWithAvatar_avatarImage"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/navBarWithAvatar_bottomGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:theme="@style/UiKitThemeOverlay.FcaDisclaimer"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/navBarWithAvatar_headerDisclaimer"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithAvatar_bottomGuideline"
        style="?attr/internal_textAppearanceFcaDisclaimerEmphasised"/>
</androidx.constraintlayout.widget.ConstraintLayout>
