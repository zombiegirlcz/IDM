<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.swipeablecards.container.SwipeableCardContainerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@drawable/internal_background_swipeable_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/swipeableCardLoadingDelegate_shimmeringView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="@dimen/internal_dp24"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:id="@+id/swipeableCardLoadingDelegate_title"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.4"/>
                <View
                    android:id="@+id/swipeableCardLoadingDelegate_subtitle"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/swipeableCardLoadingDelegate_title"/>
                <View
                    android:id="@+id/swipeableCardLoadingDelegate_secondSubtitle"
                    android:background="@drawable/internal_rectangle_gradient_grey"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/swipeableCardLoadingDelegate_subtitle"
                    app:layout_constraintWidth_percent="0.8"/>
                <View
                    android:id="@+id/swipeableCardLoadingDelegate_image"
                    android:background="@drawable/internal_purple_grey_gradient_background_rounded"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:alpha="0.4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="H,295:218"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>
</com.revolut.core.ui_kit.internal.views.swipeablecards.container.SwipeableCardContainerView>
