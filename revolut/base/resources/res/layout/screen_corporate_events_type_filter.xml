<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.NestedScrollCoordinatorView
        android:id="@+id/corporateEventsFilter_coordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/corporateEventsFilter_navBarWithToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/corporateEventsFilter_recyclerView"
            android:paddingBottom="96dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    </com.revolut.core.ui_kit.views.NestedScrollCoordinatorView>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:layout_gravity="bottom"
        android:id="@+id/corporateEventsFilter_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp24"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
