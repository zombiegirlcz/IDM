<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/deprecated_background_selectable_white"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:ellipsize="end"
        android:id="@+id/dialog_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/dialog_item_checked_tick"
        android:layout_alignParentStart="true"
        style="@style/MainText.Primary"/>
    <ImageView
        android:id="@+id/dialog_item_checked_tick"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/ic_checkmark_m"/>
</RelativeLayout>
