<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/basicNavBar_rootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/basicNavBar_contentTopGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/basicNavBar_contentBottomGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/internal_basic_nav_bar_height"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
        android:id="@+id/basicNavBar_navigationButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/internal_dp8"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/internal_dp8"
        app:layout_constraintBottom_toTopOf="@+id/basicNavBar_contentBottomGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar_contentTopGuideline"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/basicNavBar_toolbarTitleContainer"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/internal_dp16"
        android:paddingEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/basicNavBar_contentBottomGuideline"
        app:layout_constraintEnd_toStartOf="@+id/basicNavBar_menuRecyclerView"
        app:layout_constraintStart_toEndOf="@+id/basicNavBar_navigationButton"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar_contentTopGuideline"
        app:layout_goneMarginEnd="@dimen/dp_8">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/basicNavBar_toolbarLoadingTitleContainer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/internal_dp18"
            android:layout_marginBottom="@dimen/internal_dp8"
            android:layout_marginEnd="@dimen/internal_basic_nav_bar_title_content_horizontal_margin"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/basicNavBar_toolbarLoadingSubtitleContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="200dp">
            <View
                android:id="@+id/basicNavBar_toolbarLoadingTitleView"
                android:background="@drawable/internal_background_rounded_gray"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="?attr/uikit_colorShimmer"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/basicNavBar_toolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginEnd="@dimen/internal_basic_nav_bar_title_content_horizontal_margin"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/basicNavBar_toolbarSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/basicNavBar_toolbarLoadingSubtitleContainer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_basic_nav_bar_title_content_horizontal_margin"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/basicNavBar_toolbarLoadingTitleContainer"
            app:layout_constraintWidth_max="120dp">
            <View
                android:id="@+id/basicNavBar_toolbarLoadingSubtitleView"
                android:background="@drawable/internal_background_rounded_gray"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="?attr/uikit_colorShimmer"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/basicNavBar_toolbarSubtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginEnd="@dimen/internal_basic_nav_bar_title_content_horizontal_margin"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/basicNavBar_toolbarTitle"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/basicNavBar_toolbarEndIcon"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/basicNavBar_toolbarTitle"
            app:layout_constraintStart_toEndOf="@+id/basicNavBar_toolbarTitle"
            app:layout_constraintTop_toTopOf="@+id/basicNavBar_toolbarTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/basicNavBar_menuRecyclerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/basicNavBar_contentBottomGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar_contentTopGuideline"/>
    <com.revolut.core.ui_kit.views.CenteredFixedTabsView
        android:id="@+id/basicNavBar_centeredFixedTabs"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/basicNavBar_contentBottomGuideline"
        app:layout_constraintEnd_toStartOf="@+id/basicNavBar_menuRecyclerView"
        app:layout_constraintStart_toEndOf="@+id/basicNavBar_navigationButton"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar_contentTopGuideline"
        app:layout_goneMarginEnd="@dimen/dp_8"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/internalBasicNavBar_tagView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/basicNavBar_contentBottomGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar_contentTopGuideline"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/basicNavBar_headerDisclaimer"
        android:padding="@dimen/internal_dp8"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp8"
        android:layout_marginHorizontal="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar_contentBottomGuideline"
        style="?attr/internal_textAppearanceFcaDisclaimerEmphasised"/>
</androidx.constraintlayout.widget.ConstraintLayout>
