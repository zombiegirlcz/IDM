<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/amountEdit_amountTypeImage"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/amountEdit_amountInputContainer"
        app:layout_constraintEnd_toStartOf="@+id/amountEdit_amountTypeText"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/amountEdit_amountInputContainer"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/amountEdit_amountTypeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/amountEdit_amountInputContainer"
        app:layout_constraintEnd_toStartOf="@+id/amountEdit_amountTypeChevron"
        app:layout_constraintStart_toEndOf="@+id/amountEdit_amountTypeImage"
        app:layout_constraintTop_toTopOf="@+id/amountEdit_amountInputContainer"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/amountEdit_amountTypeChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="?attr/uikit_colorForeground"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/amountEdit_amountInputContainer"
        app:layout_constraintEnd_toStartOf="@+id/amountEdit_amountInputContainer"
        app:layout_constraintStart_toEndOf="@+id/amountEdit_amountTypeText"
        app:layout_constraintTop_toTopOf="@+id/amountEdit_amountInputContainer"
        app:layout_constraintVertical_bias="0.428"
        app:srcCompat="@drawable/uikit_icn_16_chevron_down"/>
    <View
        android:id="@+id/amountEdit_amountTypeContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/amountEdit_amountInputContainer"
        app:layout_constraintEnd_toEndOf="@+id/amountEdit_amountTypeChevron"
        app:layout_constraintStart_toStartOf="@+id/amountEdit_amountTypeImage"
        app:layout_constraintTop_toTopOf="@+id/amountEdit_amountInputContainer"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/amountEdit_amountInputContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/amountEdit_amountInputShimmer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:background="@drawable/internal_amount_edit_rectangle_gradient_grey"
                    android:layout_width="80dp"
                    android:layout_height="20dp"
                    style="?attr/internal_textAppearanceHeading3"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/amountEdit_amountInputPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="?attr/internal_textAppearanceHeading3"/>
            <com.revolut.core.ui_kit.views.input.MaskedTextInputEditText
                android:textColor="?attr/uikit_colorForeground"
                android:textColorHint="?attr/uikit_colorGreyTone50"
                android:gravity="end|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/amountEdit_amountInputText"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:minHeight="28dp"
                android:hint="0"
                android:singleLine="true"
                android:digits="0123456789.,"
                android:inputType="numberDecimal"
                app:errorEnabled="false"
                app:hintEnabled="false"
                style="?attr/internal_textAppearanceHeading3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/amountEdit_amountInputResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="?attr/internal_textAppearanceHeading3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/amountEdit_amountInputSuffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="?attr/internal_textAppearanceHeading3"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/amountEdit_startHintContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="80dp"
        android:minHeight="22dp"
        app:layout_constraintEnd_toStartOf="@+id/amountEdit_endHintContainer"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/amountEdit_endHintContainer">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGrey50"
            android:ellipsize="marquee"
            android:gravity="start|center_vertical"
            android:id="@+id/amountEdit_startHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:minHeight="22dp"
            android:textAlignment="viewStart"
            android:breakStrategy="simple"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/amountEdit_startHintIcon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceBody3"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/amountEdit_startHintIcon"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="?attr/uikit_colorForeground"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/amountEdit_startHintText"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/uikit_icn_16_chevron_down"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/amountEdit_startHintShimmer"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/internal_amount_edit_rectangle_gradient_grey"
                android:layout_width="109dp"
                android:layout_height="12dp"
                style="?attr/internal_textAppearanceBody2"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/amountEdit_endHintContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minWidth="80dp"
        android:minHeight="22dp"
        app:layout_constraintEnd_toStartOf="@+id/amountEdit_switcher"
        app:layout_constraintStart_toEndOf="@+id/amountEdit_startHintContainer"
        app:layout_constraintTop_toBottomOf="@+id/amountEdit_amountInputContainer">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/amountEdit_endHintLeftIcon"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="24dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="@+id/amountEdit_negativeMarginSpace"
            app:layout_constraintTop_toTopOf="parent"/>
        <Space
            android:id="@+id/amountEdit_negativeMarginSpace"
            android:layout_width="24dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@+id/amountEdit_endHintText"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/amountEdit_endHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="22dp"
            android:textAlignment="viewEnd"
            android:paddingStart="28dp"
            android:layout_marginEnd="8dp"
            android:breakStrategy="simple"
            app:layout_constraintEnd_toStartOf="@+id/amountEdit_endHintRightIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/amountEdit_endHintRightIcon"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/amountEdit_endHintShimmer"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/internal_amount_edit_rectangle_gradient_grey"
                android:layout_width="84dp"
                android:layout_height="12dp"
                style="?attr/internal_textAppearanceBody2"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/amountEdit_switcher"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/amountEdit_endHintContainer"
        app:layout_constraintTop_toBottomOf="@+id/amountEdit_amountInputContainer"
        app:srcCompat="@drawable/uikit_icn_24_arrows_sort"/>
</merge>
