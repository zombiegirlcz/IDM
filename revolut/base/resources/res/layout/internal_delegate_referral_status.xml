<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/referralStatus_stagesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/referralStatus_title"
        app:layout_constraintTop_toBottomOf="@+id/referralStatus_stagesTopHorizontalBarrier"/>
    <com.revolut.core.ui_kit.internal.views.CutoutImageView
        android:id="@+id/referralStatus_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
        android:id="@+id/referralStatus_badgeBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginStart="26dp"
        app:layout_constraintStart_toStartOf="@+id/referralStatus_image"
        app:layout_constraintTop_toTopOf="@+id/referralStatus_image"
        app:uikit_circle_badge_size="small"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/referralStatus_badgeTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/referralStatus_image"
        app:layout_constraintEnd_toEndOf="@+id/referralStatus_image"
        app:layout_constraintStart_toEndOf="@+id/referralStatus_image"
        app:layout_constraintTop_toTopOf="@+id/referralStatus_image"
        app:srcCompat="@drawable/internal_icn_16_new_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/referralStatus_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/referralStatus_valueBarrier"
        app:layout_constraintStart_toEndOf="@+id/referralStatus_image"
        app:layout_constraintTop_toTopOf="@+id/referralStatus_image"
        app:layout_goneMarginTop="16dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/referralStatus_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/referralStatus_title"
        app:layout_constraintStart_toStartOf="@+id/referralStatus_title"
        app:layout_constraintTop_toBottomOf="@+id/referralStatus_title"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/referralStatus_valueButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/referralStatus_valueImage"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/referralStatus_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/referralStatus_image"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/referralStatus_stagesTopHorizontalBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="referralStatus_title, referralStatus_description,referralStatus_valueButton,referralStatus_valueImage"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/referralStatus_valueBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="referralStatus_valueButton,referralStatus_valueImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
