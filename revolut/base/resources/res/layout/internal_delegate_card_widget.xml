<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/cardWidget_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/cardWidget_border"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/cardWidget_image"
            app:layout_constraintEnd_toEndOf="@+id/cardWidget_image"
            app:layout_constraintStart_toStartOf="@+id/cardWidget_image"
            app:layout_constraintTop_toTopOf="@+id/cardWidget_image"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cardWidget_image"
            android:padding="4dp"
            android:layout_width="119dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:maxHeight="119dp"
            app:layout_constraintBottom_toTopOf="@+id/cardWidget_title"
            app:layout_constraintDimensionRatio="1.538:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cardWidget_badge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/cardWidget_image"
            app:layout_constraintEnd_toEndOf="@+id/cardWidget_image"
            app:layout_constraintStart_toStartOf="@+id/cardWidget_image"
            app:layout_constraintTop_toTopOf="@+id/cardWidget_image"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/cardWidget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxWidth="132dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/cardWidget_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardWidget_image"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/cardWidget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="132dp"
            android:maxLines="1"
            android:textDirection="firstStrongLtr"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardWidget_title"
            style="?attr/internal_textAppearanceBody3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
