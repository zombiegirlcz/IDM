<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/transferTopUpScreen_navBarWithToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:enabled="false"
        android:layout_gravity="bottom"
        android:id="@+id/next_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/uikit_dp16"
        android:layout_marginRight="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp24"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
