<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/listingCardRevPoints_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/listingCardRevPoints_endTextImage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardRevPoints_endTextImage"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/listingCardRevPoints_title"
        app:layout_constraintEnd_toStartOf="@+id/listingCardRevPoints_price"
        app:layout_constraintStart_toEndOf="@+id/listingCardRevPoints_title"
        app:layout_constraintTop_toTopOf="@+id/listingCardRevPoints_title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/listingCardRevPoints_leftGroupBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="listingCardRevPoints_title,listingCardRevPoints_endTextImage"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/listingCardRevPoints_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/listingCardRevPoints_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/listingCardRevPoints_title"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/listingCardRevPoints_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/uikit_dp4"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="@+id/listingCardRevPoints_price"
        app:layout_constraintEnd_toStartOf="@+id/listingCardRevPoints_price"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/listingCardRevPoints_leftGroupBarrier"
        app:layout_constraintTop_toTopOf="@+id/listingCardRevPoints_price"
        style="?attr/internal_textAppearanceBody1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
