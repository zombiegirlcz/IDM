<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageStories_backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/imageStories_contentRoot"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/imageStories_topSpacing"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.DynamicHeightAutosizeTextView
            android:textColor="?attr/uikit_colorWhite"
            android:id="@+id/imageStories_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageStories_topSpacing"
            style="?attr/internal_textAppearanceStoriesTitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorWhite"
            android:id="@+id/imageStories_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageStories_title"
            style="?attr/internal_textAppearanceStoriesSubtitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorWhite"
            android:id="@+id/imageStories_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageStories_subtitle"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <View
            android:id="@+id/imageStories_titleOverlayBottom"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageStories_link"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/imageStories_imageView"
            android:saveEnabled="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="24dp"
            app:layout_constraintBottom_toTopOf="@+id/imageStories_button"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="spread"
            app:layout_constraintHeight_max="200dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageStories_link"
            app:layout_constraintWidth_default="spread"
            app:layout_constraintWidth_max="200dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
        <com.revolut.core.ui_kit.views.buttons.CollapsingActionButton
            android:layout_gravity="center"
            android:id="@+id/imageStories_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/imageStories_secondaryButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="?attr/uikit_dp24"/>
        <com.revolut.core.ui_kit.views.buttons.CollapsingActionButton
            android:layout_gravity="center"
            android:id="@+id/imageStories_secondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp24"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/imageStories_twinHorizontalButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.revolut.core.ui_kit.views.buttons.TwinHorizontalButton
            android:id="@+id/imageStories_twinHorizontalButton"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
