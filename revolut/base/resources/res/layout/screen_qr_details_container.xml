<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.kompot.view.ControllerContainerFrameLayout
        android:id="@+id/qrDetailsContainer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarWithAvatar
        android:id="@+id/qrDetailsContainer_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.CircleActionButtonsBarView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/qrDetailsContainer_circleActionButtonsBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_32"
        android:layout_marginHorizontal="@dimen/dp_16"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
