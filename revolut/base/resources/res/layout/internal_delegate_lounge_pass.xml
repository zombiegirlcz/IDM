<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.box.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/internal_shadow_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="?attr/uikit_dp32"
    android:layout_marginEnd="?attr/uikit_dp32">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/uikit_colorWhite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/internal_logo_image"
            android:layout_width="90dp"
            android:layout_height="?attr/uikit_dp32"
            android:layout_marginTop="?attr/uikit_dp24"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorBlack"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/internal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginBottom="20dp"
            android:maxLines="1"
            android:layout_marginStart="?attr/uikit_dp24"
            android:layout_marginEnd="?attr/uikit_dp24"
            style="?attr/internal_textAppearanceHeading3"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/internal_bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorWhite_50"
                android:gravity="center_horizontal"
                android:id="@+id/internal_top_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:maxLines="1"
                android:layout_marginStart="?attr/uikit_dp24"
                android:layout_marginEnd="?attr/uikit_dp24"
                style="?attr/internal_textAppearanceEmphasis2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorWhite"
                android:gravity="center_horizontal"
                android:id="@+id/internal_top_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="?attr/uikit_dp24"
                android:layout_marginEnd="?attr/uikit_dp24"
                style="?attr/internal_textAppearanceBody1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorWhite_50"
                android:gravity="center_horizontal"
                android:id="@+id/internal_bottom_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                android:maxLines="1"
                android:layout_marginStart="?attr/uikit_dp24"
                android:layout_marginEnd="?attr/uikit_dp24"
                style="?attr/internal_textAppearanceEmphasis2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorWhite"
                android:gravity="center_horizontal"
                android:id="@+id/internal_bottom_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="?attr/uikit_dp24"
                android:layout_marginEnd="?attr/uikit_dp24"
                style="?attr/internal_textAppearanceBody1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/internal_qr_code_image"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp24"
                android:forceDarkAllowed="false"/>
        </LinearLayout>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.box.ShadowLayout>
