<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:layout_marginBottom="7dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/gridCell_title"
        android:background="@drawable/internal_grid_cell_states"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="33dp"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        android:layout_marginTop="?attr/uikit_dp4"
        android:divider="?android:attr/listDivider"
        android:showDividers="middle"
        android:dividerPadding="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridCell_title">
        <View
            android:id="@+id/gridCell_bottomDotView1"
            android:background="@drawable/internal_grid_bottom_dot"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="4dp"/>
        <View
            android:id="@+id/gridCell_bottomDotView2"
            android:background="@drawable/internal_grid_bottom_dot"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="4dp"/>
        <View
            android:id="@+id/gridCell_bottomDotView3"
            android:background="@drawable/internal_grid_bottom_dot"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="4dp"/>
        <FrameLayout
            android:id="@+id/gridCell_bottomDotView4"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="4dp">
            <View
                android:layout_gravity="center"
                android:id="@+id/gridCell_bottomDotView4Actual"
                android:background="@drawable/internal_grid_bottom_dot"
                android:layout_width="2dp"
                android:layout_height="2dp"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
