<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/productIntroShimmering_textContainer"
        android:layout_width="0dp"
        android:layout_height="136dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="top|center_horizontal"
            android:layout_width="216dp"
            android:layout_height="32dp"/>
        <View
            android:layout_gravity="top|center_horizontal"
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginTop="44dp"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <View
        android:id="@+id/productIntroNavBarContentV2_introView"
        android:layout_width="0dp"
        android:layout_height="484dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
        android:textSize="40dp"
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/productIntroNavBarContentV2_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="80dp"
        android:maxLines="3"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="27dp"
        android:autoSizeMaxTextSize="40dp"
        app:layout_constraintBottom_toTopOf="@+id/productIntroNavBarContentV2_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/productIntroNavBarContentV2_introView"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="375dp"
        app:lineHeight="40dp"/>
    <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/productIntroNavBarContentV2_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/productIntroNavBarContentV2_smallAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productIntroNavBarContentV2_title"
        app:layout_constraintWidth_max="375dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.switcher_button.SwitcherButtonView
        android:layout_gravity="center_horizontal"
        android:id="@+id/productIntroNavBarContentV2_smallAction"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/productIntroNavBarContentV2_introView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productIntroNavBarContentV2_subtitle"/>
    <com.revolut.core.ui_kit.views.ActionsView
        android:id="@+id/productIntroNavBarContentV2_actionsView"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        app:internal_paddingTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productIntroNavBarContentV2_introView"/>
</merge>
