<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.kompot.view.ControllerContainerCoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/calculatorScreen_navBarWithToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/calculatorScreen_recyclerView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/calculatorScreen_gradient"
            android:background="@drawable/uikit_bottom_container_gradient"
            android:layout_width="match_parent"
            android:layout_height="?attr/uikit_dp16"/>
        <com.revolut.core.ui_kit.views.buttons.TwinVerticalButton
            android:layout_gravity="bottom"
            android:id="@+id/calculatorScreen_twinVerticalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="com.revolut.core.ui_kit.views.buttons.CollapsibleButtonBehavior"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
    </com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
    <com.revolut.kompot.view.ControllerContainerLinearLayout
        android:orientation="vertical"
        android:id="@+id/calculatorScreen_footerContainer"
        android:background="@drawable/uikit_bottom_container_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
            android:id="@+id/calculatorScreen_bottomRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:layout_gravity="bottom"
            android:id="@+id/calculatorScreen_largeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/uikit_dp16"
            android:layout_marginTop="?attr/uikit_dp24"
            android:layout_marginRight="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp24"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
    </com.revolut.kompot.view.ControllerContainerLinearLayout>
</com.revolut.kompot.view.ControllerContainerLinearLayout>
