<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/internalNumericKeyboardView_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <Button
        android:id="@+id/internalNumericKeyboardView_button1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="1"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toTopOf="@+id/internalNumericKeyboardView_button4"
        app:layout_constraintEnd_toStartOf="@+id/internalNumericKeyboardView_button2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="2"
        app:layout_constraintBottom_toTopOf="@+id/internalNumericKeyboardView_button5"
        app:layout_constraintEnd_toStartOf="@+id/internalNumericKeyboardView_button3"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/internalNumericKeyboardView_button1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="3"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/internalNumericKeyboardView_button6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/internalNumericKeyboardView_button2"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="4"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toTopOf="@+id/internalNumericKeyboardView_button7"
        app:layout_constraintEnd_toStartOf="@+id/internalNumericKeyboardView_button5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button1"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="5"
        app:layout_constraintBottom_toTopOf="@+id/internalNumericKeyboardView_button8"
        app:layout_constraintEnd_toStartOf="@+id/internalNumericKeyboardView_button6"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/internalNumericKeyboardView_button4"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button2"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="6"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/internalNumericKeyboardView_button9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalNumericKeyboardView_button5"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button3"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button7"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="7"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toTopOf="@+id/internalNumericKeyboardView_dot"
        app:layout_constraintEnd_toStartOf="@+id/internalNumericKeyboardView_button8"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button4"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="8"
        app:layout_constraintBottom_toTopOf="@+id/internalNumericKeyboardView_button0"
        app:layout_constraintEnd_toStartOf="@+id/internalNumericKeyboardView_button9"
        app:layout_constraintStart_toEndOf="@+id/internalNumericKeyboardView_button7"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button5"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button9"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="9"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/internalNumericKeyboardView_buttonBackspace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalNumericKeyboardView_button8"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button6"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_dot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/internalNumericKeyboardView_button0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button7"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <Button
        android:id="@+id/internalNumericKeyboardView_button0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/internalNumericKeyboardView_buttonBackspace"
        app:layout_constraintStart_toEndOf="@+id/internalNumericKeyboardView_dot"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button8"
        style="@style/InternalCustomNumericKeyboardButton"/>
    <ImageButton
        android:id="@+id/internalNumericKeyboardView_buttonBackspace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/internalNumericKeyboardView_button0"
        app:layout_constraintTop_toBottomOf="@+id/internalNumericKeyboardView_button9"
        style="@style/InternalCustomNumericKeyboardButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
