<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/internal_gaugeNavBar_shimmerTitle"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="120dp"
            android:layout_height="30dp"/>
        <View
            android:id="@+id/internal_gaugeNavBar_shimmerSubtitle"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="195dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"/>
        <View
            android:id="@+id/internal_gaugeNavBar_shimmerDescription"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="120dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
