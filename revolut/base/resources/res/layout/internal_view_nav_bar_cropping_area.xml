<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/navBarCroppingArea_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/navBarCroppingArea_search"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/navBarCroppingArea_menu1"
        app:layout_constraintStart_toEndOf="@+id/navBarCroppingArea_avatar"
        app:layout_constraintTop_toTopOf="@+id/navBarCroppingArea_avatar"/>
    <View
        android:id="@+id/navBarCroppingArea_menu1"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/navBarCroppingArea_menu2"
        app:layout_constraintTop_toTopOf="@+id/navBarCroppingArea_avatar"/>
    <View
        android:id="@+id/navBarCroppingArea_menu2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/navBarCroppingArea_avatar"/>
    <View
        android:id="@+id/navBarCroppingArea_text1"
        android:layout_width="45dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toTopOf="@+id/navBarCroppingArea_text2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarCroppingArea_search"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/navBarCroppingArea_text2"
        android:layout_width="133dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/navBarCroppingArea_text3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarCroppingArea_text1"/>
    <View
        android:id="@+id/navBarCroppingArea_text3"
        android:layout_width="95dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/navBarCroppingArea_action1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarCroppingArea_text2"/>
    <View
        android:id="@+id/navBarCroppingArea_action1"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/navBarCroppingArea_action2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/navBarCroppingArea_action2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/navBarCroppingArea_action1"
        app:layout_constraintEnd_toStartOf="@+id/navBarCroppingArea_action3"
        app:layout_constraintStart_toEndOf="@+id/navBarCroppingArea_action1"/>
    <View
        android:id="@+id/navBarCroppingArea_action3"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/navBarCroppingArea_action1"
        app:layout_constraintEnd_toStartOf="@+id/navBarCroppingArea_action4"
        app:layout_constraintStart_toEndOf="@+id/navBarCroppingArea_action2"/>
    <View
        android:id="@+id/navBarCroppingArea_action4"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/navBarCroppingArea_action1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/navBarCroppingArea_action3"/>
</merge>
