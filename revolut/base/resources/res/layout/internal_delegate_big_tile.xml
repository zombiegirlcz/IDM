<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bigTile_cardBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,12:10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.videoplayer.UiKitPlayerView
        android:id="@+id/bigTile_playerView"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/internal_card_16dp_padding_size"
        android:layout_marginBottom="@dimen/dp_32"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bigTile_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bigTile_cardBackground"
        app:layout_constraintEnd_toEndOf="@+id/bigTile_cardBackground"
        app:layout_constraintStart_toStartOf="@+id/bigTile_cardBackground"
        app:layout_constraintTop_toTopOf="@+id/bigTile_cardBackground"/>
    <View
        android:id="@+id/bigTile_dimmedOverlay"
        android:background="?attr/uikit_colorBlack"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="@+id/bigTile_cardBackground"
        app:layout_constraintEnd_toEndOf="@+id/bigTile_cardBackground"
        app:layout_constraintStart_toStartOf="@+id/bigTile_cardBackground"
        app:layout_constraintTop_toTopOf="@+id/bigTile_cardBackground"/>
    <com.revolut.core.ui_kit.internal.views.ActionStatusView
        android:id="@+id/bigTile_actionStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_8dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_24dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_24dp_padding_size"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bigTile_badgeStatusContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_8dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_24dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_24dp_padding_size"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent">
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/bigTile_badgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/internal_card_8dp_padding_size"/>
    </LinearLayout>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/bigTile_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_8dp_padding_size"
        android:maxHeight="120dp"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_card_24dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_24dp_padding_size"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="@dimen/internal_card_8dp_padding_size"
        style="?attr/internal_textAppearanceHeading1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/bigTile_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_8dp_padding_size"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_card_24dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_24dp_padding_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_socialProof"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.SocialProofView
        android:id="@+id/bigTile_socialProof"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_8dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_24dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_24dp_padding_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.views.HorizontalStepsProgressView
        android:id="@+id/bigTile_progress"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginBottom="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_actionsView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.views.ActionsView
        android:id="@+id/bigTile_actionsView"
        android:paddingTop="@dimen/internal_card_8dp_padding_size"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_card_8dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_24dp_padding_size"
        android:layout_marginEnd="@dimen/internal_card_24dp_padding_size"
        app:internal_brightDark="true"
        app:internal_paddingEnd="0dp"
        app:internal_paddingStart="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_bottomSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/bigTile_bottomSpace"
        android:layout_width="0dp"
        android:layout_height="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintBottom_toTopOf="@+id/bigTile_footerGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/bigTile_cardForeground"
        android:background="@drawable/internal_box_foreground_ripple"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bigTile_cardBackground"
        app:layout_constraintEnd_toEndOf="@+id/bigTile_cardBackground"
        app:layout_constraintStart_toStartOf="@+id/bigTile_cardBackground"
        app:layout_constraintTop_toTopOf="@+id/bigTile_cardBackground"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bigTile_endBottomImage"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/bigTile_footerGroup"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bigTile_cardBackground">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorWhite"
            android:ellipsize="end"
            android:id="@+id/bigTile_footerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="5"
            android:textAlignment="viewStart"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bigTile_footerAction"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceBody3"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:id="@+id/bigTile_footerAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="@+id/bigTile_footerTextToActionGuideline"
            app:layout_constraintTop_toTopOf="parent"
            app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
        <com.revolut.core.ui_kit.internal.views.ActionStatusView
            android:id="@+id/bigTile_footerLabel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/bigTile_footerTextToActionGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.6"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bigTile_footerForeground"
        android:background="@drawable/internal_box_foreground_ripple"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bigTile_footerGroup"
        app:layout_constraintTop_toTopOf="@+id/bigTile_footerGroup"/>
</androidx.constraintlayout.widget.ConstraintLayout>
