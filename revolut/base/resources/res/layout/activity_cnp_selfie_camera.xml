<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <io.fotoapparat.view.CameraView
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"/>
    <View
        android:background="@drawable/mask_gradient_top"
        android:layout_width="wrap_content"
        android:layout_height="80dp"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/mask_gradient_bottom"
        android:layout_width="wrap_content"
        android:layout_height="140dp"/>
    <FrameLayout
        android:id="@+id/finderGroup"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/navBarWithToolbar"
            android:background="?attr/uikit_windowBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/takePhotoButton"
            android:background="@drawable/ic_shutter"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"/>
        <com.revolut.core.ui_kit.views.buttons.TwinVerticalButton
            android:layout_gravity="bottom"
            android:id="@+id/twinVerticalButton"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <View
        android:id="@+id/splash"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout>
