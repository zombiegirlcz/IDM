<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/invoicePreview_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.FixedTabs
        android:id="@+id/invoicePreview_tabs"
        android:paddingBottom="?attr/uikit_dp8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="?attr/uikit_dp16"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/invoicePreview_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</com.revolut.kompot.view.ControllerContainerLinearLayout>
