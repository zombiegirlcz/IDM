<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/internal_input_text_loading_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="56dp">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/loadingDropDown_label"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/loadingDropDown_content"
            app:layout_constraintEnd_toStartOf="@+id/loadingDropDown_mainIconView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="?attr/internal_textAppearanceEmphasis3"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/loadingDropDown_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loadingDropDown_label"
            app:layout_constraintWidth_percent="0.6">
            <View
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="match_parent"
                android:layout_height="16dp"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loadingDropDown_mainIconView"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
