<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/tradesHistoryLoadingItem_shimmeringView"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/uikit_dp32">
    <View
        android:id="@+id/tradesHistoryLoadingItem_pricePlaceholder"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_weight="1"
        android:layout_marginVertical="?attr/uikit_dp8"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"/>
    <View
        android:id="@+id/tradesHistoryLoadingItem_quantityPlaceholder"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_weight="1"
        android:layout_marginVertical="?attr/uikit_dp8"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <View
        android:id="@+id/tradesHistoryLoadingItem_timePlaceholder"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_weight="1"
        android:layout_marginVertical="?attr/uikit_dp8"/>
</com.facebook.shimmer.ShimmerLinearLayout>
