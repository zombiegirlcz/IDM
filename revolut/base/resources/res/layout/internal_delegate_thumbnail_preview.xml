<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.navbar.preview.WallpaperPreviewView
        android:id="@+id/thumbnailPreview_wallpaper"
        android:layout_width="134dp"
        android:layout_height="288dp"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toTopOf="@+id/thumbnailPreview_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/thumbnailPreview_selectionView"
        android:layout_width="142dp"
        android:layout_height="296dp"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintEnd_toEndOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintStart_toStartOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintTop_toTopOf="@+id/thumbnailPreview_wallpaper"/>
    <com.revolut.core.ui_kit.internal.views.navbar.preview.NavBarScalableSilhouetteView
        android:id="@+id/thumbnailPreview_navBarSilhouette"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintStart_toStartOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintTop_toTopOf="@+id/thumbnailPreview_wallpaper"/>
    <com.revolut.core.ui_kit.internal.views.navbar.preview.ActionsScalableSilhouetteView
        android:id="@+id/thumbnailPreview_actionsSilhouette"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/wallpaperPreview_contentSilhouette"
        app:layout_constraintEnd_toEndOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintStart_toStartOf="@+id/thumbnailPreview_wallpaper"/>
    <com.revolut.core.ui_kit.internal.views.navbar.preview.ContentScalableSilhouetteView
        android:id="@+id/wallpaperPreview_contentSilhouette"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintEnd_toEndOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintStart_toStartOf="@+id/thumbnailPreview_wallpaper"/>
    <View
        android:id="@+id/thumbnailPreview_lockedStateOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintEnd_toEndOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintStart_toStartOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintTop_toTopOf="@+id/thumbnailPreview_wallpaper"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/thumbnailPreview_lockedStateIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintEnd_toEndOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintStart_toStartOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintTop_toTopOf="@+id/thumbnailPreview_wallpaper"/>
    <com.revolut.core.ui_kit.internal.views.NewBadgeView
        android:id="@+id/thumbnailPreview_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="58dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/thumbnailPreview_wallpaper"
        app:layout_constraintTop_toTopOf="@+id/thumbnailPreview_wallpaper"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/thumbnailPreview_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thumbnailPreview_wallpaper"
        style="@style/InternalTextAppearance.Emphasis2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
