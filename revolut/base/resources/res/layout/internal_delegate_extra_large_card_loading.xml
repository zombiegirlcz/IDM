<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/extraLargeListingCardLoading_headerImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:layout_constraintDimensionRatio="H,343:120"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/extraLargeListingCardLoading_shimmeringView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCardLoading_headerImage">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/extraLargeListingCardLoading_title"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="228dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginTop="?attr/uikit_dp16"
                android:alpha="0.2"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_subtitle"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="132dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp48"
                android:alpha="0.2"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCardLoading_title"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_secondSubtitle"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:alpha="0.2"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCardLoading_subtitle"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_firstDetailsItem"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp48"
                android:alpha="0.2"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCardLoading_secondSubtitle"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_firstDetailsValue"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:alpha="0.2"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/extraLargeListingCardLoading_firstDetailsItem"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_secondDetailsItem"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:alpha="0.2"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCardLoading_firstDetailsItem"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_secondDetailsValue"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:alpha="0.2"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/extraLargeListingCardLoading_secondDetailsItem"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_thirdDetailsItem"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:alpha="0.2"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCardLoading_secondDetailsItem"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_thirdDetailsValue"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:alpha="0.2"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/extraLargeListingCardLoading_thirdDetailsItem"/>
            <View
                android:id="@+id/extraLargeListingCardLoading_button"
                android:background="@drawable/internal_rectangle_gradient_action_button"
                android:layout_width="0dp"
                android:layout_height="?attr/uikit_dp48"
                android:layout_marginTop="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="@dimen/internal_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCardLoading_thirdDetailsItem"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
