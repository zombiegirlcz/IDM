<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/horizontalHistogramTileLoading_shimmer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/horizontalHistogramTileLoading_subtitle"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="96dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/trendPreviewLoading_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/horizontalHistogramTileLoading_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="56dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@+id/horizontalHistogramTileLoading_subtitle"
            app:layout_constraintTop_toBottomOf="@+id/horizontalHistogramTileLoading_subtitle"/>
        <View
            android:id="@+id/horizontalHistogramTileLoading_bottomBar1"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/horizontalHistogramTileLoading_bottomBar2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/horizontalHistogramTileLoading_subtitle"/>
        <View
            android:id="@+id/horizontalHistogramTileLoading_bottomBar2"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="96dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/horizontalHistogramTileLoading_subtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
