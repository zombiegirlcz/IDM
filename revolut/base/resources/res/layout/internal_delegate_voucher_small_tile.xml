<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/smallVoucherTile_mediaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/smallVoucherTile_voucherTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/smallVoucherTile_blurOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/internal_gradient_bottom_to_top_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/smallVoucherTile_mediaView"/>
    <View
        android:id="@+id/voucherSmallTile_lockedOverlay"
        android:background="@color/internal_foreground_50"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voucherSmallTile_topRightIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/smallVoucherTile_voucherTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/smallVoucherTile_voucherSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/smallVoucherTile_mediaView"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:id="@+id/smallVoucherTile_bottomLabel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/smallVoucherTile_voucherTag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="?attr/uikit_dp0"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <ProgressBar
        android:id="@+id/smallVoucherTile_progressBar"
        android:paddingTop="?attr/uikit_dp8"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="?attr/uikit_dp12"
        android:progressDrawable="@drawable/internal_vaults_progress"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/smallVoucherTile_subtitleGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <Space
        android:id="@+id/smallVoucherTile_subtitleSpace"
        android:layout_width="16dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/smallVoucherTile_subtitleIcon"
        android:layout_width="?attr/uikit_dp16"
        android:layout_height="?attr/uikit_dp16"
        android:layout_marginTop="1dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/smallVoucherTile_voucherSubtitle"
        app:layout_constraintEnd_toStartOf="@+id/smallVoucherTile_voucherSubtitle"
        app:layout_constraintStart_toEndOf="@+id/smallVoucherTile_subtitleSpace"
        app:layout_constraintTop_toTopOf="@+id/smallVoucherTile_voucherSubtitle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/smallVoucherTile_background"
        android:background="@drawable/internal_voucher_cutaway_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/smallVoucherTile_mediaView"
        app:layout_constraintEnd_toEndOf="@+id/smallVoucherTile_logo"
        app:layout_constraintStart_toStartOf="@+id/smallVoucherTile_logo"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/smallVoucherTile_logo"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="-12dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/smallVoucherTile_mediaView"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/smallVoucherTile_voucherSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/smallVoucherTile_bottomLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/smallVoucherTile_subtitleIcon"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/smallVoucherTile_voucherTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/smallVoucherTile_progressBar"
        app:layout_constraintEnd_toStartOf="@+id/smallVoucherTile_voucherExtraTag"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginEnd="?attr/uikit_dp16"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/smallVoucherTile_voucherExtraTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/smallVoucherTile_progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/smallVoucherTile_voucherTag"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginStart="?attr/uikit_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/smallVoucherTile_subtitleGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="?attr/uikit_dp12"/>
    <View
        android:id="@+id/voucherSmallTile_overlay"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
