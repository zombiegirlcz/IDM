<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/giftAttachmentCover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/giftAttachmentLabel"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"
        app:srcCompat="@drawable/internal_payment_attachment_panel_gift_placeholder"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone20"
        android:id="@+id/giftAttachmentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/verticalGuideline1"
        app:layout_constraintStart_toEndOf="@+id/giftAttachmentCover"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <Space
        android:id="@+id/giftAttachmentDeleteTopGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/giftAttachmentCover"
        app:layout_constraintEnd_toStartOf="@+id/verticalGuideline1"/>
    <Space
        android:id="@+id/giftAttachmentDeleteEndGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/giftAttachmentCover"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/giftDeleteButton"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/giftAttachmentDeleteEndGuideline"
        app:layout_constraintTop_toBottomOf="@+id/giftAttachmentDeleteTopGuideline"
        app:srcCompat="@drawable/uikit_icn_20_close_accent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/verticalGuideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.33"
        app:layout_constraintStart_toEndOf="@+id/giftAttachmentLabel"/>
    <View
        android:id="@+id/verticalDivider1"
        android:background="?attr/uikit_colorGreyTone20"
        android:layout_width="1dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/verticalGuideline1"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/attachedImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/verticalGuideline2"
        app:layout_constraintStart_toEndOf="@+id/verticalGuideline1"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/internal_payment_attachment_panel_image_placeholder_grey"/>
    <Space
        android:id="@+id/imageAttachmentDeleteTopGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/attachedImage"
        app:layout_constraintEnd_toStartOf="@+id/verticalGuideline2"/>
    <Space
        android:id="@+id/imageAttachmentDeleteEndGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/attachedImage"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageDeleteButton"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/imageAttachmentDeleteEndGuideline"
        app:layout_constraintTop_toBottomOf="@+id/imageAttachmentDeleteTopGuideline"
        app:srcCompat="@drawable/uikit_icn_20_close_accent"/>
    <View
        android:id="@+id/verticalDivider2"
        android:background="?attr/uikit_colorGreyTone20"
        android:layout_width="1dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/verticalGuideline2"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/verticalGuideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.66"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColor="?attr/uikit_colorGreyTone50"
        android:textColorHint="?attr/uikit_colorGreyTone20"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/noteEditor"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="6"
        android:inputType="textMultiLine"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/verticalGuideline2"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
