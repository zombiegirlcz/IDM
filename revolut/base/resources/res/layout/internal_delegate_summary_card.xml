<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/summaryCard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/uikit_dp8"
    android:layout_marginBottom="?attr/uikit_dp8"
    android:layout_marginStart="?attr/uikit_dp16"
    android:layout_marginEnd="?attr/uikit_dp16">
    <com.revolut.core.ui_kit.views.AvatarView
        android:id="@+id/summaryCard_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_summary_card_vertical_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/summaryCard_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryCard_avatar"
        style="?attr/internal_textAppearanceHeading2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/summaryCard_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:maxLines="3"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryCard_title"
        style="?attr/internal_textAppearanceBody2"/>
    <ImageView
        android:id="@+id/summaryCard_primaryValueInfoIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="?attr/uikit_dp16"
        android:layout_height="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="@+id/summaryCard_primaryValue"
        app:layout_constraintEnd_toStartOf="@+id/summaryCard_primaryValue"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/summaryCard_primaryValue"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/summaryCard_primaryValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/summaryCard_primaryLabel"
        app:layout_constraintEnd_toStartOf="@+id/summaryCard_infoDivider"
        app:layout_constraintStart_toEndOf="@+id/summaryCard_primaryValueInfoIcon"
        app:layout_constraintTop_toTopOf="@+id/summaryCard_infoDivider"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginStart="?attr/uikit_dp24"
        style="?attr/internal_textAppearanceBody1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/summaryCard_primaryLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="@+id/summaryCard_infoDivider"
        app:layout_constraintEnd_toStartOf="@+id/summaryCard_infoDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryCard_primaryValue"
        style="?attr/internal_textAppearanceBody2"/>
    <View
        android:id="@+id/summaryCard_infoDivider"
        android:background="?attr/uikit_colorElevatedSearchBackground"
        android:layout_width="1dp"
        android:layout_height="58dp"
        android:layout_marginTop="?attr/uikit_dp32"
        android:layout_marginBottom="@dimen/internal_summary_card_vertical_padding"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summaryCard_description"/>
    <ImageView
        android:id="@+id/summaryCard_secondaryValueInfoIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="?attr/uikit_dp16"
        android:layout_height="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="@+id/summaryCard_secondaryValue"
        app:layout_constraintEnd_toStartOf="@+id/summaryCard_secondaryValue"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/summaryCard_infoDivider"
        app:layout_constraintTop_toTopOf="@+id/summaryCard_secondaryValue"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/summaryCard_secondaryValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/summaryCard_secondaryLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/summaryCard_secondaryValueInfoIcon"
        app:layout_constraintTop_toTopOf="@+id/summaryCard_infoDivider"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginStart="?attr/uikit_dp8"
        style="?attr/internal_textAppearanceBody1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/summaryCard_secondaryLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="@+id/summaryCard_infoDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/summaryCard_infoDivider"
        app:layout_constraintTop_toBottomOf="@+id/summaryCard_secondaryValue"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
