<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/internal_dp16"
        android:layout_marginVertical="@dimen/internal_dp12">
        <com.revolut.core.ui_kit.internal.views.ResizableTileHeaderView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/goalProgressTile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/InternalTextAppearance.Emphasis2"/>
        <com.revolut.core.ui_kit.views.StatusProgressBarView
            android:id="@+id/goalProgressTile_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/internal_dp4"
            android:progressDrawable="@drawable/internal_vaults_progress"
            android:screenReaderFocusable="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textAppearance="?attr/internal_textAppearanceBody3"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/goalProgressTile_bar_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp8"
            android:maxLines="2"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
