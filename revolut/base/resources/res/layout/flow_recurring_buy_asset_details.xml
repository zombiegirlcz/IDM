<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.kompot.view.ControllerContainerFrameLayout
        android:id="@+id/screen_transparent_container"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.buttons.TwinHorizontalButton
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:id="@+id/actionsPanel"
        android:background="@drawable/uikit_bottom_container_gradient"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
