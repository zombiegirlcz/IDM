<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarVaults
        android:id="@+id/subaccountInfoPickerNavBar"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/subaccountInfoPickerRecyclerView"
        android:paddingTop="16dp"
        android:paddingBottom="96dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarOverlappingScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/subaccountInfoPickerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp24"
        android:layout_marginBottom="?attr/uikit_dp24"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_anchor="@+id/subaccountInfoPickerRecyclerView"
        app:layout_anchorGravity="bottom"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
