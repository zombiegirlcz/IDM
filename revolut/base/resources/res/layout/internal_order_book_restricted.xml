<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/orderBookRestricted_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/uikit_colorWidgetBackground_20"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/orderBookRestricted_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/uikit_colorForeground"
        app:layout_constraintBottom_toTopOf="@+id/orderBookRestricted_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/uikit_icn_16_lock_closed"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/orderBookRestricted_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderBookRestricted_icon"
        app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
