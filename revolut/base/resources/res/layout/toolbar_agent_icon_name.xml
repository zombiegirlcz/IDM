<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar_custom_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height">
    <View
        android:id="@+id/toolbar_avatar_border"
        android:background="@drawable/background_shape_avatar_border"
        android:visibility="invisible"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="15dp"/>
    <ImageView
        android:id="@+id/toolbar_avatar"
        android:visibility="invisible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/toolbar_avatar_border"
        android:layout_centerVertical="true">
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_m"
            android:id="@+id/toolbar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/TransactionListItemHeader"/>
    </LinearLayout>
</RelativeLayout>
