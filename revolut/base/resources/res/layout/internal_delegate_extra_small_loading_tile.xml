<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/extraSmallLoadingTile_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/extraSmallLoadingTile_imageView"
            android:background="?attr/uikit_shimmerBackgroundCircle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/internal_extra_small_vertical_padding"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/extraSmallLoadingTile_titleText"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="102dp"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/extraSmallLoadingTile_descriptionText"
            app:layout_constraintHeight_min="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/extraSmallLoadingTile_imageView"
            app:layout_constraintVertical_bias="1"/>
        <View
            android:id="@+id/extraSmallLoadingTile_descriptionText"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="51dp"
            android:layout_height="16dp"
            android:layout_marginBottom="@dimen/internal_extra_small_vertical_padding"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
