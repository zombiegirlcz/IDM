<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/amountDualEdit_amount_1_stub"
        android:layout="@layout/internal_delegate_amount_dual_edit_input"
        android:inflatedId="@+id/amountDualEdit_amount_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/amountDualEdit_amount_1_facelifted_stub"
        android:layout="@layout/internal_delegate_amount_dual_edit_input_facelifted"
        android:inflatedId="@+id/amountDualEdit_amount_1_facelifted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/amountDualEdit_amount_1_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="amountDualEdit_amount_1,amountDualEdit_amount_1_facelifted"/>
    <ViewStub
        android:id="@+id/amountDualEdit_amount_2_stub"
        android:layout="@layout/internal_delegate_amount_dual_edit_input"
        android:inflatedId="@+id/amountDualEdit_amount_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amountDualEdit_amount_1_barrier"/>
    <ViewStub
        android:id="@+id/amountDualEdit_amount_2_facelifted_stub"
        android:layout="@layout/internal_delegate_amount_dual_edit_input_facelifted"
        android:inflatedId="@+id/amountDualEdit_amount_2_facelifted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amountDualEdit_amount_1_barrier"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/amountDualEdit_topBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="top"
        app:constraint_referenced_ids="amountDualEdit_amount_2,amountDualEdit_amount_2_facelifted"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/amountDualEdit_bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="amountDualEdit_amount_1,amountDualEdit_amount_1_facelifted"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/amountDualEdit_directionArrow"
        android:background="@drawable/internal_circle_white_bordered"
        android:padding="8dp"
        android:layout_width="@dimen/internal_dp32"
        android:layout_height="@dimen/internal_dp32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/amountDualEdit_topBarrier"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amountDualEdit_bottomBarrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
