<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/image_text_root"
    android:background="@drawable/deprecated_background_selectable_transparent"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/layout_icon_with_badges"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintRight_toLeftOf="@+id/right_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="spread"
        app:layout_goneMarginRight="16dp"
        app:ttv_typeface="medium"/>
    <ImageView
        android:id="@+id/presubtitle_icon"
        android:background="@drawable/deprecated_background_selectable_transparent"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintLeft_toLeftOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/subtitle"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_s"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="6dp"
        app:layout_constraintBottom_toTopOf="@+id/message"
        app:layout_constraintLeft_toRightOf="@+id/presubtitle_icon"
        app:layout_constraintRight_toRightOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"
        app:ttv_typeface="regular"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_s"
        android:textColor="?attr/uikit_colorPink"
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/title"
        app:layout_constraintRight_toRightOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:ttv_typeface="regular"/>
    <ImageView
        android:id="@+id/right_icon"
        android:background="@drawable/deprecated_background_selectable_transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/title"
        app:layout_constraintRight_toLeftOf="@+id/right_icon2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="16dp"/>
    <ProgressBar
        android:id="@+id/progress"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/right_icon2"
        android:background="@drawable/deprecated_selectable_circle_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="100"
        app:layout_constraintRight_toLeftOf="@+id/label"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="14sp"
        android:textColor="?attr/uikit_colorAccent"
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttv_typeface="medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
