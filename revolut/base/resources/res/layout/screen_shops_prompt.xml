<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenContainer"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.background.AnimatedBackgroundView
        android:id="@+id/shopsPrompt_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/shopsPrompt_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
