<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/basicNavBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/basicNavBar_expandedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar"
        style="?attr/internal_textAppearanceHeading1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/basicNavBar_expandedSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar_expandedTitle"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/tripsListScreen_coordinatorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basicNavBar">
        <com.revolut.core.ui_kit.internal.dialogs.BottomExpandableDialogView
            android:id="@+id/tripsListScreen_expandableDialogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_anchorGravity="bottom"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
