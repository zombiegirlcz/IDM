<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:layout_gravity="center_vertical"
        android:id="@+id/revPointsPrice_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/revPointsPrice_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/internal_textAppearanceHeading3"/>
</merge>
