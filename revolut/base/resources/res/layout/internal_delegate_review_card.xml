<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/reviewCard_ratingTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody1"/>
    <TextView
        android:id="@+id/reviewCard_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/uikit_dp32"
        app:layout_constraintEnd_toStartOf="@+id/reviewCard_ratingTag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:id="@+id/reviewCard_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:layout_marginEnd="?attr/uikit_dp32"
        app:layout_constraintEnd_toStartOf="@+id/reviewCard_ratingTag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reviewCard_title"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/reviewCard_sourceImage"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reviewCard_subtitle"/>
    <TextView
        android:id="@+id/reviewCard_sourceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/reviewCard_sourceImage"
        app:layout_constraintTop_toBottomOf="@+id/reviewCard_subtitle"
        app:layout_goneMarginStart="?attr/uikit_dp0"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/reviewCard_description"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="4"
        android:lines="4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reviewCard_sourceName"
        style="?attr/internal_textAppearanceBody2"/>
    <TextView
        android:textColor="?attr/uikit_colorAccent"
        android:id="@+id/reviewCard_actionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reviewCard_description"
        style="?attr/internal_textAppearanceEmphasis2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
