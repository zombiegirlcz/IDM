<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:focusable="true"
    android:clickable="true"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.CutoutImageView
        android:layout_gravity="center"
        android:id="@+id/navBarMenuItem_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="4dp"
        android:scaleType="fitCenter"/>
    <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
        android:layout_gravity="end|bottom"
        android:id="@+id/navBarMenuItem_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:uikit_circle_badge_size="small"/>
</FrameLayout>
