<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenProfileCard_root"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.background.AnimatedBackgroundView
        android:id="@+id/screenProfileCard_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/screenProfileCard_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.TiltGlowCardContainerView
        android:layout_gravity="center"
        android:id="@+id/screenProfileCard_tiltContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:glowCornerRadius="24dp"
        app:glowIntensity="0.8">
        <com.revolut.core.ui_kit.views.ProfileCardView
            android:layout_gravity="center"
            android:id="@+id/screenProfileCard_profileCard"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"/>
    </com.revolut.core.ui_kit.views.TiltGlowCardContainerView>
    <com.revolut.core.ui_kit.views.CircleActionButtonsBarView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/screenProfileCard_circleActionButtonsBar"
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"/>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
