<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/headerLayout_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <View
                android:id="@+id/headerLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="24dp"
                app:layout_constraintEnd_toStartOf="@+id/headerLoading_profileAvatar"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_percent="0.5"/>
            <View
                android:id="@+id/headerLoading_description"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="?attr/uikit_dp16"
                app:layout_constraintEnd_toStartOf="@+id/headerLoading_profileAvatar"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/headerLoading_title"
                app:layout_constraintTop_toBottomOf="@+id/headerLoading_title"
                app:layout_constraintWidth_percent="0.7"/>
            <View
                android:id="@+id/headerLoading_secondaryDescription"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/headerLoading_profileAvatar"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/headerLoading_title"
                app:layout_constraintTop_toBottomOf="@+id/headerLoading_description"
                app:layout_constraintWidth_percent="0.3"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/headerLoading_profileAvatar"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/headerLoading_title"
                app:srcCompat="@drawable/internal_circle_gradient_grey"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</merge>
