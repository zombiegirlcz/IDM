<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarLargeCentred_navBarLayout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="56dp"
    app:layout_scrollFlags="exitUntilCollapsed|scroll">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/navBarLargeCentred_loadingShimmer"
        android:paddingBottom="@dimen/internal_dp24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/navBarLargeCentred_imageLoading"
                android:background="@drawable/uikit_shape_circle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:backgroundTint="?attr/uikit_colorShimmer"
                app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_titleLoading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/navBarLargeCentred_titleLoading"
                android:background="@drawable/internal_background_rounded_gray"
                android:layout_width="174dp"
                android:layout_height="@dimen/internal_dp24"
                android:layout_marginTop="@dimen/internal_dp24"
                android:layout_marginBottom="@dimen/internal_dp8"
                android:backgroundTint="?attr/uikit_colorShimmer"
                app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_subtitleLoading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_imageLoading"/>
            <View
                android:id="@+id/navBarLargeCentred_subtitleLoading"
                android:background="@drawable/internal_background_rounded_gray"
                android:layout_width="224dp"
                android:layout_height="@dimen/internal_dp16"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="@dimen/internal_dp8"
                android:backgroundTint="?attr/uikit_colorShimmer"
                app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_descriptionLoading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_titleLoading"/>
            <View
                android:id="@+id/navBarLargeCentred_descriptionLoading"
                android:background="@drawable/internal_background_rounded_gray"
                android:layout_width="104dp"
                android:layout_height="@dimen/internal_dp16"
                android:layout_marginTop="@dimen/internal_dp8"
                android:backgroundTint="?attr/uikit_colorShimmer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_subtitleLoading"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navBarLargeCentred_headerContainerLayout"
        android:paddingBottom="@dimen/internal_dp24"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="spread"
        app:layout_constraintHeight_min="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_menuLayout">
        <com.revolut.core.ui_kit.views.AvatarView
            android:id="@+id/navBarLargeCentred_headerImageView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.revolut.core.ui_kit.internal.views.LabelView
            android:textAppearance="?attr/internal_textAppearanceEmphasis1"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="end|center_vertical"
            android:id="@+id/navBarLargeCentred_headerTopLabel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp16"
            android:layout_marginHorizontal="@dimen/internal_dp16"
            app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_headerTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_headerImageView"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginTop="@dimen/internal_dp24"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center_horizontal"
            android:id="@+id/navBarLargeCentred_headerTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/internal_dp16"
            app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_headerSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_headerTopLabel"
            app:layout_goneMarginTop="@dimen/internal_dp16"
            style="?attr/internal_textAppearanceHeading1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center_horizontal"
            android:id="@+id/navBarLargeCentred_headerSubtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp8"
            android:layout_marginHorizontal="@dimen/internal_dp16"
            app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_headerDescription"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_headerTitle"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="center_horizontal"
            android:id="@+id/navBarLargeCentred_headerDescription"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp4"
            android:layout_marginHorizontal="@dimen/internal_dp16"
            app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_actionsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_headerSubtitle"
            style="?attr/internal_textAppearanceBody2"/>
        <FrameLayout
            android:id="@+id/navBarLargeCentred_actionsContainer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp16"
            app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_headerDescription"
            app:layout_goneMarginTop="@dimen/internal_dp16">
            <ViewStub
                android:id="@+id/navBarLargeCentred_actionsViewStub"
                android:layout="@layout/internal_view_nav_bar_large_centred_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/navBarLargeCentred_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/navBarLargeCentred_switcherButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_actionsContainer"
            app:layout_goneMarginTop="@dimen/internal_dp16"/>
        <com.revolut.core.ui_kit.internal.views.switcher_button.SwitcherButtonView
            android:id="@+id/navBarLargeCentred_switcherButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBarLargeCentred_badge"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/navBarLargeCentred_toolbarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/navBarLargeCentred_menuLayout"
        app:layout_constraintEnd_toEndOf="@+id/navBarLargeCentred_menuLayout"
        app:layout_constraintStart_toStartOf="@+id/navBarLargeCentred_menuLayout"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/navBarLargeCentred_menuLayout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
            android:layout_gravity="center_vertical"
            android:id="@+id/navBarLargeCentred_navigationButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="@dimen/dp_8"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/uikit.navigate_up.description"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/navBarLargeCentred_toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:alpha="0"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/navBarLargeCentred_menuRecyclerView"
            app:layout_constraintStart_toEndOf="@+id/navBarLargeCentred_navigationButton"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceHeading3"/>
        <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
            android:orientation="horizontal"
            android:id="@+id/navBarLargeCentred_menuRecyclerView"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout>
