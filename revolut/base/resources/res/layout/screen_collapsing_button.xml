<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/screenCollapsingButton_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/screenCollapsingButton_recyclerView"
        android:paddingBottom="@dimen/dp_96"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.buttons.CollapsingActionButton
        android:layout_gravity="bottom"
        android:id="@+id/screenCollapsingButton_button"
        android:paddingLeft="?attr/uikit_dp16"
        android:paddingRight="?attr/uikit_dp16"
        android:paddingBottom="?attr/uikit_dp24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
