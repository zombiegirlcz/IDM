<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/cellDetailsPrice_titleWithIcon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsPrice_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/cellDetailsPrice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            android:layout_marginBottom="?attr/uikit_dp8"
            android:maxLines="1"
            android:drawablePadding="?attr/uikit_dp8"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp32"
            app:drawableTint="?attr/uikit_colorGreyTone50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cellDetailsPrice_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </LinearLayout>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/cellDetailsPrice_strikethroughPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="@+id/cellDetailsPrice_price"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsPrice_price"
        style="?attr/internal_textAppearanceBody1"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/cellDetailsPrice_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/cellDetailsPrice_titleWithIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cellDetailsPrice_titleWithIcon"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/cellDetailsPrice_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="cellDetailsPrice_strikethroughPrice"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cellDetailsPrice_bottomLine"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginHorizontal="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellDetailsPrice_price">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cellDetailsPrice_noteImage"
            android:paddingTop="@dimen/internal_dp4"
            android:paddingBottom="@dimen/internal_dp16"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="40dp"
            android:paddingEnd="@dimen/internal_dp8"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/cellDetailsPrice_noteText"
            android:paddingTop="@dimen/internal_dp4"
            android:paddingBottom="@dimen/internal_dp16"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="?attr/internal_textAppearanceBody2"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
