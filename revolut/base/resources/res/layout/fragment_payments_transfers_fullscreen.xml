<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/wtt_navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/wtt_recyclerView"
        android:paddingBottom="?attr/uikit_dp72"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:splitMotionEvents="false"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.LabeledVerticalScrollView
        android:layout_gravity="end|bottom"
        android:id="@+id/wtt_labeledRecyclerViewScroller"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
