<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:padding="?attr/uikit_dp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/counterText_closeButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/common.action.dismiss"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_16_cross_small"
        app:tint="?attr/uikit_colorGreyTone50"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center_horizontal"
        android:id="@+id/counterText_topSectionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/counterText_valueSectionTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/counterText_topSectionIcon"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/counterText_valueSectionTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/counterText_topSectionLabelLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/counterText_valueSectionTitleLoading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="56dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/counterText_topSectionIconLoading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/counterText_valueSectionTitleLoading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            android:id="@+id/counterText_topSectionIconLoadingView"
            android:background="?attr/uikit_shimmerBackgroundCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/counterText_topSectionBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="counterText_topSectionLabel, counterText_topSectionIcon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/counterText_valueSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_topSectionBarrier"
        style="?attr/internal_textAppearanceHeading1"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/counterText_valueSectionTitleLoading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="41dp"
        android:layout_marginEnd="41dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_topSectionBarrier">
        <View
            android:layout_gravity="center"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="11dp"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/counterText_valueSectionTitleBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="counterText_valueSectionTitle, counterText_valueSectionTitleLoading"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center_horizontal"
        android:id="@+id/counterText_valueSectionDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_valueSectionTitleBarrier"
        style="?attr/internal_textAppearanceBody3"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/counterText_valueSectionDescriptionLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_valueSectionTitleBarrier">
        <View
            android:layout_gravity="center"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="72dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/counterText_valueSectionDescriptionBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="counterText_valueSectionDescription, counterText_valueSectionDescriptionLoading"/>
    <com.revolut.core.ui_kit.internal.views.timer.CountDownTimerView
        android:id="@+id/counterText_bottomSectionCountDownTimer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_valueSectionDescriptionBarrier"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/counterText_bottomSectionCountDownTimerLoading"
        android:layout_width="170dp"
        android:layout_height="68dp"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_valueSectionDescriptionBarrier">
        <View
            android:layout_gravity="center"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.revolut.core.ui_kit.internal.views.LinearGaugeChartView
        android:id="@+id/counterText_bottomSectionLinearGaugeChartView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_valueSectionDescription"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <com.revolut.core.ui_kit.internal.views.chart.HorizontalSingleLineChartLegendView
        android:id="@+id/counterText_bottomSectionChartLegend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_bottomSectionLinearGaugeChartView"/>
    <ProgressBar
        android:id="@+id/counterText_bottomSectionProgressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="20dp"
        android:progressDrawable="@drawable/internal_progress_accent"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:screenReaderFocusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_valueSectionDescription"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center_horizontal"
        android:id="@+id/counterText_bottomSectionProgressDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_bottomSectionProgressBar"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/counterText_bottomSectionActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/counterText_valueSectionDescription"
        app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
