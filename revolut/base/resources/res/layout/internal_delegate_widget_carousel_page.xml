<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetCarouselPageDelegate_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/internal_dp16"
    android:paddingVertical="@dimen/internal_dp24">
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/widgetCarouselPageDelegate_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/widgetCarouselPageDelegate_recycler"
        app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/widgetCarouselPageDelegate_startGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="25"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/widgetCarouselPageDelegate_endGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="75"/>
    <com.revolut.recyclerkit.UIKitRecyclerView
        android:id="@+id/widgetCarouselPageDelegate_recycler"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/widgetCarouselPageDelegate_btn"
        app:layout_constraintEnd_toEndOf="@+id/widgetCarouselPageDelegate_endGuideline"
        app:layout_constraintStart_toStartOf="@+id/widgetCarouselPageDelegate_startGuideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
</androidx.constraintlayout.widget.ConstraintLayout>
