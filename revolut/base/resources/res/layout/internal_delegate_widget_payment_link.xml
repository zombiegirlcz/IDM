<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/paymentLinkWidget_constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/paymentLinkWidget_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textStyle="bold"
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/paymentLinkWidget_imageActionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/paymentLinkWidget_image"
            app:layout_constraintEnd_toEndOf="@+id/paymentLinkWidget_image"
            app:layout_constraintStart_toStartOf="@+id/paymentLinkWidget_image"
            app:layout_constraintTop_toTopOf="@+id/paymentLinkWidget_image"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/paymentLinkWidget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toStartOf="@+id/paymentLinkWidget_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/paymentLinkWidget_image"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/paymentLinkWidget_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="3"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/paymentLinkWidget_image"
            app:layout_constraintEnd_toStartOf="@+id/paymentLinkWidget_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/paymentLinkWidget_title"
            app:layout_constraintVertical_bias="0"
            style="?attr/internal_textAppearanceBody2"/>
        <com.revolut.core.ui_kit.views.LabelButtonView
            android:id="@+id/paymentLinkWidget_actionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/paymentLinkWidget_image"
            app:layout_constraintEnd_toStartOf="@+id/paymentLinkWidget_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
