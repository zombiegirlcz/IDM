<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/searchButton_searchContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_weight="1"
        android:paddingStart="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/searchButton_iconSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="?attr/uikit_colorGreyTone50"
            android:layout_marginEnd="8dp"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/searchButton_searchText"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:lines="1"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:layout_marginEnd="8dp"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="center"
            android:id="@+id/searchButton_leftButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="center"
            android:id="@+id/searchButton_rightButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/searchButton_filterIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:layout_marginStart="8dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/searchButton_sortingIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerInside"
        android:tint="?attr/uikit_colorAccentNeutral"
        android:layout_marginStart="8dp"
        app:srcCompat="@drawable/uikit_icn_24_arrows_sort"/>
</merge>
