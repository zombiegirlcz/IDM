<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/centeredAmountView_topLabelText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/centeredAmountView_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.AmountInputView
        android:id="@+id/centeredAmountView_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/centeredAmountView_topLabelText"
        app:layout_goneMarginTop="0dp"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/centeredAmountView_fiatSwitcherText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/centeredAmountView_input"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/centeredAmountView_hintIcon"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/centeredAmountView_hintText"
        app:layout_constraintEnd_toStartOf="@+id/centeredAmountView_hintText"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/centeredAmountView_hintText"
        app:srcCompat="@drawable/uikit_icn_24_info"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:gravity="center"
        android:id="@+id/centeredAmountView_hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/centeredAmountView_hintIcon"
        app:layout_constraintTop_toBottomOf="@+id/centeredAmountView_fiatSwitcherText"
        app:layout_goneMarginStart="@dimen/dp_16"
        app:layout_goneMarginTop="@dimen/dp_8"
        style="?attr/internal_textAppearanceBody2"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/centeredAmountView_hintShimmer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/centeredAmountView_fiatSwitcherText"
        app:layout_goneMarginTop="@dimen/dp_8">
        <androidx.appcompat.widget.AppCompatTextView
            android:background="@drawable/internal_amount_edit_rectangle_gradient_grey"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceBody2"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/centeredAmountView_hintGroup"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="centeredAmountView_hintShimmer, centeredAmountView_hintText"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/centeredAmountView_secondHintIcon"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/centeredAmountView_secondHintText"
        app:layout_constraintEnd_toStartOf="@+id/centeredAmountView_secondHintText"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/centeredAmountView_secondHintText"
        app:srcCompat="@drawable/uikit_icn_24_info"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:gravity="center"
        android:id="@+id/centeredAmountView_secondHintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:textAlignment="center"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/centeredAmountView_secondHintIcon"
        app:layout_constraintTop_toBottomOf="@+id/centeredAmountView_hintGroup"
        app:layout_goneMarginStart="@dimen/dp_16"
        style="?attr/internal_textAppearanceBody2"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/centeredAmountView_secondHintShimmer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/centeredAmountView_hintGroup">
        <androidx.appcompat.widget.AppCompatTextView
            android:background="@drawable/internal_amount_edit_rectangle_gradient_grey"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceBody2"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/centeredAmountView_secondHintGroup"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="centeredAmountView_secondHintShimmer, centeredAmountView_secondHintText"/>
    <com.revolut.core.ui_kit.internal.views.switcher_button.SwitcherButtonView
        android:id="@+id/centeredAmountView_currencyPickerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/centeredAmountView_secondHintGroup"/>
</merge>
