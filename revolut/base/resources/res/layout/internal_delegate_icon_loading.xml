<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iconLoading_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/internal_accent_light_gradient_background"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/iconLoading_shimmeringView"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconLoading_image">
        <View
            android:id="@+id/iconLoading_titleLoading"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="match_parent"
            android:layout_height="?attr/uikit_dp16"
            android:layout_marginTop="?attr/uikit_dp8"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
