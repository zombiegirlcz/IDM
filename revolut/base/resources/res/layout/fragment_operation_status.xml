<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:fitNavigationBar="true">
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="96dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/full_screen_content_max_width">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/operation_state_animation_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/full_screen_content_max_width"
                app:layout_constraintBottom_toTopOf="@+id/operation_state_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed">
                <com.revolut.core.ui_kit.views.FullScreenStateView
                    android:id="@+id/player_view"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="W,1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/operation_state_animation_big"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="W,1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.revolut.core.ui_kit.views.CircleClipView
                    android:id="@+id/operation_state_animation_big_mask"
                    android:padding="32dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="W,1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/operation_state_image_big"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintDimensionRatio="W,1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/operation_state_animation"
                    android:visibility="gone"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:lottie_autoPlay="false"/>
                <com.revolut.core.ui_kit.views.CircleClipView
                    android:id="@+id/operation_state_animation_mask"
                    android:padding="32dp"
                    android:visibility="gone"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
                <ImageView
                    android:id="@+id/operation_state_image"
                    android:visibility="gone"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
                <ProgressBar
                    android:id="@+id/operation_state_progress"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorForeground"
                android:gravity="center_horizontal"
                android:id="@+id/operation_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toTopOf="@+id/operation_state_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/operation_state_animation_container"
                app:layout_constraintWidth_max="@dimen/full_screen_content_max_width"
                app:layout_goneMarginTop="24dp"
                style="?attr/internal_textAppearanceHeading3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:gravity="center_horizontal"
                android:id="@+id/operation_state_subtitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toTopOf="@+id/operation_state_link"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/operation_state_title"
                app:layout_constraintWidth_max="@dimen/full_screen_content_max_width"
                style="?attr/internal_textAppearanceBody2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorAccent"
                android:gravity="center"
                android:id="@+id/operation_state_link"
                android:paddingTop="@dimen/padding6"
                android:paddingBottom="@dimen/padding6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/operation_state_subtitle"
                app:layout_constraintWidth_max="@dimen/full_screen_content_max_width"
                style="?attr/internal_textAppearanceBody2"/>
            <com.revolut.core.ui_kit.views.LargeActionButton
                android:id="@+id/bottom_above_next_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_max="@dimen/full_screen_content_max_width"
                app:uikit_LargeActionButtonStyle="FlatButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout>
