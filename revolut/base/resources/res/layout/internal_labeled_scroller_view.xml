<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="end"
    android:id="@+id/layout_scroller"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:minWidth="@dimen/dp_16">
    <TextView
        android:textColor="@color/internal_white"
        android:gravity="center"
        android:id="@+id/textView_track"
        android:background="@drawable/internal_shape_circled_rect_accent"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_8"
        style="?attr/internal_textAppearanceHeading1"/>
</FrameLayout>
