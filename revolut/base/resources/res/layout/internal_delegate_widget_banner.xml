<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/bannerWidget_title"
            android:paddingTop="?attr/uikit_dp8"
            android:paddingBottom="?attr/uikit_dp12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/uikit_dp12"
            android:paddingEnd="?attr/uikit_dp12"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_weight="1">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/bannerWidget_image"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.revolut.core.ui_kit.internal.views.UIKitTextView
                    android:textColor="?attr/uikit_colorForeground"
                    android:ellipsize="end"
                    android:id="@+id/bannerWidget_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/bannerWidget_description"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/bannerWidget_image"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_goneMarginBottom="16dp"
                    style="?attr/internal_textAppearanceEmphasis1"/>
                <com.revolut.core.ui_kit.internal.views.UIKitTextView
                    android:textColor="?attr/uikit_colorGreyTone50"
                    android:ellipsize="end"
                    android:id="@+id/bannerWidget_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/bannerWidget_image"
                    app:layout_constraintTop_toBottomOf="@+id/bannerWidget_label"
                    app:layout_goneMarginTop="16dp"
                    style="?attr/internal_textAppearanceBody2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
