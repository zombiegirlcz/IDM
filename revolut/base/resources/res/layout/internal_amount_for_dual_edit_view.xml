<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.revolut.core.ui_kit.internal.views.LabelView
        android:textAppearance="?attr/internal_textAppearanceEmphasis1"
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="start|center_vertical"
        android:id="@+id/amountForDualEdit_amountTypeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:endIconPadding="4dp"
        app:startIconPadding="8dp"
        app:startIconSize="24dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/amountForDualEdit_startHintContainer"
        android:paddingTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/amountForDualEdit_startHintIcon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:tint="?attr/uikit_colorForeground"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/uikit_icn_16_chevron_down"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGrey50"
            android:ellipsize="end"
            android:id="@+id/amountForDualEdit_startHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="?attr/internal_textAppearanceBody2"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/amountForDualEdit_startHintShimmer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/internal_amount_edit_rectangle_gradient_grey"
                android:layout_width="109dp"
                android:layout_height="12dp"
                style="?attr/internal_textAppearanceBody2"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/amountForDualEdit_amountInputContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp">
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/amountForDualEdit_amountInputShimmer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:background="@drawable/internal_amount_edit_rectangle_gradient_grey"
                    android:layout_width="80dp"
                    android:layout_height="24dp"
                    style="?attr/internal_textAppearanceHeading1"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/amountForDualEdit_amountInputPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="?attr/internal_textAppearanceHeading1"/>
            <com.revolut.core.ui_kit.views.input.MaskedTextInputEditText
                android:textColorHint="?attr/uikit_colorGreyTone50"
                android:gravity="end"
                android:id="@+id/amountForDualEdit_amountInputText"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="0"
                android:singleLine="true"
                android:digits="0123456789.,"
                android:inputType="numberDecimal"
                app:errorEnabled="false"
                app:hintEnabled="false"
                style="?attr/internal_textAppearanceHeading1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:ellipsize="end"
                android:id="@+id/amountForDualEdit_amountInputResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="?attr/internal_textAppearanceHeading1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:id="@+id/amountForDualEdit_amountInputSuffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="?attr/internal_textAppearanceHeading1"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/amountForDualEdit_endHintContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/amountForDualEdit_endHintIcon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"/>
        <com.revolut.core.ui_kit.internal.views.AlignedTextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/amountForDualEdit_endHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceBody2"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/amountForDualEdit_endHintShimmer"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:background="@drawable/internal_amount_edit_rectangle_gradient_grey"
                android:layout_width="84dp"
                android:layout_height="12dp"
                style="?attr/internal_textAppearanceBody2"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>
</merge>
