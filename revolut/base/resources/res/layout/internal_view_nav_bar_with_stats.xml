<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarWithStats_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    app:layout_scrollFlags="exitUntilCollapsed|scroll">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/navBarWithStats_guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="0dp"/>
    <com.revolut.recyclerkit.UIKitRecyclerView
        android:id="@+id/navBarWithStats_statsRecyclerView"
        android:paddingBottom="@dimen/internal_dp16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithStats_menuLayout"/>
    <ViewStub
        android:id="@+id/navBarWithStats_descriptionStub"
        android:layout="@layout/internal_view_nav_bar_with_stats_description"
        android:inflatedId="@+id/navBarWithStats_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:layout_marginBottom="@dimen/internal_dp12"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithStats_statsRecyclerView"/>
    <View
        android:id="@+id/navBarWithStats_toolbarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/navBarWithStats_menuLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithStats_guidelineTop"/>
    <com.revolut.core.ui_kit.internal.views.linearlayout.UIKitLinearLayout
        android:orientation="vertical"
        android:id="@+id/navBarWithStats_menuLayout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithStats_guidelineTop">
        <com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout
            android:id="@+id/navBarWithStats_innerMenuLayout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp">
            <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
                android:layout_gravity="center_vertical"
                android:id="@+id/navBarWithStats_navigationButton"
                android:background="@drawable/internal_oval_ripple"
                android:padding="@dimen/dp_8"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/uikit.navigate_up.description"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.revolut.core.ui_kit.internal.views.switcher_button.SwitcherButtonView
                android:id="@+id/navBarWithStats_switcherButton"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/navBarWithStats_navigationButton"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorForeground"
                android:ellipsize="end"
                android:id="@+id/navBarWithStats_toolbarTitleChained"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/navBarWithStats_toolbarSubtitleChained"
                app:layout_constraintEnd_toStartOf="@+id/navBarWithStats_menuRecyclerView"
                app:layout_constraintStart_toEndOf="@+id/navBarWithStats_switcherButton"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="?attr/internal_textAppearanceEmphasis1"/>
            <com.revolut.core.ui_kit.internal.views.UIKitTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:ellipsize="end"
                android:id="@+id/navBarWithStats_toolbarSubtitleChained"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/navBarWithStats_menuRecyclerView"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/navBarWithStats_switcherButton"
                app:layout_constraintTop_toBottomOf="@+id/navBarWithStats_toolbarTitleChained"
                app:layout_constraintVertical_chainStyle="packed"
                style="?attr/internal_textAppearanceBody2"/>
            <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
                android:orientation="horizontal"
                android:id="@+id/navBarWithStats_menuRecyclerView"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintHeight_max="56dp"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:theme="@style/UiKitThemeOverlay.FcaDisclaimer"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/navBarWithStats_headerDisclaimerSticky"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="16dp"
            style="?attr/internal_textAppearanceFcaDisclaimerEmphasised"/>
    </com.revolut.core.ui_kit.internal.views.linearlayout.UIKitLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
