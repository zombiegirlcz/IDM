<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/deprecated_background_selectable_transparent"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">
    <ImageView
        android:id="@+id/dialog_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="32dp"
        android:layout_alignParentStart="true"
        app:srcCompat="@drawable/ic_outline_info_m"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:ellipsize="end"
        android:id="@+id/dialog_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/dialog_item_checked_tick"
        android:layout_toEndOf="@+id/dialog_item_icon"
        style="@style/MainText.Primary"/>
    <ImageView
        android:id="@+id/dialog_item_checked_tick"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/ic_checkmark_m"/>
</RelativeLayout>
