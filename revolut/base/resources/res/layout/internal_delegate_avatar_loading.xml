<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/avatarLoading_shimmeringView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/avatarLoading_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/avatarLoading_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/avatarLoading_title"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:srcCompat="@drawable/internal_circle_gradient_grey"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/avatarLoading_cardImage"
            android:visibility="invisible"
            android:layout_width="56dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatarLoading_image"
            app:layout_constraintEnd_toEndOf="@+id/avatarLoading_image"
            app:layout_constraintStart_toStartOf="@+id/avatarLoading_image"
            app:layout_constraintTop_toTopOf="@+id/avatarLoading_image"
            app:srcCompat="@drawable/internal_card_gradient_grey"/>
        <View
            android:id="@+id/avatarLoading_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="56dp"
            android:layout_height="16dp"
            android:layout_marginTop="?attr/uikit_dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatarLoading_image"
            app:layout_constraintWidth_percent="0.6"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
