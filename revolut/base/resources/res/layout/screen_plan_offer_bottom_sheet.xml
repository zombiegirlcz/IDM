<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/planOfferBottomSheet_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.FadingImageBackgroundLayout
        android:id="@+id/planOfferBottomSheet_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.ui_kit_artboard.PlainLabelView
            android:id="@+id/planOfferBottomSheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="332dp"
            app:layout_constraintBottom_toTopOf="@+id/planOfferBottomSheet_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.ui_kit_artboard.PlainLabelView
            android:id="@+id/planOfferBottomSheet_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/planOfferBottomSheet_footerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/planOfferBottomSheet_title"/>
        <com.revolut.core.ui_kit.views.buttons.ActionFooterView
            android:id="@+id/planOfferBottomSheet_footerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/planOfferBottomSheet_description"/>
    </com.revolut.core.ui_kit.views.FadingImageBackgroundLayout>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
