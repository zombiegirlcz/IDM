<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/uikit_colorBackground"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/inAppBrowserBottomBar_backButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tint="@color/internal_color_in_app_browser_button_states"
            android:layout_marginStart="16dp"
            android:tintMode="src_in"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/inAppBrowserBottomBar_forwardButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"
            app:srcCompat="@drawable/uikit_icn_24_chevron_left"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/inAppBrowserBottomBar_forwardButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tint="@color/internal_color_in_app_browser_button_states"
            android:layout_marginStart="16dp"
            android:tintMode="src_in"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/inAppBrowserBottomBar_backButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"
            app:srcCompat="@drawable/uikit_icn_24_chevron_right"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:layout_gravity="center_vertical"
            android:id="@+id/inAppBrowserBottomBar_actionButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/inAppBrowserBottomBar_optionsButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
