<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/tabLayoutContainer"
        android:background="@drawable/internal_fixed_tabs_background_dark"
        android:layout_width="0dp"
        android:layout_height="?attr/uikit_fixed_tab_layout_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.revolut.core.ui_kit.views.CustomTabLayoutView
            android:id="@+id/tabLayout"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:tabBackground="@null"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/internal_fixed_tabs_selector"
            app:tabIndicatorColor="?attr/uikit_colorSegmentedActive"
            app:tabIndicatorHeight="?attr/uikit_fixed_tab_height"
            app:tabMaxWidth="0dp"
            app:tabMode="fixed"
            app:tabPaddingBottom="0dp"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingTop="0dp"
            app:tabRippleColor="@null"/>
    </FrameLayout>
</merge>
