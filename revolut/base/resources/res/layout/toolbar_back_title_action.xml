<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_custom_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height">
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/toolbar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/toolbar_action"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ToolbarTitle"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="16sp"
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/toolbar_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hide"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ToolbarRightButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
