<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/uikit_windowBackground"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/inAppBrowserTopBar_closeButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/uikit_icn_24_cross"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/inAppBrowserTopBar_urlIcon"
            android:background="@drawable/internal_oval_ripple"
            android:clickable="false"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:tint="?attr/uikit_colorGreyTone50"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/inAppBrowserTopBar_url"
            app:layout_constraintEnd_toStartOf="@+id/inAppBrowserTopBar_url"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/inAppBrowserTopBar_closeButton"
            app:layout_constraintTop_toTopOf="@+id/inAppBrowserTopBar_url"
            app:srcCompat="@drawable/uikit_icn_24_lock_closed"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/inAppBrowserTopBar_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/inAppBrowserTopBar_refreshButton"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/inAppBrowserTopBar_urlIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/inAppBrowserTopBar_refreshButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tint="@color/internal_color_in_app_browser_button_states"
            android:layout_marginEnd="16dp"
            android:tintMode="src_in"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/uikit_icn_24_retry"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
