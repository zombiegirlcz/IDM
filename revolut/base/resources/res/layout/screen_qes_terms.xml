<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/qesTerms_recyclerView"
        android:paddingBottom="@dimen/dp_80"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/qesTerms_navBarWithToolbarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.buttons.TwinVerticalButton
        android:layout_gravity="bottom"
        android:id="@+id/qesTerms_twinVerticalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.revolut.core.ui_kit.views.buttons.CollapsibleButtonBehavior"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
