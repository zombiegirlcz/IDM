<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/businessPlan_shimmerLayout"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/businessPlanLoading_image"
        android:background="@drawable/internal_circle_gradient_grey"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/businessPlanLoading_title"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="?attr/uikit_dp14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/businessPlanLoading_image"
        app:layout_constraintWidth_percent="0.4"/>
    <View
        android:id="@+id/businessPlanLoading_subtitle"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="?attr/uikit_dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/businessPlanLoading_title"
        app:layout_constraintWidth_percent="0.6"/>
    <View
        android:id="@+id/businessPlanLoading_subtitleFooter"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="?attr/uikit_dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/businessPlanLoading_subtitle"
        app:layout_constraintWidth_percent="0.5"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/businessPlanLoading_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/businessPlanLoading_subtitleFooter"
        app:uikit_SmallActionButtonStyle="SemiBlackButton"/>
    <View
        android:id="@+id/businessPlanLoading_highlight1"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/businessPlanLoading_action"/>
    <View
        android:id="@+id/businessPlanLoading_highlight2"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/businessPlanLoading_highlight1"/>
    <View
        android:id="@+id/businessPlanLoading_highlight3"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/businessPlanLoading_highlight2"/>
    <View
        android:id="@+id/businessPlanLoading_highlight4"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/businessPlanLoading_highlight3"/>
</com.facebook.shimmer.ShimmerConstraintLayout>
