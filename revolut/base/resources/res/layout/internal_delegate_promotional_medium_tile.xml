<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="164dp">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/promotionalMediumTile_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/promotionalMediumTile_foregroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/promotionalMediumTile_background"
        app:layout_constraintEnd_toEndOf="@+id/promotionalMediumTile_background"
        app:layout_constraintStart_toStartOf="@+id/promotionalMediumTile_background"
        app:layout_constraintTop_toTopOf="@+id/promotionalMediumTile_background"/>
    <com.revolut.core.ui_kit.views.BadgeStatusView
        android:id="@+id/promotionalMediumTile_topLeftBadge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp4"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/promotionalMediumTile_title"
        app:layout_constraintEnd_toStartOf="@+id/promotionalMediumTile_closeIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/promotionalMediumTile_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/promotionalMediumTile_topLeftStatusIcon"
        android:visibility="gone"
        android:layout_width="?attr/uikit_dp16"
        android:layout_height="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/promotionalMediumTile_topLeftStatusLabel"
        app:layout_constraintEnd_toEndOf="@+id/promotionalMediumTile_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/promotionalMediumTile_title"
        app:layout_constraintTop_toTopOf="@+id/promotionalMediumTile_topLeftStatusLabel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/promotionalMediumTile_topLeftStatusLabel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/promotionalMediumTile_title"
        app:layout_constraintEnd_toStartOf="@+id/promotionalMediumTile_closeIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/promotionalMediumTile_topLeftStatusIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.6"
        app:layout_goneMarginEnd="0dp"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/promotionalMediumTile_closeIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/promotionalMediumTile_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/promotionalMediumTile_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/promotionalMediumTile_title"
        app:layout_constraintTop_toBottomOf="@+id/promotionalMediumTile_subtitle"
        app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:ellipsize="end"
        android:id="@+id/promotionalMediumTile_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/promotionalMediumTile_subtitle"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/promotionalMediumTile_topLeftStatusLabel"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.6"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:ellipsize="end"
        android:id="@+id/promotionalMediumTile_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/promotionalMediumTile_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/promotionalMediumTile_background"
        app:layout_constraintTop_toBottomOf="@+id/promotionalMediumTile_title"
        app:layout_constraintWidth_percent="0.6"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
