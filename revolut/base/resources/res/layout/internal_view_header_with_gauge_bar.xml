<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/headerWithGaugeBar_topLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/headerWithGaugeBar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_topLabel"
        style="?attr/internal_textAppearanceHeading1"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/headerWithGaugeBar_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_title"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.LinearGaugeChartView
        android:id="@+id/headerWithGaugeBar_chart"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_subtitle"/>
    <com.revolut.core.ui_kit.internal.views.chart.HorizontalSingleLineChartLegendView
        android:id="@+id/headerWithGaugeBar_legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_chart"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/headerWithGaugeBar_contentGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="headerWithGaugeBar_topLabel, headerWithGaugeBar_title, headerWithGaugeBar_subtitle, headerWithGaugeBar_chart, headerWithGaugeBar_legend"/>
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/headerWithGaugeBar_loadingContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp">
        <View
            android:id="@+id/headerWithGaugeBar_loadingTopLabel"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="174dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/headerWithGaugeBar_loadingTitle"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="224dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_loadingTopLabel"/>
        <View
            android:id="@+id/headerWithGaugeBar_loadingSubtitle"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="104dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_loadingTitle"/>
        <View
            android:id="@+id/headerWithGaugeBar_loadingChart"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_loadingSubtitle"/>
        <View
            android:id="@+id/headerWithGaugeBar_loadingFirstIcon"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="8dp"
            android:layout_height="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/headerWithGaugeBar_loadingFirstText"
            app:layout_constraintEnd_toStartOf="@+id/headerWithGaugeBar_loadingFirstText"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/headerWithGaugeBar_loadingFirstText"/>
        <View
            android:id="@+id/headerWithGaugeBar_loadingFirstText"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="48dp"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@+id/headerWithGaugeBar_loadingSecondIcon"
            app:layout_constraintStart_toEndOf="@+id/headerWithGaugeBar_loadingFirstIcon"
            app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_loadingChart"/>
        <View
            android:id="@+id/headerWithGaugeBar_loadingSecondIcon"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/headerWithGaugeBar_loadingSecondText"
            app:layout_constraintEnd_toStartOf="@+id/headerWithGaugeBar_loadingSecondText"
            app:layout_constraintStart_toEndOf="@+id/headerWithGaugeBar_loadingFirstText"
            app:layout_constraintTop_toTopOf="@+id/headerWithGaugeBar_loadingSecondText"/>
        <View
            android:id="@+id/headerWithGaugeBar_loadingSecondText"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="48dp"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/headerWithGaugeBar_loadingSecondIcon"
            app:layout_constraintTop_toBottomOf="@+id/headerWithGaugeBar_loadingChart"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</merge>
