<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/extraLargeListingCard_headerImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/internal_box_foreground_ripple"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,343:120"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/extraLargeListingCard_headerTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.flexbox.FlexboxLayout
        android:id="@+id/extraLargeListingCard_topBadgeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:dividerDrawable="@drawable/internal_divider_price_tags"
        app:flexDirection="row_reverse"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showDivider="middle"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/extraLargeListingCard_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCard_headerImage"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/extraLargeListingCard_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCard_title"
        style="?attr/internal_textAppearanceBody2"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/extraLargeListingCard_toDoItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCard_subtitle"/>
    <include
        android:id="@+id/extraLargeListingCard_priceDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCard_toDoItems"
        layout="@layout/internal_delegate_cell_details_price"/>
    <include
        android:id="@+id/extraLargeListingCard_revPoints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCard_priceDetails"
        layout="@layout/internal_delegate_cell_details_rev_points"/>
    <include
        android:id="@+id/extraLargeListingCard_textDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCard_revPoints"
        layout="@layout/internal_listing_card_cell_text_details"/>
    <include
        android:id="@+id/extraLargeListingCard_cashbackDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCard_textDetails"
        layout="@layout/internal_delegate_cell_details_badge"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/extraLargeListingCard_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraLargeListingCard_cashbackDetails"/>
</androidx.constraintlayout.widget.ConstraintLayout>
