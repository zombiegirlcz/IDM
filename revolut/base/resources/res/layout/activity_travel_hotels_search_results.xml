<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/recyclerView"
        android:paddingBottom="?attr/uikit_dp72"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.buttons.FormsActionButton
        android:id="@+id/next_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/uikit_dp16"
        app:layout_anchor="@+id/recyclerView"
        app:layout_anchorGravity="end|bottom"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navBarWithToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.InputTravelSearchItemView
            android:id="@+id/searchInputView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar>
    <com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer
        android:id="@+id/slidingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationY="?attr/uikit_dp32"
        app:layout_anchor="@+id/navBarWithToolbar"
        app:layout_anchorGravity="bottom">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/uikit_windowBackground"
            android:paddingTop="?attr/uikit_dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.revolut.core.ui_kit.views.InputTravelDatesGuestsItemView
                android:id="@+id/datesGuests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer>
    <com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer
        android:id="@+id/quickFiltersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationY="?attr/uikit_dp24"
        app:layout_anchor="@+id/navBarWithToolbar"
        app:layout_anchorGravity="bottom">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/uikit_windowBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.revolut.core.ui_kit.views.ActionsView
                android:id="@+id/quickFiltersActions"
                android:background="?attr/uikit_windowBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                android:layout_marginBottom="?attr/uikit_dp8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
