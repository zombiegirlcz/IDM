<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomBar_tabContent"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="0dp"
    android:layout_height="56dp"
    android:layout_weight="1">
    <View
        android:id="@+id/bottomBar_rippleBackground"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/floatingBottomTab_image"
        android:layout_width="@dimen/internal_dp24"
        android:layout_height="@dimen/internal_dp24"
        android:layout_marginTop="@dimen/internal_dp8"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/internal_dp16"
        app:layout_constraintBottom_toTopOf="@+id/floatingBottomTab_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="@dimen/internal_dp8"
        app:tint="@color/internal_color_tab_bar_selectable"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/floatingBottomTab_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/floatingBottomTab_image"
        app:layout_constraintEnd_toEndOf="@+id/floatingBottomTab_image"
        app:layout_constraintStart_toEndOf="@+id/floatingBottomTab_image"
        app:layout_constraintTop_toTopOf="@+id/floatingBottomTab_image"
        app:srcCompat="@drawable/internal_icn_16_new_item"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/internal_color_tab_bar_selectable"
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/floatingBottomTab_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:minWidth="@dimen/dp_64"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:autoSizeMaxTextSize="11sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/InternalTextAppearance.Emphasis4"/>
</merge>
