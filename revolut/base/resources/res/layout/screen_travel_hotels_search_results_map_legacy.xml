<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/travelHotelsSearchResultsMapScreen_rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.MapView
        android:id="@+id/travelHotelsSearchResultsMapScreen_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/travelHotelsSearchResultsMapScreen_toolbar"
        android:background="@color/colorTransparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:translationZ="10dp"
        android:outlineProvider="none"
        app:layout_anchorGravity="top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/travelHotelsSearchResultsMapScreen_searchButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:translationZ="50dp"
            android:outlineProvider="none"
            app:uikit_SmallActionButtonStyle="AccentButton"/>
        <com.revolut.core.ui_kit.views.InputTravelView
            android:id="@+id/travelHotelsSearchResultsMapScreen_searchInputView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            android:translationZ="40dp"
            android:outlineProvider="none"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/travelHotelsSearchResultsMapScreen_inputTravelSearchDatesGuestsContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:translationZ="0dp">
            <com.revolut.core.ui_kit.views.InputTravelView
                android:id="@+id/travelHotelsSearchResultsMapScreen_dates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/travelHotelsSearchResultsMapScreen_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.revolut.core.ui_kit.views.InputTravelView
                android:id="@+id/travelHotelsSearchResultsMapScreen_visitors"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/uikit_dp8"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/travelHotelsSearchResultsMapScreen_guideline"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/travelHotelsSearchResultsMapScreen_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.69"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.revolut.core.ui_kit.views.ActionsView
            android:id="@+id/travelHotelsSearchResultsMapScreen_quickFiltersActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:translationZ="0dp"/>
    </com.revolut.core.ui_kit.views.navbar.BasicNavBar>
    <FrameLayout
        android:id="@+id/travelHotelsSearchResultsMapScreen_backgroundView"
        android:background="?attr/uikit_windowBackground"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="-36dp"
        app:layout_constraintBottom_toTopOf="@+id/travelHotelsSearchResultsMapScreen_coordinatorLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/uikit_dp32"
        app:layout_constraintBottom_toTopOf="@+id/travelHotelsSearchResultsMapScreen_mapRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_google_logo"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/travelHotelsSearchResultsMapScreen_mapRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/stays_legacy_expandable_layout_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:orientation="vertical"
        android:id="@+id/travelHotelsSearchResultsMapScreen_coordinatorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelHotelsSearchResultsMapScreen_toolbar">
        <com.revolut.core.ui_kit.internal.dialogs.BottomExpandableDialogView
            android:id="@+id/travelHotelsSearchResultsMapScreen_expandableDialogContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_anchorGravity="bottom"/>
        <com.revolut.core.ui_kit.views.buttons.FormsActionButton
            android:layout_gravity="end|bottom"
            android:id="@+id/travelHotelsSearchResultsMapScreen_formsActionButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            app:uikit_FormsActionButton="AccentButton"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
