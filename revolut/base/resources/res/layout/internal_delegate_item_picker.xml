<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.framelayout.UIKitFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground_res_0x7f04060d"
    android:maxWidth="132dp"
    android:maxHeight="132dp"
    android:minWidth="80dp"
    android:minHeight="80dp"
    android:clipToOutline="true">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/itemPicker_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"/>
    <View
        android:id="@+id/itemPicker_selectionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.revolut.core.ui_kit.internal.views.framelayout.UIKitFrameLayout>
