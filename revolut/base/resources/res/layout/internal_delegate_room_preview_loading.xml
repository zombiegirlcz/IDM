<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/roomPreviewLoading_previewImage"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp72"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/internal_badge_background_accent"/>
            <View
                android:id="@+id/roomPreviewLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_16"
                app:layout_constraintBottom_toTopOf="@+id/roomPreviewLoading_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_percent="0.63"/>
            <View
                android:id="@+id/roomPreviewLoading_subtitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="?attr/uikit_dp8"
                app:layout_constraintBottom_toTopOf="@+id/roomPreviewLoading_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/roomPreviewLoading_title"
                app:layout_constraintWidth_percent="0.31"/>
            <View
                android:id="@+id/roomPreviewLoading_label"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="?attr/uikit_dp8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/roomPreviewLoading_subtitle"
                app:layout_constraintWidth_percent="0.16"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
