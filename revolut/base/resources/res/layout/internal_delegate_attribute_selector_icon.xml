<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/attributeSelectorIcon_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="?attr/uikit_dp16">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/attributeSelectorIcon_icon"
            android:layout_width="?attr/uikit_dp32"
            android:layout_height="?attr/uikit_dp32"
            android:layout_marginTop="?attr/uikit_dp16"
            android:adjustViewBounds="true"
            android:layout_marginHorizontal="?attr/uikit_dp12"
            app:layout_constraintBottom_toTopOf="@+id/attributeSelectorIcon_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/attributeSelectorIcon_background"
            app:layout_constraintVertical_chainStyle="spread"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/attributeSelectorIcon_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            android:maxLines="1"
            android:layout_marginHorizontal="?attr/uikit_dp12"
            app:autoSizeMaxTextSize="@dimen/internal_heading3_text_size"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/attributeSelectorIcon_icon"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintWidth="wrap_content_constrained"
            style="?attr/internal_textAppearanceHeading3"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50_70"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/attributeSelectorIcon_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginHorizontal="?attr/uikit_dp12"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/attributeSelectorIcon_title"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintWidth="wrap_content_constrained"
            style="?attr/internal_textAppearanceBody3"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/attributeSelectorIcon_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp4"
            android:maxLines="2"
            android:layout_marginHorizontal="?attr/uikit_dp12"
            app:autoSizeMaxTextSize="@dimen/internal_primary_text_size"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@+id/attributeSelectorIcon_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/attributeSelectorIcon_subtitle"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintWidth="wrap_content_constrained"
            style="?attr/internal_textAppearanceBody3"/>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/attributeSelectorIcon_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            android:layout_marginHorizontal="?attr/uikit_dp24"
            app:layout_constraintBottom_toBottomOf="@+id/attributeSelectorIcon_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/attributeSelectorIcon_description"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintWidth="wrap_content_constrained"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
