<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comparisonTableHeader_shimmerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/comparisonTableHeaderLoading_title"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="80dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/comparisonTableHeaderLoading_subtitle"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="120dp"
        android:layout_height="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comparisonTableHeaderLoading_title"/>
</com.facebook.shimmer.ShimmerConstraintLayout>
