<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navBarWithToolbar"
        android:background="?attr/uikit_colorGroupedBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/recyclerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/newChatContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/newChatBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/ic_new_chat"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_m"
            android:textColor="?attr/uikit_colorAccent"
            android:id="@+id/newBtnSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:ttv_typeface="regular"/>
    </LinearLayout>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
