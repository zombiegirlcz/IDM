<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:fitNavigationBar="true">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navBarWithToolbar"
        android:background="?attr/uikit_colorTransparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.camera.view.PreviewView
            android:id="@+id/activityBackendFlow_cameraPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/imageViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/topOverlay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/mask"
                app:layout_constraintHeight_default="spread"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="?attr/uikit_colorWhite"
                android:gravity="center"
                android:id="@+id/label"
                android:paddingLeft="?attr/uikit_dp16"
                android:paddingRight="?attr/uikit_dp16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/uikit_dp8"
                app:layout_constraintBottom_toTopOf="@+id/mask"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="?attr/internal_textAppearanceBody1"/>
            <com.revolut.camera.facelift.CameraMaskView
                android:id="@+id/mask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="66dp"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@+id/footer"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleView"
                app:layout_constraintVertical_bias="0"/>
            <View
                android:id="@+id/bottomOverlay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_default="spread"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mask"/>
            <TextView
                android:textColor="?attr/uikit_colorBlack"
                android:gravity="center_vertical"
                android:id="@+id/warning"
                android:paddingLeft="?attr/uikit_dp16"
                android:paddingRight="?attr/uikit_dp16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginRight="?attr/uikit_dp16"
                android:drawablePadding="?attr/uikit_dp16"
                android:backgroundTint="?attr/uikit_colorWhite"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mask"
                style="?attr/internal_textAppearanceEmphasis1"/>
            <ImageButton
                android:id="@+id/buttonBack"
                android:tint="?attr/uikit_colorWhite"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/uikit_icn_24_back"
                style="@style/ToolbarLeftButton"/>
            <TextView
                android:textColor="?attr/uikit_colorWhite"
                android:id="@+id/titleView"
                android:paddingLeft="?attr/uikit_dp16"
                android:paddingRight="?attr/uikit_dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonBack"
                style="?attr/internal_textAppearanceHeading1"/>
            <TextView
                android:textColor="?attr/uikit_colorWhite"
                android:ellipsize="end"
                android:id="@+id/descriptionView"
                android:paddingLeft="?attr/uikit_dp16"
                android:paddingRight="?attr/uikit_dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleView"
                style="?attr/internal_textAppearanceBody1"/>
            <FrameLayout
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">
                <Button
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/buttonAction"
                    android:background="@drawable/ic_shutter_facelifted"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="26dp"/>
                <com.revolut.core.ui_kit.views.buttons.TwinVerticalButton
                    android:layout_gravity="bottom"
                    android:id="@+id/twinVerticalButton"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/progressBar"
                    android:background="?attr/uikit_colorBlack_20"
                    android:visibility="gone"
                    android:layout_width="200dp"
                    android:layout_height="20dp"
                    android:max="1000"
                    android:progress="0"
                    android:screenReaderFocusable="true"
                    style="?android:attr/progressBarStyleHorizontal"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/splash"
            android:background="?attr/uikit_colorPink"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/loadingProgress"
        android:background="?attr/uikit_colorTransparent"
        android:visibility="invisible"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/uikit_colorAccent"
        android:indeterminateTintMode="src_in"
        app:layout_anchorGravity="center"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:background="@drawable/background_action_button_white_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/next_button_above_note_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="16dp"
            style="@style/BottomNoteText"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:layout_gravity="bottom"
            android:id="@+id/next_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="bottom"
            android:id="@+id/backendFlow_actionsRecyclerView"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:overScrollMode="never"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:gravity="center"
            android:id="@+id/bottom_note_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            style="@style/BottomNoteText"/>
    </LinearLayout>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerCoordinatorLayout>
