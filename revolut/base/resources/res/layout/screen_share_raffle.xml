<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navBarWithToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/raffleShareCardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="490dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/raffleShareAssetBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/raffleShareAsset"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/raffleShareRevolutLogo"
            android:layout_width="60dp"
            android:layout_height="19dp"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_marginStart="@dimen/dp_20"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorForeground"
                android:gravity="center_horizontal"
                android:id="@+id/raffleShareTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_8"
                android:layout_marginHorizontal="@dimen/dp_16"
                style="?attr/internal_textAppearanceHeading1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:gravity="center_horizontal"
                android:id="@+id/raffleShareDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_32"
                android:layout_marginHorizontal="@dimen/dp_16"
                style="?attr/internal_textAppearanceBody2"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/raffleShareQrCode"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="18dp"
                android:layout_marginEnd="18dp"/>
        </LinearLayout>
    </FrameLayout>
    <com.revolut.core.ui_kit.views.ActionsView
        android:layout_gravity="bottom"
        android:id="@+id/raffleShareActionsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
