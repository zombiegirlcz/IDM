<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/portalLoading_screenContainer"
    android:background="?attr/uikit_colorGrey2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/portalLoading_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.WebView
        android:id="@+id/portalLoading_webView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/portalLoading_navBar"/>
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/portalLoading_loadingView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/portalLoading_navBar">
        <View
            android:id="@+id/webviewShimmeringLoadingView_titleRow1"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="174dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/webviewShimmeringLoadingView_titleRow2"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="224dp"
            android:layout_height="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/webviewShimmeringLoadingView_titleRow1"/>
        <View
            android:id="@+id/webviewShimmeringLoadingView_titleRow3"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="104dp"
            android:layout_height="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toTopOf="@+id/webviewShimmeringLoadingView_recyclerView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/webviewShimmeringLoadingView_titleRow2"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/webviewShimmeringLoadingView_recyclerView"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/webviewShimmeringLoadingView_titleRow3"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
