<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp">
    <View
        android:id="@+id/attributeSelectorSmall_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/attributeSelectorSmall_icon"
        android:visibility="gone"
        android:layout_width="?attr/uikit_dp32"
        android:layout_height="?attr/uikit_dp32"
        android:layout_marginTop="?attr/uikit_dp12"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="?attr/uikit_dp12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="?attr/uikit_dp12"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/attributeSelectorSmall_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginBottom="12dp"
        android:maxLines="3"
        android:layout_marginHorizontal="?attr/uikit_dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/attributeSelectorSmall_icon"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintWidth="wrap_content_constrained"
        app:layout_goneMarginBottom="?attr/uikit_dp12"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/attributeSelectorSmall_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp12"
        android:layout_marginEnd="?attr/uikit_dp12"
        app:layout_constraintBottom_toTopOf="@+id/attributeSelectorSmall_subTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth="wrap_content_constrained"
        app:layout_goneMarginBottom="?attr/uikit_dp12"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/attributeSelectorSmall_subTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp12"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp12"
        android:layout_marginEnd="?attr/uikit_dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/attributeSelectorSmall_title"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth="wrap_content_constrained"
        app:layout_goneMarginTop="?attr/uikit_dp12"
        style="?attr/internal_textAppearanceEmphasis3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
