<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/internal_dp12"
        android:paddingBottom="@dimen/internal_dp12"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/internal_dp16">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:gravity="start"
            android:id="@+id/trackingProgressLoadingWidget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.facebook.shimmer.ShimmerConstraintLayout
            android:id="@+id/trackingProgressLoadingWidget_shimmeringLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">
            <View
                android:id="@+id/trackingProgressLoadingWidget_image"
                android:background="?attr/uikit_shimmerBackgroundRectSquared"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/trackingProgressLoadingWidget_mainValue"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="114dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/internal_dp8"
                app:layout_constraintStart_toEndOf="@+id/trackingProgressLoadingWidget_image"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/trackingProgressLoadingWidget_secondaryValue"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="53dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="@dimen/internal_dp8"
                app:layout_constraintStart_toEndOf="@+id/trackingProgressLoadingWidget_image"
                app:layout_constraintTop_toBottomOf="@+id/trackingProgressLoadingWidget_mainValue"/>
            <View
                android:id="@+id/trackingProgressLoadingWidget_badge"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="60dp"
                android:layout_height="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/trackingProgressLoadingWidget_progress"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                app:layout_constraintBottom_toTopOf="@+id/trackingProgressLoadingWidget_footerTitle"
                app:layout_constraintTop_toBottomOf="@+id/trackingProgressLoadingWidget_image"/>
            <View
                android:id="@+id/trackingProgressLoadingWidget_footerTitle"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="96dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/trackingProgressLoadingWidget_footerValue"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="96dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </com.facebook.shimmer.ShimmerConstraintLayout>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
