<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cellWithProgressLoadingWidget_shimmerLayout"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/cellWithProgressLoadingWidget_topLabel"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="96dp"
            android:layout_height="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/cellWithProgressLoadingWidget_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="56dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cellWithProgressLoadingWidget_topLabel"/>
        <com.revolut.core.ui_kit.internal.views.CircleProgressBar
            android:id="@+id/cellWithProgressLoadingWidget_progress"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
