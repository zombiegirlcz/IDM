<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gaugeNavBar_contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        app:layout_scrollFlags="exitUntilCollapsed|scroll">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/gaugeNavBar_guidelineTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="0dp"/>
        <com.revolut.core.ui_kit.internal.views.gaugechart.ArcGaugeView
            android:id="@+id/gaugeNavBar_arcGaugeView"
            android:layout_width="?attr/uikit_dp0"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/gaugeNavBar_titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="?attr/uikit_dp32"
            android:layout_marginEnd="?attr/uikit_dp32"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gaugeNavBar_arcGaugeView"
            style="@style/InternalTextAppearance.Heading1"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/gaugeNavBar_subtitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="?attr/uikit_dp32"
            android:layout_marginEnd="?attr/uikit_dp32"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gaugeNavBar_titleTextView"
            app:layout_goneMarginTop="?attr/uikit_dp0"
            style="@style/InternalTextAppearance.Emphasis1"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/gaugeNavBar_descriptionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp4"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="?attr/uikit_dp32"
            android:layout_marginEnd="?attr/uikit_dp32"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gaugeNavBar_subtitleTextView"
            style="@style/InternalTextAppearance.Body2"/>
        <ViewStub
            android:id="@+id/gaugeNavBar_shimmerStub"
            android:layout="@layout/internal_gauge_nav_bar_shimmer"
            android:inflatedId="@+id/gaugeNavBar_shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gaugeNavBar_arcGaugeView"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/gaugeNavBar_contentBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="gaugeNavBar_descriptionTextView,gaugeNavBar_shimmerLayout"/>
        <Space
            android:id="@+id/gaugeNavBar_space"
            android:layout_width="match_parent"
            android:layout_height="?attr/uikit_dp24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gaugeNavBar_contentBottomBarrier"/>
        <View
            android:id="@+id/gaugeNavBar_toolbarBackground"
            android:background="?attr/uikit_colorBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/gaugeNavBar_buttonBottomBarrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
            android:id="@+id/gaugeNavBar_navigationButton"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="?attr/uikit_dp8"
            android:layout_marginBottom="?attr/uikit_dp8"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gaugeNavBar_guidelineTop"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/gaugeNavBar_buttonBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:barrierMargin="?attr/uikit_dp8"
            app:constraint_referenced_ids="gaugeNavBar_navigationButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
