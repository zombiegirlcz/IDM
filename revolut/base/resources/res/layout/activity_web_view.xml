<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/webview_container"
    android:tag="tempBG"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.uicomponent.toolbar.app_bar.ToolbarShadow
        android:id="@+id/toolbarShadow"
        android:background="0x7f0806f7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_anchor="@+id/appbar"
        app:layout_anchorGravity="bottom"/>
    <com.revolut.uicomponent.toolbar.app_bar.CustomViewRevolutToolbar
        android:id="@+id/transparentToolbar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:rtb_menu_layout="@menu/menu_save"/>
    <com.revolut.uicomponent.toolbar.app_bar.RevolutAppBarLayout
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        android:id="@+id/appbar"
        android:background="?attr/uikit_colorBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.uicomponent.toolbar.app_bar.CustomViewRevolutToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:rtb_menu_layout="@menu/menu_save"
            app:shadow="white_line"
            app:titleTextColor="?attr/uikit_colorForeground"/>
    </com.revolut.uicomponent.toolbar.app_bar.RevolutAppBarLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/list_t_c_progress"
        android:background="?attr/uikit_colorTransparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/toolbar_height"
        android:layout_centerInParent="true"
        style="?android:attr/progressBarStyleLarge"/>
    <com.revolut.core.ui_kit.views.FullScreenStateView
        android:id="@+id/errorView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/actionBarSize"/>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerCoordinatorLayout>
