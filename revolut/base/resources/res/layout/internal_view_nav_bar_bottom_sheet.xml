<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogHeader_root"
    android:paddingTop="28dp"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/dialogHeader_assetContainer"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/dialogHeader_titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dialogHeader_image"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"/>
        <com.revolut.core.ui_kit.views.AvatarView
            android:id="@+id/dialogHeader_avatar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.revolut.core.ui_kit.internal.views.SimpleLimitProgressBarWithText
            android:id="@+id/dialogHeader_progress"
            android:layout_width="88dp"
            android:layout_height="88dp"/>
        <ViewStub
            android:id="@+id/dialogHeader_timerStub"
            android:visibility="gone"
            android:layout="@layout/internal_view_timer_view"
            android:inflatedId="@+id/dialogHeader_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/dialogHeader_titleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/dialogHeader_menuStartBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialogHeader_assetContainer"
        app:layout_constraintWidth_default="wrap"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/dialogHeader_descriptionView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialogHeader_bottom"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/dialogHeader_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="dialogHeader_titleView,dialogHeader_menuIcon,dialogHeader_menuButtonTextView"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/dialogHeader_endGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/dialogHeader_menuStartBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="start"
        app:constraint_referenced_ids="dialogHeader_menuTextView,dialogHeader_menuButtonTextView,dialogHeader_menuButtonAddNew,dialogHeader_endGuideline"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorAccent"
        android:ellipsize="end"
        android:id="@+id/dialogHeader_menuTextView"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialogHeader_titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialogHeader_titleView"
        app:layout_constraintWidth_default="wrap"
        style="?attr/internal_textAppearanceBody1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorOnAccent"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/dialogHeader_menuButtonTextView"
        android:background="@drawable/internal_extra_small_action_background_accent"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:drawableStartCompat="@drawable/uikit_icn_16_plus"
        app:drawableTint="?attr/uikit_colorOnAccent"
        app:layout_constraintBottom_toBottomOf="@+id/dialogHeader_titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialogHeader_titleView"
        app:layout_constraintWidth_default="wrap"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.button.ButtonAddNew
        android:id="@+id/dialogHeader_menuButtonAddNew"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialogHeader_titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialogHeader_titleView"
        app:layout_constraintWidth_default="wrap"/>
    <com.revolut.core.ui_kit.internal.views.navbar.SearchView
        android:id="@+id/dialogHeader_SearchView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialogHeader_titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dialogHeader_titleView"/>
    <com.revolut.core.ui_kit.views.buttons.SearchButton
        android:id="@+id/dialogHeader_SearchButton"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialogHeader_descriptionView"/>
</com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout>
