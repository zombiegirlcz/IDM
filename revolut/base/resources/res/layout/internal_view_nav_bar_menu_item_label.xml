<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:focusable="true"
    android:clickable="true"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_32"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">
    <View
        android:id="@+id/navBarMenuItemLabel_background"
        android:background="@drawable/internal_extra_small_action_background_foreground"
        android:duplicateParentState="true"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:foregroundGravity="center"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/navBarMenuItemLabel_icon"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/navBarMenuItemLabel_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/dp_8"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorBackground"
        android:gravity="center_vertical"
        android:id="@+id/navBarMenuItemLabel_text"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_32"
        android:paddingEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/navBarMenuItemLabel_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
