<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cameraKitTerminalCameraScreen_screenContainer"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.camerakit.ui.views.view.CameraKitView
        android:id="@+id/cameraKitTerminalCameraScreen_cameraKitView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.camerakit.ui.views.view.debug.CameraKitDebugOverlayView
        android:id="@+id/cameraKitTerminalCameraScreen_debugOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.FooterTextView
        android:layout_gravity="bottom"
        android:id="@+id/cameraKitTerminalCameraScreen_footerText"
        android:layout_width="match_parent"
        android:layout_height="100dp"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/cameraKitTerminalCameraScreen_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:uikit_LargeActionButtonStyle="BlackButtonNoShadow"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
