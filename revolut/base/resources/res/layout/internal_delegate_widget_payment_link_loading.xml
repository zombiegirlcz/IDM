<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/paymentLinkWidgetLoading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <com.revolut.core.ui_kit.internal.views.ShimmeringRectView
            android:id="@+id/paymentLinkWidgetLoading_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/paymentLinkWidgetLoading_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toStartOf="@+id/paymentLinkWidgetLoading_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/paymentLinkWidgetLoading_image"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/paymentLinkWidgetLoading_description"
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toStartOf="@+id/paymentLinkWidgetLoading_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/paymentLinkWidgetLoading_title"
            style="?attr/internal_textAppearanceBody2"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/paymentLinkWidgetLoading_action"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/paymentLinkWidgetLoading_image"
            app:layout_constraintEnd_toStartOf="@+id/paymentLinkWidgetLoading_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
