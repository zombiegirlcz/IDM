<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/mapWidgetLoading_title"
            android:paddingLeft="?attr/uikit_dp16"
            android:paddingTop="?attr/uikit_dp12"
            android:paddingRight="?attr/uikit_dp16"
            android:paddingBottom="?attr/uikit_dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/mapWidgetLoading_shimmeringView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="?attr/uikit_dp4"
            android:layout_weight="1">
            <View
                android:background="?attr/uikit_colorGreyTone8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
