<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/smartTileAssetLoading_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/assetSmartTileLoading_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/horizontal_top_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/uikit_shimmerBackgroundCircle"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/assetSmartTileLoading_caption"
            android:layout_width="57dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/horizontal_top_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:uikit_shimmeringTextMaxHeight="12dp"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/horizontal_top_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="assetSmartTileLoading_caption,assetSmartTileLoading_icon"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/vertical_center_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/assetSmartTileLoading_chart"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vertical_center_guideline"
            app:layout_constraintTop_toBottomOf="@+id/horizontal_top_barrier"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:gravity="bottom"
            android:id="@+id/assetSmartTileLoading_title"
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/assetSmartTileLoading_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/vertical_center_guideline"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontal_top_barrier"
            app:layout_constraintVertical_chainStyle="packed"
            app:uikit_shimmeringTextMaxHeight="24dp"
            style="?attr/internal_textAppearanceHeading1"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/assetSmartTileLoading_subtitle"
            android:layout_width="83dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vertical_center_guideline"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/assetSmartTileLoading_title"
            app:layout_constraintVertical_chainStyle="packed"
            app:uikit_shimmeringTextMaxHeight="12dp"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
