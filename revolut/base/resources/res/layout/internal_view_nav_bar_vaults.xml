<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBarLayout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="56dp"
    app:layout_scrollFlags="exitUntilCollapsed|scroll">
    <com.revolut.core.ui_kit.internal.views.navbar.VaultsHeaderLayout
        android:id="@+id/vaultsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/menuLayout"
        android:layout_width="0dp"
        android:layout_height="@dimen/internal_vaults_menu_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarNavigationButtonView
            android:layout_gravity="center_vertical"
            android:id="@+id/navigationButton"
            android:background="@drawable/internal_oval_ripple"
            android:padding="@dimen/dp_8"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/menuLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/menuLayout"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/toolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            style="?attr/internal_textAppearanceHeading3"/>
        <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/menuRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</com.revolut.core.ui_kit.views.FitsSystemWindowsConstraintLayout>
