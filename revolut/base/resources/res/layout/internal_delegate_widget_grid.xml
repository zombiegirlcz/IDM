<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/gridWidget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/gridWidget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.recyclerkit.UIKitRecyclerView
            android:theme="@style/internal_GrayWidgetBackgroundTheme"
            android:id="@+id/gridWidget_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="?attr/uikit_dp4"
            android:layout_weight="1"
            android:layout_marginStart="?attr/uikit_dp4"
            android:layout_marginEnd="?attr/uikit_dp4"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/gridWidget_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/gridWidget_buttonLoading"
            android:layout_width="match_parent"
            android:layout_height="@dimen/internal_large_action_button">
            <View
                android:layout_gravity="center"
                android:background="@drawable/internal_rectangle_gradient_light_accent"
                android:layout_width="133dp"
                android:layout_height="16dp"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
