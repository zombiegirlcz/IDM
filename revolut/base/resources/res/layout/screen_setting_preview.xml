<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/settingPreview_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.ScreenContentNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/settingPreview_previewRecyclerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/settingPreview_bottomSectionRecyclerView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="432dp"
                app:layout_constraintHeight_min="320dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/settingPreview_bottomSectionRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintBottom_toTopOf="@+id/settingPreview_disclaimer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/settingPreview_previewRecyclerView"/>
            <com.revolut.core.ui_kit.views.FooterTextView
                android:id="@+id/settingPreview_disclaimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/settingPreview_bottomSectionRecyclerView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.revolut.core.ui_kit.views.ScreenContentNestedScrollView>
</com.revolut.kompot.view.ControllerContainerLinearLayout>
