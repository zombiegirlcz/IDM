<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarLargeCentred
        android:id="@+id/creditCongratulation_navBarLargeCentred"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/creditCongratulation_parentNestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior">
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/creditCongratulation_recyclerView"
            android:paddingBottom="@dimen/dp_96"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/creditCongratulation_largeActionButtonContainer"
        android:background="@drawable/uikit_bottom_button_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:layout_gravity="bottom"
            android:id="@+id/creditCongratulation_largeActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
    </FrameLayout>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
