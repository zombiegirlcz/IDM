<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selfieWithCardGroup"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/overlayTop"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="196dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/overlayLeft"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/overlayBottom"
        app:layout_constraintEnd_toStartOf="@+id/faceMaskImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overlayTop"/>
    <ImageView
        android:id="@+id/faceMaskImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/overlayBottom"
        app:layout_constraintDimensionRatio="1:1.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overlayTop"
        app:srcCompat="@drawable/selfie_mask"/>
    <View
        android:id="@+id/overlayRight"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/overlayBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/faceMaskImageView"
        app:layout_constraintTop_toBottomOf="@+id/overlayTop"/>
    <View
        android:id="@+id/overlayBottom"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="196dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Space
        android:id="@+id/leftTopNumberCover"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <Space
        android:id="@+id/rightBottomNumberCover"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <View
        android:id="@+id/numberCoverView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rightBottomNumberCover"
        app:layout_constraintEnd_toEndOf="@+id/rightBottomNumberCover"
        app:layout_constraintStart_toEndOf="@+id/leftTopNumberCover"
        app:layout_constraintTop_toTopOf="@+id/leftTopNumberCover"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/overlayGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="overlayTop, overlayLeft, overlayRight, overlayBottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
