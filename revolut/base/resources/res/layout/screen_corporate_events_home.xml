<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/corporateEventsHome_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.FixedTabs
            android:id="@+id/corporateEventsHome_tabs"
            android:paddingTop="?attr/uikit_dp4"
            android:paddingBottom="?attr/uikit_dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/uikit_dp16"
            android:paddingEnd="?attr/uikit_dp16"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/corporateEventsHome_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.buttons.FormsActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/corporateEventsHome_scrollFab"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp24"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:uikit_FormsActionButton="AccentButton"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
