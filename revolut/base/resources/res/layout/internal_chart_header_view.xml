<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chartHeaderView_container"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/chartHeaderView_sectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:textAlignment="viewStart"
            app:layout_constraintEnd_toStartOf="@+id/chartHeaderView_endImageSecondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_min="wrap"
            style="?attr/internal_textAppearanceLargeSubheader"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/chartHeaderView_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:textAlignment="viewStart"
            app:layout_constraintEnd_toStartOf="@+id/chartHeaderView_endImageSecondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chartHeaderView_sectionTitle"
            app:layout_constraintWidth_min="wrap"
            style="?attr/internal_textAppearanceHeading1"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/chartHeaderView_subtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAlignment="viewStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chartHeaderView_title"
            app:layout_constraintWidth_min="wrap"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/chartHeaderView_endImageSecondary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="@+id/chartHeaderView_title"
            app:layout_constraintEnd_toStartOf="@+id/chartHeaderView_endImage"
            app:layout_constraintStart_toEndOf="@+id/chartHeaderView_title"
            app:layout_constraintTop_toTopOf="@+id/chartHeaderView_title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/chartHeaderView_endImage"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/chartHeaderView_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chartHeaderView_endImageSecondary"
            app:layout_constraintTop_toTopOf="@+id/chartHeaderView_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
