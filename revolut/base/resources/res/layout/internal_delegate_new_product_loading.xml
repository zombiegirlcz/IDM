<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/newProductLoading_shimmeringTexts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/newProductLoading_shimmeringView"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:layout_gravity="bottom"
            android:id="@+id/newProductLoading_title"
            android:background="@drawable/internal_rectangle_foreground"
            android:layout_width="170dp"
            android:layout_height="24dp"
            android:layout_marginBottom="36dp"
            android:alpha="0.05"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp16"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/newProductLoading_subtitle"
            android:background="@drawable/internal_rectangle_foreground"
            android:layout_width="90dp"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="@dimen/internal_dp16"
            android:alpha="0.05"
            android:layout_marginStart="@dimen/internal_dp16"
            style="?attr/internal_textAppearanceBody3"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/newProductLoading_shimmeringView"
        android:layout_width="96dp"
        android:layout_height="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/newProductLoading_imageBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
