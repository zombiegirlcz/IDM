<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/cardWidget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp12"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/internal_dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.internal.views.card_design.CardsEmptyStateView
            android:layout_gravity="center"
            android:id="@+id/cardWidget_emptyStateView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/internal_dp16"
            app:layout_constraintBottom_toBottomOf="@+id/cardWidget_description"
            app:layout_constraintTop_toTopOf="@+id/cardWidget_title"/>
        <TextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/cardWidget_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/internal_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
