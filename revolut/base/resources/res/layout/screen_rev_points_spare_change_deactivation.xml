<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/spareChangeDeactivation_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/spareChangeDeactivation_recyclerView"
        android:paddingBottom="@dimen/dp_160"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.legacy.LegacyContentContainerLinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="?attr/uikit_windowBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fitNavigationBar="true">
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/spareChangeDeactivation_actionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_16"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/spareChangeDeactivation_backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_16"/>
    </com.revolut.core.ui_kit.views.legacy.LegacyContentContainerLinearLayout>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
