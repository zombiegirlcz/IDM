<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/basketLoading_constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/basketLoading_avatar"
        android:background="?attr/uikit_shimmerBackgroundCircle"
        android:layout_width="@dimen/internal_dp40"
        android:layout_height="@dimen/internal_dp40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/basketLoading_title"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="0dp"
        android:layout_height="@dimen/internal_dp16"
        android:layout_marginTop="@dimen/internal_dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basketLoading_avatar"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="1"/>
    <View
        android:id="@+id/basketLoading_description"
        android:background="?attr/uikit_shimmerBackgroundRect"
        android:layout_width="0dp"
        android:layout_height="@dimen/internal_dp16"
        android:layout_marginTop="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp48"
        app:layout_constraintEnd_toEndOf="@+id/basketLoading_title"
        app:layout_constraintStart_toStartOf="@+id/basketLoading_title"
        app:layout_constraintTop_toBottomOf="@+id/basketLoading_title"/>
</com.facebook.shimmer.ShimmerConstraintLayout>
