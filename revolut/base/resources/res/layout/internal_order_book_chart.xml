<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.order_book.OrderBookChartView
        android:id="@+id/orderBookChart_chart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/internal_order_book_chart_default_height"
        android:layout_marginBottom="?attr/uikit_dp12"
        app:layout_constraintBottom_toTopOf="@+id/orderBookChart_labels"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="?attr/uikit_dp0"/>
    <com.revolut.core.ui_kit.internal.views.order_book.OrderBookChartLabelsView
        android:id="@+id/orderBookChart_labels"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
