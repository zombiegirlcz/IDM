<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/internal_rounded_corner_background_tooltip"
    android:padding="@dimen/dp_8"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="136dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textAppearance="?attr/internal_textAppearanceBody3"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/multiTargetFanChartTooltip_high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:paddingEnd="4dp"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textAppearance="?attr/internal_textAppearanceBody3"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:layout_gravity="end"
            android:id="@+id/multiTargetFanChartTooltip_highValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewEnd"
            android:paddingStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textAppearance="?attr/internal_textAppearanceBody3"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/multiTargetFanChartTooltip_average"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:paddingEnd="4dp"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textAppearance="?attr/internal_textAppearanceBody3"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/multiTargetFanChartTooltip_averageValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewEnd"
            android:paddingStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textAppearance="?attr/internal_textAppearanceBody3"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/multiTargetFanChartTooltip_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:paddingEnd="4dp"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textAppearance="?attr/internal_textAppearanceBody3"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/multiTargetFanChartTooltip_lowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewEnd"
            android:paddingStart="4dp"/>
    </LinearLayout>
</LinearLayout>
