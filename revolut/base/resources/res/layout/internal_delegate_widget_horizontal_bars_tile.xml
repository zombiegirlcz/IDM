<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp">
        <com.revolut.core.ui_kit.internal.views.ResizableTileHeaderView
            android:textColor="@color/internal_greyTone50"
            android:id="@+id/horizontalBarsTile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/InternalTextAppearance.Emphasis2"/>
        <com.revolut.core.ui_kit.internal.views.barchart.HorizontalBarView
            android:id="@+id/horizontalBarsTile_bars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
