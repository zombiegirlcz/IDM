<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/largeVoucherTile_background"
        android:background="?attr/uikit_colorGreyTone5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/largeVoucherTile_backgroundBottomBarrier"
        app:layout_constraintDimensionRatio="H,536:256"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/largeVoucherTile_images"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_card_16dp_padding_size"
        android:layout_marginBottom="@dimen/internal_card_16dp_padding_size"
        android:layout_marginStart="@dimen/internal_card_16dp_padding_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/largeVoucherTile_topRightIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/largeVoucherTile_background"
        app:layout_constraintTop_toTopOf="@+id/largeVoucherTile_background"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/largeVoucherTile_logoBackground"
        android:background="@drawable/internal_voucher_cutaway_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="?attr/uikit_colorWidgetBackground"
        app:layout_constraintBottom_toBottomOf="@+id/largeVoucherTile_backgroundBottomBarrier"
        app:layout_constraintEnd_toEndOf="@+id/largeVoucherTile_logoIcon"
        app:layout_constraintStart_toStartOf="@+id/largeVoucherTile_logoIcon"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/largeVoucherTile_logoIcon"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="-12dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/largeVoucherTile_backgroundBottomBarrier"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/largeVoucherTile_backgroundBottomBarrier"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="largeVoucherTile_titleText, largeVoucherTile_subtitleText, largeVoucherTile_actionButton"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/largeVoucherTile_titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/largeVoucherTile_subtitleText"
        app:layout_constraintEnd_toStartOf="@+id/largeVoucherTile_actionButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/largeVoucherTile_backgroundBottomBarrier"
        app:layout_goneMarginBottom="?attr/uikit_dp12"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/largeVoucherTile_subtitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp12"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/largeVoucherTile_actionButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/largeVoucherTile_titleText"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/largeVoucherTile_actionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp12"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/largeVoucherTile_backgroundBottomBarrier"/>
    <com.revolut.flexbox.FlexboxLayout
        android:orientation="horizontal"
        android:id="@+id/largeVoucherTile_tagsContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:dividerDrawable="@drawable/internal_divider_tags"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toStartOf="@+id/largeVoucherTile_topRightIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showDivider="middle"/>
    <View
        android:id="@+id/largeVoucherTile_foregroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/largeVoucherTile_grayMask"
        android:background="?attr/uikit_colorBackground_50"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
