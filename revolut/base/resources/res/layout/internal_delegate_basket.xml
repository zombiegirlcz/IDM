<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/internal_box_foreground_ripple">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/basket_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/basket_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp8"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basket_avatar"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/basket_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp2"
        android:maxLines="2"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="@+id/basket_title"
        app:layout_constraintStart_toStartOf="@+id/basket_title"
        app:layout_constraintTop_toBottomOf="@+id/basket_title"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/basket_contentBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="basket_description,basket_avatar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/basket_detailsContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/basket_badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basket_contentBottomBarrier"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_default="wrap"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/basket_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/basket_avatarGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/basket_contentBottomBarrier"
        app:layout_constraintVertical_bias="1"/>
</com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
