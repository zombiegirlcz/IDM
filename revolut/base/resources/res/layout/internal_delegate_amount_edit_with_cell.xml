<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.amount.CutoutFrameLayout
        android:id="@+id/amountEditWithCell_cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:uikit_clipOffset="4dp"
        app:uikit_clipRadius="16dp"
        app:uikit_cutoutSide="bottom"/>
    <com.revolut.core.ui_kit.views.amount.CutoutFrameLayout
        android:id="@+id/amountEditWithCell_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amountEditWithCell_cell"
        app:uikit_clipOffset="4dp"
        app:uikit_clipRadius="16dp"
        app:uikit_cutoutSide="top"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@drawable/internal_circle_white_bordered"
        android:padding="4dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:tint="?attr/uikit_colorOnAccentNeutral"
        app:layout_constraintBottom_toTopOf="@+id/amountEditWithCell_amount"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amountEditWithCell_cell"
        app:srcCompat="@drawable/uikit_icn_24_arrow_thin_down"/>
</androidx.constraintlayout.widget.ConstraintLayout>
