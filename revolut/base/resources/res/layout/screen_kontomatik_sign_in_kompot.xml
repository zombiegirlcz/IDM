<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/screenKontomatikSignIn_navBarWithToolbar"
        android:background="?attr/uikit_colorTransparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/screenKontomatikSignIn_nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior">
        <WebView
            android:id="@+id/screenKontomatikSignIn_kontomatikSignInView"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/screenKontomatikSignIn_retryContainer"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/credit_legal_button_retry_description"
            style="?attr/textAppearanceBody2"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:textColor="@color/color_state_primary_text_blue"
            android:layout_gravity="center"
            android:id="@+id/screenKontomatikSignIn_buttonRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/credit_legal_button_retry_title"
            app:uikit_LargeActionButtonStyle="FlatButton"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/screenKontomatikSignIn_progress"
        android:background="?attr/uikit_colorTransparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/toolbar_height"
        android:layout_centerInParent="true"
        style="?android:attr/progressBarStyleLarge"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
