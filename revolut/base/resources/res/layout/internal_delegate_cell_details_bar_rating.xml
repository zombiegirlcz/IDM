<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/cellDetailsBarRating_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:layout_marginBottom="?attr/uikit_dp12"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cellDetailsBarRating_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <ProgressBar
        android:id="@+id/cellDetailsBarRating_progress"
        android:layout_width="90dp"
        android:layout_height="?attr/uikit_dp4"
        android:layout_marginEnd="16dp"
        android:progressTintMode="src_in"
        android:progressBackgroundTintMode="src_in"
        android:screenReaderFocusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/cellDetailsBarRating_endBarrier"
        app:layout_constraintTop_toTopOf="parent"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/cellDetailsBarRating_endBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="cellDetailsBarRating_endText, cellDetailsBarRating_endGuideline"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/cellDetailsBarRating_endGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_end="84dp"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/cellDetailsBarRating_endText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
