<?xml version="1.0" encoding="utf-8"?>
<com.revolut.ui_kit.payments.send_message_transition.SendingMessageAnimationContainerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/groupChatConversation_rootContainer"
    android:background="?attr/uikit_colorGroupedBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:fitNavigationBar="false">
    <com.revolut.core.ui_kit.views.BackgroundWallpaperView
        android:id="@+id/groupChatConversation_wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/groupChatConversation_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fitNavigationBar="true">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithAvatar
            android:id="@+id/groupChatConversation_navBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/groupChatConversation_recyclerView"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:splitMotionEvents="false"
            app:layout_constraintBottom_toTopOf="@+id/groupChatConversation_disclaimerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/groupChatConversation_navBar"
            app:layout_constraintVertical_bias="0"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/groupChatConversation_disclaimerView"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/groupChatConversation_buttonsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/groupChatConversation_recyclerView"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupChatConversation_buttonsContainer"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintBottom_toTopOf="@+id/groupChatConversation_inputView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/groupChatConversation_disclaimerView">
            <com.revolut.core.ui_kit.internal.views.SmallActionButton
                android:id="@+id/groupChatConversation_firstSmallButton"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/groupChatConversation_buttonPrimary"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
            <com.revolut.core.ui_kit.internal.views.SmallActionButton
                android:id="@+id/groupChatConversation_buttonPrimary"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/groupChatConversation_buttonSecondary"
                app:layout_constraintHorizontal_weight="3"
                app:layout_constraintStart_toEndOf="@+id/groupChatConversation_firstSmallButton"
                app:layout_constraintTop_toTopOf="parent"
                app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
            <com.revolut.core.ui_kit.internal.views.SmallActionButton
                android:id="@+id/groupChatConversation_buttonSecondary"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="3"
                app:layout_constraintStart_toEndOf="@+id/groupChatConversation_buttonPrimary"
                app:layout_constraintTop_toTopOf="parent"
                app:uikit_SmallActionButtonStyle="AccentButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/groupChatConversation_mentionPicker"
            android:background="?attr/uikit_colorGroupedBackground"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_8"
            android:alpha="0"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/groupChatConversation_buttonsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/groupChatConversation_navBar"
            app:layout_constraintVertical_bias="1"/>
        <com.revolut.core.ui_kit.views.ChatInputView
            android:id="@+id/groupChatConversation_inputView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout>
</com.revolut.ui_kit.payments.send_message_transition.SendingMessageAnimationContainerLayout>
