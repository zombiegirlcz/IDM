<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/image_text_root"
        android:background="@drawable/deprecated_background_selectable_transparent"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/title_wrapper"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/circle_orange"/>
        <ImageView
            android:id="@+id/bottom_right_icon_badge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintLeft_toLeftOf="@+id/icon"
            app:srcCompat="?attr/uikit_colorAccent"/>
        <ImageView
            android:id="@+id/top_right_icon_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            app:layout_constraintLeft_toLeftOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"
            app:srcCompat="@drawable/icon_12_accent_badge_circle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toTopOf="@+id/subtitle"
            app:layout_constraintLeft_toRightOf="@+id/icon"
            app:layout_constraintRight_toLeftOf="@+id/right_barrier"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">
            <com.revolut.core_ui_custom_font.TypefaceTextView
                android:textSize="@dimen/material_text_size_m"
                android:textColor="?attr/uikit_colorGreyTone50"
                android:id="@+id/titlePrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                app:ttv_typeface="medium"/>
            <com.revolut.core_ui_custom_font.TypefaceTextView
                android:textSize="@dimen/material_text_size_m"
                android:textColor="?attr/uikit_colorForeground"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ttv_typeface="medium"/>
        </LinearLayout>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_s"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/message"
            app:layout_constraintLeft_toLeftOf="@+id/title_wrapper"
            app:layout_constraintRight_toRightOf="@+id/title_wrapper"
            app:layout_constraintTop_toBottomOf="@+id/title_wrapper"
            app:layout_constraintVertical_chainStyle="packed"
            app:ttv_typeface="regular"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_s"
            android:textColor="?attr/uikit_colorPink"
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/title_wrapper"
            app:layout_constraintRight_toRightOf="@+id/title_wrapper"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            app:layout_constraintVertical_chainStyle="packed"
            app:ttv_typeface="regular"/>
        <ImageView
            android:id="@+id/selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_delegate_selectable"/>
        <TextView
            android:gravity="center"
            android:id="@+id/caption"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:lines="1"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/right_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="left"
            app:constraint_referenced_ids="selected,caption"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
