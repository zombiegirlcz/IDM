<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/extraSmallVoucherTile_mediaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/extraSmallVoucherTile_voucherTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/extraSmallVoucherTile_voucherTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp12"
        android:layout_marginEnd="?attr/uikit_dp12"
        app:layout_constraintBottom_toTopOf="@+id/extraSmallVoucherTile_voucherSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/extraSmallVoucherTile_mediaView"
        app:layout_goneMarginBottom="?attr/uikit_dp8"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/extraSmallVoucherTile_subtitleIcon"
        android:layout_width="?attr/uikit_dp12"
        android:layout_height="?attr/uikit_dp12"
        android:layout_marginTop="1dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="?attr/uikit_dp12"
        android:layout_marginEnd="?attr/uikit_dp4"
        app:layout_constraintBottom_toBottomOf="@+id/extraSmallVoucherTile_voucherSubtitle"
        app:layout_constraintEnd_toStartOf="@+id/extraSmallVoucherTile_voucherSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/extraSmallVoucherTile_voucherSubtitle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/extraSmallVoucherTile_background"
        android:background="@drawable/internal_voucher_cutaway_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-8dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/extraSmallVoucherTile_mediaView"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/extraSmallVoucherTile_logo"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/extraSmallVoucherTile_background"
        app:layout_constraintEnd_toEndOf="@+id/extraSmallVoucherTile_background"
        app:layout_constraintStart_toStartOf="@+id/extraSmallVoucherTile_background"
        app:layout_constraintTop_toTopOf="@+id/extraSmallVoucherTile_background"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/extraSmallVoucherTile_voucherSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="?attr/uikit_dp8"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginEnd="?attr/uikit_dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/extraSmallVoucherTile_subtitleIcon"
        app:layout_constraintTop_toBottomOf="@+id/extraSmallVoucherTile_voucherTitle"
        app:layout_goneMarginLeft="?attr/uikit_dp12"
        style="?attr/internal_textAppearanceEmphasis3"/>
    <View
        android:id="@+id/extraSmallVoucherTile_foregroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/extraSmallVoucherTile_grayMask"
        android:background="?attr/uikit_colorBackground_50"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
