<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/productIntroShimmering_videoPlayerPhantom"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/productIntroShimmering_textContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="300dp"
        app:layout_constraintHeight_min="160dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/productIntroShimmering_textContainer"
        android:layout_width="0dp"
        android:layout_height="136dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productIntroShimmering_videoPlayerPhantom">
        <View
            android:layout_gravity="top|center_horizontal"
            android:layout_width="216dp"
            android:layout_height="32dp"/>
        <View
            android:layout_gravity="top|center_horizontal"
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginTop="44dp"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
