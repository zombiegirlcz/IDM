<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/avatarWidget_container"
        android:paddingTop="21dp"
        android:paddingBottom="21dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/avatarWidget_lottieBackground"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatarWidget_image"
            app:layout_constraintEnd_toEndOf="@+id/avatarWidget_image"
            app:layout_constraintStart_toStartOf="@+id/avatarWidget_image"
            app:layout_constraintTop_toTopOf="@+id/avatarWidget_image"/>
        <com.revolut.core.ui_kit.internal.views.CutoutImageView
            android:id="@+id/avatarWidget_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
            android:id="@+id/avatarWidget_imageBadge"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatarWidget_image"
            app:layout_constraintEnd_toEndOf="@+id/avatarWidget_image"/>
        <com.revolut.core.ui_kit.internal.views.CircleProgressBar
            android:id="@+id/avatarWidget_progress"
            android:layout_width="66dp"
            android:layout_height="66dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatarWidget_image"
            app:layout_constraintEnd_toEndOf="@+id/avatarWidget_image"
            app:layout_constraintStart_toStartOf="@+id/avatarWidget_image"
            app:layout_constraintTop_toTopOf="@+id/avatarWidget_image"/>
        <com.revolut.core.ui_kit.internal.views.tag.TagView
            android:id="@+id/avatarWidget_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-8dp"
            app:layout_constraintBottom_toBottomOf="@+id/avatarWidget_image"
            app:layout_constraintEnd_toEndOf="@+id/avatarWidget_image"
            app:layout_constraintStart_toStartOf="@+id/avatarWidget_image"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/avatarWidget_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatarWidget_image"
            style="?attr/internal_textAppearanceWidgetAmount"/>
        <com.revolut.core.ui_kit.internal.views.animated_numbers.AnimatedNumbersView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/avatarWidget_animatedNumbersTitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatarWidget_image"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/avatarWidget_titleBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="avatarWidget_title,avatarWidget_animatedNumbersTitle"/>
        <Space
            android:id="@+id/avatarWidget_titleSpace"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/avatarWidget_titleBarrier"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/avatarWidget_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatarWidget_titleSpace"
            app:layout_goneMarginTop="12dp"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50_70"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/avatarWidget_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatarWidget_subtitle"
            app:layout_goneMarginTop="12dp"
            style="?attr/internal_textAppearanceBody3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
