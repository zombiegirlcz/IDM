<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/internal_toolbox_cell_background"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/toolboxCell_icon"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="?attr/uikit_colorForeground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toolboxCell_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_16_plus"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center_vertical"
        android:id="@+id/toolboxCell_text"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toolboxCell_chevron"
        app:layout_constraintStart_toEndOf="@+id/toolboxCell_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/toolboxCell_chevron"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="?attr/uikit_colorForeground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/toolboxCell_text"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_16_chevron_down_small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
