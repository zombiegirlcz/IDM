<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/loadingChartTile_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="96dp"
                android:layout_height="16dp"/>
            <View
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="56dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:layout_gravity="bottom"
        android:id="@+id/loadingChartTile_chartPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:layout_marginBottom="16dp"/>
</FrameLayout>
