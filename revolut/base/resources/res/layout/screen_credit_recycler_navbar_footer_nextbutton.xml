<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.kompot.view.ControllerContainerCoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/creditNavbarRecyclerFooterButton_navBarWithToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.revolut.recyclerkit.ScreenContentRecyclerView
            android:id="@+id/creditNavbarRecyclerFooterButton_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    </com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
    <com.revolut.core.ui_kit.views.FooterActionButtonView
        android:layout_gravity="bottom"
        android:id="@+id/creditNavbarRecyclerFooterButton_largeButtonWithFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
</com.revolut.kompot.view.ControllerContainerLinearLayout>
