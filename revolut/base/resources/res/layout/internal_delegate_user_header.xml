<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/userHeader_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toTopOf="@+id/userHeader_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/userHeader_badge"
        android:visibility="invisible"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/userHeader_image"
        app:layout_constraintEnd_toEndOf="@+id/userHeader_image"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/userHeader_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/userHeader_subtitlePrimaryHolder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userHeader_image"
        style="?attr/internal_textAppearanceHeading1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/userHeader_subtitlePrimaryHolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/userHeader_subtitleSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userHeader_title">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/userHeader_subtitlePrimary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/userHeader_subtitlePrimaryIcon"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center"
        android:id="@+id/userHeader_subtitleSecondary"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/userHeader_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userHeader_subtitlePrimaryHolder"
        style="?attr/internal_textAppearanceBody1"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/userHeader_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userHeader_subtitleSecondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
