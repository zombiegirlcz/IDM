<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/biometricVerificationMyNumberDobEdit_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="112dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="?attr/uikit_dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/uikit_dp16"
            android:paddingEnd="?attr/uikit_dp16">
            <com.revolut.core.ui_kit.views.input.InputText
                android:id="@+id/biometricVerificationMyNumberDobEdit_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                android:baselineAligned="false">
                <com.revolut.core.ui_kit.views.input.InputText
                    android:id="@+id/biometricVerificationMyNumberDobEdit_year"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="?attr/uikit_dp8"/>
                <com.revolut.core.ui_kit.views.input.InputText
                    android:id="@+id/biometricVerificationMyNumberDobEdit_month"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="?attr/uikit_dp8"/>
                <com.revolut.core.ui_kit.views.input.InputText
                    android:id="@+id/biometricVerificationMyNumberDobEdit_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.revolut.core.ui_kit.views.FooterActionButtonView
        android:layout_gravity="bottom"
        android:id="@+id/biometricVerificationMyNumberDobEdit_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
