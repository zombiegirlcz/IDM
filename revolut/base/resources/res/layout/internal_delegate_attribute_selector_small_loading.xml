<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attributeSelectorSmallLoading_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/attributeSelectorSmallLoading_shimmer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:layout_marginBottom="?attr/uikit_dp12"
        android:layout_marginStart="?attr/uikit_dp12"
        android:layout_marginEnd="?attr/uikit_dp12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="center"
                android:id="@+id/attributeSelectorSmallLoading_fakeTitleView"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="match_parent"
                android:layout_height="?attr/uikit_dp12"
                android:layout_marginBottom="4dp"
                android:alpha="0.3"
                android:layout_marginStart="?attr/uikit_dp12"
                android:layout_marginEnd="?attr/uikit_dp12"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/attributeSelectorSmallLoading_fakeImageView"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:visibility="gone"
                android:layout_width="?attr/uikit_dp32"
                android:layout_height="?attr/uikit_dp32"
                android:layout_marginBottom="4dp"
                android:alpha="0.3"
                android:layout_marginStart="?attr/uikit_dp12"
                android:layout_marginEnd="?attr/uikit_dp12"/>
            <View
                android:layout_gravity="center"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:alpha="0.3"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout>
