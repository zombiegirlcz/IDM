<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/displayAmountToggle_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.internal.views.navbar.preview.NavBarScalableSilhouetteView
        android:id="@+id/displayAmountToggle_navbarSilhouette"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/displayAmountToggle_optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/displayAmountToggle_actionsSilhouette"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/displayAmountToggle_navbarSilhouette">
        <TextView
            android:id="@+id/displayAmountToggle_primaryOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <TextView
            android:id="@+id/displayAmountToggle_secondaryOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceEmphasis1"/>
    </LinearLayout>
    <com.revolut.core.ui_kit.internal.views.navbar.preview.ActionsScalableSilhouetteView
        android:id="@+id/displayAmountToggle_actionsSilhouette"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/displayAmountToggle_contentSilhouette"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.navbar.preview.ContentScalableSilhouetteView
        android:id="@+id/displayAmountToggle_contentSilhouette"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
