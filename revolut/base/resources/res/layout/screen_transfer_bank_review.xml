<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/transferScreenReview_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/transferScreenReview_navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/transferScreenReview_recyclerView"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/uikit_bottom_container_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fitNavigationBar="true"
        app:layout_behavior="com.revolut.core.ui_kit.views.scrolling.BottomOverlayPaddingBehavior">
        <com.revolut.core.ui_kit.views.FooterTextView
            android:gravity="center"
            android:id="@+id/transferScreenReview_footerText"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_32"
            android:paddingEnd="@dimen/dp_32"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/transferScreenReview_submitButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/transferScreenReview_footerText"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
    </com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
