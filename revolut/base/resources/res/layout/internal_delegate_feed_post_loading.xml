<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feedPostLoading_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/feedPostLoading_backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/feedPostLoading_imageShimmeringView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/feedPostLoading_backgroundImage"
        app:layout_constraintEnd_toEndOf="@+id/feedPostLoading_backgroundImage"
        app:layout_constraintStart_toStartOf="@+id/feedPostLoading_backgroundImage"
        app:layout_constraintTop_toTopOf="@+id/feedPostLoading_backgroundImage">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/feedPostLoading_title"
                android:background="@drawable/internal_rectangle_white"
                android:layout_width="142dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp8"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/feedPostLoading_subtitle"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/feedPostLoading_subtitle"
                android:background="@drawable/internal_rectangle_white"
                android:layout_width="56dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
