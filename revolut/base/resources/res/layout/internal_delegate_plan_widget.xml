<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/internal_box_foreground_ripple">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/planWidget_media"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/planWidget_topEndButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/planWidget_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/planWidget_title"/>
    <Space
        android:id="@+id/planWidget_topEndFallback"
        android:layout_width="?attr/uikit_dp8"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/planWidget_topEndBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="planWidget_media,planWidget_topEndButton,planWidget_topEndFallback"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/planWidget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintEnd_toStartOf="@+id/planWidget_topEndBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceHeading3"/>
    <com.revolut.core.ui_kit.internal.views.LabelView
        android:textAppearance="?attr/internal_textAppearanceEmphasis2"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/planWidget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:iconPadding="?attr/uikit_dp2"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/planWidget_bottomBarrier"
        app:layout_constraintEnd_toStartOf="@+id/planWidget_topEndBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/planWidget_title"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginBottom="?attr/uikit_dp16"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/planWidget_bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="planWidget_description,planWidget_actionsView"/>
    <com.revolut.core.ui_kit.internal.views.LabelView
        android:textAppearance="?attr/internal_textAppearanceBody2"
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/planWidget_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="34dp"
        app:layout_constraintBottom_toTopOf="@+id/planWidget_actionsView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/planWidget_subtitle"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        app:startIconPadding="?attr/uikit_dp8"
        app:startIconSize="?attr/uikit_dp20"/>
    <com.revolut.core.ui_kit.views.ActionsView
        android:id="@+id/planWidget_actionsView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:layout_marginBottom="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/planWidget_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
