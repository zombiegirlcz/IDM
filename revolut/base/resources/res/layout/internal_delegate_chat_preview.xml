<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxHeight="432dp"
    app:uikit_ratio="200:432"
    app:uikit_strategy="adjust_width">
    <View
        android:id="@+id/chatPreview_profileOverlay"
        android:background="@color/internal_greyTone20"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/chatPreview_cardsOverlay"
        android:background="@color/internal_greyTone20"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/chatPreview_incomingBubblesGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.56"/>
    <com.revolut.core.ui_kit.internal.views.chat.ChatBubbleView
        android:id="@+id/chatPreview_bubbleIncomingTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/chatPreview_bubbleIncomingBottom"
        app:layout_constraintEnd_toEndOf="@+id/chatPreview_incomingBubblesGuideline"
        app:layout_constraintHeight_max="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatPreview_profileOverlay"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.revolut.core.ui_kit.internal.views.chat.ChatBubbleView
        android:id="@+id/chatPreview_bubbleIncomingBottom"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="11dp"
        app:layout_constraintBottom_toTopOf="@+id/chatPreview_bubbleOutgoingView"
        app:layout_constraintEnd_toEndOf="@+id/chatPreview_incomingBubblesGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatPreview_bubbleIncomingTop"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/chatPreview_outgoingBubblesGuideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.32"/>
    <com.revolut.core.ui_kit.internal.views.chat.ChatBubbleView
        android:id="@+id/chatPreview_bubbleOutgoingView"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toTopOf="@+id/chatPreview_action2Overlay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/chatPreview_outgoingBubblesGuideline"
        app:layout_constraintTop_toBottomOf="@+id/chatPreview_bubbleIncomingBottom"/>
    <View
        android:id="@+id/chatPreview_actionOverlay"
        android:background="@color/internal_greyTone20"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/chatPreview_buttonOverlay"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/chatPreview_action1Overlay"
        android:background="@color/internal_greyTone20"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toTopOf="@+id/chatPreview_buttonOverlay"
        app:layout_constraintEnd_toStartOf="@+id/chatPreview_action2Overlay"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="0.5"
        app:layout_constraintStart_toEndOf="@+id/chatPreview_actionOverlay"/>
    <View
        android:id="@+id/chatPreview_action2Overlay"
        android:background="@color/internal_greyTone20"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/chatPreview_buttonOverlay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.5"
        app:layout_constraintStart_toEndOf="@+id/chatPreview_action1Overlay"/>
    <View
        android:id="@+id/chatPreview_buttonOverlay"
        android:background="@color/internal_greyTone20"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.revolut.core.ui_kit.internal.views.layout.UIKitConstraintLayout>
