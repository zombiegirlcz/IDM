<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navBarWithToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/recyclerView"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navBarWithToolbar"/>
    <com.revolut.core.ui_kit.views.buttons.ActionFooterView
        android:id="@+id/footerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
