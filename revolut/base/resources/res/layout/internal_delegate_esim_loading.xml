<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/esimLoading_shimmeringView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/esimLoading_topLabel"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="55dp"
            android:layout_height="16dp"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceBody2"/>
        <View
            android:id="@+id/esimLoading_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="96dp"
            android:layout_height="24dp"
            android:layout_marginTop="?attr/uikit_dp8"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp8"
            app:layout_constraintBottom_toTopOf="@+id/esimLoading_bottomLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/esimLoading_topLabel"
            app:layout_goneMarginTop="?attr/uikit_dp16"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/esimLoading_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/uikit_shimmerBackgroundCircle"/>
        <View
            android:id="@+id/esimLoading_bottomLabel"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="160dp"
            android:layout_height="16dp"
            android:layout_margin="?attr/uikit_dp16"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/esimLoading_additionalDescriptionsStartLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/esimLoading_title"/>
        <View
            android:layout_gravity="start"
            android:id="@+id/esimLoading_additionalDescriptionsStartLabel"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:visibility="gone"
            android:layout_width="?attr/uikit_dp72"
            android:layout_height="16dp"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:layout_gravity="end"
            android:id="@+id/esimLoading_additionalDescriptionsEndLabel"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:visibility="gone"
            android:layout_width="?attr/uikit_dp48"
            android:layout_height="?attr/uikit_dp16"
            android:layout_marginTop="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp16"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"
            app:layout_constraintBottom_toBottomOf="@+id/esimLoading_additionalDescriptionsStartLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/esimLoading_additionalDescriptionsStartLabel"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
