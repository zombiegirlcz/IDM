<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.AutoFitTabLayout
        android:id="@+id/ReactionsKeyboardTabs_tabLayout"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        app:tabBackground="@null"
        app:tabIndicator="@drawable/internal_tabs_selector"
        app:tabIndicatorColor="?attr/uikit_colorWidgetBackground"
        app:tabIndicatorHeight="36dp"
        app:tabMaxWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="0dp"
        app:tabPaddingStart="0dp"
        app:tabRippleColor="@null"/>
    <View
        android:layout_gravity="end"
        android:id="@+id/tabs_Gradient"
        android:background="@drawable/internal_tab_shadow_gradient"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="36dp"/>
</merge>
