<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.framelayout.NestedScrollableHost
        android:id="@+id/headerWithBigTile_scrollHost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/imagesViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.revolut.core.ui_kit.internal.views.framelayout.NestedScrollableHost>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/headerWithBigTile_topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="56dp"/>
    <FrameLayout
        android:id="@+id/blurred_icon_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/blurred_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:translationY="-100dp"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.internal.views.LazyInflatableCachedView
        android:id="@+id/headerWithBigTile_duoAvatarContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/actionStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerWithBigTile_topGuideline"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.revolut.core.ui_kit.internal.views.LazyInflatableCachedView
        android:id="@+id/headerWithBigTile_avatarGroupContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/actionStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerWithBigTile_topGuideline"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.revolut.core.ui_kit.views.AvatarView
        android:id="@+id/icon"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/actionStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerWithBigTile_topGuideline"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.revolut.core.ui_kit.internal.views.ActionStatusView
        android:id="@+id/actionStatus"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        app:layout_goneMarginTop="8dp"/>
    <com.revolut.core.ui_kit.internal.views.navbar.VersatileTitleView
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/headerWithBigTile_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionStatus"
        app:layout_goneMarginTop="8dp"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/headerWithBigTile_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/headerWithBigTile_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/headerWithBigTile_descriptionPointsIcon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/headerWithBigTile_description"
        app:layout_constraintEnd_toStartOf="@+id/headerWithBigTile_description"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerWithBigTile_description"
        app:tint="?attr/uikit_colorWhite"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/headerWithBigTile_description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/socialProof"
        app:layout_constraintEnd_toStartOf="@+id/headerWithBigTile_descriptionChevronIcon"
        app:layout_constraintStart_toEndOf="@+id/headerWithBigTile_descriptionPointsIcon"
        app:layout_constraintTop_toBottomOf="@+id/headerWithBigTile_subtitle"
        app:layout_goneMarginEnd="24dp"
        app:layout_goneMarginStart="24dp"
        app:layout_goneMarginTop="8dp"
        style="?attr/internal_textAppearanceHeading3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/headerWithBigTile_descriptionChevronIcon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/headerWithBigTile_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/headerWithBigTile_description"
        app:layout_constraintTop_toTopOf="@+id/headerWithBigTile_description"
        app:tint="?attr/uikit_colorWhite"/>
    <com.revolut.core.ui_kit.internal.views.SocialProofView
        android:id="@+id/socialProof"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/headerWithBigTile_ratingStars"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerWithBigTile_description"
        app:layout_goneMarginTop="8dp"/>
    <com.revolut.core.ui_kit.internal.views.RatingBar
        android:id="@+id/headerWithBigTile_ratingStars"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:internal_fsrb_background_color="?attr/uikit_colorWhite"
        app:internal_fsrb_background_star_filled="false"
        app:internal_fsrb_gap="6dp"
        app:internal_fsrb_half_star_step="true"
        app:internal_fsrb_rating_color="?attr/uikit_colorWhite"
        app:internal_fsrb_star_size="16dp"
        app:layout_constraintBottom_toTopOf="@+id/headerWithBigTile_tagView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/socialProof"
        app:layout_goneMarginTop="8dp"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/headerWithBigTile_tagView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/actionsView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerWithBigTile_ratingStars"
        app:layout_goneMarginTop="16dp"/>
    <com.revolut.core.ui_kit.views.ActionsView
        android:id="@+id/actionsView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:internal_brightDark="true"
        app:internal_paddingEnd="24dp"
        app:internal_paddingStart="24dp"
        app:layout_constraintBottom_toTopOf="@+id/headerWithBigTile_lineProgressIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerWithBigTile_tagView"
        app:layout_goneMarginTop="16dp"/>
    <com.revolut.core.ui_kit.views.HorizontalStepsProgressView
        android:id="@+id/headerWithBigTile_lineProgressIndicator"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/linePageIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionsView"
        app:layout_goneMarginTop="16dp"/>
    <com.revolut.core.ui_kit.internal.views.LinePageIndicator
        android:id="@+id/linePageIndicator"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/headerWithBigTile_searchButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerWithBigTile_lineProgressIndicator"
        app:layout_goneMarginTop="16dp"/>
    <com.revolut.core.ui_kit.views.buttons.SearchButton
        android:id="@+id/headerWithBigTile_searchButton"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/headerWithBigTile_bottomGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linePageIndicator"
        app:layout_goneMarginTop="16dp"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/headerWithBigTile_imagesPreviewTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/headerWithBigTile_bottomGuideline"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/headerWithBigTile_bottomGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
</merge>
