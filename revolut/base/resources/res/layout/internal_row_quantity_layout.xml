<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowQuantity_container"
    android:background="@drawable/internal_box_background_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/rowQuantity_rowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/rowQuantity_decreaseButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/rowQuantity_decreaseButton"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="@+id/rowQuantity_rowContainer"
        app:layout_constraintTop_toBottomOf="@+id/rowQuantity_rowContainer"
        app:layout_goneMarginEnd="0dp"
        app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorAccent"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/rowQuantity_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:maxWidth="100dp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/rowQuantity_decreaseButton"
        app:layout_constraintTop_toBottomOf="@+id/rowQuantity_rowContainer"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/rowQuantity_increaseButton"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/rowQuantity_text"
        app:layout_constraintTop_toBottomOf="@+id/rowQuantity_rowContainer"
        app:layout_goneMarginEnd="0dp"
        app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
