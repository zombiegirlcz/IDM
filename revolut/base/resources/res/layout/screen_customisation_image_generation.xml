<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customisationImageGenerationScreen_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.background.AnimatedBackgroundView
        android:id="@+id/customisationImageGenerationScreen_animatedBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarBottomSheet
        android:id="@+id/customisationImageGenerationScreen_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/customisationImageGenerationScreen_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/customisationImageGenerationScreen_pager"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/customisationImageGenerationScreen_buttonsLayout"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.ScrollingPagerIndicatorView
        android:id="@+id/customisationImageGenerationScreen_pagerIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customisationImageGenerationScreen_pager"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/customisationImageGenerationScreen_buttonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/customisationImageGenerationScreen_firstButton"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/uikit_dp16"
            android:layout_marginRight="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp16"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/customisationImageGenerationScreen_secondButton"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/uikit_dp16"
            android:layout_marginRight="?attr/uikit_dp16"
            android:layout_marginBottom="?attr/uikit_dp24"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
    </LinearLayout>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/customisationImageGenerationScreen_stopButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp64"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
    <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
        android:id="@+id/customisationImageGenerationScreen_suggestionsRecyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/customisationImageGenerationScreen_inputView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.views.ChatInputView
        android:id="@+id/customisationImageGenerationScreen_inputView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
