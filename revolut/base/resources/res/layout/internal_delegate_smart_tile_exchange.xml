<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.amount.AmountEditView
        android:id="@+id/exchangeSmartTile_topAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/exchangeSmartTile_bottomAmount"
        app:layout_constraintEnd_toStartOf="@+id/exchangeSmartTile_chartContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.amount.AmountEditView
        android:id="@+id/exchangeSmartTile_bottomAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/exchangeSmartTile_button"
        app:layout_constraintEnd_toStartOf="@+id/exchangeSmartTile_chartContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exchangeSmartTile_topAmount"/>
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/exchangeSmartTile_chartContainer"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/exchangeSmartTile_bottomAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/exchangeSmartTile_topAmount">
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/exchangeSmartTile_topChartTitleStub"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/exchangeSmartTile_bottomChartTitleStub"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:layout_constraintBottom_toTopOf="@+id/exchangeSmartTile_chartView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/exchangeSmartTile_topChartTitleStub"
            style="?attr/internal_textAppearanceBody3"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="end"
            android:id="@+id/exchangeSmartTile_topChartTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGrey50"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/exchangeSmartTile_bottomChartTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            app:layout_constraintBottom_toTopOf="@+id/exchangeSmartTile_chartView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/exchangeSmartTile_topChartTitle"
            style="?attr/internal_textAppearanceBody3"/>
        <com.revolut.core.ui_kit.internal.views.chart.LineChartView
            android:id="@+id/exchangeSmartTile_chartView"
            android:layout_width="93dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/exchangeSmartTile_bottomChartTitle"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/exchangeSmartTile_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exchangeSmartTile_bottomAmount"/>
</androidx.constraintlayout.widget.ConstraintLayout>
