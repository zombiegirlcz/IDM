<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selfieWithCardGroup"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/overlayTop"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cardMaskView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/overlayLeft"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/overlayBottom"
        app:layout_constraintEnd_toStartOf="@+id/cardMaskView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overlayTop"/>
    <ImageView
        android:id="@+id/cardMaskView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="85.6:54"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cnp_selfie_bank_card_mask"/>
    <com.revolut.core.backend_flow.photo.selfserve.selfie.common.selfiewithcard.selfiecamera.NumberCoverDrawView
        android:id="@+id/numberCoverDrawView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="85.6:54"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/overlayRight"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/overlayBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardMaskView"
        app:layout_constraintTop_toBottomOf="@+id/overlayTop"/>
    <View
        android:id="@+id/overlayBottom"
        android:background="?attr/uikit_colorBlack_80"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardMaskView"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Space
        android:id="@+id/leftTopNumberCover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cardMaskView"
        app:layout_constraintEnd_toEndOf="@+id/cardMaskView"
        app:layout_constraintHorizontal_bias="0.08"
        app:layout_constraintStart_toStartOf="@+id/cardMaskView"
        app:layout_constraintTop_toTopOf="@+id/cardMaskView"
        app:layout_constraintVertical_bias="0.52"/>
    <Space
        android:id="@+id/rightBottomNumberCover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cardMaskView"
        app:layout_constraintEnd_toEndOf="@+id/cardMaskView"
        app:layout_constraintHorizontal_bias="0.71"
        app:layout_constraintStart_toStartOf="@+id/cardMaskView"
        app:layout_constraintTop_toTopOf="@+id/cardMaskView"
        app:layout_constraintVertical_bias="0.72"/>
    <View
        android:id="@+id/numberCoverView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rightBottomNumberCover"
        app:layout_constraintEnd_toEndOf="@+id/rightBottomNumberCover"
        app:layout_constraintStart_toEndOf="@+id/leftTopNumberCover"
        app:layout_constraintTop_toTopOf="@+id/leftTopNumberCover"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/overlayGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="overlayTop, overlayLeft, overlayRight, overlayBottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
