<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tripShareBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navBarWithToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/tripShareCardContainer"
        android:padding="10dp"
        android:layout_width="300dp"
        android:layout_height="310dp"
        android:layout_marginBottom="40dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tripShareCardMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|top"
            android:id="@+id/tripShareCardRevolutLogoNew"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="14.67dp"
            android:layout_margin="2dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|top"
            android:orientation="horizontal"
            android:id="@+id/tripShareCardTopRightHeader"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tripShareCardTopIconNew"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10sp"
                android:textColor="?attr/uikit_colorWhite"
                android:id="@+id/tripShareCardUserTravels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="10sp"
            android:textColor="?attr/uikit_colorWhite"
            android:layout_gravity="start|top"
            android:id="@+id/tripShareCardUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/textAppearanceBodySmall"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/tripShareCardTopIcon"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="10sp"
            android:textColor="?attr/uikit_colorWhite"
            android:layout_gravity="end|top"
            android:id="@+id/tripShareCardJoinDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/tripShareCardRevolutLogo"
            android:layout_width="60dp"
            android:layout_height="13.75dp"
            android:layout_margin="2dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/tripShareCardBottomContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/tripShareCardWorldPercentageContainer"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="36sp"
                    android:textColor="?attr/uikit_colorWhite"
                    android:id="@+id/tripShareCardWorldPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="?attr/uikit_colorWhite"
                    android:id="@+id/tripShareCardWorldPercentageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/tripShareCardTripsContainer"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="36sp"
                    android:textColor="?attr/uikit_colorWhite"
                    android:id="@+id/tripShareCardTripsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="?attr/uikit_colorWhite"
                    android:id="@+id/tripShareCardTripsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/tripShareCardCountriesContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="36sp"
                    android:textColor="?attr/uikit_colorWhite"
                    android:id="@+id/tripShareCardCountriesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="?attr/uikit_colorWhite"
                    android:id="@+id/tripShareCardCountriesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <com.revolut.core.ui_kit.views.ActionsView
        android:layout_gravity="bottom"
        android:id="@+id/tripShareActionButtonsBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
