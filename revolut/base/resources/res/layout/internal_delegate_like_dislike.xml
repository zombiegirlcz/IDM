<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="start"
        android:id="@+id/delegateLikeDislike_topLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/delegateLikeDislike_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.ButtonBarLayout
        android:id="@+id/delegateLikeDislike_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delegateLikeDislike_topLabel"
        app:layout_goneMarginBottom="24dp"
        app:layout_goneMarginTop="24dp"
        app:uikit_childMargin="8dp">
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:id="@+id/delegateLikeDislike_primaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:id="@+id/delegateLikeDislike_secondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </com.revolut.core.ui_kit.internal.views.ButtonBarLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
