<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/ratingView_valueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp12"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCard_titleText"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/ratingView_descriptionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp4"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/ratingView_valueText"
        app:layout_constraintEnd_toStartOf="@+id/ratingView_starRating"
        app:layout_constraintStart_toEndOf="@+id/ratingView_valueText"
        app:layout_constraintTop_toTopOf="@+id/ratingView_valueText"
        app:layout_goneMarginStart="?attr/uikit_dp16"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.RatingBar
        android:id="@+id/ratingView_starRating"
        android:layout_width="wrap_content"
        android:layout_height="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:internal_fsrb_background_color="?attr/uikit_colorForeground"
        app:internal_fsrb_background_star_filled="false"
        app:internal_fsrb_gap="?attr/uikit_dp4"
        app:internal_fsrb_half_star_step="true"
        app:internal_fsrb_rating_color="?attr/uikit_colorForeground"
        app:internal_fsrb_star_size="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="@+id/ratingView_valueText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ratingView_valueText"/>
</merge>
