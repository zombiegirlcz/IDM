<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flightDetails_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.CutoutImageView
        android:id="@+id/flightDetails_airlineIcon"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/flightDetails_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/flightDetails_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/flightDetails_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintStart_toEndOf="@+id/flightDetails_airlineIcon"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/flightDetails_dotsView"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/flightDetails_placeArrival"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/flightDetails_timeDeparture"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/flightDetails_timeDeparture"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/flightDetails_dotsView"
        app:layout_constraintTop_toBottomOf="@+id/flightDetails_title"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/flightDetails_departureDayOffset"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/flightDetails_timeDeparture"
        app:layout_constraintStart_toEndOf="@+id/flightDetails_timeDeparture"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/flightDetails_placeDeparture"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/flightDetails_timeDeparture"
        app:layout_constraintTop_toBottomOf="@+id/flightDetails_timeDeparture"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/flightDetails_duration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingVertical="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="@+id/flightDetails_timeDeparture"
        app:layout_constraintTop_toBottomOf="@+id/flightDetails_placeDeparture"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/flightDetails_timeArrival"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/flightDetails_timeDeparture"
        app:layout_constraintTop_toBottomOf="@+id/flightDetails_duration"
        app:layout_goneMarginTop="@dimen/internal_dp48"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/flightDetails_arrivalDayOffset"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/flightDetails_timeArrival"
        app:layout_constraintStart_toEndOf="@+id/flightDetails_timeArrival"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/flightDetails_placeArrival"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/flightDetails_timeDeparture"
        app:layout_constraintTop_toBottomOf="@+id/flightDetails_timeArrival"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:id="@+id/flightDetails_connection"
        android:background="@drawable/uikit_icn_rounded_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:maxLines="1"
        android:backgroundTint="?attr/uikit_colorNestedBackground"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/internal_dp12"
        app:layout_constraintStart_toStartOf="@+id/flightDetails_timeDeparture"
        app:layout_constraintTop_toBottomOf="@+id/flightDetails_placeArrival"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/flightDetails_dateArrival"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flightDetails_connection"
        style="?attr/internal_textAppearanceBody3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
