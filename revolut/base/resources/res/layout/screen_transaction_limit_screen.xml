<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenTransactionLimit_container"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarBottomSheet
        android:id="@+id/screenTransactionLimit_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/screenTransactionLimit_recyclerView"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"
        app:layout_constraintBottom_toTopOf="@+id/screenTransactionLimit_footerView"
        app:layout_constraintTop_toBottomOf="@+id/screenTransactionLimit_navBar"/>
    <com.revolut.core.ui_kit.views.FooterTextView
        android:id="@+id/screenTransactionLimit_footerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/screenTransactionLimit_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.views.LargeActionButton
        android:id="@+id/screenTransactionLimit_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/uikit_dp16"
        android:layout_marginRight="?attr/uikit_dp16"
        android:layout_marginBottom="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:uikit_LargeActionButtonStyle="AccentButton"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
