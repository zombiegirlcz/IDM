<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navBarWithToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:expanded="true"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/recycler_view_res_0x7f0a1777"
        android:paddingBottom="@dimen/dp_96"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/uikit_bottom_container_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fitNavigationBar="true">
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/schedule_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/next_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/next_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/schedule_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/schedule_button"
            app:layout_constraintTop_toTopOf="@+id/schedule_button"
            app:uikit_LargeActionButtonStyle="AccentButton"/>
    </com.revolut.core.ui_kit.views.legacy.LegacyButtonContainerConstraintLayout>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerCoordinatorLayout>
