<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
            android:id="@+id/horizontalRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/verticalRecyclerView"
        android:paddingBottom="@dimen/dp_80"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.buttons.TwinVerticalButton
        android:layout_gravity="bottom"
        android:id="@+id/twinVerticalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
