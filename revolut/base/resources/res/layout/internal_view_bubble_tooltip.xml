<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bubbleTooltipView_itemContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bubbleTooltipView_icon"
            android:visibility="gone"
            android:layout_width="?attr/uikit_dp16"
            android:layout_height="?attr/uikit_dp16"
            android:layout_marginTop="?attr/uikit_dp4"
            android:layout_marginBottom="?attr/uikit_dp4"
            android:layout_marginStart="?attr/uikit_dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bubbleTooltipView_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:id="@+id/bubbleTooltipView_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp4"
            android:layout_marginBottom="?attr/uikit_dp4"
            android:lines="1"
            android:layout_marginStart="?attr/uikit_dp8"
            android:layout_marginEnd="?attr/uikit_dp8"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/bubbleTooltipView_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="?attr/uikit_dp8"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bubbleTooltipView_bottomArrow"
        android:layout_width="18dp"
        android:layout_height="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bubbleTooltipView_itemContainer"/>
</merge>
