<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/internalRateDelegate_root"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/rate_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="18dp"
        android:textAlignment="textStart"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toTopOf="@+id/rate_description"
        app:layout_constraintEnd_toStartOf="@+id/rate_closeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <ImageView
        android:id="@+id/rate_closeButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="?attr/uikit_colorGreyTone20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rate_title"
        app:srcCompat="@drawable/uikit_icn_24_cross"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/rate_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toTopOf="@+id/rate_bottomBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/rate_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toBottomOf="@+id/rate_fiveStarRating"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rate_fiveStarRating"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.RatingBar
        android:id="@+id/rate_fiveStarRating"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        app:internal_fsrb_background_color="?attr/uikit_colorAccent"
        app:internal_fsrb_background_star_filled="false"
        app:internal_fsrb_gap="12dp"
        app:internal_fsrb_half_star_step="false"
        app:internal_fsrb_rating_color="?attr/uikit_colorAccent"
        app:internal_fsrb_star_size="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/rate_ActionButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rate_description"
        app:layout_goneMarginTop="0dp"
        app:uikit_SmallActionButtonStyle="AccentButton"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/rate_bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="rate_ActionButton, rate_fiveStarRating"/>
</androidx.constraintlayout.widget.ConstraintLayout>
