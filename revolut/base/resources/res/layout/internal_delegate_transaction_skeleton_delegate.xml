<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/transactionSkeletonDelegate_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_max="20dp"
        app:layout_constraintHeight_min="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/transactionSkeletonDelegate_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="26dp"
        app:layout_constraintBottom_toBottomOf="@+id/transactionSkeletonDelegate_image"
        app:layout_constraintEnd_toStartOf="@+id/transactionSkeletonDelegate_value"
        app:layout_constraintHeight_min="4dp"
        app:layout_constraintStart_toEndOf="@+id/transactionSkeletonDelegate_image"
        app:layout_constraintTop_toTopOf="@+id/transactionSkeletonDelegate_image"/>
    <View
        android:id="@+id/transactionSkeletonDelegate_value"
        android:layout_width="20dp"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/transactionSkeletonDelegate_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="4dp"
        app:layout_constraintTop_toTopOf="@+id/transactionSkeletonDelegate_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
