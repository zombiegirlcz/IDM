<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <com.revolut.core.ui_kit.internal.views.LabelView
        android:textAppearance="?attr/internal_textAppearanceEmphasis2"
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/expandableCell_titleLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        app:endIconPadding="@dimen/internal_dp8"
        app:endIconPlacement="lastLineBottom"
        app:endIconSize="@dimen/internal_dp16"
        app:layout_constraintEnd_toStartOf="@+id/expandableCell_valuesContainer"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/expandableCell_valuesContainer"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/expandableCell_titleLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/expandableCell_titleLabel"
        app:layout_constraintTop_toTopOf="@+id/expandableCell_titleLabel">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/expandableCell_valueImage"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/internal_dp8"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorForeground"
            android:layout_gravity="end|bottom"
            android:id="@+id/expandableCell_txtValue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/internal_dp8"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/expandableCell_txtDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp16"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/expandableCell_titleLabel"
        app:layout_constraintTop_toBottomOf="@+id/expandableCell_titleLabel"
        style="?attr/textAppearanceCaption"/>
</androidx.constraintlayout.widget.ConstraintLayout>
