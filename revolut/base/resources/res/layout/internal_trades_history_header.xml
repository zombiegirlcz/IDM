<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tradesHistoryHeader_startText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tradesHistoryHeader_middleText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:textAlignment="viewEnd"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tradesHistoryHeader_endText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:textAlignment="viewEnd"
        style="?attr/internal_textAppearanceBody2"/>
</merge>
