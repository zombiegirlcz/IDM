<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UIKitImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/backgroundImageOverlay"
        android:background="@drawable/internal_header_gradient_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/backgroundImage"
        app:layout_constraintEnd_toEndOf="@+id/backgroundImage"
        app:layout_constraintStart_toStartOf="@+id/backgroundImage"
        app:layout_constraintTop_toTopOf="@+id/backgroundImage"/>
    <com.revolut.core.ui_kit.internal.views.navbar.ImageAutoSizeTextView
        android:id="@+id/descriptionText"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="41sp"
        android:layout_marginTop="@dimen/internal_vaults_menu_height"
        android:paddingStart="?attr/uikit_dp16"
        android:paddingEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/internal_dp24"
        app:layout_constraintBottom_toTopOf="@+id/actionStatus"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iconBadge"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toEndOf="@+id/icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/actionStatus"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp8"
        android:lines="1"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constraintBottom_toTopOf="@+id/titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorWhite"
        android:ellipsize="end"
        android:id="@+id/titleView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp24"
        android:maxLines="2"
        android:layout_marginStart="@dimen/internal_dp24"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/vaultsHeaderLayout_subtitleView"
        app:layout_constraintEnd_toStartOf="@+id/titleIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginEnd="@dimen/internal_dp24"
        style="?attr/internal_textAppearanceHeading1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorWhite"
        android:id="@+id/vaultsHeaderLayout_subtitleView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp16"
        android:maxLines="1"
        android:layout_marginStart="@dimen/internal_dp24"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constraintBottom_toTopOf="@+id/actionsView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="@dimen/internal_dp24"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/titleIcon"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constraintBottom_toBottomOf="@+id/titleView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/titleView"
        app:layout_constraintTop_toTopOf="@+id/titleView"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/endBottomIcon"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="@dimen/internal_dp24"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/internal_dp8"
        android:layout_marginEnd="@dimen/internal_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.revolut.core.ui_kit.views.ActionsView
        android:id="@+id/actionsView"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp24"
        android:paddingStart="@dimen/internal_dp8"
        android:paddingEnd="@dimen/internal_dp8"
        app:internal_brightDark="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
