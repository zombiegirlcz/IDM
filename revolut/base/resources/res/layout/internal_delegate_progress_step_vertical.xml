<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_colorBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.ProgressStepVerticalIndicatorView
        android:id="@+id/progressStepVertical_stepProgress"
        android:layout_width="@dimen/internal_dp4"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/progressStepVertical_stepTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/progressStepVertical_stepSubtitle"
        app:layout_constraintEnd_toStartOf="@+id/progressStepVertical_endIconsView"
        app:layout_constraintStart_toEndOf="@+id/progressStepVertical_stepProgress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="@dimen/internal_dp4"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/progressStepVertical_stepSubtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:layout_marginBottom="@dimen/internal_dp4"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/internal_dp16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/progressStepVertical_stepFooterText"
        app:layout_constraintEnd_toStartOf="@+id/progressStepVertical_endIconsView"
        app:layout_constraintStart_toEndOf="@+id/progressStepVertical_stepProgress"
        app:layout_constraintTop_toBottomOf="@+id/progressStepVertical_stepTitle"
        app:layout_goneMarginTop="@dimen/internal_dp4"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/progressStepVertical_stepFooterText"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:layout_marginBottom="@dimen/internal_dp4"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/progressStepVertical_endIconsView"
        app:layout_constraintStart_toEndOf="@+id/progressStepVertical_stepProgress"
        app:layout_constraintTop_toBottomOf="@+id/progressStepVertical_stepSubtitle"
        app:layout_goneMarginTop="@dimen/internal_dp4"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.views.OverlappedIconsView
        android:id="@+id/progressStepVertical_endIconsView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
