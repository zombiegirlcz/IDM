<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tradesHistoryRow_startValue"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tradesHistoryRow_middleValue"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:textAlignment="viewEnd"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tradesHistoryRow_endValue"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:textAlignment="viewEnd"
        style="?attr/internal_textAppearanceBody3"/>
</merge>
