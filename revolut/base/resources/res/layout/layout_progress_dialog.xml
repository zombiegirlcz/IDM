<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/dialogRoot"
    android:background="?attr/uikit_colorBackground"
    android:paddingLeft="16dp"
    android:paddingTop="52dp"
    android:paddingRight="16dp"
    android:paddingBottom="40dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.revolut.uicomponent.transactions.CircleProgressBar
        android:id="@+id/circleProgressBar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:max="100"
        app:min="0"
        app:progressBarThickness="3dp"
        app:progressbarColor="?attr/uikit_colorAccent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieView"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="@+id/circleProgressBar"
        app:layout_constraintEnd_toEndOf="@+id/circleProgressBar"
        app:layout_constraintStart_toStartOf="@+id/circleProgressBar"
        app:layout_constraintTop_toTopOf="@+id/circleProgressBar"
        app:lottie_autoPlay="false"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="20dp"
        android:textColor="?attr/uikit_colorAccent"
        android:id="@+id/circleProgressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/circleProgressBar"
        app:layout_constraintEnd_toEndOf="@+id/circleProgressBar"
        app:layout_constraintStart_toStartOf="@+id/circleProgressBar"
        app:layout_constraintTop_toTopOf="@+id/circleProgressBar"
        app:ttv_typeface="medium"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="16dp"
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center"
        android:id="@+id/circleProgressTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Uploading is in progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/circleProgressBar"
        app:ttv_typeface="medium"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:gravity="center"
        android:id="@+id/circleProgressSubtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/circleProgressTitle"
        app:ttv_typeface="regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
