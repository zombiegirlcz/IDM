<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/themeCustomisation_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.ScreenContentNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.revolut.core.ui_kit.views.TwoViewsSwitcherView
                android:id="@+id/themeCustomisation_previewSwitcherView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/themeCustomisation_wallpapersTopMargin"
                app:layout_constraintBottom_toTopOf="@+id/themeCustomisation_bottomSection"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="432dp"
                app:layout_constraintHeight_min="320dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/themeCustomisation_wallpapersRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/themeCustomisation_chatsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.revolut.core.ui_kit.views.TwoViewsSwitcherView>
            <com.revolut.core.ui_kit.views.TwoViewsSwitcherView
                android:id="@+id/themeCustomisation_bottomSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/themeCustomisation_buttonsTopMargin"
                app:layout_constraintBottom_toTopOf="@+id/themeCustomisation_disclaimer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_min="76dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/themeCustomisation_previewSwitcherView"/>
            <com.revolut.core.ui_kit.views.FooterTextView
                android:layout_gravity="center"
                android:id="@+id/themeCustomisation_disclaimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/themeCustomisation_actionFooter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/themeCustomisation_bottomSection"/>
            <com.revolut.core.ui_kit.views.buttons.ActionFooterView
                android:id="@+id/themeCustomisation_actionFooter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.revolut.core.ui_kit.views.ScreenContentNestedScrollView>
</com.revolut.kompot.view.ControllerContainerLinearLayout>
