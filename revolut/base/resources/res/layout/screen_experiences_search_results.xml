<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/experiencesSearchResults_navBarWithToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.views.InputTravelSearchItemView
            android:id="@+id/experiencesSearchResults_searchInputView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar>
    <com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer
        android:id="@+id/experiencesSearchResults_slidingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationY="?attr/uikit_dp32"
        app:layout_anchor="@+id/experiencesSearchResults_navBarWithToolbar"
        app:layout_anchorGravity="bottom">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/uikit_windowBackground"
            android:paddingTop="?attr/uikit_dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.revolut.core.ui_kit.views.InputTravelSearchItemView
                android:id="@+id/experiencesSearchResults_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer>
    <com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer
        android:id="@+id/experiencesSearchResults_slidingContainerFilters"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationY="?attr/uikit_dp24"
        app:layout_anchor="@+id/experiencesSearchResults_navBarWithToolbar"
        app:layout_anchorGravity="bottom">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/uikit_windowBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.revolut.core.ui_kit.views.ActionsView
                android:id="@+id/experiencesSearchResults_quickFiltersActions"
                android:background="?attr/uikit_windowBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                android:layout_marginBottom="?attr/uikit_dp8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/experiencesSearchResults_dates"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/experiencesSearchResults_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
