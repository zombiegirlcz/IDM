<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/internalDelegateNewProductSmall_guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/internal_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/internalDelegateNewProductSmall_guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/internal_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/internalDelegateNewProductSmall_guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/internal_dp16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/internalDelegateNewProductSmall_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintBottom_toTopOf="@+id/internalDelegateNewProductSmall_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/internalDelegateNewProductSmall_badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/internalDelegateNewProductSmall_guidelineStart"
        app:layout_constraintTop_toTopOf="@+id/internalDelegateNewProductSmall_guidelineTop"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorWhite"
        android:id="@+id/internalDelegateNewProductSmall_badge"
        android:background="@drawable/internal_background_new_product_small_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/internalDelegateNewProductSmall_icon"
        app:layout_constraintStart_toEndOf="@+id/internalDelegateNewProductSmall_title"
        app:layout_constraintTop_toTopOf="@+id/internalDelegateNewProductSmall_title"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/internalDelegateNewProductSmall_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/internal_dp4"
        android:maxLines="3"
        android:layout_marginEnd="@dimen/internal_dp8"
        app:layout_constraintBottom_toBottomOf="@+id/internalDelegateNewProductSmall_guidelineBottom"
        app:layout_constraintEnd_toStartOf="@+id/internalDelegateNewProductSmall_icon"
        app:layout_constraintStart_toStartOf="@+id/internalDelegateNewProductSmall_guidelineStart"
        app:layout_constraintTop_toBottomOf="@+id/internalDelegateNewProductSmall_title"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/internalDelegateNewProductSmall_icon"
        android:layout_width="96dp"
        android:layout_height="98dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
