<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/referralOutput_viewBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/referralOutput_contentBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/referralOutput_content"
        app:layout_constraintEnd_toEndOf="@+id/referralOutput_content"
        app:layout_constraintStart_toStartOf="@+id/referralOutput_content"
        app:layout_constraintTop_toTopOf="@+id/referralOutput_content"
        app:srcCompat="@drawable/internal_referral_outline_content_drawable"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/referralOutput_content"
        android:padding="40dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/referralOutput_codeImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>
        <View
            android:id="@+id/referralOutput_spaceCenter"
            android:layout_width="?attr/uikit_dp24"
            android:layout_height="?attr/uikit_dp24"/>
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorBlack"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/referralOutput_messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            style="?attr/internal_textAppearanceEmphasis1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</merge>
