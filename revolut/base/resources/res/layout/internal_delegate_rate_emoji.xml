<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/rateEmoji_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <ImageView
        android:id="@+id/rateEmoji_closeButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="?attr/uikit_colorGreyTone20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_16_cross"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rateEmoji_imageFirst"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toStartOf="@+id/rateEmoji_imageSecond"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rateEmoji_title"
        app:layout_goneMarginTop="8dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/rateEmoji_labelFirst"
        android:layout_width="@dimen/internal_dp72"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/rateEmoji_imageFirst"
        app:layout_constraintStart_toStartOf="@+id/rateEmoji_imageFirst"
        app:layout_constraintTop_toBottomOf="@+id/rateEmoji_imageFirst"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rateEmoji_imageSecond"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toStartOf="@+id/rateEmoji_imageThird"
        app:layout_constraintStart_toEndOf="@+id/rateEmoji_imageFirst"
        app:layout_constraintTop_toTopOf="@+id/rateEmoji_imageFirst"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/rateEmoji_labelSecond"
        android:layout_width="@dimen/internal_dp72"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/rateEmoji_imageSecond"
        app:layout_constraintStart_toStartOf="@+id/rateEmoji_imageSecond"
        app:layout_constraintTop_toBottomOf="@+id/rateEmoji_imageSecond"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rateEmoji_imageThird"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toStartOf="@+id/rateEmoji_imageFourth"
        app:layout_constraintStart_toEndOf="@+id/rateEmoji_imageSecond"
        app:layout_constraintTop_toTopOf="@+id/rateEmoji_imageFirst"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/rateEmoji_labelThird"
        android:layout_width="@dimen/internal_dp72"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/rateEmoji_imageThird"
        app:layout_constraintStart_toStartOf="@+id/rateEmoji_imageThird"
        app:layout_constraintTop_toBottomOf="@+id/rateEmoji_imageThird"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rateEmoji_imageFourth"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toStartOf="@+id/rateEmoji_imageFifth"
        app:layout_constraintStart_toEndOf="@+id/rateEmoji_imageThird"
        app:layout_constraintTop_toTopOf="@+id/rateEmoji_imageFirst"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/rateEmoji_labelFourth"
        android:layout_width="@dimen/internal_dp72"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/rateEmoji_imageFourth"
        app:layout_constraintStart_toStartOf="@+id/rateEmoji_imageFourth"
        app:layout_constraintTop_toBottomOf="@+id/rateEmoji_imageFourth"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rateEmoji_imageFifth"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rateEmoji_imageFourth"
        app:layout_constraintTop_toTopOf="@+id/rateEmoji_imageFirst"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/rateEmoji_labelFifth"
        android:layout_width="@dimen/internal_dp72"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/rateEmoji_imageFifth"
        app:layout_constraintStart_toStartOf="@+id/rateEmoji_imageFifth"
        app:layout_constraintTop_toBottomOf="@+id/rateEmoji_imageFifth"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorAccent"
        android:id="@+id/rateEmoji_bottomButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rateEmoji_labelFirst"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
