<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trendPreviewLoading_shimmerLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/trendPreviewLoading_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="69dp"
            android:layout_height="18dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/trendPreviewLoading_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/trendPreviewLoading_subtitle"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="53dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trendPreviewLoading_title"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/trendPreviewLoading_barrier"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:barrierDirection="right"
            app:constraint_referenced_ids="trendPreviewLoading_title,trendPreviewLoading_subtitle"/>
        <com.revolut.core.ui_kit.internal.views.trend.TrendPreviewView
            android:id="@+id/trendPreviewLoading_chart"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/trendPreviewLoading_barrier"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
