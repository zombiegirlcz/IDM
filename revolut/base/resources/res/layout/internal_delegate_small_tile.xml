<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smallTile_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/smallTile_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/smallTile_title"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.videoplayer.UiKitPlayerView
        android:id="@+id/smallTile_playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/smallTile_image"
        app:layout_constraintLeft_toLeftOf="@+id/smallTile_image"
        app:layout_constraintRight_toRightOf="@+id/smallTile_image"
        app:layout_constraintTop_toTopOf="@+id/smallTile_image"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/smallTile_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:maxLines="1"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="@+id/smallTile_image"
        app:layout_constraintStart_toStartOf="@+id/smallTile_image"
        app:layout_constraintTop_toBottomOf="@+id/smallTile_image"
        style="?attr/internal_textAppearanceBody2"/>
    <View
        android:id="@+id/smallTile_foregroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/smallTile_image"
        app:layout_constraintEnd_toEndOf="@+id/smallTile_image"
        app:layout_constraintStart_toStartOf="@+id/smallTile_image"
        app:layout_constraintTop_toTopOf="@+id/smallTile_image"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/smallTile_badgeIcon"
        android:visibility="gone"
        android:layout_width="?attr/uikit_dp24"
        android:layout_height="?attr/uikit_dp24"
        android:translationX="6dp"
        android:translationY="-6dp"
        app:layout_constraintEnd_toEndOf="@+id/smallTile_image"
        app:layout_constraintTop_toTopOf="@+id/smallTile_image"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorBackground"
        android:gravity="center"
        android:id="@+id/smallTile_badgeText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="?attr/uikit_dp24"
        android:minHeight="?attr/uikit_dp24"
        android:includeFontPadding="false"
        android:maxLength="2"
        android:translationX="6dp"
        android:translationY="-6dp"
        app:layout_constraintEnd_toEndOf="@+id/smallTile_badgeIcon"
        app:layout_constraintTop_toTopOf="@+id/smallTile_badgeIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
