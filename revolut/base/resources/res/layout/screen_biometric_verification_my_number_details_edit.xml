<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/biometricVerificationMyNumberDetailsEdit_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="112dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="?attr/uikit_dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/uikit_dp16"
            android:paddingEnd="?attr/uikit_dp16">
            <com.revolut.core.ui_kit.views.input.InputText
                android:id="@+id/biometricVerificationMyNumberDetailsEdit_expiryYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.revolut.core.ui_kit.views.input.InputText
                android:id="@+id/biometricVerificationMyNumberDetailsEdit_securityCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.revolut.core.ui_kit.views.FooterActionButtonView
        android:layout_gravity="bottom"
        android:id="@+id/biometricVerificationMyNumberDetailsEdit_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
