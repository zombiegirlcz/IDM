<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <io.fotoapparat.view.CameraView
        android:id="@+id/cardPhoto_cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/cardPhoto_previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"/>
    <View
        android:background="@drawable/mask_gradient_top"
        android:layout_width="wrap_content"
        android:layout_height="80dp"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/mask_gradient_bottom"
        android:layout_width="wrap_content"
        android:layout_height="140dp"/>
    <FrameLayout
        android:id="@+id/cardPhoto_finderGroup"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
            android:id="@+id/cardPhoto_navBarWithToolbar"
            android:background="?attr/uikit_windowBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/cardPhoto_takePhotoButton"
            android:background="@drawable/ic_shutter"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"/>
        <com.revolut.core.ui_kit.views.buttons.TwinVerticalButton
            android:layout_gravity="bottom"
            android:id="@+id/cardPhoto_twinVerticalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</com.revolut.kompot.view.ControllerContainerFrameLayout>
