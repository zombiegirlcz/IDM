<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/segmentedGaugeChartLoading_shimmerLayout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.gaugechart.SegmentedGaugeChartView
            android:id="@+id/segmentedGaugeChartLoading_chart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/segmentedGaugeChartLoading_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/segmentedGaugeChartLoading_button"
            app:layout_constraintEnd_toEndOf="@+id/segmentedGaugeChartLoading_chart"
            app:layout_constraintStart_toStartOf="@+id/segmentedGaugeChartLoading_chart"
            app:layout_constraintTop_toTopOf="@+id/segmentedGaugeChartLoading_chart"
            app:layout_constraintVertical_chainStyle="packed"
            style="?attr/internal_textAppearanceDisplay2"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:layout_gravity="center"
            android:id="@+id/segmentedGaugeChartLoading_button"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/segmentedGaugeChartLoading_chart"
            app:layout_constraintEnd_toEndOf="@+id/segmentedGaugeChartLoading_chart"
            app:layout_constraintStart_toStartOf="@+id/segmentedGaugeChartLoading_chart"
            app:layout_constraintTop_toBottomOf="@+id/segmentedGaugeChartLoading_display"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
