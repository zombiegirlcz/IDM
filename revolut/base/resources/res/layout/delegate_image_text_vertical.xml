<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/image_text_root"
        android:background="@drawable/deprecated_background_selectable_transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/icons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:layout_constraintEnd_toEndOf="@+id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/bottom_right_icon_badge"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <ImageView
                android:layout_gravity="top|right"
                android:id="@+id/top_right_icon_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_m"
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_s"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="@+id/icons_layout"
            app:layout_constraintStart_toStartOf="@+id/icons_layout"
            app:layout_constraintTop_toBottomOf="@+id/icons_layout"
            app:ttv_typeface="medium"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_s"
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="@+id/icons_layout"
            app:layout_constraintStart_toStartOf="@+id/icons_layout"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:ttv_typeface="regular"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="@dimen/material_text_size_s"
            android:textColor="?attr/uikit_colorPink"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="@+id/icons_layout"
            app:layout_constraintStart_toStartOf="@+id/icons_layout"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            app:ttv_typeface="regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
