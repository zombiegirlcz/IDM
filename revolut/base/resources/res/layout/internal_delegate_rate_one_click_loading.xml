<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/rateOneClickLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/rateOneClickLoading_title"
            android:layout_width="168dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toTopOf="@+id/rateOneClickLoading_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/internal_textAppearanceEmphasis1"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringPillShapeView
            android:id="@+id/rateOneClickLoading_item1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rateOneClickLoading_item2"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rateOneClickLoading_title"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringPillShapeView
            android:id="@+id/rateOneClickLoading_item2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/rateOneClickLoading_item1"
            app:layout_constraintEnd_toStartOf="@+id/rateOneClickLoading_item3"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/rateOneClickLoading_item1"
            app:layout_constraintTop_toTopOf="@+id/rateOneClickLoading_item1"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringPillShapeView
            android:id="@+id/rateOneClickLoading_item3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/rateOneClickLoading_item1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/rateOneClickLoading_item2"
            app:layout_constraintTop_toTopOf="@+id/rateOneClickLoading_item1"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
