<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/imageViewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/topOverlay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/mask"
            app:layout_constraintHeight_default="spread"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.camera.facelift.CameraMaskView
            android:id="@+id/mask"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="66dp"
            android:layout_marginBottom="46dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/footer"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navBar"
            app:layout_constraintVertical_bias="0"/>
        <View
            android:id="@+id/bottomOverlay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_default="spread"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mask"/>
        <TextView
            android:textColor="?attr/uikit_colorWhite"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/descriptionView"
            android:paddingLeft="?attr/uikit_dp16"
            android:paddingRight="?attr/uikit_dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lines="2"
            app:layout_constraintBottom_toTopOf="@+id/footer"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            style="?attr/internal_textAppearanceBody1"/>
        <FrameLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:animateLayoutChanges="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <ImageButton
                android:layout_gravity="center"
                android:id="@+id/buttonAction"
                android:background="@null"
                android:visibility="invisible"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_shutter_facelifted"
                android:scaleType="centerInside"/>
            <com.revolut.core.ui_kit.views.buttons.TwinHorizontalButton
                android:layout_gravity="center"
                android:id="@+id/twinHorizontalButton"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <com.revolut.core.ui_kit.views.navbar.BasicNavBar
            android:theme="@style/UiKitColorsTheme.Night"
            android:id="@+id/navBar"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/splash"
        android:background="?attr/uikit_colorPink"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout>
