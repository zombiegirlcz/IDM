<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/internalViewCardPersonalization_imageContainer"
        android:layout_width="@dimen/internal_revolut_card_image_width"
        android:layout_height="@dimen/internal_revolut_card_image_height"
        android:layout_marginTop="62dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/internalViewCardPersonalization_cardImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/uikit_pic_602_card_placeholder"/>
        <com.revolut.core.ui_kit.views.CardPersonalisationDrawingView
            android:id="@+id/internalViewCardPersonalization_drawingView"
            android:background="?attr/uikit_colorTransparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/internalViewCardPersonalization_customisationAnimationView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.internal.views.ThicknessSliderView
        android:id="@+id/internalViewCardPersonalization_thicknessSlider"
        android:visibility="invisible"
        android:layout_width="@dimen/internal_thickness_slider_width"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/internalViewCardPersonalization_imageContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/internal_thickness_slider_height"
        app:layout_constraintTop_toTopOf="@+id/internalViewCardPersonalization_imageContainer"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/internalViewCardPersonalization_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internalViewCardPersonalization_imageContainer"/>
</merge>
