<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.internal.views.UiKitMediaView
        android:id="@+id/planTile_backgroundMedia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/planTile_gradient"
        android:background="@drawable/internal_plan_tile_gradient_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/planTile_titleImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="@dimen/internal_dp4"
        android:baselineAlignBottom="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/planTile_title"
        app:layout_constraintBottom_toBottomOf="@+id/planTile_title"
        app:layout_constraintEnd_toStartOf="@+id/planTile_title"
        app:layout_constraintStart_toStartOf="@+id/planTile_startGuideline"
        app:layout_constraintTop_toTopOf="@+id/planTile_title"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/planTile_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/planTile_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/planTile_tag"
        app:layout_constraintStart_toEndOf="@+id/planTile_titleImage"
        app:layout_constraintTop_toTopOf="@+id/planTile_topGuideline"
        style="?attr/internal_textAppearanceHeading1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorAccent"
        android:id="@+id/planTile_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/planTile_amountDescription"
        app:layout_constraintEnd_toStartOf="@+id/planTile_endGuideline"
        app:layout_constraintStart_toStartOf="@+id/planTile_startGuideline"
        app:layout_constraintTop_toBottomOf="@+id/planTile_title"
        app:layout_constraintVertical_bias="1"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/planTile_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/planTile_title"
        app:layout_constraintEnd_toStartOf="@+id/planTile_endTextBarrier"
        app:layout_constraintTop_toTopOf="@+id/planTile_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/planTile_endText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/planTile_title"
        app:layout_constraintEnd_toEndOf="@+id/planTile_endGuideline"
        app:layout_constraintTop_toTopOf="@+id/planTile_title"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGrey50"
        android:id="@+id/planTile_endTextDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/planTile_endGuideline"
        app:layout_constraintTop_toBottomOf="@+id/planTile_endText"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="vertical"
        android:id="@+id/planTile_endTextBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="planTile_endText, planTile_endTextDescription"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGrey50"
        android:id="@+id/planTile_caption"
        android:paddingTop="?attr/uikit_dp4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/planTile_bottomGuideline"
        app:layout_constraintEnd_toStartOf="@+id/planTile_endGuideline"
        app:layout_constraintStart_toStartOf="@+id/planTile_startGuideline"
        app:layout_constraintTop_toBottomOf="@+id/planTile_amountDescription"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/planTile_amountDescription"
        android:paddingTop="?attr/uikit_dp4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toTopOf="@+id/planTile_caption"
        app:layout_constraintEnd_toStartOf="@+id/planTile_endGuideline"
        app:layout_constraintStart_toStartOf="@+id/planTile_startGuideline"
        app:layout_constraintTop_toBottomOf="@+id/planTile_subtitle"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/planTile_startGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="?attr/uikit_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/planTile_endGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="?attr/uikit_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/planTile_topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="?attr/uikit_dp16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/planTile_bottomGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="?attr/uikit_dp16"/>
    <View
        android:id="@+id/planTile_foregroundRipple"
        android:background="@drawable/internal_box_foreground_ripple"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
