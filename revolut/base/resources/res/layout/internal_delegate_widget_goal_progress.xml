<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/goalProgressWidget_container"
        android:paddingTop="@dimen/internal_dp12"
        android:paddingBottom="@dimen/internal_dp14"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/internal_dp16">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/goalProgressWidget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/internal_dp8"
            app:layout_constraintEnd_toStartOf="@+id/goalProgressWidget_topRightContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <FrameLayout
            android:id="@+id/goalProgressWidget_topRightContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth="wrap_content"/>
        <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/goalProgressWidget_topContentMainValue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="24sp"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/goalProgressWidget_mainContentBottom"
            app:layout_constraintEnd_toStartOf="@+id/goalProgressWidget_topContentSecondaryValue"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goalProgressWidget_title"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginBottom="@dimen/internal_dp4"
            style="?attr/internal_textAppearanceHeading2"/>
        <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/goalProgressWidget_topContentSecondaryValue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/internal_dp4"
            android:layout_marginEnd="@dimen/internal_dp8"
            android:autoSizeMinTextSize="16sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/goalProgressWidget_topContentMainValue"
            app:layout_constraintBottom_toBottomOf="@+id/goalProgressWidget_topContentMainValue"
            app:layout_constraintEnd_toStartOf="@+id/goalProgressWidget_topRightContainer"
            app:layout_constraintStart_toEndOf="@+id/goalProgressWidget_topContentMainValue"
            app:layout_constraintTop_toTopOf="@+id/goalProgressWidget_topContentMainValue"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody1"/>
        <LinearLayout
            android:id="@+id/goalProgressWidget_mainContentBottom"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/internal_dp4"
            app:layout_constraintBottom_toTopOf="@+id/goalProgressWidget_bottomBarrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/goalProgressWidget_topContentMainValue"
            app:layout_constraintVertical_bias="0">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorGreyTone50"
                android:id="@+id/goalProgressWidget_bottomContentValue"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="?attr/internal_textAppearanceBody1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/uikit_colorForeground"
                android:id="@+id/goalProgressWidget_bottomContentStatus"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="?attr/internal_textAppearanceEmphasis1"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/goalProgressWidget_bottomBarrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="goalProgressWidget_progressStatusContainer,goalProgressWidget_gaugeChart,goalProgressWidget_chartLegend,goalProgressWidget_progressDescription,goalProgressWidget_progressSecondaryDescription,goalProgressWidget_actionButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/goalProgressWidget_progressStatusContainer"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginBottom="@dimen/internal_dp8"
            android:progressDrawable="@drawable/internal_vaults_progress"
            app:layout_constraintBottom_toTopOf="@+id/goalProgressWidget_progressDescription"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="@dimen/internal_dp0"/>
        <com.revolut.core.ui_kit.internal.views.LinearGaugeChartView
            android:id="@+id/goalProgressWidget_gaugeChart"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginBottom="@dimen/internal_dp16"
            app:layout_constraintBottom_toTopOf="@+id/goalProgressWidget_chartLegend"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.chart.HorizontalSingleLineChartLegendView
            android:id="@+id/goalProgressWidget_chartLegend"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/goalProgressWidget_progressDescription"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/internal_dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/goalProgressWidget_progressSecondaryDescription"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/goalProgressWidget_progressSecondaryDescription"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/internal_dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/goalProgressWidget_progressDescription"
            app:layout_goneMarginStart="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody2"/>
        <com.revolut.core.ui_kit.internal.views.SmallActionButton
            android:id="@+id/goalProgressWidget_actionButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:uikit_SmallActionButtonStyle="SemiAccentButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
