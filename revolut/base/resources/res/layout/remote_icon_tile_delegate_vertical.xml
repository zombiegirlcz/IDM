<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/UiKitTheme.Widgets"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@android:id/background"
        android:background="@drawable/widget_background_default"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="24sp"
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:baselineAlignBottom="true"
                android:layout_alignBaseline="@+id/subtitle"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/uikit_colorGreyTone50"
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_toEndOf="@+id/icon"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
