<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenContainer"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:fitNavigationBar="true">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:layout_gravity="top"
        android:id="@+id/atmsMapController_navbar"
        android:background="@color/colorTransparent"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:outlineProvider="none"/>
    <com.revolut.core.ui_kit.views.MapView
        android:id="@+id/atmsMapController_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:orientation="vertical"
        android:id="@+id/atmsMapController_coordinatorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.revolut.core.ui_kit.internal.dialogs.BottomExpandableDialogView
            android:id="@+id/atmsMapController_expandableDialogContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="@dimen/dp_4"
            app:layout_anchorGravity="bottom"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="top"
            android:id="@+id/atmsMapController_locationButton"
            android:paddingBottom="@dimen/dp_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="84dp"
            android:paddingEnd="@dimen/dp_16"
            app:fabSize="normal"
            app:layout_anchor="@+id/atmsMapController_expandableDialogContainer"
            app:layout_anchorGravity="end|top"
            app:useCompatPadding="true"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/atmsMapController_showAtms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="84dp"
            android:text="@string/map.atms.button.search_this_area"
            android:translationY="-16dp"
            app:layout_anchor="@+id/atmsMapController_expandableDialogContainer"
            app:layout_anchorGravity="top|center_horizontal"
            app:uikit_LargeActionButtonStyle="WhiteButton"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
