<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bottomDialogDimOverlay"
        android:background="?attr/uikit_colorForeground_70"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/bottomDialogCoordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.uicomponent.slidingbottomsheet.BottomExpandableDialogView
            android:id="@+id/bottomExpandableDialog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_anchorGravity="bottom"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</merge>
