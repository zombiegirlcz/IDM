<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground_res_0x7f04060d"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/indexBarDelegate_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/indexBarDelegate_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:id="@+id/indexBarDelegate_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceBody2"/>
    </LinearLayout>
</LinearLayout>
