<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerCoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.MapView
        android:id="@+id/cashTopUpLocations_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.core.ui_kit.views.buttons.FormsActionButton
        android:id="@+id/cashTopUpLocations_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:translationY="-40dp"
        android:elevation="1dp"
        app:layout_anchor="@+id/cashTopUpLocations_locationsRv"
        app:layout_anchorGravity="end|top"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:layout_gravity="bottom"
        android:id="@+id/cashTopUpLocations_locationsRv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"/>
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/cashTopUpLocations_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.core.ui_kit.views.buttons.SearchButton
        android:id="@+id/cashTopUpLocations_searchButton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationY="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="1dp"
        app:layout_anchor="@+id/cashTopUpLocations_navBar"
        app:layout_anchorGravity="bottom|center_horizontal"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/cashTopUpLocations_smallAction"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationY="32dp"
        app:layout_anchor="@+id/cashTopUpLocations_navBar"
        app:layout_anchorGravity="bottom|center_horizontal"
        app:uikit_SmallActionButtonStyle="AccentButton"/>
    <com.revolut.core.ui_kit.internal.dialogs.BottomExpandableDialogView
        android:id="@+id/cashTopUpLocations_bottomView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        app:layout_anchorGravity="bottom"/>
</com.revolut.kompot.view.ControllerContainerCoordinatorLayout>
