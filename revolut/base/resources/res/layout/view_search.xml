<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.SearchView
        android:layout_gravity="end"
        android:id="@+id/header_search"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxWidth="500dp"
        app:closeIcon="@drawable/ic_close_black_24dp"
        app:searchIcon="@drawable/ic_search_light_m"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_xl"
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="72dp"
        android:layout_centerHorizontal="true"
        app:ttv_typeface="medium"/>
</FrameLayout>
