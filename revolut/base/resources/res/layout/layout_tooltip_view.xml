<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tooltip_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_pointer"
        android:background="@drawable/tooltip_pointer"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_tooltip"
        android:padding="@dimen/tooltip_side_offset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/uikit_colorBackground"
            android:id="@+id/tooltipTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="?attr/uikit_colorBackground"
            android:id="@+id/tooltipSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
