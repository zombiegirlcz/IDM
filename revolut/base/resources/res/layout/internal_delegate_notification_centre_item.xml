<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/notificationCentreItem_selectedView"
        android:background="@drawable/internal_notification_item_selected_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:alpha="0.4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.CutoutLottieAnimationView
        android:id="@+id/notificationCentreItem_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/notificationCentreItem_notificationDot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/notificationCentreItem_icon"
        app:layout_constraintEnd_toEndOf="@+id/notificationCentreItem_icon"
        app:layout_constraintStart_toEndOf="@+id/notificationCentreItem_icon"
        app:layout_constraintTop_toTopOf="@+id/notificationCentreItem_icon"
        app:srcCompat="@drawable/internal_icn_16_new_item"/>
    <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
        android:id="@+id/notificationCentreItem_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="4dp"
        android:translationY="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/notificationCentreItem_icon"
        app:layout_constraintEnd_toEndOf="@+id/notificationCentreItem_icon"
        app:uikit_circle_badge_size="small"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/notificationCentreItem_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/notificationCentreItem_valueBarrier"
        app:layout_constraintStart_toEndOf="@+id/notificationCentreItem_icon"
        app:layout_constraintTop_toTopOf="@+id/notificationCentreItem_icon"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginStart="16dp"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/notificationCentreItem_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="@+id/notificationCentreItem_title"
        app:layout_constraintStart_toEndOf="@+id/notificationCentreItem_icon"
        app:layout_constraintTop_toBottomOf="@+id/notificationCentreItem_title"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginStart="16dp"
        style="?attr/internal_textAppearanceBody2"/>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/notificationCentreItem_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="@+id/notificationCentreItem_title"
        app:layout_constraintStart_toEndOf="@+id/notificationCentreItem_icon"
        app:layout_constraintTop_toBottomOf="@+id/notificationCentreItem_subtitle"
        app:layout_goneMarginStart="0dp"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/notificationCentreItem_valuePrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxWidth="130dp"
        android:maxLines="2"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/notificationCentreItem_valueSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/notificationCentreItem_title"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceBody1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/notificationCentreItem_valueSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxWidth="130dp"
        android:maxLines="2"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notificationCentreItem_valuePrimary"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/notificationCentreItem_valueBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="notificationCentreItem_valuePrimary, notificationCentreItem_valueSecondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/notificationCentreItem_buttonsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="notificationCentreItem_time, notificationCentreItem_valueSecondary"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/notificationCentreItem_primaryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/notificationCenterItem_bottomSpace"
        app:layout_constraintEnd_toStartOf="@+id/notificationCentreItem_secondaryButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/notificationCentreItem_title"
        app:layout_constraintTop_toBottomOf="@+id/notificationCentreItem_buttonsBarrier"
        app:layout_constraintVertical_bias="1"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/notificationCentreItem_secondaryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/notificationCenterItem_bottomSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/notificationCentreItem_primaryButton"
        app:layout_constraintTop_toBottomOf="@+id/notificationCentreItem_buttonsBarrier"
        app:layout_constraintVertical_bias="1"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/notificationCentreItem_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="notificationCentreItem_icon, notificationCentreItem_primaryButton, notificationCentreItem_secondaryButton, notificationCentreItem_buttonsBarrier"/>
    <Space
        android:id="@+id/notificationCenterItem_bottomSpace"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notificationCentreItem_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
