<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikit_windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.BasicNavBar
        android:id="@+id/splitBillQr_navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.views.TiltGlowCardContainerView
        android:id="@+id/splitBillQr_tiltContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:glowCornerRadius="24dp"
        app:glowIntensity="0.8"
        app:layout_constraintBottom_toTopOf="@+id/splitBillQr_recyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splitBillQr_navBar">
        <com.revolut.core.ui_kit.views.ProfileCardView
            android:layout_gravity="center"
            android:id="@+id/splitBillQr_profileCard"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"/>
    </com.revolut.core.ui_kit.views.TiltGlowCardContainerView>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/splitBillQr_recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp24"
        android:layout_marginHorizontal="?attr/uikit_dp24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
