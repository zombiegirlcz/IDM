<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/testimonial_shimmerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/testimonialLoading_text1"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="?attr/uikit_dp32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8"/>
    <View
        android:id="@+id/testimonialLoading_text2"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="?attr/uikit_dp32"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/testimonialLoading_text1"
        app:layout_constraintWidth_percent="1"/>
    <View
        android:id="@+id/testimonialLoading_text3"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="?attr/uikit_dp32"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/testimonialLoading_text2"
        app:layout_constraintWidth_percent="0.8"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/testimonialLoading_authorAvatar"
        android:background="@drawable/internal_circle_gradient_grey"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/testimonialLoading_text3"/>
    <View
        android:id="@+id/testimonialLoading_authorName"
        android:background="@drawable/internal_rectangle_gradient_grey"
        android:layout_width="0dp"
        android:layout_height="?attr/uikit_dp16"
        android:layout_marginTop="?attr/uikit_dp16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/testimonialLoading_authorAvatar"
        app:layout_constraintWidth_percent="0.3"/>
</com.facebook.shimmer.ShimmerConstraintLayout>
