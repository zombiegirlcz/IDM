<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_attachment_background"
    android:layout_width="40dp"
    android:layout_height="40dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/attachmentIcon"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="@color/internal_greyTone20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/uikit_progressBarPrimary"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/internal_greyTone20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uikit_icn_24_cross"/>
    <FrameLayout
        android:id="@+id/badge"
        android:background="@drawable/internal_attachment_badge_background_red"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:translationX="6dp"
        android:translationY="-6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/badgeIcon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:tint="?attr/uikit_colorBackground"
            app:srcCompat="@drawable/uikit_icn_24_cross"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorBackground"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/badgeText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="12dp"
            android:minHeight="12dp"
            android:includeFontPadding="false"
            android:maxLength="3"
            style="?attr/internal_textAppearanceEmphasis4"/>
    </FrameLayout>
</merge>
