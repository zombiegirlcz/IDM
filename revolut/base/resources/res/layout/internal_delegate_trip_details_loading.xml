<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/tripDetailsLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/triDetailsLoading_startLabel"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="43dp"
                android:layout_height="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/triDetailsLoading_endLabel"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="43dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/triDetailsLoading_startLabel"/>
            <View
                android:id="@+id/triDetailsLoading_startHeading"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toStartOf="@+id/triDetailsLoading_endHeading"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/triDetailsLoading_startLabel"
                app:layout_constraintWidth_max="116dp"/>
            <View
                android:id="@+id/triDetailsLoading_endHeading"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/triDetailsLoading_startHeading"
                app:layout_constraintTop_toTopOf="@+id/triDetailsLoading_startHeading"
                app:layout_constraintWidth_max="116dp"/>
            <View
                android:id="@+id/triDetailsLoading_startSubHeading"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="43dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/triDetailsLoading_startHeading"/>
            <View
                android:id="@+id/triDetailsLoading_endSubHeading"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="43dp"
                android:layout_height="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/triDetailsLoading_startSubHeading"/>
            <View
                android:id="@+id/triDetailsLoading_startFooterFirstLine"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="43dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/triDetailsLoading_startSubHeading"/>
            <View
                android:id="@+id/triDetailsLoading_endFooterFirstLine"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="43dp"
                android:layout_height="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/triDetailsLoading_startFooterFirstLine"
                style="?attr/internal_textAppearanceEmphasis3"/>
            <View
                android:id="@+id/triDetailsLoading_startFooterSecondLine"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="43dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/triDetailsLoading_startFooterFirstLine"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/triDetailsLoading_endFooterSecondLine"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="43dp"
                android:layout_height="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/triDetailsLoading_startFooterSecondLine"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
