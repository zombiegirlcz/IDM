<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/detailedTileLoading_topBackgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,343:164"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/detailedTileLoading_topShimmeringView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/detailedTileLoading_topBackgroundImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/detailedTileLoading_topBackgroundImage">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/detailedTileLoading_badge"
                android:background="@drawable/internal_rectangle_white"
                android:layout_width="67dp"
                android:layout_height="16dp"
                android:layout_marginTop="19dp"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/detailedTileLoading_title"
                android:background="@drawable/internal_rectangle_white"
                android:layout_width="155dp"
                android:layout_height="16dp"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/detailedTileLoading_subtitle"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/detailedTileLoading_subtitle"
                android:background="@drawable/internal_rectangle_white"
                android:layout_width="102dp"
                android:layout_height="16dp"
                android:layout_marginBottom="22dp"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/detailedTileLoading_bottomShimmeringView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailedTileLoading_topShimmeringView">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/detailedTileLoading_description"
                android:background="@drawable/internal_rectangle_white"
                android:layout_width="102dp"
                android:layout_height="16dp"
                android:layout_marginTop="19dp"
                android:layout_marginStart="?attr/uikit_dp16"
                android:backgroundTint="@color/internal_grey20_80"/>
            <View
                android:id="@+id/detailedTileLoading_button"
                android:background="@drawable/internal_large_action_background_semiaccent"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="41dp"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
