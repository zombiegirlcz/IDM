<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/resizableTileHeader_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toStartOf="@+id/resizableTileHeader_rightImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="0dp"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:id="@+id/resizableTileHeader_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resizableTileHeader_label"
        app:layout_constraintWidth_default="wrap"
        style="?attr/internal_textAppearanceWidgetAmountResizable"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:id="@+id/resizableTileHeader_rightSubtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/resizableTileHeader_title"
        app:layout_constraintStart_toEndOf="@+id/resizableTileHeader_title"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/resizableTileHeader_bottomSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resizableTileHeader_title"
        style="?attr/internal_textAppearanceEmphasis2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/resizableTileHeader_rightImage"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/resizableTileHeader_label"/>
</merge>
