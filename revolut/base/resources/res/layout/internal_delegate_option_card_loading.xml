<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/optionCardLoading_shimmeringView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travelRoomListingCardLoading_headerImage">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/optionCardLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="228dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/optionCardLoading_firstDescription"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_title"/>
            <View
                android:id="@+id/optionCardLoading_secondDescription"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="0dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_firstDescription"/>
            <View
                android:id="@+id/optionCardLoading_timeTitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp32"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_secondDescription"/>
            <View
                android:id="@+id/optionCardLoading_priceTitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_timeTitle"/>
            <View
                android:id="@+id/optionCardLoading_cashbackTitle"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="?attr/uikit_dp72"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_priceTitle"/>
            <View
                android:id="@+id/optionCardLoading_timeValue"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp32"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_secondDescription"/>
            <View
                android:id="@+id/optionCardLoading_priceValue"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_timeValue"/>
            <View
                android:id="@+id/optionCardLoading_cashbackValue"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="?attr/uikit_dp48"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_priceValue"/>
            <View
                android:id="@+id/optionCardLoading_button"
                android:background="@drawable/internal_large_action_background_semiaccent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/internal_large_action_button"
                android:layout_marginTop="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:layout_marginStart="?attr/uikit_dp16"
                android:layout_marginEnd="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/optionCardLoading_cashbackTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
