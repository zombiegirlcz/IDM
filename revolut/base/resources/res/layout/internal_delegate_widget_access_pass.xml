<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/accessPassWidget_container"
        android:paddingTop="@dimen/internal_dp12"
        android:paddingBottom="@dimen/internal_dp14"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/internal_dp16">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/accessPassWidget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/internal_dp8"
            app:layout_constraintEnd_toStartOf="@+id/accessPassWidget_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.views.AvatarView
            android:id="@+id/accessPassWidget_avatar"
            android:visibility="gone"
            android:layout_width="@dimen/internal_dp48"
            android:layout_height="@dimen/internal_dp48"
            android:layout_marginTop="@dimen/internal_dp4"
            android:scaleType="centerInside"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/accessPassWidget_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/internal_dp8"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="24sp"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/accessPassWidget_primaryDescriptionLabel"
            app:layout_constraintEnd_toStartOf="@+id/accessPassWidget_avatar"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/accessPassWidget_title"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginBottom="@dimen/internal_dp4"
            style="?attr/internal_textAppearanceHeading2"/>
        <com.revolut.core.ui_kit.internal.views.LabelView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/accessPassWidget_primaryDescriptionLabel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="?attr/uikit_dp8"
            android:layout_marginEnd="@dimen/internal_dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/accessPassWidget_secondaryDescriptionLabel"
            app:layout_constraintEnd_toStartOf="@+id/accessPassWidget_primaryDescriptionValue"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/accessPassWidget_primaryDescriptionValue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/internal_dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/accessPassWidget_secondaryDescriptionValue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/accessPassWidget_primaryDescriptionLabel"
            app:layout_goneMarginStart="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody2"/>
        <com.revolut.core.ui_kit.internal.views.LabelView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/accessPassWidget_secondaryDescriptionLabel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="?attr/uikit_dp8"
            android:layout_marginEnd="@dimen/internal_dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/accessPassWidget_tertiaryDescriptionLabel"
            app:layout_constraintEnd_toStartOf="@+id/accessPassWidget_secondaryDescriptionValue"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/accessPassWidget_secondaryDescriptionValue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/internal_dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/accessPassWidget_tertiaryDescriptionValue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/accessPassWidget_secondaryDescriptionLabel"
            app:layout_goneMarginStart="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody2"/>
        <com.revolut.core.ui_kit.internal.views.LabelView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/accessPassWidget_tertiaryDescriptionLabel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="?attr/uikit_dp8"
            android:layout_marginEnd="@dimen/internal_dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/accessPassWidget_tertiaryDescriptionValue"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginEnd="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/accessPassWidget_tertiaryDescriptionValue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/internal_dp4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/accessPassWidget_tertiaryDescriptionLabel"
            app:layout_goneMarginStart="@dimen/internal_dp0"
            style="?attr/internal_textAppearanceBody2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
