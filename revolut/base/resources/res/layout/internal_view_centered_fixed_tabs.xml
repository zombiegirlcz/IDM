<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/centeredFixedTabs_tabLayoutContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/centeredFixedTabs_tabLayout"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="?attr/uikit_centered_fixed_tab_height"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabBackground="@null"
            app:tabGravity="center"
            app:tabIndicator="@drawable/internal_centered_fixed_tabs_selector"
            app:tabIndicatorColor="?attr/uikit_colorSegmentedActive"
            app:tabIndicatorHeight="?attr/uikit_centered_fixed_tab_height"
            app:tabMaxWidth="0dp"
            app:tabMinWidth="90dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabRippleColor="@null"/>
    </FrameLayout>
</merge>
