<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/passCard_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/passCard_logo"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/internal_dp18"
        android:layout_marginTop="20dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/passCard_headerTitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:maxWidth="200dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/passCard_headerIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passCard_logo"
        style="?attr/internal_textAppearanceBody3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/passCard_headerValue"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/passCard_headerIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passCard_headerTitle"
        style="?attr/internal_textAppearanceHeading1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/passCard_headerIcon"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/passCard_headerValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/passCard_headerTitle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/passCard_headerOrLogoBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="passCard_logo,passCard_headerTitle,passCard_headerValue,passCard_headerIcon"/>
    <FrameLayout
        android:id="@+id/passCard_contentContainer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passCard_headerOrLogoBarrier"
        app:layout_constraintWidth_max="264dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/passCard_contentImage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:id="@+id/passCard_contentNumericCode"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="center"
            style="?attr/internal_textAppearanceHeading1"/>
    </FrameLayout>
    <com.revolut.core.ui_kit.internal.views.PassCardDetailsContainer
        android:id="@+id/passCard_detailsContainer"
        android:layout_width="@dimen/internal_dp0"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        android:layout_marginBottom="@dimen/internal_dp24"
        app:alignContent="flex_start"
        app:alignItems="flex_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passCard_contentContainer"
        app:layout_goneMarginTop="38dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
