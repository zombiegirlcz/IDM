<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardSmall_subtitleImage"
        android:layout_width="?attr/uikit_dp16"
        android:layout_height="?attr/uikit_dp16"
        android:layout_marginTop="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/listingCardSmall_subtitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp4"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmall_image"
        app:layout_constraintStart_toEndOf="@+id/listingCardSmall_subtitleImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceBody3"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/listingCardSmall_titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp4"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmall_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardSmall_subtitleText"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <TextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/listingCardSmall_descriptionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp8"
        android:maxLines="2"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmall_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardSmall_titleText"
        style="?attr/internal_textAppearanceBody3"/>
    <com.revolut.flexbox.FlexboxLayout
        android:orientation="horizontal"
        android:id="@+id/listingCardSmall_tagsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:dividerDrawable="@drawable/internal_divider_price_tags"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintBottom_toTopOf="@+id/listingCardSmall_bottomText"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmall_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingCardSmall_descriptionText"
        app:showDivider="middle|beginning"/>
    <TextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/listingCardSmall_bottomText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/listingCardSmall_priceRevPoints"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmall_image"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.revpoints.RevPointsPriceView
        android:id="@+id/listingCardSmall_priceRevPoints"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/listingCardSmall_bottomButton"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmall_image"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:ellipsize="end"
        android:id="@+id/listingCardSmall_bottomButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmall_secondaryBottomButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_max="200dp"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:ellipsize="end"
        android:id="@+id/listingCardSmall_secondaryBottomButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="1"
        android:layout_marginStart="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/listingCardSmall_image"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/listingCardSmall_bottomButton"
        app:layout_constraintWidth_min="wrap"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardSmall_image"
        android:layout_width="96dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardSmall_topRightImage"
        android:padding="?attr/uikit_dp8"
        android:visibility="gone"
        android:layout_width="?attr/uikit_dp32"
        android:layout_height="?attr/uikit_dp32"
        android:layout_marginTop="?attr/uikit_dp8"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
