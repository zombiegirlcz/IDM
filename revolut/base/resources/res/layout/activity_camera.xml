<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <io.fotoapparat.view.CameraView
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/imageViewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View
        android:background="@drawable/mask_gradient_top"
        android:layout_width="wrap_content"
        android:layout_height="80dp"/>
    <View
        android:layout_gravity="bottom"
        android:background="@drawable/mask_gradient_bottom"
        android:layout_width="wrap_content"
        android:layout_height="140dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.revolut.camera.CameraMaskView
            android:id="@+id/mask"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toTopOf="@+id/buttonAction"
            app:layout_constraintTop_toBottomOf="@+id/titleView"/>
        <View
            android:id="@+id/overlayBottom"
            android:background="?attr/uikit_colorBlack_20"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mask"/>
        <View
            android:id="@+id/overlayTop"
            android:background="?attr/uikit_colorBlack_20"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/mask"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/buttonBack"
            android:tint="?attr/uikit_colorWhite"
            android:layout_centerVertical="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/uikit_icn_24_back"
            style="@style/ToolbarLeftButton"/>
        <Button
            android:id="@+id/buttonAction"
            android:background="@drawable/ic_shutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="16dp"
            android:textColor="?attr/uikit_colorWhite"
            android:gravity="center_horizontal"
            android:id="@+id/titleView"
            android:paddingTop="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="56dp"
            android:layout_marginRight="56dp"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ttv_typeface="medium"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guidelineCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:id="@+id/buttonRetake"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="24dp"
            android:minWidth="148dp"
            android:text="@string/camera.result.retake"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/guidelineCenter"
            style="@style/Style.Button.Grey.Small"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:id="@+id/buttonSubmit"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="24dp"
            android:minWidth="148dp"
            android:text="@string/camera.result.submit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/guidelineCenter"
            style="@style/Style.Button.Blue.Small"/>
        <com.revolut.core_ui_custom_font.TypefaceTextView
            android:textSize="24dp"
            android:textColor="?attr/uikit_colorBackground"
            android:id="@+id/hintText"
            android:background="?attr/uikit_colorBlack_20"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/mask"/>
        <ProgressBar
            android:id="@+id/progressBar"
            android:background="?attr/uikit_colorBlack_20"
            android:visibility="gone"
            android:layout_width="200dp"
            android:layout_height="20dp"
            android:max="1000"
            android:progress="0"
            android:screenReaderFocusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?android:attr/progressBarStyleHorizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/splash"
        android:background="?attr/uikit_colorPink"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.revolut.core.ui_kit.views.legacy.LegacyContentContainerFrameLayout>
