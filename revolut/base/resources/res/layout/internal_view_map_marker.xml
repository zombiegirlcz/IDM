<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/mapMarkerView_bottomArrow"
        android:layout_width="wrap_content"
        android:layout_height="10dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintStart_toStartOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintTop_toBottomOf="@+id/mapMarkerView_circleBackground"
        app:srcCompat="@drawable/internal_bubble_view_bottom_arrow_white"
        app:tint="?attr/uikit_colorBackground"/>
    <ImageView
        android:id="@+id/mapMarkerView_circleBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/uikit_colorBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/mapMarkerView_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintEnd_toEndOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintStart_toStartOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintTop_toTopOf="@+id/mapMarkerView_circleBackground"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/mapMarkerView_circleText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintEnd_toEndOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintStart_toStartOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintTop_toTopOf="@+id/mapMarkerView_circleBackground"
        style="?attr/internal_textAppearanceHeading3"/>
    <com.revolut.core.ui_kit.internal.views.OutlineTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/mapMarkerView_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/mapMarkerView_subtitle"
        app:layout_constraintStart_toEndOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintTop_toTopOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceEmphasis4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/mapMarkerView_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintStart_toEndOf="@+id/mapMarkerView_circleBackground"
        app:layout_constraintTop_toBottomOf="@+id/mapMarkerView_title"
        app:layout_constraintVertical_chainStyle="packed"
        style="?attr/internal_textAppearanceEmphasis4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
