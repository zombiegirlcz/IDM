<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/tdcoreekyc__grey100"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/startRecordingButtonLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:id="@+id/descriptionText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tdcoreekyc__margin_25dp"
                    android:text=""
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginStart="@dimen/tdcoreekyc__margin_25dp"
                    android:layout_marginEnd="@dimen/tdcoreekyc__margin_25dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imageView"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/tdcoreekyc__grey700"
                    android:id="@+id/subDescriptionText"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tdcoreekyc__margin_20dp"
                    android:text=""
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginStart="@dimen/tdcoreekyc__margin_30dp"
                    android:layout_marginEnd="@dimen/tdcoreekyc__margin_30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/descriptionText"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/tdcoreekyc__red500"
                    android:id="@+id/remarkText"
                    android:background="@drawable/tdcoreekyc__rectangle_bg_red"
                    android:paddingTop="11dp"
                    android:paddingBottom="9dp"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tdcoreekyc__margin_15dp"
                    android:text=""
                    android:lineSpacingMultiplier="1.3"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:layout_marginStart="@dimen/tdcoreekyc__margin_25dp"
                    android:layout_marginEnd="@dimen/tdcoreekyc__margin_25dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/subDescriptionText"/>
                <TextView
                    android:textSize="@dimen/tdcoreekyc__text_13sp"
                    android:textStyle="bold"
                    android:textColor="@color/tdcoreekyc__red500"
                    android:gravity="center"
                    android:id="@+id/warningText"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tdcoreekyc__margin_24dp"
                    android:text=""
                    android:drawablePadding="@dimen/tdcoreekyc__margin_8dp"
                    app:drawableStartCompat="@drawable/tdcoreekyc__ic_alert"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/remarkText"/>
                <View
                    android:id="@+id/lineView"
                    android:background="@color/tdcoreekyc__red500"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="@dimen/tdcoreekyc__margin_25dp"
                    android:layout_marginEnd="@dimen/tdcoreekyc__margin_25dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/warningText"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/unauthorizedPatternView"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginStart="@dimen/tdcoreekyc__margin_25dp"
                    android:layout_marginEnd="@dimen/tdcoreekyc__margin_25dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lineView">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ngLeftLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toStartOf="@+id/ngCenterLayout"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/ngLeftImage"
                            android:layout_width="100dp"
                            android:layout_height="100dp"/>
                        <TextView
                            android:textStyle="bold"
                            android:gravity="center_horizontal"
                            android:layout_gravity="center"
                            android:id="@+id/ngLeftText"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tdcoreekyc__margin_8dp"
                            android:text="@string/tdcoreekyc__selfieTutorial_cautionDescription_headgear"
                            style="@style/tdcoreekyc__TutorialNGTextStyle"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ngCenterLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toStartOf="@+id/ngRightLayout"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toEndOf="@+id/ngLeftLayout"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/ngCenterImage"
                            android:layout_width="100dp"
                            android:layout_height="100dp"/>
                        <TextView
                            android:textStyle="bold"
                            android:gravity="center_horizontal"
                            android:layout_gravity="center"
                            android:id="@+id/ngCenterText"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tdcoreekyc__margin_8dp"
                            android:text="@string/tdcoreekyc__selfieTutorial_cautionDescription_sunglasses"
                            style="@style/tdcoreekyc__TutorialNGTextStyle"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ngRightLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ngCenterLayout"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/ngRightImage"
                            android:layout_width="100dp"
                            android:layout_height="100dp"/>
                        <TextView
                            android:textStyle="bold"
                            android:gravity="center_horizontal"
                            android:layout_gravity="center"
                            android:id="@+id/ngRightText"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tdcoreekyc__margin_8dp"
                            android:text="@string/tdcoreekyc__selfieTutorial_cautionDescription_hair"
                            style="@style/tdcoreekyc__TutorialNGTextStyle"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/marginView"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tdcoreekyc__bottom_background_height"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/unauthorizedPatternView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/startRecordingButtonLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tdcoreekyc__bottom_background_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <Button
                android:id="@+id/startRecordingButton"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/tdcoreekyc__CommonButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
