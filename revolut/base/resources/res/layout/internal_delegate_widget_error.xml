<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/errorWidget_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintBottom_toTopOf="@+id/errorWidget_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center_horizontal"
            android:id="@+id/errorWidget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp8"
            app:layout_constraintBottom_toTopOf="@+id/errorWidget_action"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/errorWidget_image"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <TextView
            android:textColor="?attr/uikit_colorAccent"
            android:gravity="center_horizontal"
            android:id="@+id/errorWidget_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uikit_dp4"
            android:drawablePadding="?attr/uikit_dp4"
            android:drawableTint="?attr/uikit_colorAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/errorWidget_title"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
