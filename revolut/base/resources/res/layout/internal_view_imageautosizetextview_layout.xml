<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/chevronLayoutChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:gravity="center_vertical"
        android:id="@+id/chevronLayoutTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="41sp"
        android:lines="1"
        android:textAlignment="viewStart"
        android:paddingEnd="24dp"
        style="?attr/internal_textAppearanceHeading1"/>
</merge>
