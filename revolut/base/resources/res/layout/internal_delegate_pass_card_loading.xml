<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/passCardLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/passCardLoading_logoPlaceholder"
                android:background="@color/uikit_colorTransparent"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/internal_dp18"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/passCardLoading_headerTitle"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="160dp"
                android:layout_height="@dimen/internal_dp16"
                android:layout_marginTop="28dp"
                app:layout_constraintEnd_toStartOf="@+id/passCardLoading_headerIcon"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/passCardLoading_logoPlaceholder"/>
            <View
                android:id="@+id/passCardLoading_headerValue"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="80dp"
                android:layout_height="22dp"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toStartOf="@+id/passCardLoading_headerIcon"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/passCardLoading_headerTitle"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/passCardLoading_headerIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:layout_constraintBottom_toBottomOf="@+id/passCardLoading_headerValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/passCardLoading_headerTitle"
                app:srcCompat="?attr/uikit_shimmerBackgroundCircle"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/passCardLoading_contentImage"
                android:layout_width="@dimen/internal_dp0"
                android:layout_height="@dimen/internal_dp0"
                android:layout_marginTop="50dp"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/passCardLoading_headerValue"
                app:layout_constraintWidth_max="264dp"
                app:layout_goneMarginTop="62dp"
                app:srcCompat="?attr/uikit_shimmerBackgroundRect"/>
            <com.revolut.flexbox.FlexboxLayout
                android:id="@+id/passCardLoading_detailsContainer"
                android:layout_width="@dimen/internal_dp0"
                android:layout_height="wrap_content"
                android:layout_marginTop="54dp"
                android:layout_marginBottom="@dimen/internal_dp24"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:dividerDrawableHorizontal="@drawable/internal_divider_horizontal_pass_card_details"
                app:dividerDrawableVertical="@drawable/internal_divider_vertical_pass_card_details"
                app:flexWrap="wrap"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/passCardLoading_contentImage"
                app:layout_goneMarginTop="38dp"
                app:showDividerHorizontal="middle"
                app:showDividerVertical="middle">
                <include layout="@layout/internal_view_labeled_text_loading"/>
                <include layout="@layout/internal_view_labeled_text_loading"/>
                <include layout="@layout/internal_view_labeled_text_loading"/>
                <include layout="@layout/internal_view_labeled_text_loading"/>
            </com.revolut.flexbox.FlexboxLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/passCardLoading_logo"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/internal_dp18"
        android:layout_marginTop="20dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>
</FrameLayout>
