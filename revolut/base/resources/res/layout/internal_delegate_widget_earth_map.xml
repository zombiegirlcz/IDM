<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.ResizableTileHeaderView
            android:id="@+id/earthMapWidget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp12"
            android:layout_marginHorizontal="@dimen/internal_dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/earthMapWidget_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/internal_dp16"
            app:layout_constraintDimensionRatio="304:150"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/earthMapWidget_header"/>
        <com.revolut.core.ui_kit.internal.views.StatItemView
            android:id="@+id/earthMapWidget_stat1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp4"
            android:layout_marginBottom="@dimen/internal_dp8"
            android:layout_marginStart="@dimen/internal_dp12"
            android:layout_marginEnd="@dimen/internal_dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/earthMapWidget_stat2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/earthMapWidget_image"/>
        <com.revolut.core.ui_kit.internal.views.StatItemView
            android:id="@+id/earthMapWidget_stat2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp4"
            android:layout_marginBottom="@dimen/internal_dp8"
            android:layout_marginHorizontal="@dimen/internal_dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/earthMapWidget_stat3"
            app:layout_constraintStart_toEndOf="@+id/earthMapWidget_stat1"
            app:layout_constraintTop_toBottomOf="@+id/earthMapWidget_image"/>
        <com.revolut.core.ui_kit.internal.views.StatItemView
            android:id="@+id/earthMapWidget_stat3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/internal_dp4"
            android:layout_marginBottom="@dimen/internal_dp8"
            android:layout_marginStart="@dimen/internal_dp8"
            android:layout_marginEnd="@dimen/internal_dp12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/earthMapWidget_stat2"
            app:layout_constraintTop_toBottomOf="@+id/earthMapWidget_image"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
