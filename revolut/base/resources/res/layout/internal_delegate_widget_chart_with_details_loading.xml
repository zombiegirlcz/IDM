<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/chartWithDetailsLoadingWidget_shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants">
        <com.revolut.core.ui_kit.internal.views.chart.ChartGridBackgroundView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/uikit_dp12"
            android:layout_marginBottom="?attr/uikit_dp4"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.6"/>
        <View
            android:id="@+id/chartWithDetailsLoadingWidget_topLabel"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="96dp"
            android:layout_height="16dp"
            android:layout_marginTop="?attr/uikit_dp12"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/chartWithDetailsLoadingWidget_title"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="56dp"
            android:layout_height="24dp"
            android:layout_marginTop="?attr/uikit_dp8"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chartWithDetailsLoadingWidget_topLabel"/>
        <View
            android:id="@+id/chartWithDetailsLoadingWidget_detailsPrimary"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="100dp"
            android:layout_height="14dp"
            android:layout_marginBottom="?attr/uikit_dp8"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/chartWithDetailsLoadingWidget_detailsSecondary"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/chartWithDetailsLoadingWidget_detailsSecondary"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="72dp"
            android:layout_height="14dp"
            android:layout_marginBottom="?attr/uikit_dp8"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintBottom_toTopOf="@+id/chartWithDetailsLoadingWidget_detailsTertiary"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/chartWithDetailsLoadingWidget_detailsTertiary"
            android:background="@drawable/internal_rectangle_gradient_grey"
            android:layout_width="88dp"
            android:layout_height="14dp"
            android:layout_marginBottom="?attr/uikit_dp14"
            android:layout_marginStart="?attr/uikit_dp16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
