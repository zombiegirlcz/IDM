<?xml version="1.0" encoding="utf-8"?>
<com.revolut.kompot.view.ControllerContainerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.background.AnimatedBackgroundView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.revolut.rxdiffadapter.AsyncDiffRecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <TextView
        android:id="@+id/ringingSubtitle"
        android:fitsSystemWindows="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/in_app_calls.notification.title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/InAppCall.Screen.Ringing.SubTitle"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/ringingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/in_app_calls.notification.text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ringingSubtitle"
        style="@style/InAppCall.Screen.Ringing.Title"/>
    <TextView
        android:id="@+id/btnDeclineCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_64"
        android:text="@string/in_app_calls.notification.decline"
        android:layout_marginStart="@dimen/dp_32"
        app:drawableTopCompat="@drawable/ic_in_app_call_decline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnAcceptCall"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/InAppCall.Screen.Ringing.Action"/>
    <TextView
        android:id="@+id/btnAcceptCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_64"
        android:text="@string/in_app_calls.notification.accept"
        android:layout_marginEnd="@dimen/dp_32"
        app:drawableTopCompat="@drawable/ic_in_app_call_accept"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnDeclineCall"
        style="@style/InAppCall.Screen.Ringing.Action"/>
</com.revolut.kompot.view.ControllerContainerConstraintLayout>
