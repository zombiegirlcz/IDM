<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/deprecated_background_selectable_transparent"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <ImageView
        android:id="@+id/dialog_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_outline_info_m"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:ellipsize="end"
        android:id="@+id/dialog_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        android:layout_toEndOf="@+id/dialog_item_icon"
        app:layout_constraintBottom_toTopOf="@+id/guideline4"
        app:layout_constraintStart_toEndOf="@+id/dialog_item_icon"
        style="@style/MainText.Primary"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_s"
        android:ellipsize="end"
        android:id="@+id/dialog_item_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        android:layout_toEndOf="@+id/dialog_item_icon"
        app:layout_constraintStart_toEndOf="@+id/dialog_item_icon"
        app:layout_constraintTop_toBottomOf="@+id/guideline4"
        style="@style/MainText.Clickable"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
