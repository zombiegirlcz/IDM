<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/internal_dp12"
        android:paddingBottom="@dimen/internal_dp14"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/internal_dp16"
        android:paddingEnd="@dimen/internal_dp16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:id="@+id/goalProgressLoadingWidget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/goalProgressLoadingWidget_guidelineEnd"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/goalProgressLoadingWidget_guidelineStart"
            app:layout_constraintTop_toTopOf="@+id/goalProgressLoadingWidget_guidelineTop"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.facebook.shimmer.ShimmerConstraintLayout
            android:id="@+id/goalProgressLoadingWidget_shimmeringLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/goalProgressLoadingWidget_value"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="56dp"
                android:layout_height="24dp"
                android:layout_marginTop="@dimen/internal_dp8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/goalProgressLoadingWidget_progress"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginBottom="@dimen/internal_dp8"
                app:layout_constraintBottom_toTopOf="@+id/goalProgressLoadingWidget_progressDescription"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/goalProgressLoadingWidget_progressDescription"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="96dp"
                android:layout_height="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </com.facebook.shimmer.ShimmerConstraintLayout>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
