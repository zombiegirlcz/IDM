<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.input.InputText
        android:id="@+id/amountInputActions_inputText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layoutDirection="ltr"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/amountInputActions_minusAction"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"/>
    <com.revolut.core.ui_kit.internal.views.SmallActionButton
        android:id="@+id/amountInputActions_plusAction"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"/>
</LinearLayout>
