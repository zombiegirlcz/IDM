<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/listingCardBasicLoading_image"
        android:layout_width="106dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/listingCardBasicLoading_shimmerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/listingCardBasicLoading_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp">
            <View
                android:id="@+id/listingCardBasicLoading_additionalDetails"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="74dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"/>
            <View
                android:id="@+id/listingCardBasicLoading_title"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="118dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"/>
            <View
                android:id="@+id/listingCardBasicLoading_description"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="80dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"/>
            <View
                android:id="@+id/listingCardBasicLoading_price"
                android:background="@drawable/internal_rectangle_foreground_tag"
                android:layout_width="62dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginTop="?attr/uikit_dp16"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"/>
            <View
                android:id="@+id/listingCardBasicLoading_tag"
                android:background="@drawable/internal_rectangle_foreground"
                android:layout_width="100dp"
                android:layout_height="?attr/uikit_dp24"
                android:layout_marginBottom="?attr/uikit_dp16"
                android:alpha="0.05"
                android:layout_marginStart="?attr/uikit_dp16"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
