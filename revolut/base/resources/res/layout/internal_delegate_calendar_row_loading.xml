<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calendarRowLoading_root"
    android:background="@drawable/internal_box_background"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/smartTileFooter_guideline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintGuide_begin="@dimen/dp_64"/>
        <View
            android:id="@+id/calendarRowLoading_dateTitle"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="34dp"
            android:layout_height="16dp"
            android:layout_marginBottom="@dimen/dp_8"
            app:layout_constraintBottom_toTopOf="@+id/calendarRowLoading_dateSubtitle"
            app:layout_constraintEnd_toEndOf="@+id/smartTileFooter_guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/calendarRowLoading_dateSubtitle"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="48dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/smartTileFooter_guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calendarRowLoading_dateTitle"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/calendarRowLoading_container"
            android:background="@drawable/internal_background_rounded_color_nested_background"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/internal_dp12"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/smartTileFooter_guideline"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/calendarRowLoading_icon"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/uikit_shimmerBackgroundCircle"/>
            <View
                android:id="@+id/calendarRowLoading_title"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="102dp"
                android:layout_height="16dp"
                android:layout_marginBottom="@dimen/dp_8"
                android:layout_marginStart="@dimen/internal_dp12"
                app:layout_constraintBottom_toTopOf="@+id/calendarRowLoading_subtitle"
                app:layout_constraintStart_toEndOf="@+id/calendarRowLoading_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/calendarRowLoading_subtitle"
                android:background="?attr/uikit_shimmerBackgroundRect"
                android:layout_width="51dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/internal_dp12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/calendarRowLoading_icon"
                app:layout_constraintTop_toBottomOf="@+id/calendarRowLoading_title"
                app:layout_constraintVertical_chainStyle="packed"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
