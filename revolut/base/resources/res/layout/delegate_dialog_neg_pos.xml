<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:textColor="?attr/uikit_colorAccent"
        android:gravity="center"
        android:id="@+id/negative"
        android:background="@drawable/deprecated_background_selectable_white"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:minHeight="32dp"
        android:lineSpacingExtra="8sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:ttv_typeface="medium"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:textSize="@dimen/material_text_size_m"
        android:textColor="?attr/uikit_colorAccent"
        android:gravity="center"
        android:id="@+id/positive"
        android:background="@drawable/deprecated_background_selectable_white"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:ttv_typeface="medium"/>
</LinearLayout>
