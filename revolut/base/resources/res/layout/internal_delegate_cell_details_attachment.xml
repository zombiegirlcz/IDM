<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/cellDetailsAttachmentDelegate_container"
    android:background="@drawable/internal_box_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cellDetailsAttachmentDelegate_startContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.internal.views.badge.WarningBadgeView
            android:layout_gravity="center_vertical"
            android:id="@+id/cellDetailsAttachmentDelegate_warningBadge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/attachmentsContainer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/addAttachment"
        android:background="@drawable/internal_delegate_cell_details_attachment_add_attachment_background_ripple"
        android:padding="12dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:tint="?attr/uikit_colorAccent"
        app:srcCompat="@drawable/uikit_icn_24_camera"/>
</LinearLayout>
