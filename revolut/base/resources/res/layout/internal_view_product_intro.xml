<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@+id/productIntro_shimmeringView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/internal_view_product_intro_shimmering"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/productIntro_errorState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="?attr/uikit_colorForeground"
            android:gravity="center"
            android:id="@+id/productIntro_errorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="?attr/internal_textAppearanceHeading3"/>
        <TextView
            android:textColor="?attr/uikit_colorAccent"
            android:gravity="center"
            android:id="@+id/productIntro_tryAgainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </LinearLayout>
    <View
        android:id="@+id/productIntro_videoPlayerPlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/productIntro_textPlaceholder"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="300dp"
        app:layout_constraintHeight_min="160dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"/>
    <com.revolut.core.ui_kit.internal.views.videoplayer.UiKitPlayerView
        android:id="@+id/productIntro_videoPlayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/productIntro_videoPlayerPlaceholder"
        app:layout_constraintEnd_toEndOf="@+id/productIntro_videoPlayerPlaceholder"
        app:layout_constraintStart_toStartOf="@+id/productIntro_videoPlayerPlaceholder"
        app:layout_constraintTop_toTopOf="@+id/productIntro_videoPlayerPlaceholder"/>
    <View
        android:id="@+id/productIntro_textPlaceholder"
        android:layout_width="0dp"
        android:layout_height="172dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/productIntro_pageIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productIntro_videoPlayerPlaceholder"
        app:layout_constraintWidth_max="375dp"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:gravity="center"
        android:id="@+id/productIntro_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/internal_dp12"
        app:layout_constraintBottom_toTopOf="@+id/productIntro_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/productIntro_textPlaceholder"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintWidth="wrap_content_constrained"/>
    <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
        android:textSize="40dp"
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/productIntro_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="80dp"
        android:maxLines="3"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="27dp"
        android:autoSizeMaxTextSize="40dp"
        app:layout_constraintBottom_toTopOf="@+id/productIntro_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/productIntro_textPlaceholder"
        app:layout_constraintStart_toStartOf="@+id/productIntro_textPlaceholder"
        app:layout_constraintTop_toBottomOf="@+id/productIntro_badge"
        app:layout_constraintVertical_bias="0"
        app:lineHeight="40dp"/>
    <com.revolut.core.ui_kit.internal.views.DynamicWidthHeightAutosizeTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/productIntro_subtitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/productIntro_textPlaceholder"
        app:layout_constraintEnd_toEndOf="@+id/productIntro_textPlaceholder"
        app:layout_constraintStart_toStartOf="@+id/productIntro_textPlaceholder"
        app:layout_constraintTop_toBottomOf="@+id/productIntro_title"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.ProgressPagingIndicatorView
        android:id="@+id/productIntro_pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/productIntro_textPlaceholder"/>
</merge>
