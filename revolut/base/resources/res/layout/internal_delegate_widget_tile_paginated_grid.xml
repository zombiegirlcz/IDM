<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.internal.views.UIKitTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tilePaginatedGridWidget_title"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.internal.views.framelayout.NestedScrollableHost
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.revolut.recyclerkit.UIKitRecyclerView
                android:theme="@style/internal_GrayWidgetBackgroundTheme"
                android:id="@+id/tilePaginatedGridWidget_recycler"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
        </com.revolut.core.ui_kit.internal.views.framelayout.NestedScrollableHost>
        <com.revolut.core.ui_kit.views.ScrollingPagerIndicatorView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tilePaginatedGridWidget_pagerIndicator"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.DraggableWidgetRootFrameLayout>
