<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.revolut.camerakit.ui.views.view.CameraKitPreviewView
        android:id="@+id/cameraKitUi_previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/cameraKitUi_previewStubImage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.camerakit.ui.views.view.TrackingFaceMaskView
        android:id="@+id/cameraKitUi_faceMaskView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/cameraKitUi_previewView"
        app:layout_constraintEnd_toEndOf="@+id/cameraKitUi_previewView"
        app:layout_constraintStart_toStartOf="@+id/cameraKitUi_previewView"
        app:layout_constraintTop_toTopOf="@+id/cameraKitUi_previewView"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/cameraKitUi_topMarginGuideline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@integer/cameraKitUi_topMarginGuideline_percent"/>
    <View
        android:id="@+id/cameraKitUi_bottomOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cameraKitUi_maskHintView"/>
    <View
        android:id="@+id/cameraKitUi_topOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cameraKitUi_maskHintView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.camerakit.ui.views.view.MaskHintView
        android:id="@+id/cameraKitUi_maskHintView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cameraKitUi_shutterBtnView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cameraKitUi_topMarginGuideline"/>
    <Button
        android:id="@+id/cameraKitUi_shutterBtnView"
        android:background="@drawable/ic_shutter_btn"
        android:visibility="invisible"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
