<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bottomExpandableDialog_anchorView"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="@dimen/internal_bottom_sheet_anchor_view_with_thicker_height"
        android:scaleType="center"
        android:contentDescription="@string/uikit.collapse.description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/internal_ticker_marker_gray"/>
    <com.revolut.core.ui_kit.views.DialogHeaderView
        android:id="@+id/bottomExpandableDialog_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/bottomExpandableDialog_recyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomExpandableDialog_anchorView"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/bottomExpandableDialog_recyclerView"
        android:paddingBottom="?attr/uikit_dp16"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:splitMotionEvents="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomExpandableDialog_header"/>
    <View
        android:id="@+id/bottomExpandableDialog_shadowView"
        android:background="0x7f080763"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:alpha="0"
        android:rotation="180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomExpandableDialog_recyclerView"/>
</merge>
