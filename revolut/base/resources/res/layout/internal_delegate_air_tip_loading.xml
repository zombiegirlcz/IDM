<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerConstraintLayout
        android:id="@+id/air_tip_loading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/air_tip_loading_titleLine"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="@dimen/internal_dp18"
            android:layout_marginTop="@dimen/internal_dp14"
            android:layout_marginBottom="@dimen/internal_dp2"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp8"
            app:layout_constraintBottom_toTopOf="@+id/air_tip_loading_bodyLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3"/>
        <View
            android:id="@+id/air_tip_loading_bodyLine"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="@dimen/internal_dp18"
            android:layout_marginTop="@dimen/internal_dp12"
            android:layout_marginBottom="@dimen/internal_dp2"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp8"
            app:layout_constraintBottom_toTopOf="@+id/air_tip_loading_bodySecondLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/air_tip_loading_titleLine"
            app:layout_constraintWidth_percent="0.65"/>
        <View
            android:id="@+id/air_tip_loading_bodySecondLine"
            android:background="?attr/uikit_shimmerBackgroundRect"
            android:layout_width="0dp"
            android:layout_height="@dimen/internal_dp18"
            android:layout_marginTop="@dimen/internal_dp4"
            android:layout_marginBottom="@dimen/internal_dp16"
            android:layout_marginStart="@dimen/internal_dp16"
            android:layout_marginEnd="@dimen/internal_dp8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/air_tip_loading_bodyLine"
            app:layout_constraintWidth_percent="0.3"/>
    </com.facebook.shimmer.ShimmerConstraintLayout>
</FrameLayout>
