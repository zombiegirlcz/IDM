<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/smartTileExchangeLoading_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/smartTileExchangeLoading_internalContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/smartTileExchangeLoading_topAmountContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toStartOf="@+id/smartTileExchangeLoading_chartView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/internal_exchange_amount_placeholder"/>
        <include
            android:id="@+id/smartTileExchangeLoading_bottomAmountContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toStartOf="@+id/smartTileExchangeLoading_chartView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/smartTileExchangeLoading_topAmountContainer"
            layout="@layout/internal_exchange_amount_placeholder"/>
        <com.revolut.core.ui_kit.internal.views.chart.LineChartView
            android:id="@+id/smartTileExchangeLoading_chartView"
            android:layout_width="93dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/smartTileExchangeLoading_bottomAmountContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/smartTileExchangeLoading_bottomAmountContainer"
            app:layout_constraintTop_toBottomOf="@+id/smartTileExchangeLoading_bottomChartLabelView"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/smartTileExchangeLoading_topChartLabelView"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:layout_constraintBottom_toTopOf="@+id/smartTileExchangeLoading_bottomChartLabelView"
            app:layout_constraintEnd_toEndOf="@+id/smartTileExchangeLoading_chartView"
            app:layout_constraintTop_toTopOf="@+id/smartTileExchangeLoading_topAmountContainer"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <com.revolut.core.ui_kit.internal.views.ShimmeringTextView
            android:id="@+id/smartTileExchangeLoading_bottomChartLabelView"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/smartTileExchangeLoading_chartView"
            app:layout_constraintEnd_toEndOf="@+id/smartTileExchangeLoading_chartView"
            app:layout_constraintTop_toBottomOf="@+id/smartTileExchangeLoading_topChartLabelView"
            style="?attr/internal_textAppearanceBody3"/>
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/smartTileExchangeLoading_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/smartTileExchangeLoading_bottomAmountContainer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerConstraintLayout>
