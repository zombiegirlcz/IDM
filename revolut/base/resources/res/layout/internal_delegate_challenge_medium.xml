<?xml version="1.0" encoding="utf-8"?>
<com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/challengeMediumDelegate_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/UiKitTheme.Mono">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/challengeMediumDelegate_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.tag.TagView
        android:id="@+id/challengeMediumDelegate_badgeTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.revolut.core.ui_kit.internal.views.badge.CircleBadgeView
        android:id="@+id/challengeMediumDelegate_badgeIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:uikit_circle_badge_size="small"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/challengeMediumLoading_descriptionSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/challengeMediumDelegate_bottomSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/challengeMediumDelegate_image"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_goneMarginBottom="12dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorForeground"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/challengeMediumDelegate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="?attr/internal_textAppearanceEmphasis2"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/uikit_colorGreyTone50"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/challengeMediumDelegate_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            style="?attr/internal_textAppearanceBody3"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/challengeMediumDelegate_bottomSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/challengeMediumLoading_descriptionSection">
        <ProgressBar
            android:id="@+id/challengeMediumDelegate_linearProgressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:progressDrawable="@drawable/internal_vaults_progress"
            android:screenReaderFocusable="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/challengeMediumDelegate_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            style="?attr/internal_textAppearanceEmphasis2"/>
    </LinearLayout>
</com.revolut.core.ui_kit.internal.views.SecondaryBackgroundConstraintLayout>
