<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.revolut.core.ui_kit.views.navbar.NavBarWithToolbar
        android:id="@+id/navBarWithToolbar"
        android:background="?attr/uikit_windowBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.revolut.recyclerkit.ScreenContentRecyclerView
        android:id="@+id/recyclerView"
        android:paddingBottom="?attr/uikit_dp72"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.revolut.core.ui_kit.views.navbar.NavBarScrollingViewBehavior"/>
    <com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer
        android:id="@+id/slidingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp">
        <com.revolut.core.ui_kit.views.Tabs
            android:id="@+id/tabs"
            android:background="?attr/uikit_windowBackground"
            android:paddingTop="?attr/uikit_dp8"
            android:paddingBottom="?attr/uikit_dp16"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/uikit_dp16"
            android:paddingEnd="?attr/uikit_dp16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.revolut.core.ui_kit.views.navbar.SlidingFromTopViewContainer>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="?attr/uikit_colorTransparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.revolut.core.ui_kit.views.LargeActionButton
            android:id="@+id/next_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/uikit_dp24"
            android:layout_marginStart="?attr/uikit_dp16"
            android:layout_marginEnd="?attr/uikit_dp16"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
