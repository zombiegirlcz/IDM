<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.revolut.uicomponent.timer.GradientCircleProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_bar"
        android:layout_width="86dp"
        android:layout_height="86dp"
        app:backgroundColor="?attr/uikit_colorGreyTone20_70"
        app:endColor="?attr/uikit_colorAccent"
        app:progressBarThickness="6dp"
        app:startColor="?attr/uikit_colorPink"/>
    <com.revolut.core_ui_custom_font.TypefaceTextView
        android:layout_gravity="center"
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TimerStyle"/>
</FrameLayout>
