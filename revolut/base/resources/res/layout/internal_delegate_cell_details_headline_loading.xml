<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/internal_box_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/cellDetailsHeadlineLoading_shimmeringView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/cellDetailsHeadlineLoading_title"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="136dp"
                android:layout_height="18dp"
                android:textAlignment="viewStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/internal_textAppearanceEmphasis2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/cellDetailsHeadlineLoading_headline"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="248dp"
                android:layout_height="28dp"
                android:layout_marginTop="?attr/uikit_dp12"
                android:textAlignment="viewStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cellDetailsHeadlineLoading_title"
                style="?attr/internal_textAppearanceHeading3"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/cellDetailsHeadlineLoading_badge"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cellDetailsHeadlineLoading_headline"
                app:layout_goneMarginTop="0dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/cellDetailsHeadlineLoading_description"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="176dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/uikit_dp8"
                android:textAlignment="viewStart"
                android:layout_marginStart="?attr/uikit_dp8"
                app:layout_constraintStart_toEndOf="@+id/cellDetailsHeadlineLoading_badge"
                app:layout_constraintTop_toBottomOf="@+id/cellDetailsHeadlineLoading_headline"
                app:layout_goneMarginStart="0dp"
                app:layout_goneMarginTop="0dp"
                style="?attr/internal_textAppearanceBody2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
