<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.revolut.core.ui_kit.views.input.MaskedTextInputEditText
        android:textColor="@color/internal_color_input_text"
        android:textColorHint="?attr/uikit_colorGreyTone50"
        android:layout_gravity="end"
        android:id="@+id/row_valueEditableAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="130dp"
        android:maxLines="1"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:layoutDirection="ltr"
        android:backgroundTint="?attr/uikit_colorGreyTone10"
        style="?attr/internal_textAppearanceBody1"/>
    <TextView
        android:textColor="@color/internal_greyTone50"
        android:layout_gravity="end"
        android:id="@+id/row_subtitleEditableAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/internal_textAppearanceBody2"/>
</LinearLayout>
