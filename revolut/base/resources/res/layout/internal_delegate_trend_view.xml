<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="230dp">
    <com.revolut.core.ui_kit.internal.views.diagram.TrendView
        android:id="@+id/trendView_trendView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:internal_gestures_handling_delay="150"
        app:internal_interval_selection_enabled="false"
        app:internal_rounding="0dp"
        app:internal_tips_padding="8dp"
        app:internal_trend_baseline_color="?attr/uikit_colorGrey50"
        style="@style/InternalDiagramView"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/trendView_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/internal_lottie_chart_loading"/>
</FrameLayout>
