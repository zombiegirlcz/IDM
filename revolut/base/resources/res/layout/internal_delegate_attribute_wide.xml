<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="76dp">
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:id="@+id/attributeWide_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/attributeWide_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/attributeWide_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        app:layout_goneMarginEnd="?attr/uikit_dp0"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/attributeWide_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp2"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toTopOf="@+id/attributeWide_description"
        app:layout_constraintEnd_toStartOf="@+id/attributeWide_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/attributeWide_title"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        app:layout_goneMarginEnd="?attr/uikit_dp0"
        app:layout_goneMarginTop="?attr/uikit_dp0"
        style="?attr/internal_textAppearanceBody2"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:id="@+id/attributeWide_description"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp2"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxLines="3"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/uikit_dp16"
        android:layout_marginEnd="?attr/uikit_dp8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/attributeWide_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/attributeWide_subtitle"
        app:layout_goneMarginEnd="?attr/uikit_dp0"
        style="?attr/internal_textAppearanceBody2"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/attributeWide_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="attributeWide_valuePrimary,attributeWide_valueSecondary"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorForeground"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/attributeWide_valuePrimary"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp16"
        android:maxWidth="130dp"
        android:maxLines="2"
        android:textAlignment="viewEnd"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toTopOf="@+id/attributeWide_valueSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="?attr/uikit_dp16"
        app:layout_goneMarginTop="?attr/uikit_dp16"
        style="?attr/internal_textAppearanceEmphasis1"/>
    <com.revolut.core.ui_kit.internal.views.UIKitTextView
        android:textColor="?attr/uikit_colorGreyTone50"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/attributeWide_valueSecondary"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/uikit_dp2"
        android:layout_marginBottom="?attr/uikit_dp16"
        android:maxWidth="130dp"
        android:maxLines="2"
        android:textAlignment="viewEnd"
        android:layout_marginEnd="?attr/uikit_dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/attributeWide_valuePrimary"
        style="?attr/internal_textAppearanceBody2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
