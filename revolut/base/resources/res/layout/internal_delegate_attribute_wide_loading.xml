<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/attributeWideLoading_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:paddingStart="?attr/uikit_dp16"
            android:paddingEnd="?attr/uikit_dp16">
            <View
                android:id="@+id/attributeWideLoading_fakeTitleView"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="120dp"
                android:layout_height="?attr/uikit_dp16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/attributeWideLoading_fakeValuePrimaryView"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="120dp"
                android:layout_height="?attr/uikit_dp16"
                app:layout_constraintBottom_toTopOf="@+id/attributeWideLoading_fakeValueSecondaryView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <View
                android:id="@+id/attributeWideLoading_fakeValueSecondaryView"
                android:background="@drawable/internal_rectangle_gradient_grey"
                android:layout_width="64dp"
                android:layout_height="?attr/uikit_dp16"
                android:layout_marginTop="?attr/uikit_dp8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/attributeWideLoading_fakeValuePrimaryView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
