        android:right="2dp"
        android:bottom="2dp"/>
    <item
        android:drawable="@drawable/icon_24_retry_white"
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp"/>
</layer-list>
