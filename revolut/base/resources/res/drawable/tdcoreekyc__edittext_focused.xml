<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tdcoreekyc__colorPrimary"/>
            <corners
                android:topLeftRadius="@dimen/tdcoreekyc__corner_radius_4dp"
                android:topRightRadius="@dimen/tdcoreekyc__corner_radius_4dp"
                android:bottomLeftRadius="@dimen/tdcoreekyc__corner_radius_4dp"
                android:bottomRightRadius="@dimen/tdcoreekyc__corner_radius_4dp"/>
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tdcoreekyc__white"/>
            <corners
                android:topLeftRadius="@dimen/tdcoreekyc__corner_radius_4dp"
                android:topRightRadius="@dimen/tdcoreekyc__corner_radius_4dp"
                android:bottomLeftRadius="@dimen/tdcoreekyc__corner_radius_4dp"
                android:bottomRightRadius="@dimen/tdcoreekyc__corner_radius_4dp"/>
        </shape>
    </item>
</layer-list>
