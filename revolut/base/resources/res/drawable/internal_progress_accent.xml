<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="?attr/uikit_colorGreyTone10"/>
            <size
                android:height="4dp"
                android:width="15dp"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item>
                    <color android:color="?attr/uikit_colorWhite"/>
                </item>
                <item>
                    <shape>
                        <solid android:color="?attr/uikit_colorAccent"/>
                        <corners android:radius="2dp"/>
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
