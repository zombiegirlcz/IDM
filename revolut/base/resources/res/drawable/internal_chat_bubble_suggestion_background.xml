<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <ripple android:color="?attr/uikit_colorActionBackground">
            <item android:id="@android:id/mask">
                <shape>
                    <solid android:color="?attr/uikit_colorActionBackground"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="?attr/uikit_colorAccent"/>
        </shape>
    </item>
</layer-list>
