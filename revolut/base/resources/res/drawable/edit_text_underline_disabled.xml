<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:right="-2dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="?attr/uikit_colorGreyTone20"
                android:dashWidth="2dp"
                android:dashGap="2dp"/>
            <solid android:color="#00ffffff"/>
            <padding
                android:left="3dp"
                android:top="1dp"
                android:right="3dp"
                android:bottom="1dp"/>
        </shape>
    </item>
</layer-list>
