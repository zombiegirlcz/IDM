<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/uikit_colorGreyTone10"/>
                    <size
                        android:height="16dp"
                        android:width="16dp"/>
                </shape>
            </item>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/uikit_colorBackground"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
