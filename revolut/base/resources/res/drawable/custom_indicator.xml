<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="false"
        android:state_pressed="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/uikit_colorGreyTone5"/>
                </shape>
            </item>
            <item>
                <inset android:insetBottom="@dimen/separator_height">
                    <shape android:shape="rectangle">
                        <solid android:color="?attr/uikit_colorBackground"/>
                    </shape>
                </inset>
            </item>
        </layer-list>
    </item>
</selector>
