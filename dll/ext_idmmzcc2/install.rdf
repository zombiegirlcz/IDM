<?xml version="1.0"?>
 <RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" 
      xmlns:em="http://www.mozilla.org/2004/em-rdf#">
 
   <Description about="urn:mozilla:install-manifest">
   
     <em:id>mozilla_cc2@internetdownloadmanager.com</em:id>
     <em:name>IDM integration</em:name>
     <em:version>6.27.7</em:version>
     <em:description>Internet Download Manager integration module for Mozilla</em:description>
     <em:creator>Internet Download Manager, Tonec Inc.</em:creator>
     <em:homepageURL>http://www.internetdownloadmanager.com</em:homepageURL>
     <em:updateURL>https://data.internetdownloadmanager.com/idmmzcc2/update.rdf</em:updateURL>
     <em:unpack>true</em:unpack>
     <em:strictCompatibility>true</em:strictCompatibility>
     <em:multiprocessCompatible>false</em:multiprocessCompatible>

     <!-- Firefox -->
     <em:targetApplication>
       <Description>
         <em:id>{ec8030f7-c20a-464f-9b0e-13a3a9e97384}</em:id>
         <em:minVersion>27.0a1</em:minVersion>
         <em:maxVersion>52.*</em:maxVersion>
       </Description>
     </em:targetApplication>

     <!-- SeaMonkey -->
     <em:targetApplication>
        <Description>
          <em:id>{92650c4d-4b8e-4d2a-b7eb-24ecf4f6b63a}</em:id>
          <em:minVersion>2.37.*</em:minVersion>
          <em:maxVersion>2.50a1</em:maxVersion>
        </Description>
     </em:targetApplication>

     <em:file>
       <Description about="urn:mozilla:extension:file:idmmzcc.jar">
         <em:package>content/IDM/</em:package>
       </Description>
     </em:file>

     <em:unpack>true</em:unpack>
 
   </Description>
 
 </RDF>
